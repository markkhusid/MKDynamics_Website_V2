{"version":3,"kind":"Article","sha256":"4d62ab5c407310342172b83d740864cbb79d65f943cdfc6e02f486081bf45683","slug":"sections.mcs-projects.cse572-data-mining.projects.project-3.project-3","location":"/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_3/Project_3.md","dependencies":[],"frontmatter":{"title":"CSE572 Data Mining - Project 3 - Cluster Validation","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_3/Project_3.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_3/Project_3.md","thumbnail":"/build/CSE572_Project_3-0af30f2c8477769f77df1ad866a66677.png","exports":[{"format":"md","filename":"Project_3.md","url":"/build/Project_3-5db4404d1b8e1183925411f37a8bec22.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Bu4YeChB3j"}],"key":"ePJ4WK1rBD"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Problem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Y9gIbS6gc8"}],"identifier":"problem","label":"Problem","html_id":"problem","implicit":true,"key":"JYX7mUaxBa"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The question was whether an unsupervised clustering of meal glucose windows recovers the carbohydrate amount of the meal. Carbohydrate entries in the pump log were the ground truth. Glucose windows were the observations.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"xtxOC4ECqz"}],"key":"h1YtwwxUe3"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Approach","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Q60KSre2t8"}],"identifier":"approach","label":"Approach","html_id":"approach","implicit":true,"key":"Bzu2uP6yS1"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Carbohydrate amounts were divided into six bins between the smallest and largest intake. Those bins were the labels used only for scoring, after clustering.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"pQZR29Q6wO"}],"key":"I1y2aRSOjq"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Meal glucose windows were extracted the same way as in Project 2, then cleaned. Missing samples were filled with a K-nearest-neighbors imputer. The same style of features was computed and scaled so that a feature with a large numeric range would not dominate distance calculations.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"m5s2843Kcv"}],"key":"lcSp2BUb9v"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"K-means was fit first and viewed in the first two principal components. DBSCAN was fit on the same scaled features. Each clustering was compared with the six carbohydrate bins. Agreement was scored with entropy and purity. Entropy falls when a cluster contains one bin. Purity rises when one bin dominates a cluster.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"cyD9Enihsq"}],"key":"Jbt3lzKXZL"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Result","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"xhLT3ek69D"}],"identifier":"result","label":"Result","html_id":"result","implicit":true,"key":"tNgoOEFSJH"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"K-means and DBSCAN both mis-assigned bins 1 and 4. The two partitions still looked different, which follows from how they group points: K-means pulls points toward a centroid, and DBSCAN keeps points that sit in a dense neighborhood. Across the clusters, DBSCAN had the lower entropy and K-means had the higher purity. Neither partition reproduced the carbohydrate bins.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"wAf2MTexJH"}],"key":"XT9ReiiuMC"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Notebooks","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"vBcw34iseK"}],"identifier":"notebooks","label":"Notebooks","html_id":"notebooks","implicit":true,"key":"sPAznflra1"},{"type":"grid","columns":[2,2,2,2],"children":[{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-3/project-3-1","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Project 3 - Cluster Validation","key":"NjIZgGXvEC"}],"key":"wxMrRVAOPk"}],"key":"QpFdXFrAZB"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Clusters meal windows and scores them against carbohydrate bins.","key":"Q6Es4qBoiW"}],"key":"UTp53NHY6B"},{"type":"image","url":"/build/CSE572_Project_3-0af30f2c8477769f77df1ad866a66677.png","height":"200","align":"center","key":"Slq4WWVJMH","urlSource":"../../images/CSE572_Project_3.png"}],"urlSource":"Project_3.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-3.project-3-1.json","internal":true,"protocol":"file","key":"s3dHsVROn7"},{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-3/project-2-train","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Project 2 - Machine Model Training","key":"eMnfhbSdIz"}],"key":"zliNmxhQb3"}],"key":"xpfip5kDtp"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Meal-classifier training notebook stored in this project folder.","key":"Us3f0jLl85"}],"key":"rwswSKHAjx"},{"type":"image","url":"/build/CSE572_Project_2-8f30256326efa07dcecd31048b421b83.png","height":"200","align":"center","key":"H8hpace50k","urlSource":"../../images/CSE572_Project_2.png"}],"urlSource":"Project_2_train.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-3.project-2-train.json","internal":true,"protocol":"file","key":"kha5kV4Kr7"}],"key":"RVtyiOcksZ"}],"key":"dIMk0JBYXE"}],"key":"g2N0dCOGVK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE572 Data Mining - Project 2 - Machine Model Training","url":"/sections/mcs-projects/cse572-data-mining/projects/project-2/project-2","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"CSE575 Statistical Machine Learning","url":"/sections/mcs-projects/cse575-stats-ml/cse575-stats-ml-head","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"https://www.mkdynamics.net"}