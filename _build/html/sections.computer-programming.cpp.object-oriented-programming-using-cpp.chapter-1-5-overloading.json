s%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sG1bs3nlsF"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"IVqKkSzrhV"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K6t1ST7FFV"}],"key":"Eor5jmXm5a"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"Zt3Xk4gtbN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates operator overloading in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zqoeYv9nqQ"}],"identifier":"program-that-demonstrates-operator-overloading-in-c","label":"Program that demonstrates operator overloading in C++","html_id":"program-that-demonstrates-operator-overloading-in-c","implicit":true,"key":"w6VDbxeQ3e"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"CXPdnTJVOJ"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Overloading the operator +\n#include <iostream>\n#include <string>\n#include <cstring>\n\nusing namespace std;\n\nclass my_string {\n    public:\n        my_string() { \n            len = 0; s = new char[1]; \n        }\n\n        explicit my_string(int n) {\n            s = new char[n+1];\n            len = n;\n        }\n\n        void assign(const char* str)\n        {\n            delete []s;\n            len = strlen(str);\n            s = new char[len + 1];\n            strcpy(s, str);\n        }\n\n        int length() const {\n            return len;\n        }\n\n        void print() const {\n            cout << s << \"\\nLength: \" << len << endl;\n        }\n\n        friend my_string& operator+ (const my_string& a, const my_string& b);\n    \n    private:\n        char* s;\n        int len;\n};\n\n// Overload +\nmy_string& operator+(const my_string& a, const my_string& b)\n{\n    my_string* temp = new my_string(a.len + b.len);\n\n    strcpy(temp->s, a.s);\n    strcat(temp->s, b.s);\n    return *temp;\n}\n\nvoid print(const char* c) // file scope print\n{\n    cout << c << \"\\nLength: \" << strlen(c) << endl;\n}\n\nint main()\n{\n    my_string one, two, both;\n    char three[40] = {\"My name is Charles Babbage.\"};\n\n    one.assign(\"My name is Alan Turing.\");\n    two.assign(three);\n    print(three);   // file scope print called\n\n    if (one.length() <= two.length())\n        one.print();\n    else\n        two.print();\n\n    both = one + two;\n\n    both.print();\n}","key":"YHy7SQfSZm"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"zLu3HQ9ODG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uZ4RLPjwvl"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"K4dfp7vJ1c"}],"identifier":"867a23e3","html_id":"867a23e3","key":"cu82d3Ie68"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ug9RzA2eu7"}],"key":"rhA2XMz3s5"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"NnYIikHOrh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ft1Kqt67UQ"},{"type":"outputs","id":"XXPz_rlJU4wSSk50gFd4_","children":[],"key":"niIvRf3fwi"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"UU3BOFFj2K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_5_Overloading\"","key":"L6p96Tp2jO"},{"type":"outputs","id":"i14O3CDyslbLHLqVuffeZ","children":[],"key":"RzaSIqOrbo"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"tFnCVYR4Nr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"SlGNYIwDQi"},{"type":"outputs","id":"0sGnXY5ETWNu4Wms0EyF3","children":[],"key":"efuDD69MAn"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"WPXtsleACk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ string4.cpp -w -o string4\")","key":"eOMyUUODix"},{"type":"outputs","id":"zliiL4g7SjIO1B--mh_0y","children":[],"key":"eDMep8xrHA"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"LsgjO4GRKa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.s