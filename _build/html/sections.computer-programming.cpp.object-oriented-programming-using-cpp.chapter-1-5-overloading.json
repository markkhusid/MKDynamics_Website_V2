{"version":3,"kind":"Notebook","sha256":"e37d31cd8a6baced5381def31b3a538709fae1bac180aca85a5330632cfb05ce","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-1-5-overloading","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","dependencies":[],"frontmatter":{"title":"Chapter 1.5: Overloading the “+” Operator to Handle Strings","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","exports":[{"format":"ipynb","filename":"Chapter_1_5_Overloading.ipynb","url":"/build/Chapter_1_5_Overload-8bd6ca361ee81bb64d17fbb8c2575af6.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x08IVWFftJ"}],"key":"JgIHqph9Tk"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"e31IY1Txz9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates operator overloading in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m61x12eIMU"}],"identifier":"program-that-demonstrates-operator-overloading-in-c","label":"Program that demonstrates operator overloading in C++","html_id":"program-that-demonstrates-operator-overloading-in-c","implicit":true,"key":"XyxXuBxbEN"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"fFkxSx75jU"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Overloading the operator +\n#include <iostream>\n#include <string>\n#include <cstring>\n\nusing namespace std;\n\nclass my_string {\n    public:\n        my_string() { \n            len = 0; s = new char[1]; \n        }\n\n        explicit my_string(int n) {\n            s = new char[n+1];\n            len = n;\n        }\n\n        void assign(const char* str)\n        {\n            delete []s;\n            len = strlen(str);\n            s = new char[len + 1];\n            strcpy(s, str);\n        }\n\n        int length() const {\n            return len;\n        }\n\n        void print() const {\n            cout << s << \"\\nLength: \" << len << endl;\n        }\n\n        friend my_string& operator+ (const my_string& a, const my_string& b);\n    \n    private:\n        char* s;\n        int len;\n};\n\n// Overload +\nmy_string& operator+(const my_string& a, const my_string& b)\n{\n    my_string* temp = new my_string(a.len + b.len);\n\n    strcpy(temp->s, a.s);\n    strcat(temp->s, b.s);\n    return *temp;\n}\n\nvoid print(const char* c) // file scope print\n{\n    cout << c << \"\\nLength: \" << strlen(c) << endl;\n}\n\nint main()\n{\n    my_string one, two, both;\n    char three[40] = {\"My name is Charles Babbage.\"};\n\n    one.assign(\"My name is Alan Turing.\");\n    two.assign(three);\n    print(three);   // file scope print called\n\n    if (one.length() <= two.length())\n        one.print();\n    else\n        two.print();\n\n    both = one + two;\n\n    both.print();\n}","key":"GGG0GdL4af"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"LHGOmRWO7l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wDRZ0JfFep"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"JT4fGCF0bW"}],"identifier":"867a23e3","html_id":"867a23e3","key":"vSXnQ3ymXL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hE6yuOQwyE"}],"key":"zefBqUiugN"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"XiFYgG5iLI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"Jz0l4ZXwEU"},{"type":"outputs","id":"KgLFK2157ZUV-DF_MfWCJ","children":[],"key":"N225wRUAd5"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"e9IKCWEDQ5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_5_Overloading\"","key":"exdc21GZ8g"},{"type":"outputs","id":"XGmdS2KQ3J3F5vaDucZO8","children":[],"key":"IJJvaBgD7i"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"Fndwc0ZTjM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"bWvlNYwAte"},{"type":"outputs","id":"k5S0sncLBd32UTkW2ldOL","children":[],"key":"Pk7arsEahV"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"TvdkZjNyqb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ string4.cpp -w -o string4\")","key":"loCvr3S6GL"},{"type":"outputs","id":"fUBufkABlSp0ZYSd70AoO","children":[],"key":"jId4j0zwEx"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"dAwjSE1utG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./string4\")","key":"roSmPSU490"},{"type":"outputs","id":"1ZkluoBvv6evg6DCZvEGB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"My name is Charles Babbage.\nLength: 27\nMy name is Alan Turing.\nLength: 23\nMy name is Alan Turing.My name is Charles Babbage.\nLength: 50\n"},"children":[],"key":"eLOZoENNUp"}],"key":"stkrgeXBA8"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"OjONKbPc6j"}],"key":"n5waZmV34S"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Hello World!","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/hello-cpp","group":"Computer Programming"},"next":{"title":"Chapter 1.7: The C++ Standard Template Library","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-1-7-the-standard-template-library","group":"Computer Programming"}}},"domain":"ht