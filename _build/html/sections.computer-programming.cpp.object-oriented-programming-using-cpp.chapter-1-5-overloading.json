{"version":3,"kind":"Notebook","sha256":"e37d31cd8a6baced5381def31b3a538709fae1bac180aca85a5330632cfb05ce","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-1-5-overloading","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","dependencies":[],"frontmatter":{"title":"Chapter 1.5: Overloading the “+” Operator to Handle Strings","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_1_5_Overloading.ipynb","exports":[{"format":"ipynb","filename":"Chapter_1_5_Overloading.ipynb","url":"/build/Chapter_1_5_Overload-8bd6ca361ee81bb64d17fbb8c2575af6.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YgwZ4Qf9um"}],"key":"B3GVuYXdt4"}],"key":"cSZCvpLQKv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates operator overloading in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sqmJuMgFpg"}],"identifier":"program-that-demonstrates-operator-overloading-in-c","label":"Program that demonstrates operator overloading in C++","html_id":"program-that-demonstrates-operator-overloading-in-c","implicit":true,"key":"GsbMSZCxRw"}],"key":"hqdbgUo8DB"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Overloading the operator +\n#include <iostream>\n#include <string>\n#include <cstring>\n\nusing namespace std;\n\nclass my_string {\n    public:\n        my_string() { \n            len = 0; s = new char[1]; \n        }\n\n        explicit my_string(int n) {\n            s = new char[n+1];\n            len = n;\n        }\n\n        void assign(const char* str)\n        {\n            delete []s;\n            len = strlen(str);\n            s = new char[len + 1];\n            strcpy(s, str);\n        }\n\n        int length() const {\n            return len;\n        }\n\n        void print() const {\n            cout << s << \"\\nLength: \" << len << endl;\n        }\n\n        friend my_string& operator+ (const my_string& a, const my_string& b);\n    \n    private:\n        char* s;\n        int len;\n};\n\n// Overload +\nmy_string& operator+(const my_string& a, const my_string& b)\n{\n    my_string* temp = new my_string(a.len + b.len);\n\n    strcpy(temp->s, a.s);\n    strcat(temp->s, b.s);\n    return *temp;\n}\n\nvoid print(const char* c) // file scope print\n{\n    cout << c << \"\\nLength: \" << strlen(c) << endl;\n}\n\nint main()\n{\n    my_string one, two, both;\n    char three[40] = {\"My name is Charles Babbage.\"};\n\n    one.assign(\"My name is Alan Turing.\");\n    two.assign(three);\n    print(three);   // file scope print called\n\n    if (one.length() <= two.length())\n        one.print();\n    else\n        two.print();\n\n    both = one + two;\n\n    both.print();\n}","key":"wY0sYAQitT"}],"key":"vrHDfbYRpx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eBW7TVOW3c"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"AkWbDrQGbA"}],"key":"BJjF6wkC1K"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jzbVthMaDr"}],"key":"NgnXrBNgdB"}],"key":"Ex4RQzZ6tp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ztPOsbZHyB"},{"type":"outputs","id":"t8XZBdqLLtLtVXO6uDIqB","children":[],"key":"MK5kE9OXYg"}],"key":"zeoX5cMDSw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_5_Overloading\"","key":"EfX6s8hk6g"},{"type":"outputs","id":"fZzo28bVqh5HGfvkm1rGG","children":[],"key":"ju8EMjMtab"}],"key":"CZu7fQ8QSK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"K5l9474JyO"},{"type":"outputs","id":"vcZXCyK-fUxnLgnrgRsZJ","children":[],"key":"d6mDPmtkzo"}],"key":"WV5oxTqHbZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ string4.cpp -w -o string4\")","key":"ZT36KYW9XE"},{"type":"outputs","id":"pIPCW1cifxJUw4FyPgOk9","children":[],"key":"oKZCUpjiRq"}],"key":"KihkpiBXmb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./string4\")","key":"tzMvnpv2IH"},{"type":"outputs","id":"u2cSzh-1d2mGMJrtShFV6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"My name is Charles Babbage.\nLength: 27\nMy name is Alan Turing.\nLength: 23\nMy name is Alan Turing.My name is Charles Babbage.\nLength: 50\n"},"children":[],"key":"MX2PufCbxg"}],"key":"LVATkIdNEd"}],"key":"Dw7dqewrCg"}],"key":"qJHcuONZg0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Hello World!","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/hello-cpp","group":"Computer Programming"},"next":{"title":"Chapter 1.7: The C++ Standard Template Library","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-1-7-the-standard-template-library","group":"Computer Programming"}}},"domain":"http://localhost:3000"}