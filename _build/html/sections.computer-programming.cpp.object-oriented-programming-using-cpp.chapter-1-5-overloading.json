s%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GBVZfX08bC"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"kXgFt4eFzl"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FcjdXIzTqB"}],"key":"mli3jw4YBC"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"siqIPrZmNH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates operator overloading in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vQH9uhwnDx"}],"identifier":"program-that-demonstrates-operator-overloading-in-c","label":"Program that demonstrates operator overloading in C++","html_id":"program-that-demonstrates-operator-overloading-in-c","implicit":true,"key":"SU3i6mHO71"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"HvHGMRgtkt"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Overloading the operator +\n#include <iostream>\n#include <string>\n#include <cstring>\n\nusing namespace std;\n\nclass my_string {\n    public:\n        my_string() { \n            len = 0; s = new char[1]; \n        }\n\n        explicit my_string(int n) {\n            s = new char[n+1];\n            len = n;\n        }\n\n        void assign(const char* str)\n        {\n            delete []s;\n            len = strlen(str);\n            s = new char[len + 1];\n            strcpy(s, str);\n        }\n\n        int length() const {\n            return len;\n        }\n\n        void print() const {\n            cout << s << \"\\nLength: \" << len << endl;\n        }\n\n        friend my_string& operator+ (const my_string& a, const my_string& b);\n    \n    private:\n        char* s;\n        int len;\n};\n\n// Overload +\nmy_string& operator+(const my_string& a, const my_string& b)\n{\n    my_string* temp = new my_string(a.len + b.len);\n\n    strcpy(temp->s, a.s);\n    strcat(temp->s, b.s);\n    return *temp;\n}\n\nvoid print(const char* c) // file scope print\n{\n    cout << c << \"\\nLength: \" << strlen(c) << endl;\n}\n\nint main()\n{\n    my_string one, two, both;\n    char three[40] = {\"My name is Charles Babbage.\"};\n\n    one.assign(\"My name is Alan Turing.\");\n    two.assign(three);\n    print(three);   // file scope print called\n\n    if (one.length() <= two.length())\n        one.print();\n    else\n        two.print();\n\n    both = one + two;\n\n    both.print();\n}","key":"oGAiId9HhG"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"SVg1P54EAk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YyySCogMCd"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"t0b2pYE020"}],"identifier":"867a23e3","html_id":"867a23e3","key":"wMl1CGAjnh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Sa0g9yHBtp"}],"key":"dkn1rPGeD8"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"SHxbUHq0vr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vBFcA0Umnw"},{"type":"outputs","id":"alFrgy_bLt4XrL3SVLqj0","children":[],"key":"JE0TQeuHxw"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"jzutewNkSG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_5_Overloading\"","key":"BDtBJulK9E"},{"type":"outputs","id":"5ymxTntbbbLgKSI3lx9t4","children":[],"key":"LUVatrV2sG"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"SBIm4Tqsdz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"sr8nzqv0G8"},{"type":"outputs","id":"daJVswoeJVt0pcQP5cacP","children":[],"key":"SZQx46P50O"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"qD7bf17ILc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ string4.cpp -w -o string4\")","key":"xLV37jmzKf"},{"type":"outputs","id":"o-xyj4AH2dqWnVvGt__P1","children":[],"key":"vzWUE8gJ2s"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"WmApdsKbCE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.s