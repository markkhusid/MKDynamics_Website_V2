bject+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CJ7vdp3Ts3"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"tdK0wRuGxe"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yFMbSQV94L"}],"key":"hsp3UXCC02"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"GNnTATR56X"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates containers and item access in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pNbmcWXeDE"}],"identifier":"program-that-demonstrates-containers-and-item-access-in-c","label":"Program that demonstrates containers and item access in C++","html_id":"program-that-demonstrates-containers-and-item-access-in-c","implicit":true,"key":"y2Bc2QGta3"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"cg9RWb646x"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Dynamic arrays in two dimensions\n#include <iostream>\nusing namespace std;\n\nclass twod {\npublic:\n    bool    allocate(int r, int s);    // pseudo - constructor\n    \n    void    deallocate();              // pseudo - destructor\n    \n    double& element_lval(int i, int j) const\n        { return base[i][j]; }\n    \n    double  element_rval(int i, int j) const\n        { return base[i][j]; }\n    \n    int     r_size() const { return row_size;    }\n    int     c_size() const { return column_size; }\n\nprivate:\n    double**    base;\n    int         row_size, column_size;\n};\n\nbool twod::allocate(int r, int s)\n{\n    base = new double*[s];\n    if (base == 0)  // allocation failed\n        return false;\n    for (int i = 0; i < s; ++i) {\n        base[i] = new double[r];\n        if (base[i] == 0)   // allocation failed\n            return false;\n    }\n    row_size = r;\n    column_size = s;\n    return true;\n}\n\nvoid twod::deallocate()\n{\n    for (int i = 0; i < column_size; ++i)\n        delete [] base[i];\n    delete [] base;\n    row_size = 0;\n    column_size = 0;\n}\n\ndouble find_max(const twod& m)\n{\n    int i, j;\n    double max = m.element_rval(0,0);\n\n    for (i = 0; i < m.c_size(); ++i)\n        for (j = 0; j < m.r_size(); ++j)\n            if (m.element_rval(i, j) > max)\n                max = m.element_rval(i, j);\n    return max;\n}\n\nvoid print_2d(twod& m)\n{\n    int i, j;\n\n    for (i = 0; i < m.c_size(); ++i) {\n        for (j = 0; j < m.r_size(); ++j)\n            cout << m.element_rval(i, j) << \" \";\n        cout << \"\\n\";\n    }\n}\n\nint main ()\n{\n    twod    a, b;\n    int     i, j;\n\n    a.allocate(2, 3);\n    b.allocate(4, 6);\n\n    for (i = 0; i < a.c_size(); ++i)\n        for (j = 0; j < b.r_size(); ++j)\n            a.element_lval(i, j) = i * j;\n    \n    for (i = 0; i < b.c_size(); ++i)\n        for (j = 0; j < b.r_size(); ++j)\n            b.element_lval(i, j) = i * j;\n\n    cout << \"\\n\\nPrinting 3x2 matrix A...\\n\";\n    print_2d(a);\n    cout << \"\\n\\nPrinting 6x4 matrix B...\\n\";\n    print_2d(b);\n    cout << \"\\nMax element in size 3x2 matrix A is -> \" << find_max(a) << endl;\n    cout << \"\\nMax element in size 6x4 matrix B is -> \" << find_max(b) << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":96,"column":1}},"key":"UvICCLECzu"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"q3NjG3ibiS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CIGpAGRfli"}],"key":"a7aWdlj8yL"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"KuRW3V4Ier"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"f5aJ9LOaUu"},{"type":"outputs","id":"pezLv_PZ44-bkVDKfqM-0","children":[],"key":"pYBQSZISVJ"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"YhAfwo4OsR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_9_Containers_and_Item_Access\"","key":"q05wTtflsm"},{"type":"outputs","id":"stzAH4Ti3xBbeg7kiWDi-","children":[],"key":"s6OYu3qtyg"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"A9pVXPqSOa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"LjoEgYw2Xt"},{"type":"outputs","id":"JGQvY04inUShrKYDr4Eqq","children":[],"key":"KlESDOt0UU"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"bzH5dhk1vn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ twod.cpp -w -o twod\")","key":"MpKxY6qqmt"},{"type":"outputs","id":"sReMFi9yAP4Aku8fJx6NH","children":[],"key":"Zb5RlmUlXM"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"yIy0AIr2bw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./twod\")","key":"umUE2w3xla"},{"type":"outputs","id":"-p6-D2O6ARdWqyVy3Fwh4","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n\nPrinting 3x2 matrix A...\n0 0 \n0 1 \n0 2 \n\n\nPrinting 6x4 matrix B...\n0 0 0 0 \n0 1 2 3 \n0 2 4 6 \n0 3 6 9 \n0 4 8 12 \n0 5 10 15 \n\nMax element in size 3x2 matrix A is -> 2\n\nMax element in size 6x3 matrix B is -> 15\n"},"children":[],"key":"WkPo9yN9ZO"}],"key":"GUNE73uIZw"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"WuYjATPpPK"}],"key":"nBPcfjp8Yh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"STATIC and CONST Member Functions","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-5-8-static-and-const-member-functions","group":"Computer Programming"},"next":{"title":"Chapter 6: Object Creation and Destruction","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/object-oriented-programming-using-cpp-ch-6","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}