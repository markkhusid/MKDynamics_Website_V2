,"key":"GL1pUa8PfL"}],"identifier":"17067957","html_id":"17067957","key":"cMwil9jFuT"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"XpZzBfFcvn"}],"key":"lbjxrkkUHJ"}],"identifier":"ebaa7c39","html_id":"ebaa7c39","key":"zn97d65Aw0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GHUwFUCRv0"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"ezT73hHMnT"}],"identifier":"3e111038","html_id":"3e111038","key":"p2y28BFC99"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KEu5wUbRcC"}],"key":"TRQpW7giig"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"t7tIY0pw0n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"miyjA23fNd"},{"type":"outputs","id":"0RzQkOJdibBL8bLHaW9qw","children":[],"key":"uLFDrWXS58"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"rGP9HPZaj7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"Z0AszRN7RM"},{"type":"outputs","id":"DAgVlUhQ4w69f5WSwJ95-","children":[],"key":"G0Aa3D6nYe"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"kojhRoGrLM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"PwYQYPVbT3"},{"type":"outputs","id":"9TMd3ggUOrgn70JcutsXf","children":[],"key":"sVBdFccSag