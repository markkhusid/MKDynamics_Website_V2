2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KnVFO8U1Ae"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"vPgnbo72TY"},{"type":"text","value":" by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iTcG1CCtXG"}],"key":"NCzQD7W5i2"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"ohZRwzOxwM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fqGUe1RLgV"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"VtEyewVUZB"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"Z6EbIKnN9o"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aLIauqO7F4"}],"key":"FBvqJ2E8Gs"}],"identifier":"17067957","html_id":"17067957","key":"MUjNkE5La0"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"cpp","filename":"triple.cpp","key":"gpIdCR5TO8"}],"key":"eFl4s2yYR0"}],"identifier":"ebaa7c39","html_id":"ebaa7c39","key":"JGj4IV7kND"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"enj5mEl4Ls"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"fG1lDbJTDY"}],"identifier":"3e111038","html_id":"3e111038","key":"zNufd9C2cI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VLlMg6PeGv"}],"key":"KssF6RCVU8"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"VmvOurSZId"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vdnFxJaRBv"},{"type":"outputs","id":"6T-V9FudjTV71Z8Egm9e3","children":[],"key":"LM0UB9iJHo"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"OhfpuSB3nO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"Mwx1aQYHH0"},{"type":"outputs","id":"mhMgXsVnXwZXn_6BNAOhO","children":[],"key":"LmXiTtlf87"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"zsqZfInT92"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"hhVMdhy6uP"},{"type":"outputs","id":"DLBXe_che7J1rV19IYFLt","children":[],"key":"bxrfMFHFcv"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e9