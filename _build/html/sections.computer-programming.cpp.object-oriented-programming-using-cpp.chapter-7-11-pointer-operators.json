  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"CiOVx2VKBp"}],"key":"GgQ8PnyxHb"}],"key":"onkITnWuCW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D1rXzAcvDv"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"SxzWIJDwBA"}],"key":"HnwUkthfeD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vj7a6wyMWe"}],"key":"EchvvgRW7C"}],"key":"VhWfCNKFx4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"G0ga0ju9qQ"},{"type":"outputs","id":"F6dunAp0pvqQs__Tg3G5q","children":[],"key":"e7RJqkFtOJ"}],"key":"h9fEK0vLbn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"oJ89EcAkQu"},{"type":"outputs","id":"A_qy9ltE2v_X7r7KGuvzP","children":[],"key":"gN09biGu5E"}],"key":"QMcLbiEIGf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"WecDw1z98B"},{"type":"outputs","id":"FQ_mHB7JFocn-byv-SjTN","children":[],"key":"h4JdB4jlCz"}],"key":"ZeujLeDbyl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"Q31ZvUzVmj"},{"type":"outputs","id":"gnJ5JEgyo0lLDRRmRuV3l","children":[],"key":"UTIg4sH9FI"}],"key":"d3LfHWFgQf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BcFxHtm6bv"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"DJqr20GWpk"}],"key":"FArkPQB9Nh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"pytho