g.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eRjHcfg0AX"}],"key":"JYklzZ1216"}],"identifier":"17067957","html_id":"17067957","key":"A1nW6ozzO0"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  tracking.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.11   No Constructor, Copy Constructor Other Mysteries\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n#include  <iostream>\n\nusing namespace std;\n\n// personal data tracking\n\nstruct pers_data {\n   int   age;           //in years\n   int   weight;        //in kilograms\n   int   height;        //in centimeters\n   char  name[20];      //last name\n};\n\nvoid print(pers_data d)\n{\n   cout << d.name << \" is \" << d.age\n        << \" years old\\n\";\n   cout << \"weight : \" << d.weight << \"kg,  height : \"\n        << d.height << \"cm.\" << endl;\n}\n\nint main()\n{\n   pers_data  laura = {3, 14, 88, \"POHL\"};\n                  //construction off the stack\n\n   print(laura);  //calls copy constructor\n}","position":{"start":{"line":1,"column":1},"end":{"line":40,"column":1}},"key":"mpLP7a85zt"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"jD2XTBVGsX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xnn4F4ZMmz"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"iwJo09596N"}],"identifier":"3e111038","ht