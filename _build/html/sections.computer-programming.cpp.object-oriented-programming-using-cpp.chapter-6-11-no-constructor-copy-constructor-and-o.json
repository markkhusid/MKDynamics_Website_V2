n":[{"type":"code","lang":"c++","value":"/*********************************************************************\n\n  Filename:  tracking.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.11   No Constructor, Copy Constructor Other Mysteries\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n#include  <iostream>\n\nusing namespace std;\n\n// personal data tracking\n\nstruct pers_data {\n   int   age;           //in years\n   int   weight;        //in kilograms\n   int   height;        //in centimeters\n   char  name[20];      //last name\n};\n\nvoid print(pers_data d)\n{\n   cout << d.name << \" is \" << d.age\n        << \" years old\\n\";\n   cout << \"weight : \" << d.weight << \"kg,  height : \"\n        << d.height << \"cm.\" << endl;\n}\n\nint main()\n{\n   pers_data  laura = {3, 14, 88, \"POHL\"};\n                  //construction off the stack\n\n   print(laura);  //calls copy constructor\n}","position":{"start":{"line":1,"column":1},"end":{"line":40,"column":1}},"key":"eoxRogJnXt"}],"key":"Ymnu6hxSRs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FOji1p0LyP"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"YJFTgOBcHj"}],"key":"Ik08RMO2gu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NmMTcTgN