  # open — no bottom resistor\nCFF = 0.0            # no feedforward capacitor on the fixed part\nCOUT = 1.0e-6\nCIN = 1.0e-6\nESR_OUT = 10e-3      # ceramic assumption, not printed on TA01\nESR_IN = 10e-3\nRLOAD = 100.0        # 5 V / 50 mA\nR_TOL = 0.01         # 1 %\nC_TOL = 0.10         # 10 %\nVIN_NOM = 12.0\nVIN_MIN = 5.4\nVIN_MAX = 80.0\nILOAD_OP = 50e-3\nN_MC = 2000\nN_SPICE_MC = 40\nN_LTSPICE_MC = 40\nSKIP_SPICE_WC_MC = False\nRUN_LTSPICE_BATCH = True\nSPICE_WORKERS = 4\nLTSPICE_WORKERS = 4\n\np = CircuitParams(\n    r1=R1, r2=R2, cff=CFF, cout=COUT, cin=CIN,\n    esr_out=ESR_OUT, esr_in=ESR_IN, r_load=RLOAD,\n    r_tol=ToleranceSpec(R_TOL), c_tol=ToleranceSpec(C_TOL),\n)\np = replace(p, op=replace(p.op, vin_nom=VIN_NOM, vin_min=VIN_MIN, vin_max=VIN_MAX,\n                           iload_op=ILOAD_OP, r_load=RLOAD))\n\nFIG = ROOT / \"results\" / \"figures\"\nFIG.mkdir(parents=True, exist_ok=True)\nprint(\"gain =\", p.gain, \"  Vout nom =\", analysis.vout_dc(p))\nprint(\"SPICE_WORKERS =\", SPICE_WORKERS, \"  N_MC =\", N_MC)\n","key":"oM7lVrdyzA"},{"type":"outputs","id":"KhMD-GzUMUK3j7-2pqWjN","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"gain = 1.0   Vout nom = 5.0\nSPICE_WORKERS = 4   N_MC = 2000\n"},"children":[],"key":"Fqi8fu8AxL"}],"key":"Sto1FnQKco"}],"identifier":"dbd3e4e1","html_id":"dbd3e4e1","key":"quj8pk2GFV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-26T05:14:30.028258Z","iopub.status.busy":"2026-09-26T05:14:30.022696Z","iopub.status.idle":"2026-09-26T05:14:30.078307Z","shell.execute_reply":"2026-09-26T05:14:30.069202Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from p5v_design.simulate import find_ngspice, simulate_op, simulate_dc_vin, simulate_dc_i, simulate_ac_psrr\n\ntry:\n    print(\"ngspice ready\")\n    HAVE_SPICE = True\nexcept FileNotFoundError as e:\n    print(e)\n    HAVE_SPICE = False\n","key":"fwzv8rEHop"},{"type":"outputs","id":"2rRh_zv599HcVStHNgZaB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"ngspice ready\n"},"children":[],"key":"aBoeO0nvaX"}],"key":"OYG8W8nkER"}],"identifier":"d8345b5a","html_id":"d8345b5a","key":"jvg7YEOpNB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Operating point","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lyS9iDGg2v"}],"identifier":"operating-point","label":"Operating point","html_id":"operating-point","implicit":true,"key":"EwrRzQtJu1"}],"identifier":"eecc1e46","html_id":"eecc1e46","key":"dR0uEIRsKh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-26T05:14:30.085458Z","iopub.status.busy":"2026-09-26T05:14:30.084646Z","iopub.status.idle":"2026-09-26T05:14:30.194516Z","shell.execute_reply":"2026-09-26T05:14:30.190244Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"an = analysis.summary_metrics(p)\nprint(\"analytical Vout\", an[\"vout\"])\nif HAVE_SPICE:\n    op = simulate_op(p, workdir=ROOT/\"results\"/\"ngspice_nom\"/\"op\",\n                     mirror=ROOT/\"netlists\"/\"spice_nom\"/\"p5v_op.cir\")\n    print(\"ngspice nodes\", op.nodes)\n    vsp = op.nodes.get(\"out\", list(op.nodes.values())[0] if op.nodes else float(\"nan\"))\n    print(f\"error {1e3*(vsp-an['vout']):.3f} mV\")\nelse:\n    print(\"skip ngspice OP\")","key":"mjePKsVVqs"},{"type":"outputs","id":"ujBbjziJlR58OSqA8zHfa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"analytical Vout 5.0\n"},"children":[],"key":"loscOuGXn0"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"ngspice nodes {'out': 4.99995, 'v(out)': 4.99995, 'adj': 4.99995, 'v(adj)': 4.99995, 'vin': 12.0, 'v(vin)': 12.0}\nerror -0.050 mV\n"},"childre