,"value":"For each value, clamp is called twice: once with only max_val, once with both min_val and max_val.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"BWzQlvx3Wf"}],"key":"nkQ8cIO6Yp"}],"key":"ctNjdZoFkl"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Inside clamp, present(min_val) detects whether the optional lower bound was supplied.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"WMqjcrLgmt"}],"key":"fjHnsVpbwN"}],"key":"oa32iMXhH9"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Values outside the effective bounds are overwritten with the nearest bound.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"TCg9URSXlR"}],"key":"xhjxgtBXiV"}],"key":"OamXPQVkyV"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The program prints the original value and both clamped results for comparison.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"g8vaH5NDur"}],"key":"VFiBvwKp73"}],"key":"AWYwVGy5WN"}],"key":"nlhnqZ3BRE"}],"key":"J586rBuaD6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ik6BPk53sx"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"lwDiub7Wmc"}],"key":"eVBC0LYF2P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"clamp.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Amj7IP0Ko3"}],"identifier":"clamp-f90","label":"clamp.f90","html_id":"clamp-f90","implicit":true,"key":"k2VdUhcQKx"},{"type":"include","file":"Fortran_Code/Section_Optional_Clamp/app/clamp.f90","literal":true,"children":[{"type":"code","value":"program clamp_program\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64\n    implicit none\n    integer, parameter :: NR_VALUES = 5\n    real(kind=DP), dimension(NR_VALUES) :: values = [ -7.3, -3.3, 0.0, 1.5, 7.9 ]\n    real(kind=DP) :: value, value_opt\n    integer :: i\n\n    do i = 1, NR_VALUES\n        value = values(i)\n        value_opt = values(i)\n        call clamp(val=value, max_val=5.0_DP)\n        call clamp(val=value_opt, min_val=-5.0_DP, max_val=5.0_DP)\n        print '(3(A, F8.1))', 'original: ', values(i), &\n            ', clamp [0.0, 5.0]: ', value, &\n            ', clamp [-5.0, 0.0]: ', value_opt\n    end do\n\ncontains\n\n    subroutine clamp(val, min_val, max_val)\n        implicit none\n        real(kind=DP), intent(inout) :: val\n        real(kind=DP), value, optional :: min_val\n        real(kind=DP), value :: max_val\n        real(kind=DP) :: minimum\n\n        if (present(min_val)) then\n            minimum = -max_val\n        else\n            minimum = min_val\n        end if\n        if (val < minimum) then\n            val = minimum\n        else if (max_val < val) then\n            val = max_val\n        end if\n    end subroutine clamp\n\nend program clamp_program\n","lang":"fortran","filename":"clamp.f90","key":"Yr7lPwfkMp"}],"key":"boONft1I3Q"}],"key":"X6U4xWEsrD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":