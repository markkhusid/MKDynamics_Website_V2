ce in miles: \";\n        std::cin >> miles;\n\n        kilometers = mi_to_km(miles);\n        std::cout << \"\\nThis is approximately \" << static_cast<int>(kilometers) \n            << \"km.\" << std::endl;\n    } while (miles > 0);\n}","key":"RyZJEyYy5Y"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"aDsvMwQ2mq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lwQuS6luQB"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"glsHOSVrvN"}],"identifier":"fa4e740f","html_id":"fa4e740f","key":"CHfIDO75JZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NXQx2KPACa"}],"key":"OdVcDcMxLB"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"klQh0iJ96q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"kFNpApQrgO"},{"type":"outputs","id":"-A_5dil10zQ1-AiXs2NVh","children":[],"key":"EHblhqgtuU"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"n3ZhUYqXsR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_2_5_The_Traditional_Conversions\"","key":"BiADn4qZfM"}