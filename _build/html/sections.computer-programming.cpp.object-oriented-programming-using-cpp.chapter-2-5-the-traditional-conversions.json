nt","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates type conversion in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b4USK9dhXL"}],"identifier":"program-that-demonstrates-type-conversion-in-c","label":"Program that demonstrates type conversion in C++","html_id":"program-that-demonstrates-type-conversion-in-c","implicit":true,"key":"yFVL9GLGNg"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"Jd8zJTaMI7"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Miles are converted to kilometers\n#include <iostream>\n\nconst double m_to_k = 1.609;    // Conversion constant\n\ninline double mi_to_km(int miles)\n{\n    return (miles * m_to_k);\n}\n\nint main()\n{\n    int miles;\n    double kilometers;\n\n    do {\n        std::cout << \"\\nEnter distance in miles: \";\n        std::cin >> miles;\n\n        kilometers = mi_to_km(miles);\n        std::cout << \"\\nThis is approximately \" << static_cast<int>(kilometers) \n            << \"km.\" << std::endl;\n    } while (miles > 0);\n}","key":"PtYP9rZ6a5"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"eAAWWTI9Me"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"px9yb2YuVd"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"H5e0sJLIqx"}],"identifier":"fa4e740f","html_id":"fa4e740f","key":"r8QXE9Db1J"},{"type":"block","kind":"notebook-content","children