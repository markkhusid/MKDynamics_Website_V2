.9, 0.8, 88, -99.99};\n    list<double> z;\n\n    for (int i = 0; i < 4; ++i)\n        z.push_front(w[i]);\n    print(z);\n    z.sort();\n    print(z);\n    cout << \"sum is \" << accumulate(z.begin(), z.end(), 0.0) << endl;\n}","key":"wzs5UvL9MR"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"ekko7UyKCj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dErVyf0u22"}],"key":"NMX93qjHsG"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"jxqJx6xKTt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"Vjd02WkDPI"},{"type":"outputs","id":"642qyRwV1SNC5iKx9qrCt","children":[],"key":"C05I8mnwbS"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"epoXd2bJ6V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_7_The_Standard_Template_Library\"","key":"icsn7BIAfF"},{"type":"outputs","id":"uz0FAJlDs2h6hUkkdeWH_","children":[],"key":"x0S5gCAjrC"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"BaWagpFIAM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"gKooRuAgbc"},{"type":"outputs","id":"C6A7ZNvEUbLtHsiho3GTO","children":[],"key":"JbabWw5eJN"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"UtRBJlP3u5"},{