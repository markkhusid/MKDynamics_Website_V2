{"version":3,"kind":"Notebook","sha256":"7eec3ec9580b0b4d0b4c14d8b296842f9a1c0eae31e189b0fe2f23f70d1fa888","slug":"sections.computer-programming.fortran.guide-to-fortran-2008-programming.section-3-6-ex-1-median-of-three","location":"/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","dependencies":[],"frontmatter":{"title":"Section 3.6: Median of Three","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3.9.2 64-bit","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":4}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","exports":[{"format":"ipynb","filename":"Section_3_6_Ex_1_Median_of_Three.ipynb","url":"/build/Section_3_6_Ex_1_Med-3ad54ec9a6438985cf40d389115fdc37.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Guide to Fortran 2008 Programming” by Walter S. Brainerd (Springer 2015)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HtFNEX4vbc"}],"key":"MD79MR5wC0"}],"key":"fzewoRmIfx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that finds the median of three numbers.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g4hi0SR4SP"}],"identifier":"program-that-finds-the-median-of-three-numbers","label":"Program that finds the median of three numbers.","html_id":"program-that-finds-the-median-of-three-numbers","implicit":true,"key":"fTXLnZmdNv"}],"key":"HhUCfMA1xw"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program median_of_3_program\n\n    implicit none\n\n    real :: num1, num2, num3\n    real :: median\n    \n    write (*, '(a)') \"This program finds the median of three numbers.....\"\n    write (*, '(a)') \"Data piped in from command line....\"\n    read *, num1, num2, num3\n    \n    write (*, '(a, 3f10.2)') \"The three entered numbers were -->\", num1, num2, num3\n    \n    median = medianOf3(n1=num1, n2=num2, n3=num3)\n    \n    write (*, '(a, f10.2)') \"The median value is -->\", median\n \n    contains\n\n        subroutine swap(a, b)\n            real, intent (in out) :: a, b\n            real :: temp\n            temp = a\n            a = b\n            b = temp\n        end subroutine swap\n    \n        subroutine sort(val1, val2, val3)\n            real, intent(in out) :: val1, val2, val3\n        \n            if (val1 > val2) then\n                call swap (val1, val2)\n            end if\n            if (val1 > val3) then\n                call swap (val1, val3)\n            end if\n            if (val2 > val3) then\n                call swap (val2, val3)\n            end if\n        end subroutine sort\n\n        function medianOf3(n1, n2, n3) result (median_value)\n \n            real, intent(in out) :: n1, n2, n3\n            real :: median_value\n        \n            call sort (val1=n1, val2=n2, val3=n3)\n            \n            median_value = n2\n     \n        end function medianOf3\n\nend program median_of_3_program","position":{"start":{"line":1,"column":1},"end":{"line":55,"column":1}},"key":"GqTSYLRkha"}],"key":"Qc99bXfV6k"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QzqXgE8a4E"}],"key":"HKpHJV87lY"}],"key":"r9x8ea1haQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"qk7q2UTVIz"},{"type":"outputs","id":"AA87snyJ5APZ9SSqbYiPw","children":[],"key":"qKpOdHwcGA"}],"key":"UA1i445Dfn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_3_6_Ex_1_Median_of_Three\"","key":"sRsfaXBOVl"},{"type":"outputs","id":"EhFpYDvKKgsNtTpxMwfjn","children":[],"key":"AIWLLNFNfw"}],"key":"Ez10fkeXCP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"ZWr1WI3zA9"},{"type":"outputs","id":"3DXtDjt3MH0o4Nac4WYOX","children":[],"key":"oT4yycpHJU"}],"key":"FC2e10nI2q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"ZHNXYoxBQf"},{"type":"outputs","id":"ll1n_ljC9eOuV9ZMJwpm5","children":[],"key":"BT4LGl3JIG"}],"key":"W6UnRKea9X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"echo '87 12 55' | fpm run 2>/dev/null\")","key":"aua26r7WVX"},{"type":"outputs","id":"JZUGqQI4ahAwc0tEi-CHP","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"This program finds the median of three numbers.....\nData piped in from command line....\nThe three entered numbers were -->     87.00     12.00     55.00\nThe median value is -->     55.00\n"},"children":[],"key":"ov2MYiSyQv"}],"key":"qz5FUJ86Jc"}],"key":"kimnBYUena"}],"key":"ZKVYV1dD1G"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Section 3.4: Putting Procedures in a Module","url":"/sections/computer-programming/fortran/guide-to-fortran-2008-programming/section-3-4-putting-procedures-in-a-module","group":"Computer Programming"},"next":{"title":"Section 3.8: Argument Passing","url":"/sections/computer-programming/fortran/guide-to-fortran-2008-programming/section-3-8-argument-passing","group":"Computer Programming"}}},"domain":"http://localhost:3000"}