{"version":3,"kind":"Notebook","sha256":"7eec3ec9580b0b4d0b4c14d8b296842f9a1c0eae31e189b0fe2f23f70d1fa888","slug":"sections.computer-programming.fortran.guide-to-fortran-2008-programming.section-3-6-ex-1-median-of-three","location":"/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","dependencies":[],"frontmatter":{"title":"Section 3.6: Median of Three","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3.9.2 64-bit","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":4}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_6_Ex_1_Median_of_Three.ipynb","exports":[{"format":"ipynb","filename":"Section_3_6_Ex_1_Median_of_Three.ipynb","url":"/build/Section_3_6_Ex_1_Med-3ad54ec9a6438985cf40d389115fdc37.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Guide to Fortran 2008 Programming” by Walter S. Brainerd (Springer 2015)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Um5aOVSN0l"}],"key":"z0jdZnydgl"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"AM5XPXHzE3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that finds the median of three numbers.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D6KZjF6tY4"}],"identifier":"program-that-finds-the-median-of-three-numbers","label":"Program that finds the median of three numbers.","html_id":"program-that-finds-the-median-of-three-numbers","implicit":true,"key":"XlbdDlbhs4"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"BQCUlYi0df"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program median_of_3_program\n\n    implicit none\n\n    real :: num1, num2, num3\n    real :: median\n    \n    write (*, '(a)') \"This program finds the median of three numbers.....\"\n    write (*, '(a)') \"Data piped in from command line....\"\n    read *, num1, num2, num3\n    \n    write (*, '(a, 3f10.2)') \"The three entered numbers were -->\", num1, num2, num3\n    \n    median = medianOf3(n1=num1, n2=num2, n3=num3)\n    \n    write (*, '(a, f10.2)') \"The median value is -->\", median\n \n    contains\n\n        subroutine swap(a, b)\n            real, intent (in out) :: a, b\n            real :: temp\n            temp = a\n            a = b\n            b = temp\n        end subroutine swap\n    \n        subroutine sort(val1, val2, val3)\n            real, intent(in out) :: val1, val2, val3\n        \n            if (val1 > val2) then\n                call swap (val1, val2)\n            end if\n            if (val1 > val3) then\n                call swap (val1, val3)\n            end if\n            if (val2 > val3) then\n                call swap (val2, val3)\n            end if\n        end subroutine sort\n\n        function medianOf3(n1, n2, n3) result (median_value)\n \n            real, intent(in out) :: n1, n2, n3\n            real :: median_value\n        \n            call sort (val1=n1, val2=n2, val3=n3)\n            \n            median_value = n2\n     \n        end function medianOf3\n\nend program median_of_3_program","position":{"start":{"line":1,"column":1},"end":{"line":55,"column":1}},"key":"tjZdtjzYgK"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"RGtDx7QVhB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jvas8B5fsU"}],"key":"D8g5VvP3yc"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"Oq6d4lCinv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"U0pbyTuAxG"},{"type":"outputs","id":"sEr7efPdfTSIsddO8rtnX","children":[],"key":"XmqkvQ6y5b"}],"identifier":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","html_id":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","key":"QQDd4jJk9k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_3_6_Ex_1_Median_of_Three\"","key":"YXwhQTfzyc"},{"type":"outputs","id":"Ueob5D_P74uFJ5rqufPfC","children":[],"key":"erZRkDiVmv"}],"identifier":"bdaf795d-554a-46e6-b4da-faeb331e1b13","html_id":"bdaf795d-554a-46e6-b4da-faeb331e1b13","key":"z3cBtHoEiw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"h6oxHG5nJj"},{"type":"outputs","id":"DF_XVkKDPqMYa8D66uOxn","children":[],"key":"jMlk0gK7jl"}],"identifier":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","html_id":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","key":"g99yeEj8jD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"So4rUog0vx"},{"type":"outputs","id":"AcYyf64GKU1bIkQKO2xKc","children":[],"key":"CAwmnn8f9I"}],"identifier":"0fbd7621-e800-4235-ab30-80560cc3e1a8","html_id":"0fbd7621-e800-4235-ab30-80560cc3e1a8","key":"fljdM0Y9Qp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"echo '87 12 55' | fpm run 2>/dev/null\")","key":"Bn0DCZiPlc"},{"type":"outputs","id":"i1suUhxt37fvRc7qgiScI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"This program finds the median of three numbers.....\nData piped in from command line....\nThe three entered numbers were -->     87.00     12.00     55.00\nThe median value is -->     55.00\n"},"children":[],"key":"T89Vmwuhij"}],"key":"rpyDJFWseo"}],"identifier":"0483d40b-e849-4574-bcbe-003c81a96dd5","html_id":"0483d40b-e849-4574-bcbe-003c81a96dd5","key":"byePSXJGx0"}],"key":"zP74x16kTM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Section 3.4: Putting Procedures in a Module","url":"/sections/computer-programming/fortran/guide-to-fortran-2008-programming/section-3-4-putting-procedures-in-a-module","group":"Computer Programming"},"next":{"title":"Section 3.8: Argument Passing","url":"/sections/computer-programming/fortran/guide-to-fortran-2008-programming/section-3-8-argument-passing","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}