":"UXDIZ03Ihg"}],"key":"KHvc2Er0VT"}],"key":"UScfCYOdRF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Overview","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wWpDurNtVD"}],"identifier":"overview","label":"Overview","html_id":"overview","implicit":true,"key":"Bk0JXp2yMR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Applies Kaprekar’s process to a 4-digit-like integer until it reaches a fixed point (classically 6174).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KQuSl2gZGz"}],"key":"tx5Z1wXHLF"}],"key":"mNfhtTry2V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step-by-step explanation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iOn2dapPLn"}],"identifier":"step-by-step-explanation","label":"Step-by-step explanation","html_id":"step-by-step-explanation","implicit":true,"key":"guybf4Y5Bc"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Read a command-line integer in 1..9999 with not all digits identical.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JDR4nAsXr3"}],"key":"OePB0r4MN3"}],"key":"K4Ul4o6TDg"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Split into digits, sort, form smallest and largest rearrangements.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"fInp5t2o41"}],"key":"ioMtoi8AjC"}],"key":"V09IAdMLEV"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Replace the number by large - small and repeat.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oo46Mm46ME"}],"key":"HYkPAVvEiY"}],"key":"Amt7pchCjX"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stop when the value no longer changes; print the fixed point.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ueg7CT8uZJ"}],"key":"wr69DD6mH4"}],"key":"sJO4uQ5pQ3"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A classic recreational-math algorithm using arrays and sorting.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"y3ZqrBrk8e"}],"key":"tFvFys7XiP"}],"key":"Y3IVOI9NwI"}],"key":"sEmyc7WS4O"}],"key":"m9kOS4tHZH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uiEgTaXDvF"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"o4wTBjyl0s"}],"key":"KmIAP57Qg1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"kaprekar.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OTMfsOfpYt"}],"identifier":"kaprekar-f90","label":"kaprekar.f90","html_id":"kaprekar-f90","implicit":true,"key":"YywmIOinTi"},{"type":"include","file":"Fortran_Code/Section_Kaprekar/app/kaprekar.f90","literal":true,"children":[{"type":"code","value":"program kaprekar\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, parameter :: nr_digits = 4\n    integer, dimension(:), allocatable :: digits\n    integer :: number, prev_number, small, large, istat\n\n    number = get_argument()\n    allocate(digits(nr_digits), stat=istat)\n    if (istat /= 0) then\n        write (error_unit, '(A)') 'Error: can not allocate array'\n        stop 5\n    end if\n    prev_number = 0\n    do while (number /= prev_number)\n        call number2digits(number, digits)\n        call sort_digits(digits)\n        small = digits2number(digits)\n        large = reverse_digits2number(digits)\n        prev_number = number\n        number = large - small\n    end do\n    print '(I0)', number\n\ncontains\n\n    integer function get_argument() result(number)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=80) :: buffer\n        integer :: istat, first_digit, n, i\n        logical :: okay\n\n        if (command_argument_count() /= 1) then\n            write (error_unit, '(A)') &\n                'Error: expecting a single number as argument'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, '(I10)', iostat=istat) number\n        if (istat /= 0) then\n            write (error_unit, '(A)') &\n                'Error: expecting as integer as argument'\n            stop 2\n        end if\n        if (number < 1 .or.  number > 9999) then\n            write (error_unit, '(A)') &\n                'Error: argument should be between 1 and 9999'\n            stop 3\n        endif\n        okay = .false.\n        first_digit = mod(number, 10)\n        n = number/10\n        do i = 2, 4\n            if (first_digit /= mod(n, 10)) then\n                okay = .true.\n            exit\n            end if\n            n = n/10\n        end do\n        if (.not.  okay) then\n            write (error_unit, '(A)') &\n                'Error: number must have at least two distinct digits'\n            stop 4\n        end if\n\n    end function get_argument\n\n    subroutine number2digits(number, digits)\n        implicit none\n        integer, value :: number\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i\n\n        do i = 1, size(digits)\n            digits(i) = mod(number, 10)\n            number = number/10\n        end do\n\n    end subroutine number2digits\n\n    integer function digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = 1, size(digits)\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function digits2number\n\n    integer function reverse_digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = size(digits), 1, -1\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function reverse_digits2number\n\n    subroutine sort_digits(digits)\n        implicit none\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i, j, index, tmp\n\n        do i = 1, size(digits)\n            index = i\n            do j = i + 1, size(digits)\n                if (digits(index) < digits(j)) &\n                    index = j\n            end do\n            tmp = digits(index)\n            digits(index) = digits(i)\n            digits(i) = tmp\n        end do\n\n    end subroutine sort_digits\n\nend program kaprekar\n","lang":"fortran","filename":"kaprekar.f90","key":"YBRFV5Osvs"}],"key":"zF6utPmL7z"}],"key":"oMqeC5rpJG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IcmUHUvRb7"}],"key":"wgqQjm9R6e"}],"key":"wSn3R8FZOb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FXRy92l1x1"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"eM2SyTHFYy"}],"key":"fY1Wg616tk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"Xvh2LbmIGK"},{"type":"outputs","id":"k1DdoPu82DcVRBBosELQT","children":[],"key":"Dmm6XBfX2I"}],"key":"GIYRgnIj5Q"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"poRCVB7roX"}],"key":"beMjHbPbQD"}],"key":"OUwVfoYGtc"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Kaprekar/fpm.toml","literal":true,"children":[{"type":"code","value":"name = \"Section_Kaprekar\"\n\n[build]\nauto-executables = true\nauto-tests 