":"IZOvTIZTyj"}],"key":"Wo2AfP7OoP"}],"key":"D298rXoPYQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Overview","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wXqhjJfrfa"}],"identifier":"overview","label":"Overview","html_id":"overview","implicit":true,"key":"gIubfRwo1F"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Applies Kaprekar’s process to a 4-digit-like integer until it reaches a fixed point (classically 6174).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LlNqkUVtxd"}],"key":"wfE6Iru2jW"}],"key":"qjQEwS3s3M"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step-by-step explanation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hx13gmxhwq"}],"identifier":"step-by-step-explanation","label":"Step-by-step explanation","html_id":"step-by-step-explanation","implicit":true,"key":"vOpMfM7S4C"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Read a command-line integer in 1..9999 with not all digits identical.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TDc1vkZL3S"}],"key":"Yc6hwOclzd"}],"key":"Y7SWVTzvHt"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Split into digits, sort, form smallest and largest rearrangements.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"MPL9WpBR8T"}],"key":"YoI34zfK87"}],"key":"ouWzqS6sFT"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Replace the number by large - small and repeat.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tafTP3ZF0l"}],"key":"aqPMHyOUJ0"}],"key":"uAc5vcFbjj"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stop when the value no longer changes; print the fixed point.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"jjbfTrGl73"}],"key":"i3aS4zI80K"}],"key":"TJdfvk9kXm"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A classic recreational-math algorithm using arrays and sorting.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"BEBxUeAiEN"}],"key":"PGUZ69YJTC"}],"key":"U2b78c1nFn"}],"key":"KGybBQMeZb"}],"key":"yNT8rfDJfJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T6aP6cEhjh"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"t1aqIlGK8J"}],"key":"Jsjg17MgVT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"kaprekar.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wG4gzwvhHt"}],"identifier":"kaprekar-f90","label":"kaprekar.f90","html_id":"kaprekar-f90","implicit":true,"key":"PBstMDZDAR"},{"type":"include","file":"Fortran_Code/Section_Kaprekar/app/kaprekar.f90","literal":true,"children":[{"type":"code","value":"program kaprekar\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, parameter :: nr_digits = 4\n    integer, dimension(:), allocatable :: digits\n    integer :: number, prev_number, small, large, istat\n\n    number = get_argument()\n    allocate(digits(nr_digits), stat=istat)\n    if (istat /= 0) then\n        write (error_unit, '(A)') 'Error: can not allocate array'\n        stop 5\n    end if\n    prev_number = 0\n    do while (number /= prev_number)\n        call number2digits(number, digits)\n        call sort_digits(digits)\n        small = digits2number(digits)\n        large = reverse_digits2number(digits)\n        prev_number = number\n        number = large - small\n    end do\n    print '(I0)', number\n\ncontains\n\n    integer function get_argument() result(number)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=80) :: buffer\n        integer :: istat, first_digit, n, i\n        logical :: okay\n\n        if (command_argument_count() /= 1) then\n            write (error_unit, '(A)') &\n                'Error: expecting a single number as argument'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, '(I10)', iostat=istat) number\n        if (istat /= 0) then\n            write (error_unit, '(A)') &\n                'Error: expecting as integer as argument'\n            stop 2\n        end if\n        if (number < 1 .or.  number > 9999) then\n            write (error_unit, '(A)') &\n                'Error: argument should be between 1 and 9999'\n            stop 3\n        endif\n        okay = .false.\n        first_digit = mod(number, 10)\n        n = number/10\n        do i = 2, 4\n            if (first_digit /= mod(n, 10)) then\n                okay = .true.\n            exit\n            end if\n            n = n/10\n        end do\n        if (.not.  okay) then\n            write (error_unit, '(A)') &\n                'Error: number must have at least two distinct digits'\n            stop 4\n        end if\n\n    end function get_argument\n\n    subroutine number2digits(number, digits)\n        implicit none\n        integer, value :: number\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i\n\n        do i = 1, size(digits)\n            digits(i) = mod(number, 10)\n            number = number/10\n        end do\n\n    end subroutine number2digits\n\n    integer function digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = 1, size(digits)\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function digits2number\n\n    integer function reverse_digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = size(digits), 1, -1\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function reverse_digits2number\n\n    subroutine sort_digits(digits)\n        implicit none\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i, j, index, tmp\n\n        do i = 1, size(digits)\n            index = i\n            do j = i + 1, size(digits)\n                if (digits(index) < digits(j)) &\n                    index = j\n            end do\n            tmp = digits(index)\n            digits(index) = digits(i)\n            digits(i) = tmp\n        end do\n\n    end subroutine sort_digits\n\nend program kaprekar\n","lang":"fortran","filename":"kaprekar.f90","key":"uJLb0GEZ8H"}],"key":"UZ9f1VptGm"}],"key":"V7kS8SGHwt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iGlPTuUv3y"}],"key":"qDo1chWYTS"}],"key":"WjUXT2InED"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v9G1yE4hj6"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"G7x4kevdMw"}],"key":"rNeeyPwi0Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"BuFPvuXvPB"},{"type":"outputs","id":"DBKyaIYym5II75Js3pmIn","children":[],"key":"z5agIBw97C"}],"key":"gQz2WrJq0f"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GoYtPc5PiO"}],"key":"j4eLCh36wM"}],"key":"WLqYxNHV0l"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Kaprekar/fpm.toml","literal":true,"children":[{"type":"code","value":"name = \"Section_Kaprekar\"\n\n[build]\nauto-executables = true\nauto-tests 