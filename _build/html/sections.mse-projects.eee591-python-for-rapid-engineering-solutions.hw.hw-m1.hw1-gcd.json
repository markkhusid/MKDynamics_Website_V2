d != 0:\n        a = b\n        b = mod\n        int_div = a // b\n        mod = a % b\n        print(f\"  a={a}, b={b}, a//b={int_div}, a%b={mod}\")\n\n    print(f\"  -> gcd = {b}\")\n    return b\n\n# Quick unit checks\nfor pair in [(48, 18), (12, 2), (15, 10), (90, 25)]:\n    print(f\"GCD{pair} = {gcd(*pair)}\")\n    print()\n","key":"KKdyN0X6bU"},{"type":"outputs","id":"jqYir-jKf5g4SdWk2m9Vy","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"gcd(48, 18) ...\n  initial remainder a % b = 12\n  a=18, b=12, a//b=1, a%b=6\n  a=12, b=6, a//b=2, a%b=0\n  -> gcd = 6\nGCD(48, 18) = 6\n\ngcd(12, 2) ...\n  initial remainder a % b = 0\n  -> gcd = 2\nGCD(12, 2) = 2\n\ngcd(15, 10) ...\n  initial remainder a % b = 5\n  a=10, b=5, a//b=2, a%b=0\n  -> gcd = 5\nGCD(15, 10) = 5\n\ngcd(90, 25) ...\n  initial remainder a % b = 15\n  a=25, b=15, a//b=1, a%b=10\n  a=15, b=10, a//b=1, a%b=5\n  a=10, b=5, a//b=2, a%b=0\n  -> gcd = 5\nGCD(90, 25) = 5\n\n"},"children":[],"key":"Hodid72PJ2"}],"key":"tIEUyA9278"}],"identifier":"81ccc94c","html_id":"81ccc94c","key":"jVP5xURSfX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parse a list of integers (assignment-style input format)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F1uC1L32W9"}],"identifier":"parse-a-list-of-integers-assignment-style-input-format","label":"Parse a list of integers (assignment-style input format)","html_id":"parse-a-list-of-integers-assignment-style-input-format","implicit":true,"key":"fmqp6jELoN"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The assignment accepts a string that looks like a Python list, e.g. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oZ6aivnfH7"},{"type":"inlineCode",