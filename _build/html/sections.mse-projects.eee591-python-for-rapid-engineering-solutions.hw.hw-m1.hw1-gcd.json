le":true,"value":"working_list = int_list.copy()\nlen_list = len(working_list)\nprint(\"Input list:\", working_list)\nprint(\"Length of input list:\", len_list)\n\ncurrent_gcd = gcd(working_list[0], working_list[1])\nprint(f\"GCD of {working_list[0]} and {working_list[1]} is: {current_gcd}\")\nprint()\n\nfor i in range(2, len_list):\n    print(f\"i = {i}, next value = {working_list[i]}\")\n    print(f\"GCD of {current_gcd} and {working_list[i]} is: \", end=\"\")\n    current_gcd = gcd(current_gcd, working_list[i])\n    print(current_gcd)\n    print()\n\nprint(\"The GCD is: \", current_gcd)\n","key":"h1hAmMKkes"},{"type":"outputs","id":"SSZ98KejrMfQy6MBsZVAy","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Input list: [24, 60, 120, 30]\nLength of input list: 4\ngcd(24, 60) ...\n  initial remainder a % b = 24\n  a=60, b=24, a//b=2, a%b=12\n  a=24, b=12, a//b=2, a%b=0\n  -> gcd = 12\nGCD of 24 and 60 is: 12\n\ni = 2, next value = 120\nGCD of 12 and 120 is: gcd(12, 120) ...\n  initial remainder a % b = 12\n  a=120, b=12, a//b=10, a%b=0\n  -> gcd = 12\n12\n\ni = 3, next value = 30\nGCD of 12 and 30 is: gcd(12, 30) ...\n  initial remainder a % b = 12\n  a=30, b=12, a//b=2, a%b=6\n  a=12, b=6, a//b=2, a%b=0\n  -> gcd = 6\n6\n\nThe GCD is:  6\n"},"children":[],"key":"ydXdTQajj4"}],"key":"BaMvMU1KLq"}],"identifier":"275d510a","html_id":"275d510a","key":"gEEeuKzM4q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Takeaways","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qe2Bu1mjdZ"}],"identifier":"takeaways","label":"Takeaways","html_id":"takeaways","implicit":true,"key":"vk0ytfEHcg"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start"