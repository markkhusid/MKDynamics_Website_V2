{"version":3,"kind":"Notebook","sha256":"9dbdec51c927135c51a4570948122ae354ad81438fbeebcdf56689bdf6029beb","slug":"sections.computer-programming.fortran.fortran-mooc.section-arrays-enlarge-array","location":"/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Enlarge_Array.ipynb","dependencies":[],"frontmatter":{"title":"Section Arrays: Enlarge Array","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3.9.15 ('base')","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Enlarge_Array.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Enlarge_Array.ipynb","exports":[{"format":"ipynb","filename":"Section_Arrays_Enlarge_Array.ipynb","url":"/build/Section_Arrays_Enlar-1e4a8ac78e7be0553d9fd4ccbdb035ea.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"","value":"---\njupytext:\n  formats: md:myst\n  text_representation:\n    extension: .md\n    format_name: myst\nkernelspec:\n  display_name: Python 3\n  language: python\n  name: python3\n---","key":"cvXjUrY2Wd"}],"key":"mfR9iLVqSp"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Section Arrays: Enlarge Array","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ocm7gOh5q1"}],"identifier":"section-arrays-enlarge-array","label":"Section Arrays: Enlarge Array","html_id":"section-arrays-enlarge-array","implicit":true,"key":"gIrWkst8n8"}],"visibility":"show","key":"tdBmFnAFqH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RKOBmIupRX"},{"type":"link","url":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/gjbex​/Fortran​-MOOC​/tree​/master​/source​_code​/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AGnNVfkUUH"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"bSGfXvlmhM"}],"key":"xGXZwfDYlA"}],"key":"XB4qHDTAi3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates enlarging an array in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IdRmpbpNq5"}],"identifier":"this-program-demonstrates-enlarging-an-array-in-fortran","label":"This program demonstrates enlarging an array in Fortran.","html_id":"this-program-demonstrates-enlarging-an-array-in-fortran","implicit":true,"key":"OlhrnTpdEL"}],"key":"Gu6cG7xgjP"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program enlarge_array\n  use, intrinsic :: iso_fortran_env, only : error_unit\n  implicit none\n  integer, parameter :: initial_size = 3, size_incr = 2\n  integer, dimension(:), allocatable :: values\n  integer :: i\n  \n  allocate (values(initial_size))\n  \n  do i = 1, size(values)\n      values(i) = i\n  end do\n  print *, values\n\n  do i = 1, 3\n      call grow_array(values, size_incr)\n      print *, values\n  end do\n\n  deallocate (values)\n\n  do i = 1, 3\n      call grow_array(values, size_incr)\n      print *, values\n  end do\n\n  deallocate (values)\n\ncontains\n\n    subroutine grow_array(values, size_incr)\n        implicit none\n        integer, dimension(:), allocatable, intent(inout) :: values\n        integer, value ::size_incr\n        integer, dimension(:), allocatable :: new_values\n        integer :: i, size_of_values_array\n\n        ! Added statement below to simplify allocate statement\n        size_of_values_array = size(values)\n\n        if (allocated(values)) then\n            ! The below statement fails because values and new values are of different sizes\n            ! seems to be a Fortran version issue\n            !allocate (new_values(size_of_values_array + size_incr), source=values)\n            allocate (new_values(size_of_values_array + size_incr))\n\n            ! For now I will just copy values into new_values using a loop\n            do i = 1, size(values)\n                new_values(i) = values(i)\n            end do\n\n            do i = size(values) + 1, size(new_values)\n                new_values(i) = i\n            end do\n\n            deallocate (values)\n            \n            call move_alloc(new_values, values)\n        else\n            allocate (values(size_incr))\n            do i = 1, size(values)\n                values(i) = i\n            end do\n        end if\n    end subroutine grow_array\n\nend program enlarge_array","position":{"start":{"line":1,"column":1},"end":{"line":69,"column":1}},"key":"vRr277DY7e"}],"key":"bDaWA7EfEM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1}