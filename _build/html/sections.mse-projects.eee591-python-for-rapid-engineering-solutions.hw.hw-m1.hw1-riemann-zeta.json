s number of terms:\")\nfor N in checkpoints:\n    for n in range(prev_n, N + 1):\n        running += 1.0 / (n ** input_int)\n    prev_n = N + 1\n    print(f\"  N = {N:>9,}:  zeta~ = {running:.8f}\")\n","key":"LsVRSKGBGU"},{"type":"outputs","id":"aTjprK6PdPwSoikKnQJaI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Exact zeta(2) = pi^2/6 = 1.6449340668\nApproximation           = 1.6449330668\nAbsolute error          = 1.00e-06\nRelative error          = 6.08e-07\n\nPartial sums vs number of terms:\n  N =        10:  zeta~ = 1.54976773\n  N =       100:  zeta~ = 1.63498390\n  N =     1,000:  zeta~ = 1.64393457\n  N =    10,000:  zeta~ = 1.64483407\n  N =   100,000:  zeta~ = 1.64492407\n"},"children":[],"key":"FiVdHT17Ab"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  N = 1,000,000:  zeta~ = 1.64493307\n"},"children":[],"key":"IKL8mpobTj"}],"key":"fQWyJMi6JZ"}],"key":"w8cJmwlv7j"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional plot — convergence for ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gq4OUqR0DU"},{"type":"inlineMath","value":"s=2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">s=2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class