ord\"><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mord\">/6</span></span></span></span>","key":"Ada17XzLC5"},{"type":"text","value":" (Basel problem). Compare the partial sum to that closed form.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u8PaGaG2Ep"}],"key":"nNwdU1LI8I"}],"identifier":"41278f1e","html_id":"41278f1e","key":"WXvTQF6Kwy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:31:00.737989Z","iopub.status.busy":"2026-07-25T16:31:00.737475Z","iopub.status.idle":"2026-07-25T16:31:01.131660Z","shell.execute_reply":"2026-07-25T16:31:01.130355Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import math\nimport numpy as np\n\nif input_int == 2:\n    exact = math.pi ** 2 / 6\n    print(f\"Exact zeta(2) = pi^2/6 = {exact:.10f}\")\n    print(f\"Approximation           = {zeta_sum:.10f}\")\n    print(f\"Absolute error          = {abs(zeta_sum - exact):.2e}\")\n    print(f\"Relative error          = {abs(zeta_sum - exact) / exact:.2e}\")\n\n# Show how the partial sum approaches the limit for a few truncations\ncheckpoints = [10, 100, 1_000, 10_000, 100_000, 1_000_000]\nrunning = 0.0\nprev_n = 1\nprint()\nprint(\"Partial sums vs number of terms:\")\nfor N in checkpoints:\n    for n in range(prev_n, N + 1):\n        running += 1.0 / (n ** input_int)\n    prev_n = N + 1\n    print(f\"  N = {N:>9,}:  zeta~ = {running:.8f}\")\n","key":"fTlRZAtUEI"},{"type":"outputs","id":"wqsQSabGrow0jHV9R16rZ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Exact zeta(2) = pi^2/6 = 1.6449340668\nApproximation           = 1.6449330668\nAbsolute error          = 1.00e-06\nRelative error          = 6.08e-07\n\nPartial sums vs number of terms:\n  N =        10:  zeta~ = 1.54976773\n  N =       100:  zeta~ = 1.63498390\n  N =     1,000:  zeta~ = 1.64393457\n  N =    10,000:  zeta~ = 1.64483407\n  N =   100,000:  zeta~ = 1.64492407\n"},"children":[],"key":"yY05taiERk"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  N = 1,000,000:  zeta~ = 1.64493307\n"},"children":[],"key":"N6a8jVafK4"}],"key":"GMaMbEmXkq"}],"identifier":"f1c2d1b4","html_id":"f1c2d1b4","key":"UoqPXaEycL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional plot — convergence for ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZXYoJwX6Qh"},{"type":"inlineMath","value":"s=2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">s=2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2</span></span></span></span>","key":"dOudfIaBFG"}],"identifier":"optional-plot-convergence-for-s-2","label":"Optional plot — convergence for s=2","html_id":"optional-plot-convergence-for-s-2","implicit":true,"key":"hqfXaNCz6l"}],"ident