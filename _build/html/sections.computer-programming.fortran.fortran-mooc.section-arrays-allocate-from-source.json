DIIltw32T"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"RrYaiI678V"}],"key":"fqEQerRZ1m"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"cABqyDkV0o"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates allocating an array from a source array.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yS0CWRuI75"}],"identifier":"this-program-demonstrates-allocating-an-array-from-a-source-array","label":"This program demonstrates allocating an array from a source array.","html_id":"this-program-demonstrates-allocating-an-array-from-a-source-array","implicit":true,"key":"YQrvcwfNcH"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"vzN8d6GuKz"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program allocate_from_source\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, dimension(3, 2) :: A\n    integer, dimension(:, :), allocatable :: B\n    integer :: i, status\n\n    A = reshape([ (i, i=1, size(A)) ], shape(A))\n    allocate(B, source=A, stat=status)\n    if (status /= 0) then\n        write (unit=error_unit, fmt='(A)') 'error: can not allocate array'\n        stop 1\n    end if\n    print *, 'The matrix A contains:'\n    do i = 1, size(A, 1)\n        print '(*(I4))', A(i, :)\n    end do\n    print *\n    print *, 'The matrix B contains:'\n    do i = 1, size(A, 1)\n        print '(*(I4))', A(i, :)\n    end do\n    deallocate (B)\nend program allocate_from_source","position":{"start":{"line":1,"column":1},"end":{"line":26,"column":1}},"key":"Bhx8yRCMwB"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821