rd the center.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"aL9Bi1WZMu"}],"key":"BzuGdsjX6n"}],"key":"yde9eexgzB"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"len_trim ignores trailing blanks in the buffer.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DEZ86q4DgW"}],"key":"fewGJ3Ph6q"}],"key":"FwFQWSuY0t"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"On the first mismatch return false; if all pairs match return true.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"LLdp4SlPgf"}],"key":"z3bEJ3GKyU"}],"key":"TkVzhqu307"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Output is a Fortran logical (T or F) per input string.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"cIwXjQsI54"}],"key":"WAEdi5gBgz"}],"key":"NBTuPQ2kHb"}],"key":"j1rOfQUEZm"}],"key":"mFpfyIDbs5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CAqdJbU18O"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"N9EiOcFBGN"}],"key":"NPiKNnNDle"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"palindromes.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GDZulsujG4"}],"identifier":"palindromes-f90","label":"palindromes.f90","html_id":"palindromes-f90","implicit":true,"key":"ViXdyWCLZZ"},{"type":"include","file":"Fortran_Code/Section_Strings_Palindromes/app/palindromes.f90","literal":true,"children":[{"type":"code","value":"program palindromes\n    use, intrinsic :: iso_fortran_env, only  : input_unit, iostat_end\n    implicit none\n    character(len=1024) :: buffer, msg\n    integer :: istat\n\n    do\n        read(unit=input_unit, fmt=*, iostat=istat, iomsg=msg) buffer\n        if (istat == iostat_end) exit\n        print '(L1)', is_palindrome(buffer)\n    end do\n\ncontains\n\n    function is_palindrome(phrase) result(palindrome)\n        implicit none\n        character(len=*), intent(in) :: phrase\n        logical :: palindrome\n        integer :: i, n\n\n        n = len_trim(phrase)\n        palindrome = .true.\n        do i = 1, n/2\n            if (phrase(i:i) /= phrase(n-i+1:n-i+1)) then\n                palindrome = .false.\n                exit\n            end if\n        end do\n    end function is_palindrome\n\nend program palindromes\n","lang":"fortran","filename":"palindromes.f90","key":"nH0YUTHYJI"}],"key":"HGIQQDnr8O"}],"key":"pp8RM6Ba78"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ttetTTWqsp"}],"key":"ZmECyLYnw7"}],"key":"nLGWcmDH2Q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l3oqIeT8tx"}],"identifier":"build-the-program-using-fpm-fortran-