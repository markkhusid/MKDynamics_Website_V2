rd the center.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"TN3TXznKO0"}],"key":"c63SmwTc9I"}],"key":"hyNC9ZmcpD"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"len_trim ignores trailing blanks in the buffer.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TwKwBinwzk"}],"key":"Zn7Tf4ylLd"}],"key":"Sb2MEODGbF"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"On the first mismatch return false; if all pairs match return true.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JvMofA8RIo"}],"key":"z6ywoMeBk9"}],"key":"LaK4UmHJn1"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Output is a Fortran logical (T or F) per input string.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"A59EA0RMJg"}],"key":"JBtyPY84Fx"}],"key":"M20Qy4D0VJ"}],"key":"tmKGWkIvgn"}],"key":"Nh0A3TzUaK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R54GUSADPC"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"eq6DNDofPM"}],"key":"ztcqTqCnLp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"palindromes.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lSMuADsnzI"}],"identifier":"palindromes-f90","label":"palindromes.f90","html_id":"palindromes-f90","implicit":true,"key":"sJ9xEoDWzx"},{"type":"include","file":"Fortran_Code/Section_Strings_Palindromes/app/palindromes.f90","literal":true,"children":[{"type":"code","value":"program palindromes\n    use, intrinsic :: iso_fortran_env, only  : input_unit, iostat_end\n    implicit none\n    character(len=1024) :: buffer, msg\n    integer :: istat\n\n    do\n        read(unit=input_unit, fmt=*, iostat=istat, iomsg=msg) buffer\n        if (istat == iostat_end) exit\n        print '(L1)', is_palindrome(buffer)\n    end do\n\ncontains\n\n    function is_palindrome(phrase) result(palindrome)\n        implicit none\n        character(len=*), intent(in) :: phrase\n        logical :: palindrome\n        integer :: i, n\n\n        n = len_trim(phrase)\n        palindrome = .true.\n        do i = 1, n/2\n            if (phrase(i:i) /= phrase(n-i+1:n-i+1)) then\n                palindrome = .false.\n                exit\n            end if\n        end do\n    end function is_palindrome\n\nend program palindromes\n","lang":"fortran","filename":"palindromes.f90","key":"VR9tYNg13E"}],"key":"s8AhbTAs7o"}],"key":"fBxEe3FuNH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sdMoBdQgIn"}],"key":"anHW2M99aq"}],"key":"MLghf75xzs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Bn6cbGj2Lx"}],"identifier":"build-the-program-using-fpm-fortran-