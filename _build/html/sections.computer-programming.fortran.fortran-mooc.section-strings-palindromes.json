rd the center.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"JzSEOgItEg"}],"key":"NSeNbVF66W"}],"key":"Gi3orQkxFM"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"len_trim ignores trailing blanks in the buffer.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IkRuqignUV"}],"key":"wDVOgMuH8G"}],"key":"dqsLBDHMgz"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"On the first mismatch return false; if all pairs match return true.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"KpCIR2LegS"}],"key":"rNTkdccMBS"}],"key":"krWvQw4Prr"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Output is a Fortran logical (T or F) per input string.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lMN1bTMW3c"}],"key":"bsqLHbS517"}],"key":"TB315GTsli"}],"key":"ydy1flHYh8"}],"key":"e40hEuQvFZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VwbcYy1T2Q"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"jI3701R1Al"}],"key":"lN052FfwVS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"palindromes.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KbkAeHS9rs"}],"identifier":"palindromes-f90","label":"palindromes.f90","html_id":"palindromes-f90","implicit":true,"key":"UGOQFaCi1o"},{"type":"include","file":"Fortran_Code/Section_Strings_Palindromes/app/palindromes.f90","literal":true,"children":[{"type":"code","value":"program palindromes\n    use, intrinsic :: iso_fortran_env, only  : input_unit, iostat_end\n    implicit none\n    character(len=1024) :: buffer, msg\n    integer :: istat\n\n    do\n        read(unit=input_unit, fmt=*, iostat=istat, iomsg=msg) buffer\n        if (istat == iostat_end) exit\n        print '(L1)', is_palindrome(buffer)\n    end do\n\ncontains\n\n    function is_palindrome(phrase) result(palindrome)\n        implicit none\n        character(len=*), intent(in) :: phrase\n        logical :: palindrome\n        integer :: i, n\n\n        n = len_trim(phrase)\n        palindrome = .true.\n        do i = 1, n/2\n            if (phrase(i:i) /= phrase(n-i+1:n-i+1)) then\n                palindrome = .false.\n                exit\n            end if\n        end do\n    end function is_palindrome\n\nend program palindromes\n","lang":"fortran","filename":"palindromes.f90","key":"wEUbMdDgW8"}],"key":"smxIaw8OZk"}],"key":"rsuUoEnmTm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mj53vd8bAN"}],"key":"wOwwEiTPlH"}],"key":"zusFqW4B0P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KzOJWlxSQ6"}],"identifier":"build-the-program-using-fpm-fortran-