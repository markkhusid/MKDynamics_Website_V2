rd the center.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"O1GSd9xuRy"}],"key":"tz6jFASBic"}],"key":"i8UYy40ME5"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"len_trim ignores trailing blanks in the buffer.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"s8GvGtDOD1"}],"key":"hTf3XvsBLI"}],"key":"dQOaymov41"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"On the first mismatch return false; if all pairs match return true.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"SRdwnyxg7l"}],"key":"tdnGc2SPJz"}],"key":"SsZ2Y0VOFW"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Output is a Fortran logical (T or F) per input string.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"D99HC6hw79"}],"key":"dNsr6NUBCW"}],"key":"LCWqXIEn6F"}],"key":"ssFapQ4TJN"}],"key":"jYWK8UKKfO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z3utxGduZR"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"itvavZ916Q"}],"key":"F8sJeFIsaK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"palindromes.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Czzw5TZ7wU"}],"identifier":"palindromes-f90","label":"palindromes.f90","html_id":"palindromes-f90","implicit":true,"key":"DtqOt23YN2"},{"type":"include","file":"Fortran_Code/Section_Strings_Palindromes/app/palindromes.f90","literal":true,"children":[{"type":"code","value":"program palindromes\n    use, intrinsic :: iso_fortran_env, only  : input_unit, iostat_end\n    implicit none\n    character(len=1024) :: buffer, msg\n    integer :: istat\n\n    do\n        read(unit=input_unit, fmt=*, iostat=istat, iomsg=msg) buffer\n        if (istat == iostat_end) exit\n        print '(L1)', is_palindrome(buffer)\n    end do\n\ncontains\n\n    function is_palindrome(phrase) result(palindrome)\n        implicit none\n        character(len=*), intent(in) :: phrase\n        logical :: palindrome\n        integer :: i, n\n\n        n = len_trim(phrase)\n        palindrome = .true.\n        do i = 1, n/2\n            if (phrase(i:i) /= phrase(n-i+1:n-i+1)) then\n                palindrome = .false.\n                exit\n            end if\n        end do\n    end function is_palindrome\n\nend program palindromes\n","lang":"fortran","filename":"palindromes.f90","key":"DukA2li8Uw"}],"key":"JriJBLFAxE"}],"key":"QBD9XWWd5B"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qX5EUq4Cqp"}],"key":"UHHGyCSqCn"}],"key":"oWwVvFQ9cE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vmycNAubBR"}],"identifier":"build-the-program-using-fpm-fortran-