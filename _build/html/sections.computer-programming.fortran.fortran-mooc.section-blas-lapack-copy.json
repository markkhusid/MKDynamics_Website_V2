 copy_test\n","lang":"fortran","filename":"section_blas_lapack_copy.f90","key":"hb7agjRwda"}],"key":"QWpF9m8Xnj"}],"identifier":"49f81255","html_id":"49f81255","key":"wVD8tj05HH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bzHdpjfIeb"}],"key":"Rglyo9D5hx"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"JQtCNFmzH8"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nfXLrd7TJz"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"JcgQjPH1Lt"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"Mf7xj20Wq0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"tYmaWkbwTp"},{"type":"outputs","id":"0N8Ai50L3qL6QK7r4JHUL","children":[],"key":"i7K0Mx7eYo"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"CpAzqYjMIz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Since the code makes use of the LAPACK library, the following FPM configuration file (fpm.to