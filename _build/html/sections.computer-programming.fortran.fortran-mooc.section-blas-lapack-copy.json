 copy_test\n","lang":"fortran","filename":"section_blas_lapack_copy.f90","key":"nZGlUqTvog"}],"key":"ATVVnvO7nc"}],"identifier":"49f81255","html_id":"49f81255","key":"b5c3CDfnMc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tsJ22fluvx"}],"key":"aViE6BOLRT"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"JtWdYU14Cc"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wZDFIJnGj8"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"puTmyc3AvC"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"SpvR2kZJwb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"xVYeskU8e8"},{"type":"outputs","id":"AAHzlLJ0giY57_PRys0ko","children":[],"key":"uazpgCULtA"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"lpCEUvzQos"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Since the code makes use of the LAPACK library, the following FPM configuration file (fpm.to