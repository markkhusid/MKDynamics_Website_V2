c-4dc4-8fbe-8f3c61de2a41","key":"CSrG0JCmrX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nwC4vhsoXY"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"F5lU6j9Iiu"}],"identifier":"4883d54d-377f-427c-b3c7-b3e4878aa8e4","html_id":"4883d54d-377f-427c-b3c7-b3e4878aa8e4","key":"g9Oz8bOfHx"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_Copy/app/section_blas_lapack_copy.f90","literal":true,"children":[{"type":"code","value":"program copy_test\n  implicit none\n  integer, parameter :: v_size = 10\n  integer :: i\n  real, dimension(v_size) :: vector1 = [ (real(i), i=1, v_size) ], vector2\n  real, dimension(2*v_size) :: large_vector\n\n  interface\n    subroutine scopy(n, sx, incx, sy, incy)\n      integer :: n, incx, incy\n      real, dimension(*) :: sx, sy\n    end subroutine scopy\n  end interface\n\n  print '(A20, *(F5.1))', 'original: ', vector1\n  vector2 = 0.0\n  large_vector = 0.0\n  call scopy(size(vector1), vector1, 1, vector2, 1)\n  print '(A20, *(F5.1))', 'copy N 1 1: ', vector2\n\n  vector2 = 0.0\n  call scopy(size(vector1), vector1, 1, vector2, 2)\n  print '(A20, *(F5.1))', 'copy N 1 2: ', vector2\n\n  vector2 = 0.0\n  call scopy(size(vector1), vector1, 2, vector2, 1)\n  print '(A20, *(F5.1))', 'copy N 2 1: ', vector2\n\n  vector2 = 0.0\n  call scopy(size(vector1), vector1, 2, vector2, 2)\n  print '(A20, *(F5.1))', 'copy N 2 2: ', vector2\n\n  large_vector = 0.0\n  call scopy(size(vector1), vector1, 1, large_vector, 2)\n  print '(A20, *(F5.1))', 'copy N 1 2: ', large_vector\n  call scopy(size(vector1), 3.0*vector1, 1, large_vector(2), 2)\n  print '(A20, *(F5.1))', 'shift copy N 1 2: ', large_vector\n\nend program copy_test\n","lang":"fortran","filename":"section_blas_lapack_copy.f90","key":"MxN3E0ghCr"}],"key":"oGNeSwOChW"}],"identifier":"49f81255","html_id":"49f81255","key":"UD8EWi27bQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QXcPR3BmZ9"}],"key":"hMuerwmKBx"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"qF59lBss6m"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EyQnATofOT"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"mXnWzQIx0I"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"dJ0ANEXIS2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"qXuZkNWjGE"},{"type":"outputs","id":"4o6GBJsoN-gdXKcs03def","children":[],"key":"Lvcpr6GBja"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"Nixz57tUnx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Since the code makes use of the LAPACK library, the following FPM configuration file (fpm.to