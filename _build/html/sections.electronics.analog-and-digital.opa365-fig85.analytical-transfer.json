,"value":"f = np.logspace(np.log10(10), np.log10(50e6), 501)\nbr = bode(p, source=\"vin\", f_hz=f)\nfig, axes = plt.subplots(2, 1, figsize=(8.2, 6.2), sharex=True)\naxes[0].semilogx(br.f_hz, br.mag_db, color=\"C0\", lw=1.8)\naxes[0].axvline(p.op.f_design_hz, color=\"0.4\", ls=\"--\", lw=0.9, label=\"500 kHz\")\naxes[0].axvline(p.op.f_passband_hz, color=\"C1\", ls=\":\", lw=1.0, label=\"250 kHz tone\")\naxes[0].axhline(-3, color=\"0.5\", ls=\"--\", lw=0.8)\naxes[0].set_ylabel(\"Magnitude (dB)\")\naxes[0].set_ylim(-80, 5)\naxes[0].legend(frameon=False)\naxes[0].grid(True, which=\"both\", alpha=0.3)\naxes[1].semilogx(br.f_hz, br.phase_unwrapped_deg, color=\"C0\", lw=1.8)\naxes[1].set_xlabel(\"Frequency (Hz)\")\naxes[1].set_ylabel(\"Phase (deg)\")\naxes[1].grid(True, which=\"both\", alpha=0.3)\nfig.suptitle(\"Ideal H(s), Vin to Vout\", y=1.01)\nfig.tight_layout()\nplt.show()\n","key":"ZtO1Xava67"},{"type":"outputs","id":"hiJ4ntKsqM_vYQIM0kien","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e71a526727980aadc470762f375dfa05","path":"/build/e71a526727980aadc470762f375dfa05.png"},"text/plain":{"content":"<IPython.core.display.Image object>","content_type":"text/plain"}}},"children":[],"key":"KeQt44JQq5"}],"key":"WnlZLT1VoO"}],"identifier":"77ea73a1","html_id":"77ea73a1","key":"gKRpHJNd0e"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Probes and the four sources","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hHvabfqP8z"}],"identifier":"probes-and-the-four-sources","label":"Probes and the four sources","html_id":"probes-and-the-four-sources","implicit":true,"key":"E6e1aPfKbC"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"H(0) is exactly −1, so the phase at low frequency is 180°. The passband tone\nused later is 250 kHz, one octave below the design frequency.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HnX1qRp5xp"}],"key":"oBReWzwmWP"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Vos enters as V(n2) = −Vos, and the DC gain from Vos to Vout is −(1 + R3/R1).\nWith the published resistors that factor is −2. Ibp does not enter the signal\nnodes, because the + pin is grounded. Ibn leaves the inverting node. At DC its\ntransresistance is R2 + R3 + R2 R3/R1.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rPAVy2fHZZ"}],"key":"HQiHBKDZEW"}],"identifier":"fb065bb0","html_id":"fb065bb0","key":"N0Gr4iobaS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-17T21:00:21.068380Z","iopub.status.busy":"2026-10-17T21:00:21.068194Z","iopub.status.idle":"2026-10-17T21:00:21.109975Z","shell.execute_reply":"2026-10-17T21:00:21.109507Z","shell.execute_reply.started":"2026-10-17T21:00:21.068367Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"rows = []\nfor freq in (100.0, 1e3, 100e3, 250e3, natural_frequency_hz(p), 500e3, 1e6):\n    h = gain_at(p, freq, \"vin\")\n    rows.append({\n        \"f_Hz\": freq,\n        \"mag\": abs(h),\n        \"mag_dB\": 20*np.log10(abs(h)),\n        \"phase_deg\": np.angle(h, deg=True),\n    })\ndisplay(pd.DataFrame(rows))\n\nvin = 1.0\nbudget = dc_error_budget(\n    p, vin=vin, vos=p.opamp.vos_max, ibp=p.opamp.ib_max, ibn=p.opamp.ib_max,\n)\ndisplay(pd.DataFrame([budget]))\nprint(\n    \"At Vin = 1 V the ideal output is -1 V. \"\n    f\"Vos = +{p.opamp.vos_max*1e6:.0f} µV contributes {budget['due_vos']*1e6:.1f} µV. \"\n    f\"Ibn = +{p.opamp.ib_max*1e12:.0f} pA contributes {budget['due_ibn']*1e9:.3f} nV. \"\n    f\"Ibp contributes {budget['due_ibp']:.3e} V.\"\n)\n","ke