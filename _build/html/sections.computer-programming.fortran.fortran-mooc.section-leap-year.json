Ys"}],"key":"CysnTUkbdR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"leapyear.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"priK01BGjF"}],"identifier":"leapyear-f90","label":"leapyear.f90","html_id":"leapyear-f90","implicit":true,"key":"IpgWihoiDt"},{"type":"include","file":"Fortran_Code/Section_Leap_Year/app/leapyear.f90","literal":true,"children":[{"type":"code","value":"program leapyear\n    implicit none\n    integer :: year\n\n    year = get_year()\n    if (is_leapyear(year)) then\n        print '(I0, A)', year, ' is a leap year'\n    else\n        print '(I0, A)', year, ' is not a leap year'\n    end if\n\ncontains\n\n    integer function get_year()\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=256) :: buffer\n        \n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting a year as argument'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, '(I10)') get_year\n    end function get_year\n\n    logical function is_leapyear(year)\n        implicit none\n        integer, intent(in) :: year\n\n        if (mod(year, 4) /= 0) then\n            is_leapyear = .false.\n        else if (mod(year, 100) == 0) then\n            if (mod(year, 400) == 0) then\n                is_leapyear = .true.\n            else\n                is_leapyear = .false.\n            end if\n        else\n            is_leapyear = .true.\n        end if\n    end function is_leapyear\n\nend program leapyear\n","lang":"fortran","filename":"leapyear.f90","key":"EYyWSyqQvB"}],"key":"yFfNGgbIF6"}],"key":"f2gehRGAB7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"c