2), 1, matrix(:, 4), 1)\n  print '(A, F10.1)', 'row 2 . row 4:', &\n      sdot(size(matrix, 1), matrix(2, :), 1, matrix(4, :), 1)\nend program dot_test\n","lang":"fortran","filename":"section_blas_lapack_dot.f90","key":"Lyhm7XV1sP"}],"key":"LJ0HgaHSkL"}],"identifier":"49f81255","html_id":"49f81255","key":"js4bGLYkXN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PU4wZRRuVe"}],"key":"dPY077MIhf"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"dQmksEtugv"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vllLZdfsFX"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"fK3xUL2eBV"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"rJYkaCmr5O"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"CeHg6ORLnv"},{"type":"outputs","id":"nOpPf_Irh05Yianl5CarX","children":[],"key":"i53YM287tW"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"FstbnOCiR9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"