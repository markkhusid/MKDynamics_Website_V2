2), 1, matrix(:, 4), 1)\n  print '(A, F10.1)', 'row 2 . row 4:', &\n      sdot(size(matrix, 1), matrix(2, :), 1, matrix(4, :), 1)\nend program dot_test\n","lang":"fortran","filename":"section_blas_lapack_dot.f90","key":"nOFGw1BGek"}],"key":"j4amkrOdNE"}],"identifier":"49f81255","html_id":"49f81255","key":"I4hCGkrHRl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KZIQUrCqmG"}],"key":"s8XwHwKJFA"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"FenZqkVURw"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PcyxC8oNMZ"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"pSHudR0PDT"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"u6LwTXC1zW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"rMH3twseB5"},{"type":"outputs","id":"xB2n60ocHfHyvSixSwDc7","children":[],"key":"H8ZUjj3729"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"OUmKMzTZIi"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"