S5E88"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T02:51:16.651010Z","iopub.status.busy":"2026-11-27T02:51:16.650911Z","iopub.status.idle":"2026-11-27T02:51:25.346746Z","shell.execute_reply":"2026-11-27T02:51:25.343578Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"do frame = 1, n_frames\n    phase = 2.0_dp*pi*real(frame - 1, dp)/real(n_frames, dp)\n    y = sin(k*x - phase)*envelope\n\n    call clf()\n    call plot(x, y, \"b-\", lw=2.0_dp)\n    call fill_between(x, y, color=\"b\", alpha=0.2_dp)\n    call xlim(0.0_dp, 10.0_dp)\n    call ylim(-1.1_dp, 1.1_dp)\n    call title(\"Travelling wave\")\n    call xlabel(\"x\")\n    call ylabel(\"displacement\")\n    call grid(.true.)\n\n    call add_frame()\nend do","key":"LVYHdZmnXy"},{"type":"outputs","id":"NEkE2HWoh26MiqsQWOmgI","children":[],"key":"cO37Ax35tc"}],"identifier":"5af75e80","html_id":"5af75e80","key":"qyhMeLfBms"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T02:51:25.361282Z","iopub.status.busy":"2026-11-27T02:51:25.360682Z","iopub.status.idle":"2026-11-27T02:51:29.758101Z","shell.execute_reply":"2026-11-27T02:51:29.758061Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"call save_animation(\"wave.gif\", fps=20.0_dp)\nprint *, \"wrote wave.gif from\", n_frames, \"frames\"","key":"Tt11FxWczD"},{"type":"outputs","id":"J3JK9mgv-wK20AEFT1iMM","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wrote wave.gif from 40 frames\n"},"children":[],"key":"KtSd1jMeqJ"}],"key":"qtQtiZVk5z"}],"identifier":"9c67cabb","html_id":"9c67cabb","key":"dwJjUiKAlj"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/build/wave-33ada0cad8a8272ed247bac96e47322b.gif","alt":"Travelling wave","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K3gJxkJHiI","urlSource":"wave.gif"}],"identifier":"a3f686c4","html_id":"a3f686c4","key":"MjfxFxucUl"}],"key":"qifIBnFROY"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"fplotlib Animations Demo in Jupyter","url":"/sections/computer-programming/fortran/fplotlib/fplotlib-animation-demo","group":"Computer Programming"},"next":{"title":"Modern Fortran","url":"/sections/computer-programming/fortran/modern-fortran/modern-fortran-head","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}