{"version":3,"kind":"Article","sha256":"83eb75881e0112e21be476cd2cc559bdda5d4b23c42ed2993570bffbaf40bd61","slug":"sections.mcs-projects.cse543-information-assurance-and-security.udp-spoofing.udp-spoofing","location":"/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","dependencies":[],"frontmatter":{"title":"CSE543 Information Assurance and Security - UDP Spoofing","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","exports":[{"format":"md","filename":"UDP_Spoofing.md","url":"/build/UDP_Spoofing-6c7c9d57a136a377f0d86aefae983486.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p1kmdO8EHZ"}],"key":"GPTeWmbW8X"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"UDP has no handshake. The source address is a field the sender writes. A service that treats that field as identity will trust any host that can compose a datagram. The writeup of the protocol is on the Grokipedia page for the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tt2QoJchLQ"},{"type":"link","url":"https://grokipedia.com/page/User_Datagram_Protocol","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"User Datagram Protocol","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IdaxsNQYRJ"}],"urlSource":"https://grokipedia.com/page/User_Datagram_Protocol","key":"Hq98RWNT57"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GZq4y77zsU"}],"key":"tRvpT74Df9"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What the submission was doing","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Z2xAtK0dqA"}],"identifier":"what-the-submission-was-doing","label":"What the submission was doing","html_id":"what-the-submission-was-doing","implicit":true,"key":"MGr43jp48M"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The notebook resolved a lab name, then built one UDP datagram with Scapy. The IP source was not the machine that sent the packet. The payload named a different address, the one where a listener was waiting. The lab service accepted the header source as the caller and delivered its answer to the address in the payload.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"RJIQePp63y"}],"key":"e5QFpFDRxA"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"That split is the whole trick. The header says who the caller claims to be. The payload says where the answer should go. The service trusted both.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"xEL0bIP5Oy"}],"key":"ytoFPja4kg"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"What this page keeps","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"FXLq7KoTB8"}],"identifier":"what-this-page-keeps","label":"What this page keeps","html_id":"what-this-page-keeps","implicit":true,"key":"IAjCw6Pgwf"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The published function keeps the shape of that datagram: an IP header, a UDP header, and a short payload. The addresses are documentation addresses from the TEST-NET range. They are not the lab.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"QJYGr5xnVP"}],"key":"hHMQVJ41M7"},{"type":"code","lang":"python","value":"DISABLE_PACKET_INJECTION = True\n\ndef safe_send(packet):\n    \"\"\"Stand-in for scapy.sr1. Nothing is transmitted.\"\"\"\n    print(\"[SAFE MODE] Not sent:\", packet.summary())\n\ndef build_udp(source_ip, dest_ip, payload):\n    # The source address is an argument. UDP does not check\n    # that the sender owns it. Scapy fills the checksum from\n    # the headers when the object is built.\n    return (\n        IP(src=source_ip, dst=dest_ip)\n        / UDP(sport=40000, dport=40000)\n        / payload\n    )\n\npacket = build_udp(\"192.0.2.10\", \"192.0.2.20\", b\"demo\")\nif DISABLE_PACKET_INJECTION:\n    safe_send(packet)","position":{"start":{"line":17,"column":1},"end":{"line":37,"column":1}},"key":"tJ8LlhNsrQ"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"inlineCode","value":"192.0.2.0/24","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"lCZvUj4zA5"},{"type":"text","value":" is reserved for documentation. ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"bADYPVjrYC"},{"type":"inlineCode","value":"safe_send","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"iCwN3uAVqt"},{"type":"text","value":" prints a summary such as ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"ujj1x2X9n0"},{"type":"inlineCode","value":"IP / UDP 192.0.2.10:40000 > 192.0.2.20:40000","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"zWodNpkGNj"},{"type":"text","value":". The original notebook called ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"GJ2cnait4Q"},{"type":"inlineCode","value":"sr1","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"jIoj9DwwOu"},{"type":"text","value":" on a real interface. That call is the part that made the lab succeed, and it is not here.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"CG9ToNT08W"}],"key":"jpoM61XPkB"},{"type":"heading","depth":2,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Why a normal socket cannot do this","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"q9t4dm80fB"}],"identifier":"why-a-normal-socket-cannot-do-this","label":"Why a normal socket cannot do this","html_id":"why-a-normal-socket-cannot-do-this","implicit":true,"key":"YGLJaHNX2A"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"A normal UDP socket lets the kernel write the source address. The address it writes is an address of the machine. Setting a different source means building the IP header yourself, which is what Scapy does in the object above. Building the object is not the same as sending it. The published page stops at the object.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"TETUC9taZm"}],"key":"jhEcHUNOVw"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"What would have stopped it","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ciXDyQLo2D"}],"identifier":"what-would-have-stopped-it","label":"What would have stopped it","html_id":"what-would-have-stopped-it","implicit":true,"key":"dTWrh6V03s"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":47,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do not authorize a client from the source address of a UDP datagram.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"zpH2Vk4HVj"}],"key":"SOUoQr3vfX"}],"key":"amdpjHK3nV"},{"type":"listItem","spread":true,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do not treat an address inside the payload as a place to send a secret. If the service must answer someone, answer a session it created, or answer a challenge that only the claimed owner can meet.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"hGS8krDIb0"}],"key":"STMuZsPXsR"}],"key":"vdAIGgPqqz"},{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Bind a lab service to the lab network. A packet that claims a source outside that network is not a client.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"J6nZ30ImOh"}],"key":"FkV5erwEm7"}],"key":"cVzxTec5gH"}],"key":"c5nSHr9iAW"}],"key":"zF7IYi2Zyn"}],"key":"PPU2OhcDgX"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE543 Information Assurance and Security - TCP Spoofing","url":"/sections/mcs-projects/cse543-information-assurance-and-security/tcp-spoofing/tcp-spoofing","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"CSE543 Information Assurance and Security - Fuzz Them All","url":"/sections/mcs-projects/cse543-information-assurance-and-security/fuzz-them-all/fuzz-them-all","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"https://www.mkdynamics.net"}