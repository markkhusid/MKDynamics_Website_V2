{"version":3,"kind":"Article","sha256":"01791e0891ef34f58becca2972967a9a04a3ffc09388612aebacbe21e9f16574","slug":"sections.mcs-projects.cse543-information-assurance-and-security.udp-spoofing.udp-spoofing","location":"/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","dependencies":[],"frontmatter":{"title":"CSE543 Information Assurance and Security - UDP Spoofing","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/UDP_Spoofing/UDP_Spoofing.md","exports":[{"format":"md","filename":"UDP_Spoofing.md","url":"/build/UDP_Spoofing-fae74e1f76dd680dcfb57af516b2ef87.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YED8swZdoI"}],"key":"w3RQgKqnGr"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"UDP has no handshake. A datagram carries a source address because the sender wrote one in the header. Nothing in UDP checks that the sender owns that address.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bJ1mA53NqF"}],"key":"NOKz6YfFEy"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What the submission did","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"X1Hvj2QLYt"}],"identifier":"what-the-submission-did","label":"What the submission did","html_id":"what-the-submission-did","implicit":true,"key":"EDtLgi0gsB"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The submission sent a datagram whose source address was chosen in the script, toward a lab service that replied to whatever source the packet claimed. The service treated that address as the caller. The reply followed the forged address.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"prTQIU6I9O"}],"key":"iWUZN3Nih6"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The lesson","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"HVz0FCRzk4"}],"identifier":"the-lesson","label":"The lesson","html_id":"the-lesson","implicit":true,"key":"O6q5rYhOws"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"A service that authorizes a client from the source address of a UDP datagram will trust any host that can send a packet. The fix is an authenticator inside the payload, or a challenge that only the claimed source can answer.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"rjpr6F5EUV"}],"key":"rpgnVYieRq"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"What stayed off this page","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"HybggEj96b"}],"identifier":"what-stayed-off-this-page","label":"What stayed off this page","html_id":"what-stayed-off-this-page","implicit":true,"key":"haqPdINMjM"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The script, the lab host, and the value the service returned are not published.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"VPYeYqTUs0"}],"key":"yKN16ZbHF8"}],"key":"IVLJaJZwC6"}],"key":"LX1JO5Xmox"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE543 Information Assurance and Security - TCP Spoofing","url":"/sections/mcs-projects/cse543-information-assurance-and-security/tcp-spoofing/tcp-spoofing","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"CSE543 Information Assurance and Security - Fuzz Them All","url":"/sections/mcs-projects/cse543-information-assurance-and-security/fuzz-them-all/fuzz-them-all","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"https://www.mkdynamics.net"}