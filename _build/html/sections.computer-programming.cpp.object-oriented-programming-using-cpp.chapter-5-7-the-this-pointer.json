include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"rUI7nyRHEG"}],"key":"Tnjd4q9V0M"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QV9Oq3FqjK"}],"key":"xjFgy6FubY"}],"key":"cBFDXcAGWl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"BmRBSmd7qp"},{"type":"outputs","id":"vPRRISEVrvLsGaa5MRcwk","children":[],"key":"bbtbTdYD7Q"}],"key":"No20WEE4aE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"uJAjp8Fyt1"},{"type":"outputs","id":"l4b884BvUOcmE4fu143sa","children":[],"key":"zK4qVRnl3A"}],"key":"TVf7wIerqo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"wv6I247ADf"},{"type":"outputs","id":"HEEdw5vRvFQ7XMdjChmZc","children":[],"key":"J25bDw1yzP"}],"key":"M5SijzEoNU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","exe