include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"OwZPYR6zF4"}],"key":"rlSw0MzBxM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZJlop6D9Pt"}],"key":"iQljNfcmEr"}],"key":"quBuqPiYU7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"FUMUj7CCCl"},{"type":"outputs","id":"1C4rONC6UPxVCrT_5todk","children":[],"key":"ikSER24iRs"}],"key":"ZgLFKPDEgD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"k3Y2opqUE0"},{"type":"outputs","id":"AswI5VLSqfKXk4IPiqac9","children":[],"key":"wPQ7giZONm"}],"key":"nHUkOFsEf1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"wFNg1CKchp"},{"type":"outputs","id":"Dqa56JB-GwVWeRVlqgDMu","children":[],"key":"LOfjkO28lt"}],"key":"JPqTItlfds"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","exe