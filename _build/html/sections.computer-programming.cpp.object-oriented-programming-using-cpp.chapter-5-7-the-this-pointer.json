:"code","lang":"cpp","value":"#include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"jVznB7Y2Xw"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"WBUm2iSyOc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"akN42hh1qY"}],"key":"ItQtIinHTU"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"GYcmMDcmvS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"W0k4RUBLkU"},{"type":"outputs","id":"WfocAHE4xAOfg-7LVRyu4","children":[],"key":"qUYFBdfjB4"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"wRSiHaV3kW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"KWMjU5X2q4"},{"type":"outputs","id":"eIvFGZy22gODgtKIiWem5","children":[],"key":"OoUwoGKOxp"}],"identifier":"9836a2e4-