include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"WYDX6DKpcN"}],"key":"YSo9CmZpdX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lFw5lvMYO3"}],"key":"SrMrrnboua"}],"key":"Vv2QSwyn3A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"MuzLeGaTGy"},{"type":"outputs","id":"RNSAav5yiKyOJv0N64YUJ","children":[],"key":"mS2dXwFp0c"}],"key":"i5Hq91PWL4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"eIViBBV4yO"},{"type":"outputs","id":"nDk4mPnQjYV5A4JJEBXFR","children":[],"key":"i1xCnxPoCY"}],"key":"V7vgDQ3Yye"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"qWA7oexBYy"},{"type":"outputs","id":"UggyTTX4_MYaWm1B1muWC","children":[],"key":"lJgAKLPXz7"}],"key":"ZNCCXLYltQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","exe