include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"pTF79y9tsq"}],"key":"TsJhvJpGZL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"isOOw5gMA4"}],"key":"hcnleZlTWq"}],"key":"MBexX1rYB5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"QWOHFqhn3U"},{"type":"outputs","id":"psmNY59UCW4ZBj-2nAvUi","children":[],"key":"PypA657z0e"}],"key":"yn5DrdZWih"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"TZ5c4Xy1xU"},{"type":"outputs","id":"5mQMN-o3Sk1y2_KMoXYTe","children":[],"key":"X71lEMXXbu"}],"key":"HzPSXARPx0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"cLafTAGOhb"},{"type":"outputs","id":"DIRarwMGapuKg1ORkpKZh","children":[],"key":"pGjzRNTH9Y"}],"key":"XM9B6d2cgz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","exe