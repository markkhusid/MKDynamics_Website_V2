include <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"bQgKSYpkLr"}],"key":"wSXuh0ibxw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cUiGADqpbb"}],"key":"mRrhnZIdc7"}],"key":"dAucmY1iKL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"y67ioTLj1x"},{"type":"outputs","id":"rQH-v94nBMOc4ySALeGGt","children":[],"key":"YifOuFgQvn"}],"key":"saWb6SSDDP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"TRFs25a4zh"},{"type":"outputs","id":"Gf37wf9VFhJ2Jy8nw2QxV","children":[],"key":"TGVrMXp53j"}],"key":"Og3W2ZRCZ5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"QPOH6JCRpF"},{"type":"outputs","id":"iCh155XaM0yURwK6L5S_K","children":[],"key":"iRgEImwMBO"}],"key":"qt5Sal3T6I"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","exe