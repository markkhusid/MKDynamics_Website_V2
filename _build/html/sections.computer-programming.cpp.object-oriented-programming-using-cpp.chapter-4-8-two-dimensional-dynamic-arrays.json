{"version":3,"kind":"Notebook","sha256":"12d4e974c7dc42b557f3301c872557f731b944833c9a7b186ac46f3e77210351","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-4-8-two-dimensional-dynamic-arrays","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","dependencies":[],"frontmatter":{"title":"Two Dimensional Dynamic Arrays","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","exports":[{"format":"ipynb","filename":"Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","url":"/build/Chapter_4_8_Two_Dime-dc82b2d328b3ca2836a95bd869c6c52e.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"","value":"---\njupytext:\n  formats: md:myst\n  text_representation:\n    extension: .md\n    format_name: myst\nkernelspec:\n  display_name: Python 3\n  language: python\n  name: python3\n---","key":"KampSC1CGQ"}],"key":"M0ylWdgbtc"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Two Dimensional Dynamic Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Aeo9aIjCn8"}],"identifier":"two-dimensional-dynamic-arrays","label":"Two Dimensional Dynamic Arrays","html_id":"two-dimensional-dynamic-arrays","implicit":true,"key":"tLOPwTxkt5"}],"visibility":"show","key":"Vi7yaCRxKx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Lj5NcYCOOY"}],"key":"ERdwfcOzb2"}],"key":"I9n4gBgnjs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B387zU86pP"}],"identifier":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","label":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","html_id":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","implicit":true,"key":"fA3jnf36RN"}],"key":"LrUv0YkmQE"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// Dynamic arrays in two dimensions\n#include <iostream>\nusing namespace std;\n\nstruct twod {\n    double **   base;\n    int         row_size, column_size;\n};\n\nvoid allocate (int r, int s, twod & m)\n{\n    m.base = new double * [s];\n    for (int i = 0; i < s; ++i)\n        m.base[i] = new double[r];\n    m.row_size = r;\n    m.column_size = s;\n}\n\nvoid deallocate(twod & m)\n{\n    for (int i = 0; i < m.column_size; ++i)\n        delete [] m.base[i];\n    delete [] m.base;\n    m.row_size = 0;\n    m.column_size = 0;\n}\n\ndouble find_max(const twod & m)\n{\n    int i, j;\n    double max = m.base[0][0];\n\n    for (i = 0; i < m.column_size; ++i)\n        for (j = 0; j < m.row_size; ++j)\n            if (m.base[i][j] > max)\n                max = m.base[i][j];\n    return (max);\n}\n\nint main ()\n{\n    twod    a, b;\n    int     i, j;\n\n    allocate(2, 3, a);\n    allocate(4, 6, b);\n\n    for (i = 0; i < a.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            a.base[i][j] = i * j;\n    \n    for (i = 0; i < b.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            b.base[i][j] = i * j;\n\n    cout << find_max(a) << \" max in size 2 * 3\\n\";\n    cout << find_max(b) << \" max in size 4 * 6\\n\";\n}","position":{"start":{"line":1,"column":1},"end":{"line":60,"column":1}},"key":"zkap4Wv41k"}],"key":"saCtPjAp87"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PzPLMf6otf"}],"key":"qjkblCMwlh"}],"key":"G8oZw4VD4a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"a7SLfPjg4y"},{"type":"outputs","id":"6WxtT3d9Ikj99u_4hSrU2","children":[],"key":"dkCf6Ak94F"}],"key":"XAaxl5UcCe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_8_Two_Dimensional_Dynamic_Arrays\"","key":"PsWRuXW2Hh"},{"type":"outputs","id":"QV-099vFV2oRZEV8neG28","children":[],"key":"ucJx1lnuAD"}],"key":"sA2GhT0qso"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"hSOEdeZ8rk"},{"type":"outputs","id":"US4jMRSjuSUxqhYVBHP6Q","children":[],"key":"UrCRSqbC54"}],"key":"nfkJ3dbgk0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ array_2d.cpp -w -o array_2d\")","key":"MHnQQzLjLd"},{"type":"outputs","id":"y4qQ9by9Ajwa_mK3_UpCY","children":[],"key":"nITNgpiyo7"}],"key":"w5MTvAYopC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./array_2d\")","key":"AaCkjTKIMS"},{"type":"outputs","id":"K6sBXuIS3zSpvOykfGCEo","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 max in size 2 * 3\n15 max in size 4 * 6\n"},"children":[],"key":"T4dfoqd1Za"}],"key":"T70Nem3Ni6"}],"key":"SVpSnm6Kyc"}],"key":"SJw7j1zhNO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Bit Fields","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-4-7-bit-fields","group":"Computer Programming"},"next":{"title":"Chapter 5: Data Hiding and Member Functions","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/object-oriented-programming-using-cpp-ch-5","group":"Computer Programming"}}},"domain":"http://localhost:3000"}