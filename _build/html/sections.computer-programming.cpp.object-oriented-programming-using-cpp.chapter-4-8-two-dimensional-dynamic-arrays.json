AuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lWbnAf2N4i"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"sPTU3eaU6l"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nv25Nic3vm"}],"key":"Ov7xza3LnX"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"s04P9Ymj3F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VHQHo5Qa2m"}],"identifier":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","label":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","html_id":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","implicit":true,"key":"i0M0GIT1CQ"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"UhuHdHpEav"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Dynamic arrays in two dimensions\n#include <iostream>\nusing namespace std;\n\nstruct twod {\n    double **   base;\n    int         row_size, column_size;\n};\n\nvoid allocate (int r, int s, twod & m)\n{\n    m.base = new double * [s];\n    for (int i = 0; i < s; ++i)\n        m.base[i] = new double[r];\n    m.row_size = r;\n    m.column_size = s;\n}\n\nvoid deallocate(twod & m)\n{\n    for (int i = 0; i < m.column_size; ++i)\n        delete [] m.base[i];\n    delete [] m.base;\n    m.row_size = 0;\n    m.column_size = 0;\n}\n\ndouble find_max(const twod & m)\n{\n    int i, j;\n    double max = m.base[0][0];\n\n    for (i = 0; i < m.column_size; ++i)\n        for (j = 0; j < m.row_size; ++j)\n            if (m.base[i][j] > max)\n                max = m.base[i][j];\n    return (max);\n}\n\nint main ()\n{\n    twod    a, b;\n    int     i, j;\n\n    allocate(2, 3, a);\n    allocate(4, 6, b);\n\n    for (i = 0; i < a.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            a.base[i][j] = i * j;\n    \n    for (i = 0; i < b.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            b.base[i][j] = i * j;\n\n    cout << find_max(a) << \" max in size 2 * 3\\n\";\n    cout << find_max(b) << \" max in size 4 * 6\\n\";\n}","position":{"start":{"line":1,"column":1},"end":{"line":60,"column":1}},"key":"F5qOZsRKmE"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"fVwobk373q"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CgHQZnNSlI"}],"key":"Yk1V848Zvx"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"uvMQK2D9hd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"JsdBIUbJOa"},{"type":"outputs","id":"SHr5hn-2GQ_IDK7oeJhUI","children":[],"key":"Aw5r56PFXn"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"QB6I2qOuLo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_8_Two_Dimensional_Dynamic_Arrays\"","key":"UBKsmw262M"},{"type":"outputs","id":"c-362Z4OM2pmFFmKNJW-Y","children":[],"key":"rybEZhx2uX"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"gTCICRtmGk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"GdLxAu0jkL"},{"type":"outputs","id":"X9cELaV9sLfv4cE54AReK","children":[],"key":"iE7j9XKNIU"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"iZvNRGdeGz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ array_2d.cpp -w -o array_2d\")","key":"TUXbSxX6sr"},{"type":"outputs","id":"mMRj-BKSuJGn85qQNXvhI","children":[],"key":"PhzsNOhuLz"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"SFjCkwKm3c"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./array_2d\")","key":"S67NDmoOOa"},{"type":"outputs","id":"9R5lZmkv1yJxf37wAD23X","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 max in size 2 * 3\n15 max in size 4 * 6\n"},"children":[],"key":"DngONj4r0i"}],"key":"AwvDcUhfZb"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"jxtsJpZQgd"}],"key":"GukDf8NY4D"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"titl