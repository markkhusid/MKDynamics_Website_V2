{"version":3,"kind":"Notebook","sha256":"12d4e974c7dc42b557f3301c872557f731b944833c9a7b186ac46f3e77210351","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-4-8-two-dimensional-dynamic-arrays","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","dependencies":[],"frontmatter":{"title":"Two Dimensional Dynamic Arrays","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","exports":[{"format":"ipynb","filename":"Chapter_4_8_Two_Dimensional_Dynamic_Arrays.ipynb","url":"/build/Chapter_4_8_Two_Dime-dc82b2d328b3ca2836a95bd869c6c52e.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"","value":"---\njupytext:\n  formats: md:myst\n  text_representation:\n    extension: .md\n    format_name: myst\nkernelspec:\n  display_name: Python 3\n  language: python\n  name: python3\n---","key":"DELKUwiJh6"}],"identifier":"15b484a3-b826-4b72-ad90-8fc090a94c25","html_id":"15b484a3-b826-4b72-ad90-8fc090a94c25","key":"G577WHnDfS"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Two Dimensional Dynamic Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a8xjTtpsrC"}],"identifier":"two-dimensional-dynamic-arrays","label":"Two Dimensional Dynamic Arrays","html_id":"two-dimensional-dynamic-arrays","implicit":true,"key":"LvhBzThoCD"}],"identifier":"4fae3c47-7ba5-411e-929d-45543f813a61","html_id":"4fae3c47-7ba5-411e-929d-45543f813a61","visibility":"show","key":"Apo00yeQkR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VqomLHc6OT"}],"key":"MOxP4dzjQp"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"PIDvDzLrjT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XC9uZqTsTR"}],"identifier":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","label":"Program that demonstrates dynamic arracy creation, manipulation and destruction in C++","html_id":"program-that-demonstrates-dynamic-arracy-creation-manipulation-and-destruction-in-c","implicit":true,"key":"BGNbyxXBjc"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"EY51qaCGdX"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// Dynamic arrays in two dimensions\n#include <iostream>\nusing namespace std;\n\nstruct twod {\n    double **   base;\n    int         row_size, column_size;\n};\n\nvoid allocate (int r, int s, twod & m)\n{\n    m.base = new double * [s];\n    for (int i = 0; i < s; ++i)\n        m.base[i] = new double[r];\n    m.row_size = r;\n    m.column_size = s;\n}\n\nvoid deallocate(twod & m)\n{\n    for (int i = 0; i < m.column_size; ++i)\n        delete [] m.base[i];\n    delete [] m.base;\n    m.row_size = 0;\n    m.column_size = 0;\n}\n\ndouble find_max(const twod & m)\n{\n    int i, j;\n    double max = m.base[0][0];\n\n    for (i = 0; i < m.column_size; ++i)\n        for (j = 0; j < m.row_size; ++j)\n            if (m.base[i][j] > max)\n                max = m.base[i][j];\n    return (max);\n}\n\nint main ()\n{\n    twod    a, b;\n    int     i, j;\n\n    allocate(2, 3, a);\n    allocate(4, 6, b);\n\n    for (i = 0; i < a.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            a.base[i][j] = i * j;\n    \n    for (i = 0; i < b.column_size; ++i)\n        for (j = 0; j < b.row_size; ++j)\n            b.base[i][j] = i * j;\n\n    cout << find_max(a) << \" max in size 2 * 3\\n\";\n    cout << find_max(b) << \" max in size 4 * 6\\n\";\n}","position":{"start":{"line":1,"column":1},"end":{"line":60,"column":1}},"key":"VopimPdd1F"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"T5lxPTaunb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MfB9vH59mP"}],"key":"qWOmjCuRNz"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"HSy13sxRG0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"j7Zj9FuE6V"},{"type":"outputs","id":"3eM9_MsJGo7hGX0FO9IM7","children":[],"key":"DDZ519MlHS"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"NexLI5zd8u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_8_Two_Dimensional_Dynamic_Arrays\"","key":"m37SeJnFZB"},{"type":"outputs","id":"0XtC-Az8bd2MJnIr0EAWy","children":[],"key":"iLeOqJg23w"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"Ydbmfn82Cp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"d4vLWh7W6F"},{"type":"outputs","id":"RuoY4SQcHoypbcJTUKsXx","children":[],"key":"FDVWoKorR7"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"UKwdTbtp86"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ array_2d.cpp -w -o array_2d\")","key":"zVlSIlPdC2"},{"type":"outputs","id":"1M7X4hyNjP5gz70PV9Vi3","children":[],"key":"xTpBuSfCRV"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"d0MUC6oYne"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./array_2d\")","key":"y7nZybvuWx"},{"type":"outputs","id":"ReM8puWJHUYbxzoGtHdAb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 max in size 2 * 3\n15 max in size 4 * 6\n"},"children":[],"key":"tiGeRuick3"}],"key":"NkkBg7L9kV"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"s1t6ZTyuqM"}],"key":"BdipgGr7zT"},"reference