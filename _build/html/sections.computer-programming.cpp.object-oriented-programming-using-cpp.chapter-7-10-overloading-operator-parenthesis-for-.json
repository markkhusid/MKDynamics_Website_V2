n13\t14\t15\t16\t17\t18\t\n\nThe matrix n contains ...\n\nrow  1\n100\t101\t102\t103\t104\t105\t\nrow  2\n106\t107\t108\t109\t110\t111\t\nrow  3\n112\t113\t114\t115\t116\t117\t\n\nPerforming n = n + m....\n\nThe matrix n contains ...\n\nrow  1\n101\t103\t105\t107\t109\t111\t\nrow  2\n113\t115\t117\t119\t121\t123\t\nrow  3\n125\t127\t129\t131\t133\t135\t\n"},"children":[],"key":"IKZJCtPOU7"}],"key":"WPBoZj3BRE"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"bWXjt3vaIz"}],"key":"ukHenkxQWb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chapter 7.7: Overloading Assignment and Subscripting Operators","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-7-7-overloading-assignment-and-subscriptin","group":"Computer Programming"},"next":{"title":"Chapter 7.11: Pointer Operators","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-7-11-pointer-operators","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}