d+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xbVCLhaO1V"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"n6dmcpTPQB"},{"type":"text","value":" by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gD7rA71QVB"}],"key":"FHzzF0XqJC"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"zJLUtwMhWw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the function call operator () for use in matrix indexing in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JKd4gsrt2D"}],"identifier":"program-that-demonstrates-overloading-the-function-call-operator-for-use-in-matrix-indexing-in-c","label":"Program that demonstrates overloading the function call operator () for use in matrix indexing in C++","html_id":"program-that-demonstrates-overloading-the-function-call-operator-for-use-in-matrix-indexing-in-c","implicit":true,"key":"l5NGMuYYym"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"rVxLCd0fjm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file matrix3.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zvzeeTnWcp"}],"key":"skWNUhIysE"}],"identifier":"17067957","html_id":"17067957","key":"S5qN5Yji0Z"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_10_Overloading_Operator_Parenthesis_for_Indexing/matrix3.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\r\n\r\n  Filename:  matrix3.cpp\r\n  Chapter:   7      Ad Hoc Polymorphism\r\n  Section:   7.10   Overloading () for Indexing\r\n  Compiler:  Borland C++     Version 5.0       Summer 1996\r\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\r\n\r\n*********************************************************************/\r\n\r\n//This is matrix not based on vect\r\n//Shows () as index operator\r\n\r\n#include  <iostream>          // Changed iostream.h to iostream\r\n#include  <assert.h>\r\n\r\nusing namespace std;          // Added. MK.\r\n\r\nclass matrix {\r\npublic:\r\n   matrix(int c, int r);\r\n   ~matrix();\r\n   double& operator()(int i, int j);\r\n   double set_element(int i, int j, double d);\r\n   matrix& operator=(const matrix& m);\r\n   matrix& operator+=(matrix& m);\r\n   void print() const;\r\nprivate:\r\n   int c_size, r_size;\r\n   double  **p;\r\n};\r\n\r\nmatrix:: matrix(int c, int r):c_size(c), r_size(r)\r\n{\r\n   p = new double*[c];\r\n   assert(p != 0);\r\n\r\n   for (int i = 0; i < c; ++i){\r\n      p[i] = new double[r];\r\n      assert(p[i] != 0);\r\n   }\r\n}\r\n\r\nmatrix:: ~matrix()\r\n{\r\n   for (int i = 0; i < c_size; ++i)\r\n      delete [] p[i];\r\n   delete [] p;\r\n}\r\n\r\ninline double& matrix::operator()(int i, int j)\r\n{\r\n   assert( i >= 0 && i < c_size && j >= 0 && j < r_size);\r\n   return p[i][j];\r\n}\r\n\r\nmatrix& matrix::operator=(const matrix& m)\r\n{\r\n   assert(m.c_size == c_size && m.r_size == r_size);\r\n   int i, j;\r\n\r\n   for (i = 0; i < c_size; ++i)\r\n      for (j = 0; j < r_size; ++j)\r\n         p[i][j] = m.p[i][j];\r\n   return (*this);\r\n}\r\n\r\nmatrix& matrix::operator+=(matrix& m)\r\n{\r\n   assert(m.c_size == c_size && m.r_size == r_size);\r\n   int i, j;\r\n\r\n   for (i = 0; i < c_size; ++i)\r\n      for (j = 0; j < r_size; ++j)\r\n         p[i][j] += m.p[i][j];\r\n   return *this;\r\n}\r\n\r\nvoid matrix::print() const\r\n{\r\n   int i, j;\r\n   for (i = 0; i < c_size; ++i) {\r\n      cout << \"\\nrow  \" << (i + 1) << endl;\r\n      for (j = 0; j < r_size; ++j)\r\n         cout << p[i][j] << \"\\t\";\r\n   }\r\n   cout << endl;\r\n}\r\n\r\n\r\nvoid init_matrix(matrix& m, int c, int r, int start = 1)\r\n{\r\n   int i, j ;\r\n   for (i = 0; i < c; ++i)\r\n      for (j = 0; j < r; ++j)\r\n         m(i, j) = start++;\r\n}\r\n\r\nint main()\r\n{\r\n   matrix m(3, 6) , n(3, 6);\r\n\r\n   init_matrix(m, 3, 6, 1);\r\n   init_matrix(n, 3, 6, 100);\r\n   cout << \"The matrix m contains ...\" << endl;\r\n   m.print();\r\n   cout << endl;\r\n   cout << \"The matrix n contains ...\" << endl;\r\n   n.print();\r\n   cout << endl;\r\n   cout << \"Performing n = n + m....\" << endl;\r\n   n += m;\r\n   cout << endl;\r\n   cout << \"The matrix n contains ...\" << endl;\r\n   n.print();\r\n}\r\n","lang":"cpp","filename":"matrix3.cpp","key":"lYzTuzIEc5"}],"key":"cNoAJcKPLB"}],"identifier":"ebaa7c39","html_id":"ebaa7c39","key":"g7xKhYpdaj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SMOfWsI1QB"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"b3ubEcNC97"}],"identifier":"3e111038","html_id":"3e111038","key":"ZWVrbt42NK"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WAs505t4Qa"}],"key":"DgjWOZSzgv"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"YbgNXTIBE7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vYt51idRfz"},{"type":"outputs","id":"VpOt5ioISEqkavcExr2c2","children":[],"key":"VgGva4Jx2E"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"kuJ6nm7ScI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_10_Overloading_Operator_Parenthesis_for_Indexing\"","key":"eg7XvlCo55"},{"type":"outputs","id":"p0OnrIWIWzBN_2tBuf2lu","children":[],"key":"ccxkkTuFGQ"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"woZMGwezRY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"MzmAbfXKHe"},{"type":"outputs","id":"_B61DElYjU5TNu8RwRQQl","children":[],"key":"RunxEUqCuK"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"XuqDFq6ooy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ matrix3.cpp -w -o matrix3\")","key":"PgjAOa3Bkm"},{"type":"outputs","id":"QxMBcltzpboUX7GkRkkBL","children":[],"key":"zxHKob7cj0"}],"identifier":"a734c6b9-cf2b-455b-a92