)\")\naxes[1].set_ylabel(\"Phase (deg)\")\naxes[1].grid(True, alpha=0.3)\nfig.suptitle(\"+TCR and +TCC, ideal op-amp\", y=1.01)\nfig.tight_layout()\nfig.savefig(FIG / \"06_temperature_tran.png\", dpi=150)\nplt.show()\n","key":"eiMZb86L11"},{"type":"outputs","id":"pSJK1eGJAIqq8fhBK2jKB","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93b1719cd2f3d11b827f359f9e9033a9","path":"/build/93b1719cd2f3d11b827f359f9e9033a9.png"},"text/plain":{"content":"<Image>","content_type":"text/plain"}}},"children":[],"key":"EnnzSllcTG"}],"key":"VfyyrS2eT4"}],"identifier":"28080330","html_id":"28080330","key":"x6W7wcAFyR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(8.2, 4.4))\npairs = ((1.0, 1.0, \"+TCR +TCC\"), (1.0, -1.0, \"+TCR −TCC\"),\n         (-1.0, 1.0, \"−TCR +TCC\"), (-1.0, -1.0, \"−TCR −TCC\"))\nan_fc = None\nfor tcr, tcc, label in pairs:\n    fr = sweep_analytical(\n        p, tcr_sign=tcr, tcc_sign=tcc, use_ib_max_at_temp=False,\n    ).frame\n    ax.plot(fr[\"temp_c\"], fr[\"fc_hz\"] / 1e3, lw=1.6, label=label)\n    if tcr > 0 and tcc > 0:\n        an_fc = fr\nax.set_xlabel(\"Temperature (°C)\")\nax.set_ylabel(\"Cutoff (kHz)\")\nax.set_title(\"Analytical cutoff for the four tempco sign pairs\")\nax.grid(True, alpha=0.3)\nax.legend(frameon=False, fontsize=8)\nfig.tight_layout()\nfig.savefig(FIG / \"06_fc_sign_pairs.png\", dpi=150)\nplt.show()\n\nng = spice_temp_sweep(\n    p,\n    workdir=ROOT / \"results\" / \"ngspice\" / \"nb06_ac_temp\",\n    root=ROOT,\n    opamp_model=\"ideal\",\n    tcr_sign=1.0,\n    tcc_sign=1.0,\n)\ncmp = an_fc[[\"temp_c\", \"fc_hz\"]].merge(ng.frame, on=\"temp_c\")\ncmp[\"fc_delta_Hz\"] = cmp[\"fc_spice_hz\"] - cmp[\"fc_hz\"]\ndisplay(cmp)\nprint(f\"max |ngspice − analytical| fc = {cmp['fc_delta_Hz'].abs().max():.3e} Hz\")\n","key":"BjserFGfBg"},{"type":"outp