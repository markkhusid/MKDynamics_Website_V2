{"version":3,"kind":"Notebook","sha256":"f53a478860de03eb55f4ab967fe00c4d2643b6001321bd9bb0e7a8e918a7e46f","slug":"sections.electronics.analog-and-digital.opa365-fig85.temperature-sweep","location":"/Sections/Electronics/Analog_and_Digital/OPA365_Fig85/06_temperature_sweep.ipynb","dependencies":[],"frontmatter":{"title":"Figure 8-5 — temperature","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":4}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Electronics/Analog_and_Digital/OPA365_Fig85/06_temperature_sweep.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Electronics/Analog_and_Digital/OPA365_Fig85/06_temperature_sweep.ipynb","exports":[{"format":"ipynb","filename":"06_temperature_sweep.ipynb","url":"/build/06_temperature_sweep-25d790dc0d515b9b127bd5b5ac8d9a2d.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The study model scales resistors at 50 ppm/°C and capacitors at 30 ppm/°C,\nreferenced to 25 °C. The grid is −40 °C to 125 °C. The transient cache uses\nthe positive TCR and TCC signs. ngspice and LTspice see those scaled\npassives through the ideal voltage-controlled source, which has no\nsemiconductor temperature law of its own.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pSFVFP5bdh"}],"key":"Z2ya0VnkNj"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"A second analytical sweep flips the signs of TCR and TCC. Bias-current\ngrowth, where it is plotted, is a smooth study model, exp(0.062·ΔT), not a\ndatasheet curve. It is about 1× at 25 °C and about 500× at 125 °C.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"n9pYlIY0u2"}],"key":"WlvkhjGnp2"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Created with Grok Build.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"raNWfOP5LU"}],"key":"gFpS6LGmsS"}],"identifier":"cecd3f20","html_id":"cecd3f20","key":"kAtWVfwhS8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sys\n\nimport os\nos.environ[\"MPLBACKEND\"] = \"Agg\"\nimport matplotlib\nmatplotlib.use(\"Agg\", force=True)\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport io\nfrom pathlib import Path\nfrom IPython.display import display, Image\n\ndef _show(*args, **kwargs):\n    buf = io.BytesIO()\n    fig = plt.gcf()\n    fig.savefig(buf, format=\"png\", dpi=150, bbox_inches=\"tight\")\n    plt.close(\"all\")\n    display(Image(data=buf.getvalue()))\n\nplt.show = _show\n\ndef _find_project_root():\n    start = Path.cwd().resolve()\n    named = Path(\"Sections/Electronics/Analog_and_Digital/OPA365_Fig85\")\n    candidates = [start, *start.parents, start / named]\n    if start.name == \"notebooks\":\n        candidates.insert(0, start.parent)\n    for cand in candidates:\n        if (cand / \"mfb_design\" / \"__init__.py\").is_file():\n            return cand\n    raise FileNotFoundError(\"mfb_design package was not found\")\n\nROOT = _find_project_root()\nif str(ROOT) not in sys.path:\n    sys.path.insert(0, str(ROOT))\n","key":"JWfzMB4KJ7"},{"type":"outputs","id":"2wVLwFoVKiOA-Utr5dIAi","children":[],"key":"FAzIvIGbvd"}],"identifier":"6fd61b68","html_id":"6fd61b68","key":"KkYTFsq5PG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from mfb_design.params import CircuitParams, ToleranceSpec\n\np = CircuitParams(\n    R1=549.0,\n    R2=1.24e3,\n    R3=549.0,\n    C1=1.0e-9,\n    C2=150.0e-12,\n    r_tol=ToleranceSpec(0.001),\n    c_tol=ToleranceSpec(0.01),\n)\nSPICE_WORKERS = 4\nN_MC_AC = 2000\nN_MC_TRAN = 500\nMC_SEED = 42\nprint(\n    f\"R1={p.R1:g} ohm  R2={p.R2:g} ohm  R3={p.R3:g} ohm  \"\n    f\"C1={p.C1:g} F  C2={p.C2:g} F\"\n)\nprint(\n    f\"supplies {p.op.v_pos:g} V / {p.op.v_neg:g} V, \"\n    f\"tone {p.op.f_passband_hz:g} Hz, {p.op.v_in_peak:g} V peak\"\n)\nFIG = ROOT / \"results\" / \"figures\"\nFIG.mkdir(parents=True, exist_ok=True)\n","key":"v2ycMvKXa4"},{"type":"outputs","id":"w9zoX2_vn4rdB6Mw5TfQw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"R1=549 ohm  R2=1240 ohm  R3=549 ohm  C1=1e-09 F  C2=1.5e-10 F\nsupplies 2.5 V / -2.5 V, tone 250000 Hz, 1 V peak\n"},"children":[],"key":"hJ15J7GVLZ"}],"key":"guPm0hFlJj"}],"identifier":"b565b97a","html_id":"b565b97a","key":"Sx0z6boenJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from mfb_design.temperature import spice_temp_sweep, sweep_analytical\nfrom mfb_design.transient import load_or_run_temperature\n\ntemp = load_or_run_temperature(\n    p,\n    root=ROOT,\n    cache_csv=ROOT / \"results\" / \"temperature_tran.csv\",\n    workers=SPICE_WORKERS,\n)\nif not bool(temp[\"ng_ok\"].all()) or temp[\"lt_gain\"].isna().any():\n    raise RuntimeError(\"temperature cache is incomplete\")\ndisplay(temp)\nng_err = float((temp[\"ng_gain\"] - temp[\"an_gain\"]).abs().max())\nlt_err = float((temp[\"lt_gain\"] - temp[\"an_gain\"]).abs().max())\nprint(f\"max |ngspice − analytical| gain = {ng_err:.3e}\")\nprint(f\"max |LTspice − analytical| gain = {lt_err:.3e}\")\nif ng_err > 1e-3 or lt_err > 1e-3:\n  