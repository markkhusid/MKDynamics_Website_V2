{"version":3,"kind":"Notebook","sha256":"19bd3eef20f7939a47b95dd4ba6454d1a7cb722fc639077dabc21723cf0acb21","slug":"sections.computer-programming.fortran.fplotlib.fplotlib-animation-demo","location":"/Sections/Computer_Programming/Fortran/fplotlib/fplotlib_animation_demo.ipynb","dependencies":[],"frontmatter":{"title":"fplotlib Animations Demo in Jupyter","content_includes_title":false,"kernelspec":{"name":"fortran","display_name":"Fortran","language":"fortran"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":4}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/fplotlib/fplotlib_animation_demo.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/fplotlib/fplotlib_animation_demo.ipynb","thumbnail":"/build/mobius-9de105bd309240dfa79f8a8d91d60ec9.png","exports":[{"format":"ipynb","filename":"fplotlib_animation_demo.ipynb","url":"/build/fplotlib_animation_d-e4def3b6b54c9db6f7c18243719364e8.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BCVxHNi4Tb"},{"type":"link","url":"https://fplotlib.fortran-lang.org/auto_gallery/animation/plot_mobius_apng.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A rotating Möbius strip as an animated PNG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ttM4Yg8RX1"}],"urlSource":"https://fplotlib.fortran-lang.org/auto_gallery/animation/plot_mobius_apng.html","key":"MoFKUrMjuW"}],"key":"yM7zLMLbhn"}],"identifier":"fa0cbb8d-2930-4dbe-8556-98819ea9d197","html_id":"fa0cbb8d-2930-4dbe-8556-98819ea9d197","key":"g9tzlAsB82"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-26T19:47:29.529557Z","iopub.status.busy":"2026-11-26T19:47:29.529514Z","iopub.status.idle":"2026-11-26T19:47:38.956654Z","shell.execute_reply":"2026-11-26T19:47:38.956524Z","shell.execute_reply.started":"2026-11-26T19:47:38.956482Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"use fplotlib","key":"CehpxcYl2p"},{"type":"outputs","id":"xpXnx-O6drNHgb1pHs7rS","children":[],"key":"JDbfUCK2M2"}],"identifier":"f5ccdf7c-785f-4be9-aa33-ffe0fd94927d","html_id":"f5ccdf7c-785f-4be9-aa33-ffe0fd94927d","key":"Bhq6a5OIda"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-26T19:47:38.956968Z","iopub.status.busy":"2026-11-26T19:47:38.956912Z","iopub.status.idle":"2026-11-26T19:47:39.150297Z","shell.execute_reply":"2026-11-26T19:47:39.150183Z","shell.execute_reply.started":"2026-11-26T19:47:39.150157Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"integer, parameter :: nu = 121, nv = 9, n_frames = 36\n    real(dp), parameter :: pi = 3.14159265358979323846_dp\n    real(dp), parameter :: radius = 1.0_dp, half_width = 0.4_dp\n    real(dp) :: x(nu, nv), y(nu, nv), z(nu, nv)\n    real(dp) :: u, v, angle, r\n    integer :: frame, i, j","key":"yNDNiRnUuq"},{"type":"outputs","id":"JMvxoZo3Z9PawTkBbVHvT","children":[],"key":"vQeKEc9Bvy"}],"identifier":"9a19e46e-130d-47b9-894e-382af05e4069","html_id":"9a19e46e-130d-47b9-894e-382af05e4069","key":"VHGSZmBS9u"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-26T19:47:39.150410Z","iopub.status.busy":"2026-11-26T19:47:39.150391Z","iopub.status.idle":"2026-11-26T19:47:39.365565Z","shell.execute_reply":"2026-11-26T19:47:39.365454Z","shell.execute_reply.started":"2026-11-26T19:47:39.365426Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"call figure(figsize=[5.0_dp, 5.0_dp], dpi=80.0_dp)","key":"UtuUJmRfdX"},{"type":"outputs","id":"UYuWFPDrcJgBELmxXKxOQ","children":[],"key":"ztGTEng6c3"}],"identifier":"11bab43f-f967-4bc5-bdca-58eee491746d","html_id":"11bab43f-f967-4bc5-bdca-58eee491746d","key":"py8kSHJx2A"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-26T19:47:39.365692Z","iopub.status.busy":"2026-11-26T19:47:39.365671Z","iopub.status.idle":"2026-11-26T19:47:43.214352Z","shell.execute_reply":"2026-11-26T19:47:43.214245Z","shell.execute_reply.started":"2026-11-26T19:47:43.214218Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"do frame = 1, n_frames\n        angle = 2.0_dp*pi*real(frame - 1, dp)/real(n_frames, dp)\n        do j = 1, nv\n            v = half_width*(2.0_dp*real(j - 1, dp)/real(nv - 1, dp) - 1.0_dp)\n            do i = 1, nu\n                u = 2.0_dp*pi*real(i - 1, dp)/real(nu - 1, dp)\n                r = radius + v*cos(u/2.0_dp)\n                x(i, j) = r*cos(u + angle)\n                y(i, j) = r*sin(u + angle)\n                z(i, j) = v*sin(u/2.0_dp)\n            end do\n        end do\n\n        call clf()\n        do j = 1, nv\n            call plot3d(x(:, j), y(:, j), z(:, j), color=\"C0\", lw=1.2_dp)\n        end do\n        do i = 1, nu - 1, 5\n            call plot3d(x(i, :), y(i, :), z(i, :), color=\"C1\", lw=0.8_dp)\n        end do\n        call xlim(-1.5_dp, 1.5_dp)\n        call ylim(-1.5_dp, 1.5_dp)\n        call zlim(-0.5_dp, 0.5_dp)\n        call view_init(elev=25.0_dp, azim=-55.0_dp)\n        call grid(.false.)\n        call title(\"Rotating Mobius strip\")\n        call xlabel(\"x\")\n        call ylabel(\"y\")\n        call zlabel(\"z\")\n        call add_frame()\nend do","key":"gGJ5gqOzn1"},{"type":"outputs","id":"r5rGGq4GbbgEEuYWsZQrQ","children":[],"key":"y3fWQfqTwQ"}],"identifier":"a086ce3d-c83f-4007-ae1f-eccf48af2bf5","html_id":"a086ce3d-c83f-4007-ae1f-eccf48af2bf5","key":"c94RoGatnO"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-26T19:47:43.214495Z","iopub.status.busy":"2026-11-26T19:47:43.214476Z","iopub.status.idle":"2026-11-26T19:47:49.262334Z","shell.execute_reply":"2026-11-26T19:47:49.259762Z","shell.execute_reply.started":"2026-11-26T19:47:49.259745Z"}},"children":[{"type":"code","lang":"fortran","executable":true,"value":"call save_animation(\"mobius.png\", fps=18.0_dp)\nprint *, \"wrote mobius.png\"","key":"sZXCbUlwF4"},{"type":"outputs","id":"gQbMQ9YvapSh1dehFc-r0","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wrote mobius.png\n"},"children":[],"key":"xYSmYEeHr6"}],"key":"VtAYCzbjc9"}],"identifier":"241b7d85-f444-490a-932e-d308f0569bc4","html_id":"241b7d85-f444-490a-932e-d308f0569bc4","key":"kKb5BPo0dn"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/build/mobius-9de105bd309240dfa79f8a8d91d60ec9.png","alt":"Rotating Mobius strip","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lFwqXf6Sme","urlSource":"mobius.png"}],"identifier":"6aa8d30e-1a61-4c87-84a5-db4c4d5143a1","html_id":"6aa8d30e-1a61-4c87-84a5-db4c4d5143a1","key":"oQ5xmj8pOv"}],"key":"UP1w8MsHn5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"fplotlib demo in Jupyter","url":"/sections/computer-programming/fortran/fplotlib/fplotlib-demo","group":"Computer Programming"},"next":{"title":"fplotlib Wave Animation in Jupyter","url":"/sections/computer-programming/fortran/fplotlib/fplotlib-wave-animation","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}