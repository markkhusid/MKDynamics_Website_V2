e":"text","value":"” by Milan Curcic (Manning)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TfzasxtQw5"}],"key":"ulKB7GEoNy"}],"identifier":"f948b57a-7253-4068-8699-aed89a8921c6","html_id":"f948b57a-7253-4068-8699-aed89a8921c6","key":"MVtSu6kVJb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib inline\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib\n\n#matplotlib.use('Agg')\n#matplotlib.rcParams.update({'font.size': 16})","key":"YHZk46cPHE"},{"type":"outputs","id":"Vf1LXnhhrIPWFrl2gg4wH","children":[],"key":"EMpMPV8NA2"}],"identifier":"4e9bd283-4097-4367-9908-4ada7ec46d39","html_id":"4e9bd283-4097-4367-9908-4ada7ec46d39","key":"yDne9UNdbS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = \"Fortran_Code/Tsunami_Simulator/\"\noutput_filename = 'tsunami_simulator_data.txt'\ndatafile_full_path = code_dir + output_filename","key":"YOiIcwD5FM"},{"type":"outputs","id":"3i99J89V52zdElaU6fRRn","children":[],"key":"ZoKmnw4XeY"}],"identifier":"e53807c7-c563-401c-bda9-12af6fdfeeb9","html_id":"e53807c7-c563-401c-bda9-12af6fdfeeb9","key":"gdSiQ5oSxj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# read data into a list\ndata = [line.rstrip().split() for line in open(datafile_full_path).readlines()]","key":"cm9LKQQz0s"},{"type":"outputs","id":"9AxsXxCBAldSPXW7YGU6H","children":[],"key":"ZMTTW2HnNq"}],"identifier":"0134817e-cc60-4f0a-b63d-ed2a95d9298e","html_id":"0134817e-cc60-4f0a-b63d-ed2a95d9298e","key":"zDNPWwqPhs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time = [float(line[0]) for line in data]\nh = np.array([[float(x) for x in line[1:]] for line in data])\nx = np.arange(1, h.shape[1]+1)\ntime_steps = [0, 25, 50, 75]","key":"ICkQwUdIsc"},{"type":"outputs","id":"-YAAsqy8yut8NTBeLIyOw","children":[],"key":"P3tU5lJhYD"}],"identifier":"4016df0d-eba7-426a-a67b-eec47f8800f8","html_id":"4016df0d-eba7-426a-a67b-eec47f8800f8","key":"Xnv00i4Kan"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8, 10))\naxes = [plt.subplot2grid((4, 1), (row, 0), colspan=1, rowspan=1)\n        for row in range(4)]\n\nfor ax in axes:\n    n = axes.index(ax)\n    ax.plot(x, h[time_steps[n], :], 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch02.svg')\n#plt.close(fig)","key":"f1ZskveUFy"},{"type":"outputs","id":"_scgirTGpnLFvudAf3Ahp","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"1474dbdade8e83bd81dc2e5b2c444e54","path":"/build/1474dbdade8e83bd81dc2e5b2c444e54.png"},"text/plain":{"content":"<Figure size 576x720 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"dUQk6nn3P7"}],"key":"wiZK4JP2fc"}],"identifier":"555f1f10-06af-4f24-b645-9ded3e5acc7f","html_id":"555f1f10-06af-4f24-b645-9ded3e5acc7f","key":"oWF4sYyZYs"}],"key":"n7WoqrSlrm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tsunami Simulator","url":"/sections/computer-programming/fortran/modern-fortran/tsunami-simulator","group":"Computer Programming"},"next":{"title":"Tsunami Simulator with Modules","url":"/sections/computer-programming/