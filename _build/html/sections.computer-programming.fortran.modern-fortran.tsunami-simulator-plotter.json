n], :], 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch02.svg')\n#plt.close(fig)","key":"ABU5hi9Lig"},{"type":"outputs","id":"vybpBHZhFK6QhqqQOPBm0","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"1474dbdade8e83bd81dc2e5b2c444e54","path":"/build/1474dbdade8e83bd81dc2e5b2c444e54.png"},"text/plain":{"content":"<Figure size 576x720 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"AAWmEPfpgR"}],"key":"KQHLuoV2HO"}],"key":"zDS01JIp8v"}],"key":"hA5rucxyfp"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tsunami Simulator","url":"/sections/computer-programming/fortran/modern-fortran/tsunami-simulator","group":"Computer Programming"},"next":{"title":"Tsunami Simulator with Modules","url":"/sections/computer-programming/fortran/modern-fortran/tsunami-simulator-with-modules","group":"Computer Programming"}}},"domain":"http://localhost:3000"}