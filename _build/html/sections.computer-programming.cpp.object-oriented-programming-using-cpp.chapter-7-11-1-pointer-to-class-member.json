end":{"line":1,"column":1}},"key":"ikcZugXJag"}],"key":"jVczlC9292"}],"identifier":"17067957","html_id":"17067957","key":"w7vDtQ5VgX"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_1_Pointer_to_Class_Member/showhide.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\r\n\r\n  Filename:  showhide.cpp\r\n  Chapter:   7      Ad Hoc Polymorphism\r\n  Section:   7.11   Pointer Operators\r\n  Compiler:  Borland C++     Version 5.0       Summer 1996\r\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\r\n\r\n*********************************************************************/\r\n\r\n//Pointer to class member.\r\n\r\n#include <iostream>           // Changed iostream.h to iostream. MK.\r\n\r\nusing namespace std;          // Added. MK.\r\n\r\nclass X {\r\npublic:\r\n   int  visible;\r\n   void print()\r\n      { cout << \"\\nhide = \" << hide\r\n             << \" visible = \" << visible; }\r\n   void reset() { visible = hide; }\r\n   void set(int i) { hide = i; }\r\nprivate:\r\n   int  hide;\r\n};\r\n\r\ntypedef void (X::*pfcn)();\r\n\r\nint main()\r\n{\r\n   X  a, b, *pb = &b;\r\n   int X::*pXint = &X::visible;\r\n   pfcn pF = &X::print;\r\n\r\n   a.set(8); a.reset();\r\n   b.set(4); b.reset();\r\n   a.print();\r\n   a.*pXint += 1;\r\n   a.print();\r\n   cout << \"\\nb.visible = \" << pb ->*pXint;\r\n   (b.*pF)();\r\n   pF = &X::reset;\r\n   (a.*pF)();\r\n   a.print();\r\n   cout << endl;\r\n}","lang":"C++","filename":"showhide.cpp","key":"O3Px1bg5jr"}],"key":"LBdPv9FqQT"}],"identifier":"ebaa7c39","html_id":"ebaa7c39","key":"pSiduSH8Cv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jTuYZvK