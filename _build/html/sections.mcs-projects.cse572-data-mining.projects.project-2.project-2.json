{"version":3,"kind":"Article","sha256":"ee27f91f3c6b258b0889e91648a1b8a90a96661a430bc47fc467758775951dc7","slug":"sections.mcs-projects.cse572-data-mining.projects.project-2.project-2","location":"/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_2/Project_2.md","dependencies":[],"frontmatter":{"title":"CSE572 Data Mining - Project 2 - Machine Model Training","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_2/Project_2.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_2/Project_2.md","thumbnail":"/build/CSE572_Project_2-8f30256326efa07dcecd31048b421b83.png","exports":[{"format":"md","filename":"Project_2.md","url":"/build/Project_2-e879213be8e438336c6238b4a311b7eb.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SXFKaO2z5W"}],"key":"DJ25mocSuz"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Problem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IrvAbkwcte"}],"identifier":"problem","label":"Problem","html_id":"problem","implicit":true,"key":"aNvK2mzyuB"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The task was to train a classifier that decides, from a continuous glucose monitor window, whether the person was eating a meal. Two pump-and-sensor collections were available. The pump timestamps were not written in one consistent date and time format, so that field had to be parsed before any window could be cut.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"gZrQ54h063"}],"key":"Uqwuii8Ou4"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Approach","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ScQqvQlPLQ"}],"identifier":"approach","label":"Approach","html_id":"approach","implicit":true,"key":"C1KRs8uK8x"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"A meal start was a positive carbohydrate entry in the pump log. A meal window is the two hours after that entry. When the window contained no other meal, the sensor samples from 30 minutes before the meal to two hours after it were kept. That span is two and a half hours, which is 30 samples at a five-minute cadence. A meal that fell inside the window was ignored. A meal that landed on the end of the window used a wider span, from one hour before the meal to four hours after it. Windows with fewer than 30 samples were dropped.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"AKNM31fWMD"}],"key":"xJTPBwEqmf"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"No-meal examples came from the post-absorptive stretch, two to four hours after a meal, and only when that stretch contained no other meal. That is 24 samples. Shorter rows were dropped. Zero and missing samples inside an otherwise usable stretch were skipped rather than rejecting the whole stretch.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"FUJpN3EV3G"}],"key":"sybK9iiEjI"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Eight features were taken from each kept window, including the row mean and the area under the curve. Those two features were strongly correlated on both the meal matrix and the no-meal matrix. The two matrices were stacked, scaled, and labeled. A support vector machine was trained on an 80 percent / 20 percent split.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"haknOLShMe"}],"key":"uLnbXl2tpT"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Result","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"SDXe7xPaAW"}],"identifier":"result","label":"Result","html_id":"result","implicit":true,"key":"itgod8Qfv6"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"On the held-out windows the support vector machine reached 99.71 percent accuracy and an F1 score of 1.00. The area-under-curve feature is what separated the classes: its meal and no-meal histograms barely overlapped, so the decision did not depend on a subtle combination of the other features.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"E9HyUzzMbO"}],"key":"L2Eu6IOjbK"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Notebooks","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"E31eFWXF6g"}],"identifier":"notebooks","label":"Notebooks","html_id":"notebooks","implicit":true,"key":"bGC0qWNns7"},{"type":"grid","columns":[2,2,2,2],"children":[{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-2/project-2-train","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"CSE572 Data Mining - Project 2 - Training","key":"ou8Na4XOhn"}],"key":"nGlEg1YeBL"}],"key":"ZENWE38krm"},{"type":"image","url":"/build/CSE572_Project_2-8f30256326efa07dcecd31048b421b83.png","height":"200","align":"center","key":"ceMBdhNVNk","urlSource":"../../images/CSE572_Project_2.png"}],"urlSource":"Project_2_train.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-2.project-2-train.json","internal":true,"protocol":"file","key":"qkY7S2e78P"},{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-2/project-2-test","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"CSE572 Data Mining - Project 2 - Test","key":"ko3QeeXals"}],"key":"l7MU8G1QtI"}],"key":"byxRX16M5M"},{"type":"image","url":"/build/CSE572_Project_2-8f30256326efa07dcecd31048b421b83.png","height":"200","align":"center","key":"BWE0IlfIne","urlSource":"../../images/CSE572_Project_2.png"}],"urlSource":"Project_2_test.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-2.project-2-test.json","internal":true,"protocol":"file","key":"Te3Gy4VwlW"},{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-2/generate-test-csv","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"CSE572 Data Mining - Project 2 - Generate Test Matrix","key":"SUrBNhdAKK"}],"key":"n0Y6MUOBcs"}],"key":"W6DrQhO4C1"},{"type":"image","url":"/build/CSE572_Project_2-8f30256326efa07dcecd31048b421b83.png","height":"200","align":"center","key":"qg4UgkB3A8","urlSource":"../../images/CSE572_Project_2.png"}],"urlSource":"generate_test_csv.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-2.generate-test-csv.json","internal":true,"protocol":"file","key":"rbbCI3tOK5"}],"key":"bsTWPv0L0t"}],"key":"EyaaHdR10d"}],"key":"bBdPvvF0p2"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Project 1","url":"/sections/mcs-projects/cse572-data-mining/projects/project-1/project-1-submission","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"Project 2 - train.py","url":"/sections/mcs-projects/cse572-data-mining/projects/project-2/project-2-train","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"http://localhost:3000"}