t":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program to demonstrate different methods of passing arguments to functions in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Re4RfNCDCt"}],"identifier":"program-to-demonstrate-different-methods-of-passing-arguments-to-functions-in-fortran","label":"Program to demonstrate different methods of passing arguments to functions in Fortran.","html_id":"program-to-demonstrate-different-methods-of-passing-arguments-to-functions-in-fortran","implicit":true,"key":"U3yhorR23K"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"CBSAjP6pe3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program calculates the sum:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G2tx2T3tQW"}],"key":"kUYp6eXM1C"}],"identifier":"e1c3293a-f7fd-4dd5-89be-383f587ca98c","html_id":"e1c3293a-f7fd-4dd5-89be-383f587ca98c","key":"dcAeZGrjVW"},{"type":"block","kind":"notebook-content","children":[{"type":"math","value":"\\Large \\sum_{i=m}^n \\left(s+d \\times i \\right)","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mstyle mathsize=\"1.44em\"><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mi>m</mi></mrow><mi>n</mi></munderover><mrow><mo fence=\"true\">(</mo><mi>s</mi><mo>+</mo><mi>d</mi><mo>×</mo><mi>i</mi><mo fence=\"true\">)</mo></mrow></mstyle></mrow><annotation encoding=\"application/x-tex\">\\Large \\sum_{i=m}^n \\left(s+d \\times i \\right)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.2091em;vertical-align:-1.8346em;\"></span><span class=\"mop op-limits sizing reset-size6 size8\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.649em;\"><span style=\"top:-2.266em;margin-left:0em;\"><span class=\"pstrut\" style=\"height:3.44em;\"></span><span class=\"sizing reset-size8 size6 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">i</span><span class=\"mrel mtight\">=</span><span class=\"mord mathnormal mtight\">m</span></span></span></span><span style=\"top:-3.44em;\"><span class=\"pstrut\" style=\"height:3.44em;\"></span><span><span class=\"mop op-symbol large-op\">∑</span></span></span><span style=\"top:-4.69em;margin-left:0em;\"><span class=\"pstrut\" style=\"height:3.44em;\"></span><span class=\"sizing reset-size8 size6 mtight\"><span class=\"mord mathnormal mtight\">n</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.274em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner sizing reset-size6 size8\"><span class=\"mopen sizing reset-size8 size6 delimcenter\" style=\"top:-0.11em;\"><span class=\"delimsizing size1\">(</span></span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">i</span><span class=\"mclose sizing reset-size8 size6 delimcenter\" style=\"top:-0.11em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span></span></span>","enumerator":"1","key":"yxRlHQPAr4"}],"identifier":"0c1f1094-0066-403a-9ccc-0c5c12e5ecfa","html_id":"0c1f1094-0066-403a-9ccc-0c5c12e5ecfa","key":"Ca8YFjMDJ6"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program series_sum_program\n\n    implicit none\n    \n    integer, parameter :: n = 100\n    \n    ! Shows different ways to pass arguments to a function\n    print *, series_sum(0, 700, 100.0, 0.1)\n    print *, series_sum(0, 700, d=0.1, s=100.0)\n    print *, series_sum(n=700, d=0.1, s=100.0)\n    print *, series_sum(d=0.1, s=100.0, n=700)\n    print *, series_sum(m=0, n=700, d=0.1, s=100.0)\n\ncontains\n\n    function series_sum(m, n, s, d) result (series_sum_result)\n        integer, optional, intent(in)   :: m\n        integer, intent(in)             :: n\n        real, intent(in)                :: s, d\n        real                            :: series_sum_result\n        integer                         :: i, temp_m\n\n        if (present(m)) then\n            temp_m = m\n        else\n            temp_m = 0\n        end if\n\n        series_sum_result = 0\n        do i = temp_m, n\n            series_sum_result = series_sum_result + s + i * d\n        end do\n\nend function series_sum\n\nend program series_sum_program","position":{"start":{"line":1,"column":1},"end":{"line":38,"column":1}},"key":"RJKlrHtsIe"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"dzPvdJdwQ1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CFxJltJdKm"}],"key":"iF3RlVk9GK"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"L60lxtH9LE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"eLEsXQOPX9"},{"type":"outputs","id":"Sbqc-30bMqYqtNgzrrmbn","children":[],"key":"QaQeguHNvw"}],"identifier":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","html_id":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","key":"DCrmQi7NiU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_3_8_Argument_Passing\"","key":"Q92WB79mEX"},{"type":"outputs","id":"SBObtpS27gPxGAdBT7bcG","children":[],"key":"IXTBVW7E5J"}],"identifier":"bdaf795d-554a-46e6-b4da-faeb331e1b13","html_id":"bdaf795d-554a-46e6-b4da-faeb331e1b13","key":"QRB9XlU9vR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"LSCrAkJPBf"},{"type":"outputs","id":"mplQolXYDYYSH11n205wk","children":[],"key":"I5jXfwlgwG"}],"identifier":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","html_id":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","key":"U72grMtQaM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"hV02N5ec5f"},{"type":"outputs","id":"GUIZBGeQXpl7fVJMos2uy","children":[],"key":"f4OhncYLrV"}],"identifier":"0fbd7621-e800-4235-ab30-80560cc3e1a8","html_id":"0fbd7621-e800-4235-ab30-80560cc3e1a8","key":"XwWnvMJ1Jp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"fpm run 2>/dev/null\")","key":"auqNPEMVib"},{"type":"outputs","id":"zYrudHmBhh3ahHvJE6oU0","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"   94635.0000    \n   94635.0000    \n   94635.0000    \n   94635.0000    \n   94635.0000    \n"},"children":[],"key":"BR9REk69rn"}],"key":"jz3BpHFRBk"}],"identifier":"0483d40b-e849-4574-bcbe-003c81a96dd5","html_id":"0483d40b-e849-4574-bcbe-