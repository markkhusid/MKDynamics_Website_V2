iIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qoC8cla3hc"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"Ww4E5cQ6Kx"},{"type":"text","value":" by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q6CMFpxlcF"}],"key":"MB6hM6g3QY"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"pviRMrePsg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates using linked lists to store strings with a reference counter in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qEty0yqA81"}],"identifier":"program-that-demonstrates-using-linked-lists-to-store-strings-with-a-reference-counter-in-c","label":"Program that demonstrates using linked lists to store strings with a reference counter in C++","html_id":"program-that-demonstrates-using-linked-lists-to-store-strings-with-a-reference-counter-in-c","implicit":true,"key":"dgeuNymesi"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"HOiZrcEnZU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file string6.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ix8HYF1UGV"}],"key":"mHXcXhTvrV"}],"identifier":"17067957","html_id":"17067957","key":"Lroz3nItlI"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  string6.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.10   Strings Using Reference Semantics\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Reference counted my_strings\n#include  <iostream>\n#include  <assert.h>\n#include  <cstring>\n\nusing namespace std;\n\nclass str_obj {\npublic:\n   int    len, ref_cnt;\n   char*  s;\n   str_obj() : len(0), ref_cnt(1)\n      { s = new char[1]; assert(s != 0); s[0] = 0; }\n   str_obj(const char* p) : ref_cnt(1)\n      { len = strlen(p); s = new char[len + 1];\n        assert(s != 0); strcpy(s, p); }\n   ~str_obj() { delete []s; }\n};\n\nclass my_string {\npublic:\n   my_string() { st = new str_obj; assert(st != 0);}\n   my_string(const char* p)\n      { st = new str_obj(p); assert(st != 0);}\n   my_string(const my_string& str)\n       { st = str.st; st -> ref_cnt++; }\n   ~my_string();\n   void  assign(const my_string& str);\n   void  print() const { cout << st -> s; }\nprivate:\n   str_obj*  st;\n};\n\nvoid my_string::assign(const my_string& str)\n{\n   if (str.st != st) {\n      if (--st -> ref_cnt == 0)\n         delete st;\n      st = str.st;\n      st -> ref_cnt++;\n   }\n}\n\nmy_string:: ~my_string()\n{\n   if (--st -> ref_cnt == 0)\n      delete st;\n}\n\nint main()\n{\n   char*   str = \"The wheel that squeaks the loudest\\n\";\n   my_string  a(str), b ;\n\n   b.assign(\"Is the one that gets the grease\\n\");\n   cout << str << endl;\n   a.print();\n   b.print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":71,"column":1}},"key":"mUY9LiqrNd"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"u7PiqjlB9L"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ccfbW9UvJR"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"b1j8rv724R"}],"identifier":"3e111038","html_id":"3e111038","key":"sOCk23O9Pf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fmMRnC9EDL"}],"key":"CanEO5UHJN"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"NjOmKhjLmR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vgNpsRbHUL"},{"type":"outputs","id":"38x4s7U340kGliA1_GESm","children":[],"key":"pa7lxKmCy5"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"K5ql0gvd0m"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_10_Strings_Using_Reference_Semantics\"","key":"Ekw6tpWQ9k"},{"type":"outputs","id":"dWYLMnShxT3rXBpedwk6M","children":[],"key":"bCTwLLJqFQ"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418",