n [0,1) with floor into the inclusive range.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"aPG9iGQRrS"}],"key":"WHg48lW22B"}],"key":"ZStoyF5fX8"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The main loop prints one random integer per line.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dHqsUYb8ac"}],"key":"sjuF9cLltR"}],"key":"ISlo661zq7"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This is the standard way to get discrete uniforms from random_number.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bhQqhbrOsR"}],"key":"OyFAqQEBbo"}],"key":"KEgpv79BuJ"}],"key":"F04TRH0F8J"}],"key":"uHqEGMwsyg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aB2GUVHKb7"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"zVYushG64n"}],"key":"jCgQEsg6nU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"random_integers.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dWha2AoZBS"}],"identifier":"random-integers-f90","label":"random_integers.f90","html_id":"random-integers-f90","implicit":true,"key":"agYlYJT6AW"},{"type":"include","file":"Fortran_Code/Section_Random_Integers/app/random_integers.f90","literal":true,"children":[{"type":"code","value":"program random_integers\n    implicit none\n    integer :: nr_values, lower, upper, i\n\n    call get_values(nr_values, lower, upper)\n    do i = 1, nr_values\n        print '(I0)', random_integer(lower, upper)\n    end do\n\ncontains\n\n    !> @brief copmute a random number in a given range\n    !>\n    !> The function returns a random integer value between a given lower and\n    !> upper limits, inclusively.\n    !>\n    !> @param[in] lower lower value for the random value\n    !> @param[in] upper upper value for the random value\n    !> @returns integer value\n    function random_integer(lower, upper) result(rand_int)\n        implicit none\n        integer, value :: lower, upper\n        integer :: rand_int\n        real :: rand_real\n\n        call random_number(rand_real)\n        rand_int = lower + floor(rand_real*(upper - lower + 1))\n    end function random_integer\n\n    subroutine get_values(nr_values, lower, upper)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer, intent(out) :: nr_values, lower, upper\n\n        if (command_argument_count() /= 3) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: argument nr_values lower upper expected'\n            stop 1\n        end if\n        nr_values = get_integer(1)\n        lower = get_integer(2)\n        upper = get_integer(3)\n        if (lower > upper) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: upper should be larger or equal to lower'\n            stop 3\n        end if\n    end subroutine get_values\n\n    function get_integer(i) result(value)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer, value :: i\n        integer :: value\n        character(len=32) :: buffer\n        integer :: istat\n        character(len=1024) :: msg\n        \n        call get_command_argument(i, buffer)\n        read (buffer, fmt=*, iostat=istat, iomsg=msg) value\n        if (istat /= 0) then\n            write (unit=error_unit, fmt='(2A)') 'error: ', msg\n            stop 2\n        end if\n    end function get_integer\n\nend program random_integers\n","lang":"fortran","filename":"random_integers.f90","key":"wLJnH6HO8y"}],"key":"qNNH7rzTbD"}],"key":"BIc1FoJFGD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L5mWWYZbGF"}],"key":"R6TiTxOwvq"}],"key":"tVnx6hThgp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hNxeOpjG05"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"Q18XaaPywN"}],"key":"QSomsiH7H5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"s0ge2X55OZ"},{"type":"outputs","id":"wdl5lKWztBmVVdB5FNoQM","children":[],"key":"Bg2dj0VBmQ"}],"key":"BTSz4yrixm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Yz4QurPYKh"}],"key":"XQyYLngDTa"}],"key":"jdlLrW5DYJ"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Random_Intege