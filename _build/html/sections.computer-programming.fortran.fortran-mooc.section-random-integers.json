n [0,1) with floor into the inclusive range.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GNoGpbTx5M"}],"key":"VDWwz8EZJp"}],"key":"nQFHDqnHDI"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The main loop prints one random integer per line.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"u8ZMNhjZBw"}],"key":"uAG9Sdyxc7"}],"key":"Os95WPjc6a"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This is the standard way to get discrete uniforms from random_number.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CqfDhlTpfB"}],"key":"IY2so3KD6v"}],"key":"jjCr0v5RLY"}],"key":"MehNKjpcCF"}],"key":"ys2R0wbzS8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pGAq70nWKd"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"ExSP1mguH9"}],"key":"SwKngjpap2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"random_integers.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OYMf8T2tGV"}],"identifier":"random-integers-f90","label":"random_integers.f90","html_id":"random-integers-f90","implicit":true,"key":"bKTRwCXPyS"},{"type":"include","file":"Fortran_Code/Section_Random_Integers/app/random_integers.f90","literal":true,"children":[{"type":"code","value":"program random_integers\n    implicit none\n    integer :: nr_values, lower, upper, i\n\n    call get_values(nr_values, lower, upper)\n    do i = 1, nr_values\n        print '(I0)', random_integer(lower, upper)\n    end do\n\ncontains\n\n    !> @brief copmute a random number in a given range\n    !>\n    !> The function returns a random integer value between a given lower and\n    !> upper limits, inclusively.\n    !>\n    !> @param[in] lower lower value for the random value\n    !> @param[in] upper upper value for the random value\n    !> @returns integer value\n    function random_integer(lower, upper) result(rand_int)\n        implicit none\n        integer, value :: lower, upper\n        integer :: rand_int\n        real :: rand_real\n\n        call random_number(rand_real)\n        rand_int = lower + floor(rand_real*(upper - lower + 1))\n    end function random_integer\n\n    subroutine get_values(nr_values, lower, upper)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer, intent(out) :: nr_values, lower, upper\n\n        if (command_argument_count() /= 3) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: argument nr_values lower upper expected'\n            stop 1\n        end if\n        nr_values = get_integer(1)\n        lower = get_integer(2)\n        upper = get_integer(3)\n        if (lower > upper) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: upper should be larger or equal to lower'\n            stop 3\n        end if\n    end subroutine get_values\n\n    function get_integer(i) result(value)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer, value :: i\n        integer :: value\n        character(len=32) :: buffer\n        integer :: istat\n        character(len=1024) :: msg\n        \n        call get_command_argument(i, buffer)\n        read (buffer, fmt=*, iostat=istat, iomsg=msg) value\n        if (istat /= 0) then\n            write (unit=error_unit, fmt='(2A)') 'error: ', msg\n            stop 2\n        end if\n    end function get_integer\n\nend program random_integers\n","lang":"fortran","filename":"random_integers.f90","key":"W45wY9slT8"}],"key":"QCycYoAyqX"}],"key":"dQk60toAUC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vUteXII5H5"}],"key":"jnKbH4qIS5"}],"key":"ed7IL4tLFU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gqVNT0Jnmn"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"aJnlLq1rlm"}],"key":"DObno8NfcN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"ubC7s9i2xU"},{"type":"outputs","id":"2FnlMdABVx1Ss0ru6AB5S","children":[],"key":"xW4tj3xPZE"}],"key":"v55bjYSELw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JX4Cg5hBbc"}],"key":"qWFVf2Snd2"}],"key":"LJizb6zilm"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Random_Intege