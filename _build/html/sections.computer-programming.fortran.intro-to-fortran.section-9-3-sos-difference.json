ook\n    n = 100\n\n    ! loop from 1 to n\n\n    do i = 1, n\n        ! compute sum of squares\n        SumOfSqrs = SumOfSqrs + i ** 2\n\n        ! compute square of sums\n        SqrOfSums = SqrOfSums + i\n    end do\n\n    ! square the sums\n    SqrOfSums = SqrOfSums ** 2\n\n    ! compute the difference between sum of squares and square of sums  \n    difference = SqrOfSums - SumOfSqrs\n\n    ! display results\n    print *\n    write (*,'(a)') \"Results...\"\n    print *\n    write (*, '(a, i5, a, i10)') \"The square of the sums from 1 to \", n, \" is -> \", SqrOfSums\n    print *\n    write (*, '(a, i5, a, i10)') \"The sum of the squares from 1 to \", n, \" is -> \", SumOfSqrs\n    print *\n    write (*,'(a, i10)') \"The difference between the square of the sums and sum of the squares is -> \", difference\n    print *\nend program SOSdifference\n","lang":"fortran","filename":"section_9_3_sos_difference.f90","key":"N7LLzrAn85"}],"key":"IlpO5qkhqs"}],"identifier":"4357b7cf-9b30-4a74-bea8-726520ec0f9d","html_id":"4357b7cf-9b30-4a74-bea8-726520ec0f9d","key":"SJppdP86vr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following explanation is given by “Code Copilot” within ChatGPT 4.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sMFeScNGnp"}],"key":"W08ghzBtvj"}],"identifier":"63dd9100-dcb1-40b7-a16c-23cfeec208c7","html_id":"63dd9100-dcb1-40b7-a16c-23cfeec208c7","key":"UBfmI8u79j"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The Fortran program ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CJelXZdaZ9"},{"type":"inlineCode","value":"SOSdifference","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WuMMBWYp