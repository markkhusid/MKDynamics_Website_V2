"2024-09-18T05:17:14.662205Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def feature_extractor(data_matrix):\n\n    features = []\n\n    for row in data_matrix:\n        mean_glucose = np.mean(row)\n        std_glucose  = np.std(row)\n        max_glucose  = np.max(row)\n        min_glucose  = np.min(row)\n        \n        first_derivative = compute_first_derivative(row)\n        mean_first_derivate = np.mean(first_derivative)\n\n        if len(row) > 2:\n            second_derivative = compute_second_derivative(row)\n            mean_second_derivative = np.mean(second_derivative)\n        else:\n            mean_second_derivative = 0\n\n        AUC = compute_AUC(row)\n\n        time_to_peak = np.argmax(row)\n\n        features_vector = [\n            mean_glucose,\n            std_glucose,\n            max_glucose,\n            min_glucose,\n            mean_first_derivate,\n            mean_second_derivative,\n            AUC,\n            time_to_peak\n        ]\n\n        features.append(features_vector)\n    \n    return np.array(features)","key":"pfkyJ5tn1j"},{"type":"outputs","id":"f-Oem8G6ijjQ8W6VbH7S4","children":[],"key":"q2mcWx23LI"}],"identifier":"52953dc3-99dd-41ce-8192-fbf03926932c","html_id":"52953dc3-99dd-41ce-8192-fbf03926932c","key":"Xqi30p0WwE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Feature Matrix for Test Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E9HcWRSTFM"}],"identifier":"get-feature-matrix-for-test-data","label":"Get Feature Matrix for Test Data","html_id":"get-feature-matrix-for-test-data","implicit":true,"key":"xN8yDC1N1r"}],"identifier":"7e6fcaf5-1ef6-4765-8696-5a17ae7fc69f","html_id":"7e6fcaf5-1ef6-4765-8696-5a17ae7fc69f","key":"FnBFEHTEfT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","po