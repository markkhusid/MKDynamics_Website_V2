06Z","shell.execute_reply":"2024-09-18T05:17:11.788856Z","shell.execute_reply.started":"2024-09-18T05:17:11.731504Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def compute_second_derivative(glucose_values, delta_t=5):\n    second_derivative = np.zeros(len(glucose_values) - 2)\n    for i in range(1, len(glucose_values) - 1):\n        second_derivative[i - 1] = \\\n            (glucose_values[i + 1] - 2 * glucose_values[i] + glucose_values[i - 1]) / (delta_t ** 2)\n    return second_derivative","key":"FDpJVVrpbf"},{"type":"outputs","id":"TNK1m4mOC4mHwhR_u2Qfa","children":[],"key":"YN5IaYyWSW"}],"identifier":"32daad96-bd53-42bf-87a0-de6b22b7f702","html_id":"32daad96-bd53-42bf-87a0-de6b22b7f702","key":"F47S8LTLn1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-09-18T05:17:12.546418Z","iopub.status.busy":"2024-09-18T05:17:12.526224Z","iopub.status.idle":"2024-09-18T05:17:12.586888Z","shell.execute_reply":"2024-09-18T05:17:12.583654Z","shell.execute_reply.started":"2024-09-18T05:17:12.546349Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"#first_derivative(cleaned_imputed_meal_matrix[0])","key":"bAA7ovVJbA"},{"type":"outputs","id":"9vTsQqS6I0JzQRwvelThZ","children":[],"key":"Co167WBRws"}],"identifier":"546d5147-085c-4134-b65a-505f331678b2","html_id":"546d5147-085c-4134-b65a-505f331678b2","key":"iy92RgMKlw"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-09-18T05:17:12.756118Z","iopub.status.busy":"2024-09-18T05:17:12.755708Z","iopub.status.idle":"2024-09-18T05:17:12.767314Z","shell.execute_reply":"2024-09-18T05:17:12.764652Z","shell.execute_reply.started":"2024-09-18T05:17:12.756079Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"#second_derivative(cleaned_imputed_meal_matrix[0])","key":"McIlwMoFQw"},{"type":"outputs","id":"4CU7bEj70lXX8AhiZ5sI8","children":[],"key":"M8QKTJC8f1"}],"identifier":"1f002e4d-3b17-4f62-bbf9-be359684b52a","html_id":"1f002e4d-3b17-4f62-bbf9-be359684b52a","key":"VyzIAXDg3J"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-09-18T05:17:13.191643Z","iopub.status.busy":"2024-09-18T05:17:13.191132Z","iopub.status.idle":"2024-09-18T05:17:13.270994Z","shell.execute_reply":"2024-09-18T05:17:13.238460Z","shell.execute_reply.started":"2024-09-18T05:17:13.191588Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def compute_AUC(glucose_values, delta_t=5):\n    return simpson(glucose_values, dx=delta_t)","key":"kUtGPJJDig"},{"type":"outputs","id":"P-e9yHFv7bN0u7r7r-vgr","children":[],"key":"qkLzlR1bcZ"}],"identifier":"f746aae3-8f1d-40b5-8dbb-bef552378d59","html_id":"f746aae3-8f1d-40b5-8dbb-bef552378d59","key":"ba6ZYXRJJG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Feature Extractor Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BMZ6PHsfEX"}],"identifier":"define-feature-extractor-function","label":"Define Feature Extractor Function","html_id":"define-feature-extractor-function","implicit":true,"key":"bomrmePacx"}],"identifier":"2c5c581e-dd6d-47b6-934a-eff0c00b5403","html_id":"2c5c581e-dd6d-47b6-934a-eff0c00b5403","key":"SMZ6eGf8QN"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-09-18T05:17:14.662261Z","iopub.status.busy":"2024-09-18T05:17:14.661488Z","iopub.status.idle":"2024-09-18T05:17:14.669730Z","shell.execute_reply":"2024-09-18T05:17:14.668345Z","shell.execute_reply.started":"2024-09-18T05:17:14.662205Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def feature_extractor(data_matrix):\n\n    features = []\n\n    for row in data_matrix:\n        mean_glucose = np.mean(row)\n        std_glucose  = np.std(row)\n        max_glucose  = np.max(row)\n        min_glucose  = np.min(row)\n        \n        first_derivative = compute_first_derivative(row)\n        mean_first_derivate = np.mean(first_derivative)\n\n        if len(row) > 2:\n            second_derivative = compute_second_derivative(row)\n            mean_second_derivative = np.mean(second_derivative)\n        else:\n            mean_second_derivative = 0\n\n        AUC = compute_AUC(row)\n\n        time_to_peak = np.argmax(row)\n\n        features_vector = [\n            mean_glucose,\n            std_glucose,\n            max_glucose,\n            min_glucose,\n            mean_first_derivate,\n            mean_second_derivative,\n            AUC,\n            time_to_peak\n        ]\n\n        features.append(features_vector)\n    \n    return np.array(features)","key":"GnDNn4zOIV"},{"type":"outputs","id":"UZ9Z8vb4w42-pGqdPCFPs","children":[],"key":"dlrPLpzz5v"}],"identifier":"52953dc3-99dd-41ce-8192-fbf03926932c","html_id":"52953dc3-99dd-41ce-8192-fbf03926932c","key":"jbxfaiHLTP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Feature Matrix for Test Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ecGsLtCPIh"}],"identifier":"get-feature-matrix-for-test-data","label":"Get Feature Matrix for Test Data","html_id":"get-feature-matrix-for-test-data","implicit":true,"key":"sSG8nkRfFc"}],"identifier":"7e6fcaf5-1ef6-4765-8696-5a17ae7fc69f","html_id":"7e6fcaf5-1ef6-4765-8696-5a17ae7fc69f","key":"ghtDTFcAVq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-09-18T05:17:16.155636Z","iopub.status.busy":"2024-09-18T05:17:16.155260Z","iopub.status.idle":"2024-09-18T05:17:16.174125Z","shell.execute_reply":"2024-09-18T05:17:16.172474Z","shell.execute_reply.started":"2024-09-18T05:17:16.155597Z"}},"children":[{"type":"code","lang":"python