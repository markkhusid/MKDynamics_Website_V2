{"version":3,"kind":"Article","sha256":"20c00f68c8e812d38dc2e141adf03e5e3e874d6c8d045ccd4afd93453d40d113","slug":"sections.cybersecurity.slae64.modules.module-1.section-12-the-stack.section-12-the-stack","location":"/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","dependencies":[],"frontmatter":{"title":"Section 12 - The Stack","authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","thumbnail":"/build/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","exports":[{"format":"md","filename":"section_12_the_stack.md","url":"/build/section_12_the_stack-467a628dcf5ed00e419687d8a704ef22.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Built with Grok Build","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"QpVBJspbMj"}],"key":"iur1Z7Apwi"}],"key":"CPzd7LnSWg"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"aOLDhOqSza"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"W30ouUZdpa"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"In this section we will be following along with and completing course material from the Pentester Academy’s SecurityTube Linux Assembly language Expert 64 Bit course. As the title suggests, this assignment deals with the stack. The stack is a Last In First Out (LIFO) data structure. It is used extensively in high level programming languages, such as C.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"MN553CAKBw"}],"key":"hb1WuZ3tGS"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The stack is manipulated with the Push and Pop operations. The pointer to the top of the stack in 64 bit Intel based machines is called RSP. The stack grows from high memory to low memory.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Td7fkAxEi4"}],"key":"uZZflHoXJb"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We will write an assembly program that manipulates the stack in 64 bit Intel assembly instructions. This program will be coded, assembled, linked and run. Execution is then to be monitored via GDB. We will use the GEF add-on for GDB to enhance the visual presentation from GDB. We will also use Radare2 to run through the program execution to gain another perspective.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"AMw9T08sdo"}],"key":"ksifrjJvxl"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Project code is contained in my ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"wSZq0bCag1"},{"type":"link","url":"https://github.com/markkhusid/SLAE64","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"GitHub repository","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"WVqtIjTv76"}],"urlSource":"https://github.com/markkhusid/SLAE64","error":true,"key":"KTu0memAIX"},{"type":"text","value":".","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"uVN76mD6eA"}],"key":"h8zwgU0y96"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"GO9fXDzF4N"}],"identifier":"the-program-stack-nasm","label":"The program stack.nasm","html_id":"the-program-stack-nasm","implicit":true,"key":"GwfF3GiICD"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The screenshot below displays the contents of the program stack.nasm.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"MF7noadm5s"}],"key":"fHBOnZRXmK"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","alt":"stack nasm","align":"center","key":"jbNYOYUmzK","urlSource":"images/stack_nasm.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","html_id":"slae-s12-stack-nasm-1","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"vhoa9Op4mE"},{"type":"text","value":"1","key":"hvmzwW65nr"},{"type":"text","value":":","key":"UoJFazghX0"}],"template":"Figure %s:","key":"UkUbfAYDp7"},{"type":"text","value":"stack nasm","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"d0yGhwiJsp"}],"key":"c0hCKxfKo6"}],