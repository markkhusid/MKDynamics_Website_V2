{"version":3,"kind":"Article","sha256":"20c00f68c8e812d38dc2e141adf03e5e3e874d6c8d045ccd4afd93453d40d113","slug":"sections.cybersecurity.slae64.modules.module-1.section-12-the-stack.section-12-the-stack","location":"/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","dependencies":[],"frontmatter":{"title":"Section 12 - The Stack","authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","thumbnail":"/build/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","exports":[{"format":"md","filename":"section_12_the_stack.md","url":"/build/section_12_the_stack-467a628dcf5ed00e419687d8a704ef22.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Built with Grok Build","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"npGOJPEvJB"}],"key":"NqlHKtWYPD"}],"key":"WIOKklP585"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"frLScvMODA"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"toQ5o8eQNX"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"In this section we will be following along with and completing course material from the Pentester Academy’s SecurityTube Linux Assembly language Expert 64 Bit course. As the title suggests, this assignment deals with the stack. The stack is a Last In First Out (LIFO) data structure. It is used extensively in high level programming languages, such as C.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"jhN57dxbFN"}],"key":"xUVe9qBIp3"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The stack is manipulated with the Push and Pop operations. The pointer to the top of the stack in 64 bit Intel based machines is called RSP. The stack grows from high memory to low memory.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"hTohJPAfkk"}],"key":"XSLucHFePx"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We will write an assembly program that manipulates the stack in 64 bit Intel assembly instructions. This program will be coded, assembled, linked and run. Execution is then to be monitored via GDB. We will use the GEF add-on for GDB to enhance the visual presentation from GDB. We will also use Radare2 to run through the program execution to gain another perspective.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"rsVp1CVFqa"}],"key":"ajmxIjOt9M"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Project code is contained in my ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"h5kHn6r12D"},{"type":"link","url":"https://github.com/markkhusid/SLAE64","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"GitHub repository","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"vLQoOnbIIA"}],"urlSource":"https://github.com/markkhusid/SLAE64","error":true,"key":"UNSN7dCCFI"},{"type":"text","value":".","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"AeCjBjtQOg"}],"key":"ZtRb7XOqSX"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"no4CIaxPs0"}],"identifier":"the-program-stack-nasm","label":"The program stack.nasm","html_id":"the-program-stack-nasm","implicit":true,"key":"IC5bFvQmgD"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The screenshot below displays the contents of the program stack.nasm.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"FqFDx6m60S"}],"key":"D5X8Uw7J68"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","alt":"stack nasm","align":"center","key":"AaKpjXHYXM","urlSource":"images/stack_nasm.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","html_id":"slae-s12-stack-nasm-1","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"ZkMqZEenJZ"},{"type":"text","value":"1","key":"OAfGWoLbUJ"},{"type":"text","value":":","key":"j6SFNZDGRy"}],"template":"Figure %s:","key":"WEC8W3SwkV"},{"type":"text","value":"stack nasm","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"m9dO9AKm6W"}],"key":"UicQPxk7oM"}],"key":"ameFDu6z3h"}],"class":"clickable-figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","enumerator":"1","html_id":"slae-s12-stack-nasm-1","key":"yHIdEsn7qk"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"TLM89QfiHZ"}],"key":"kx1I8jokXD"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The program pushes an immediate onto the stack. The immediate is: 0x1122334455667788. It does this by first moving the immediate into RAX and then pushing RAX.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"wxZtPxwn2q"}],"key":"PPvBPLhO5b"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Next it pushes data labled by sample. As shown in the program, this data is:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"NsvrHihMY8"}],"key":"fnO3l1YpjM"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"sample:\tdb 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0x11, 0x22","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"q8OpaaKrdV"}],"key":"HTR4vc8b38"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"First sample is pushed. What this does it push the memory address of sample onto the stack. Then the contents of the memory address labled as sample is pushed onto the stack, as denoted by the brackets (i.e. []) around the label.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"FQxJ3h42mt"}],"key":"SQFYC7YPgy"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Then the contents of the stack is popped off into R15, R14 and RBX. The first item pushed onto the stack is the last item to come out. Therefore, RBX will contain the contents of RAX.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"CM8MYX5Kwm"}],"key":"aVGP3tYZVI"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Finally, the familiar exit syscall is executed to gracefully exit back to the shell.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"OluB2z0tN4"}],"key":"NZNVMgLnJ7"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The program is assembled with:","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"CRVIFbkEoo"}],"key":"EWtIN73VML"},{"type":"code","lang":"bash","value":"$ nasm -felf64 stack.nasm -o stack.o","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"Oso68n60pp"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"And linked with:","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"OI1F7SSIPg"}],"key":"F4vxib3hV8"},{"type":"code","lang":"bash","value":"$ ld stack.o -o stack","position":{"start":{"line":52,"column":1},"end":{"line":54,"column":1}},"key":"T4SzrarjDu"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"We then run the executable and look at it’s objdump. The results of these operations is shown below:","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"f891rKA0Wk"}],"key":"F3kHVirtFY"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/asse