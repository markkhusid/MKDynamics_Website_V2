{"version":3,"kind":"Notebook","sha256":"a77c187d91f37ddcbe2b09579d16808359badfb401ed89ee7966dcf71e667039","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-7-2-overloading-and-function-selection","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_7_2_Overloading_and_Function_Selection.ipynb","dependencies":[],"frontmatter":{"title":"Chapter 7.2: Overloading and Function Selection","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_7_2_Overloading_and_Function_Selection.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_7_2_Overloading_and_Function_Selection.ipynb","exports":[{"format":"ipynb","filename":"Chapter_7_2_Overloading_and_Function_Selection.ipynb","url":"/build/Chapter_7_2_Overload-ae0a5873cf09cfcd9394a1500ddac042.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q8T7RkSntn"}],"key":"Qy4Xe2dljV"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"zyosd9KJSc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloaded functions selection in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bqjzCL3wV1"}],"identifier":"program-that-demonstrates-overloaded-functions-selection-in-c","label":"Program that demonstrates overloaded functions selection in C++","html_id":"program-that-demonstrates-overloaded-functions-selection-in-c","implicit":true,"key":"P2mXorTiU6"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"cnPC1y8jrQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file rational.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JtdeWbukEb"}],"key":"i5O6lheolj"}],"identifier":"17067957","html_id":"17067957","key":"KiJ8nCp4JJ"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  rational.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.3    Overloading and Function Selection\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Overloading functions\n#include  <iostream>       // Changed iostream.h to iostream.  MK.\n\nusing namespace std;       // Added. MK.\n\nclass rational{\npublic:\n   rational(int n = 0) : a(n),q(1){}\n   rational(int i, int j) : a(i), q(j){}\n   rational(double r) : q(BIG), a(r * BIG){}\n   void  print() const { cout << a << \" / \" << q ; }\n   operator double(){return static_cast<double>(a)/q;}\n   friend ostream& operator<<(ostream& out, rational x);\n   friend istream& operator>>(istream& in, rational& x);\nprivate:\n   long  a, q;\n   enum {BIG = 100};\n};\n\nostream& operator<<(ostream& out, rational x)\n{\n    return (out << x.a << \" / \" << x.q << '\\t');\n}\n\n\nistream& operator>>(istream& in, rational& x)\n{\n   return (in >> x.a >> x.q);\n}\n\n// Changed greater to is_greater since greater\n// interferes with std::greater and compiler complains.\ninline int      is_greater(int i, int j)\n      { return ( i > j ? i : j); }\ninline double   is_greater(double x, double y)\n      { return ( x > y ? x : y); }\ninline rational is_greater(rational w, rational z)\n      { return ( w > z ? w : z); }\n\nint main()\n{\n   int     i = 10, j = 5;\n   float   x = 7.0;\n   double  y = 14.5;\n   rational w(10), z(3.5), zmax;\n\n   cout << \"\\ngreater(\" << i << \", \" << j << \") = \"\n        << is_greater(i, j);\n   cout << \"\\ngreater(\" << x << \", \" << y << \") = \"\n        << is_greater(x, y);\n   cout << \"\\ngreater(\" << i << \", \" ;\n   z.print();\n   cout << \") = \"\n        << is_greater(static_cast<rational>(i), z);\n   zmax = is_greater(w, z);\n   cout << \"\\ngreater(\";\n   w.print();\n   cout << \", \";\n   z.print();\n   cout << \") = \";\n   zmax.print();\n   // Commented code below.  MK.\n   //cout << \"\\nEnter two longs for rational: \";\n   cout << endl;\n   cout << \"Testing overloaded stream operation on rational class...\" << endl;\n   cin >> w;\n   cout << w << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":80,"column":1}},"key":"Mzk2WHQI4K"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"KGkyWwVCz2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kowaQbLTFy"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"yvZk8lACnn"}],"identifier":"3e111038","html_id":"3e111038","key":"audFsT2irg"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bJx94iw4Ec"}],"key":"kkPhAuaIx5"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"hHIPNOKwn9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"anXos89gLc"},{"type":"outputs","id":"ngmJWeatxDA-v1bGqYg89","children":[],"key":"XcDgNoeT9S"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"X4pHKT7Gdy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_2_Overloading_and_Function_Selection\"","key":"Jx8Xn0CyNp"},{"type":"outputs","id":"C1GsLWv4_JZ2wa2PrRxjJ","children":[],"key":"zW1EUh4kfL"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"sV6fOykyoe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"GWIVcibxmn"},{"type":"outputs","id":"dCtupJ3LRsx6rv9_dFxb_","children":[],"key":"tdcR0QSG9i"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"fvUTJrFpiX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ rational.cpp -w -o rational\")","key":"Ym8iIq9SWV"},{"type":"outputs","id":"KXUF_VOjqdIfJnicmRM-e","children":[],"key":"udx1lnV0en"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"gOTDE0XIZ9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xbUclFe4dE"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"BkxmUVKwCp"}],"identifier":"999f33dc","html_id":"999f33dc","key":"qvkcgZqI2F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"echo \\\"123 456\\\" | ./rational\")","key":"c8ZBbSKYs3"},{"type":"outputs","id":"cLtF8ntGL0zKbQUZ1viAd","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\ngreater(10, 5) = 10\ngreater(7, 14.5) = 14.5\ngreater(10, 350 / 100) = 10 / 1\t\ngreater(10 / 1, 350 / 100) = 10 / 1\nTesting overloaded stream operation on rational class...\n123 / 456\t\n"},"children":[],"key":"miB7vmQ7Lt"}],"key":"ROfT8W94c5"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"EhFuWPOXzK"}],"key":"MFEcRWF6Vg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chapter 7.1: ADT Conversions","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-7-1-adt-conversions","group":"Computer Programming"},"next":{"title":"Chapter 7.3: Friend Functions","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-7-3-friend-functions","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}