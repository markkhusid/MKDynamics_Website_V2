{"version":3,"kind":"Article","sha256":"b8abeff60786ee07993f4d517e8011d8067931335f29f1afb90b3228875d3dc7","slug":"sections.mcs-projects.cse572-data-mining.projects.project-1.project-1","location":"/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_1/Project_1.md","dependencies":[],"frontmatter":{"title":"CSE572 Data Mining - Project 1 - Extracting Time Series Properties of Glucose Levels","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_1/Project_1.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE572_Data_Mining/Projects/Project_1/Project_1.md","thumbnail":"/build/CSE572_Project_1-dd92aa0f92bd2891c9bf1fde177fde03.png","exports":[{"format":"md","filename":"Project_1.md","url":"/build/Project_1-0408a10075f364a12113c44e38c33c4a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TSgafGeM9s"}],"key":"qaka2PPg6Y"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Problem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EfuzDgNzDK"}],"identifier":"problem","label":"Problem","html_id":"problem","implicit":true,"key":"nck2E16cZa"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The pump log and the continuous glucose monitor log were recorded on separate clocks and stored newest-first. Both files carried columns that were unused for this question, and the glucose series had missing samples. The project asked for the share of time spent in each glucose range, split by pump mode and by time of day.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Uw32Qa16cr"}],"key":"UIJLRo201c"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Approach","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"O3orVjp9aM"}],"identifier":"approach","label":"Approach","html_id":"approach","implicit":true,"key":"iXrsCIyY3D"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Each log was reversed into chronological order and reduced to the columns needed for alignment: date, time, and the glucose reading on the sensor side, and date, time, and the alarm field on the pump side. A single datetime column was built on each frame so the two series could be compared.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"ceobXIYJB6"}],"key":"uXBYLfmcTu"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Auto mode begins at the pump alarm that reports auto mode active, and the pump stays there until a reset. That timestamp was matched to the nearest later sensor sample, and every sensor row was labeled manual or auto. With a reading every five minutes, a full day is 288 samples. Day numbers were counted in 24-hour blocks from the first sample, which covered 203 days. Hours from midnight to 6 AM were labeled overnight, and 6 AM to midnight were labeled daytime.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"UcnfbN0Gky"}],"key":"sdx1mxNPM1"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Missing glucose values were filled with linear interpolation, on the assumption that glucose moves smoothly between neighboring readings. Each sample was then placed in one of six ranges: hyperglycemia critical, hyperglycemia, normal, secondary, hypoglycemia level 1, and hypoglycemia level 2. Those six ranges, the two modes, and the three dayparts (overnight, daytime, and the whole day) give 36 percentages. Each percentage is a count of matching samples in a day, divided by 288, then averaged across days.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"tQKz8nlwuL"}],"key":"y9ITp8ziBL"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Result","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"L4UshcgJMH"}],"identifier":"result","label":"Result","html_id":"result","implicit":true,"key":"QjD8Cx2kE9"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"In auto mode the person spent most of the recorded time in the normal range or the secondary range. The manual-mode percentages were not interpretable. The manual-mode record was too sparse for those fractions to describe a real day.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"c918LGhYDA"}],"key":"sZeP4KPmhC"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Notebook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"jpQ6jaqzT2"}],"identifier":"notebook","label":"Notebook","html_id":"notebook","implicit":true,"key":"NcVjMF0Cte"},{"type":"grid","columns":[1,1,1,1],"children":[{"type":"card","url":"/sections/mcs-projects/cse572-data-mining/projects/project-1/project-1-submission","children":[{"type":"header","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"CSE572 Data Mining - Project 1 - Submission Notebook","key":"mGlJRGuhMx"}],"key":"VnxkW5ivcP"}],"key":"z8rFEMGckV"},{"type":"image","url":"/build/CSE572_Project_1-dd92aa0f92bd2891c9bf1fde177fde03.png","height":"200","align":"center","key":"eF1AqXqwLi","urlSource":"../../images/CSE572_Project_1.png"}],"urlSource":"Project_1_Submission.ipynb","dataUrl":"/sections.mcs-projects.cse572-data-mining.projects.project-1.project-1-submission.json","internal":true,"protocol":"file","key":"oZNxr38vR6"}],"key":"cgA4k7uZz5"}],"key":"iF05ryldDu"}],"key":"EeoaH2phwR"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE572 Data Mining","url":"/sections/mcs-projects/cse572-data-mining/cse572-data-mining-head","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"Project 1","url":"/sections/mcs-projects/cse572-data-mining/projects/project-1/project-1-submission","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"http://localhost:3000"}