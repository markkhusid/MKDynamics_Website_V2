    implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        integer :: i\n\n        if (size(matrix, 1) /= size(matrix, 2)) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: can not compute trace of a non-square matrix'\n            stop 1\n        end if\n        trace = 0.0\n        do i = 1, size(matrix, 1)\n            trace = trace + matrix(i, i)\n        end do\n    end function trace\n\nend program compute_trace","position":{"start":{"line":1,"column":1},"end":{"line":33,"column":1}},"key":"uuFXEzhJEn"}],"key":"AK75kmRvzG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SL0sGeUd6c"}],"key":"udW8ZzLsdv"}],"key":"doqe9JzDnf"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yPkcehfdSV"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"Z2gxTJDtzD"}],"visibility":"show","key":"mP8lDFIvOR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vk6ZB9oAXq"},{"type":"outputs","id":"Kfjok-EBAAAHK8FkUfN6G","children":[],"key":"pt5as8m3P2"}],"key":"RUMc7YmKbj"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"co