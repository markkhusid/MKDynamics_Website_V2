:1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EPZK8TSNrU"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"Y5BM0BGdOo"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BCDZM2HDKk"}],"key":"E0JKMTiPnO"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"vbIsAzsOOM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates bit field manipulation in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q1sv9YLyie"}],"identifier":"program-that-demonstrates-bit-field-manipulation-in-c","label":"Program that demonstrates bit field manipulation in C++","html_id":"program-that-demonstrates-bit-field-manipulation-in-c","implicit":true,"key":"PmwJSSW36W"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"KBfXA1aQ4Y"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"#include <iostream>\n\nusing namespace std;\n\nstruct word {\n    unsigned    w0:1, w1:1, w2:1, w3:1, w4:1, w5:1, w6:1, w7:1,\n                w8:1, w9:1, w10:1, w11:1, w12:1, w13:1, w14:1, w15:1,\n                w16:1, w17:1, w18:1, w19:1, w20:1, w21:1, w22:1, w23:1, \n                w24:1, w25:1, w26:1, w27:1, w28:1, w29:1, w30:1, w31:1;\n};\n\nunion set {\n    word        m;\n    unsigned    u;\n};\n\nint main()\n{\n    set x, y;\n\n    x.u = 0x0f100f10;\n    y.u = 0x01a1a0a1;\n    x.u = x.u | y.u;    // set union\n\n    cout    << \"\\nelement 9 = \" \n            << ((x.m.w9) ? \"true\" : \"false\") << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"ADGSPBjwYq"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"HjlnSK83Gp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cZlloDXZIM"}],"key":"OZGkvlScbN"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"Z9AjWdrrSL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"d5ETVA7Xnh"},{"type":"outputs","id":"kuZw2I5FxgFCQNL9atpKp","children":[],"key":"o39ykxNz4Y"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"vunp13iMax"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_7_Bit_Fields\"","key":"Cdwsw8cY4w"},{"type":"outputs","id":"-qoJ4HmOdNmNOj97vmAD0","children":[],"key":"uVdb1GuQBc"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"awQGwhLrmt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"KO4kP4UfrQ"},{"type":"outputs","id":"mYMEChaYqCJ5okjhoxHZk","children":[],"key":"LImb9J5jlr"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","h