:1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aLwmaysuj8"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"dvqOgm5VdW"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wWsIzimsSo"}],"key":"fTTkVtftZH"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"JEsGKGHpmH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates bit field manipulation in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vCey5f3gAJ"}],"identifier":"program-that-demonstrates-bit-field-manipulation-in-c","label":"Program that demonstrates bit field manipulation in C++","html_id":"program-that-demonstrates-bit-field-manipulation-in-c","implicit":true,"key":"UunBkpYaaK"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"UzgWR00136"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"#include <iostream>\n\nusing namespace std;\n\nstruct word {\n    unsigned    w0:1, w1:1, w2:1, w3:1, w4:1, w5:1, w6:1, w7:1,\n                w8:1, w9:1, w10:1, w11:1, w12:1, w13:1, w14:1, w15:1,\n                w16:1, w17:1, w18:1, w19:1, w20:1, w21:1, w22:1, w23:1, \n                w24:1, w25:1, w26:1, w27:1, w28:1, w29:1, w30:1, w31:1;\n};\n\nunion set {\n    word        m;\n    unsigned    u;\n};\n\nint main()\n{\n    set x, y;\n\n    x.u = 0x0f100f10;\n    y.u = 0x01a1a0a1;\n    x.u = x.u | y.u;    // set union\n\n    cout    << \"\\nelement 9 = \" \n            << ((x.m.w9) ? \"true\" : \"false\") << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"DfzyykFbM0"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"upngzQdD36"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KDYHzT0hzH"}],"key":"QENLzK1zD5"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"dXMbFYxBPs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"txUq9KyS3P"},{"type":"outputs","id":"UyoqNDN1tfDdoLem1rwxb","children":[],"key":"cM3M7VcKXF"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"WYvbR5ekfa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_7_Bit_Fields\"","key":"yYQbtkHZfp"},{"type":"outputs","id":"0f3yLZ4kbixFghgh73Z6A","children":[],"key":"Ug4UPN1o4r"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"AbNh8uiBPY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"n5eA1hgoV7"},{"type":"outputs","id":"_Lhk0F8IKf9qYJ6MbKkLA","children":[],"key":"pjB9hsmle3"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","h