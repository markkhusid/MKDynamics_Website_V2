-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"twFm08IDTw"},{"type":"outputs","id":"r7L2RXGBZoEkPA9AwaEfB","children":[],"key":"fZiZnLDkgw"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"XdkgimgJGJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_7_Bit_Fields\"","key":"kkTDCeYk0q"},{"type":"outputs","id":"Z96pUE5ge32Z5ORy1Fhlt","children":[],"key":"LswfOGWy01"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"NGtWGeNjbO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"PCSg558sp3"},{"type":"outputs","id":"tqWTYsxL4HvusGldtYq-S","children":[],"key":"PbSvoegHB9"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"I1tFx6sND7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ set.cpp -w -o set\")","key":"BLLtVLiof3"},{"type":"outputs","id":"ubI8RV1-_YYo325r2PGpE","children":[],"key":"BiOBH4IR1e"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"hDY61KgiWX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./set\")","key":"lVxNwLJZ95"},{"type":"outputs","id":"9uvh2u3Wzo7JsmYkD1s7C","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nelement 9 = true\n"},"children":[],"key":"JOoogjLCif"}],"key":"m0gdhKBoR1"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"pzGoLWIDub"}],"key":"xwAkSnHEvC"},"re