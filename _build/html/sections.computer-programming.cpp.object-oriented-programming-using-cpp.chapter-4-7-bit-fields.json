igned    u;\n};\n\nint main()\n{\n    set x, y;\n\n    x.u = 0x0f100f10;\n    y.u = 0x01a1a0a1;\n    x.u = x.u | y.u;    // set union\n\n    cout    << \"\\nelement 9 = \" \n            << ((x.m.w9) ? \"true\" : \"false\") << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"Ecu97o3Qwd"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"xsbsLsdzpz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J44UN9odKJ"}],"key":"YdT8anP45L"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"prJDWedAHH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"qg8UWJenZe"},{"type":"outputs","id":"9OTI2ksN8-wAkmF_nbfy5","children":[],"key":"HU91j7fAA8"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"LlLZQBcGLx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_7_Bit_Fields\"","key":"woZOxu6hbb"},{"type":"outputs","id":"OZ0pEUs_TOjuCPNHMod7O","children":[],"key":"jhGBZ2zulZ"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"HewGfrsjhN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"ZO121Vi9nF"},{"type":"outputs","id":"UETT3FW3YoMWDl2P68OpC","children":[],"key":"CLkLpitFI5"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":