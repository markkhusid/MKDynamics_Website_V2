igned    u;\n};\n\nint main()\n{\n    set x, y;\n\n    x.u = 0x0f100f10;\n    y.u = 0x01a1a0a1;\n    x.u = x.u | y.u;    // set union\n\n    cout    << \"\\nelement 9 = \" \n            << ((x.m.w9) ? \"true\" : \"false\") << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"PZwrdOgzt2"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"tyZJ043aA7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k1JXSA9h4h"}],"key":"fUpgFzPD5x"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"t0BNvIO1Er"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"bMg28dDpXU"},{"type":"outputs","id":"Xc2Tg0KvAXLRcr5flfc4O","children":[],"key":"zluV1diXkd"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"tHdO7vRdAg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_7_Bit_Fields\"","key":"Cbnfxu28Nb"},{"type":"outputs","id":"f2oSfmeOb2E1tmHX7KGl7","children":[],"key":"t3azPnWija"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"PkzGQYsEYg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"aMVy2EmTxI"},{"type":"outputs","id":"KC0zIm6LzANwHRkXnUTIb","children":[],"key":"xUY1XQ3CaP"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":