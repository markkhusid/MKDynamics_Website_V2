forms are mapped to [-1,1]^2 and rejected outside the unit disk.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"MdMsMKsYOI"}],"key":"FY8yYPjcfX"}],"key":"EMxUan4jHG"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Box–Muller factor scales the coordinates.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xT4oIPFbLU"}],"key":"fpg6NoEzRK"}],"key":"vnBpPTznkP"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"One sample is returned and the other stored for the next call.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"i5KuJR7orF"}],"key":"cV03NtpFub"}],"key":"DlSGcK6I96"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The driver prints 1000 values for statistical checks or plotting.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"d03q9U3Tn9"}],"key":"QTXGHEk4pZ"}],"key":"yiUFZaVdxK"}],"key":"VoEImgE1Oh"}],"key":"L7JSIZJ5zM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BrgRWMV6AV"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"kKv9CUERay"}],"key":"exHBjSTpZ8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"exp_distr.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cKTSotb4j1"}],"identifier":"exp-distr-f90","label":"exp_distr.f90","html_id":"exp-distr-f90","implicit":true,"key":"JZM0vK7Srv"},{"type":"include","file":"Fortran_Code/Section_Exp_Distr/app/exp_distr.f90","literal":true,"children":[{"type":"code","value":"program exp_distr_program\n    implicit none\n    integer, parameter :: NR_VALUES = 1000\n    integer :: i\n\n    do i = 1, NR_VALUES\n        print *, get_exp_rand()\n    end do\n\ncontains\n\n    function get_exp_rand() result(val)\n        implicit none\n        real :: val\n        real, save :: next_val\n        logical, save :: is_next_set = .false.\n        real :: x, y, radius, factor\n\n        if (is_next_set) then\n            is_next_set = .false.\n            val = next_val\n        else\n            do while (.not. is_next_set)\n                call random_number(x) \n                call random_number(y) \n                x = 2.0*x - 1.0\n                y = 2.0*y - 1.0\n                radius = x**2 + y**2\n                if (0.0 < radius .and. radius <= 1.0) exit\n            end do\n            factor = sqrt(-2.0*log(radius)/radius)\n            val = x*factor\n            next_val =y*factor\n            is_next_set = .true.\n        end if\n    end function get_exp_rand\n\nend program exp_distr_program\n","lang":"fortran","filename":"exp_distr.f90","key":"FPp2Gu9mpe"}],"key":"Df93jHzhuU"}],"key":"dp9bmUwK0J"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UKQRo482B7"}],"key":"fAXTs3ooxm"}],"key":"L9Z5vnSjtX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"chi