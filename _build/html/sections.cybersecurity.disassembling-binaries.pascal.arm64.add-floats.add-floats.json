x1, [x0]                                   // Store the bits of 5.6 at b.\n\tc := a + b;\n   3c: 90000000 adrp x0, 0 <main>                               // Page of a, for the load.\n   40: 91000000 add x0, x0, #0x0                                // Low 12 bits of a.\n   44: fc400001 ldur d1, [x0]                                   // d1 = a.\n   48: 90000000 adrp x0, 0 <main>                               // Page of b, for the load.\n   4c: 91000000 add x0, x0, #0x0                                // Low 12 bits of b.\n   50: fc400000 ldur d0, [x0]                                   // d0 = b.\n   54: 1e602820 fadd d0, d1, d0                                 // d0 = a + b. fadd adds two doubles.\n   58: 90000000 adrp x0, 0 <main>                               // Page of c. The relocation is to .bss+0x10.\n   5c: 91000000 add x0, x0, #0x0                                // Low 12 bits of c.\n   60: fc000000 stur d0, [x0]                                   // c = a + b.\nEND.\n   64: 94000000 bl 0 <FPC_DO_EXIT>                              // Call FPC_DO_EXIT.\n   68: a8c17bfd ldp x29, x30, [sp], #16                         // Restore the frame pointer and the return address.\n   6c: d65f03c0 ret                                             // Return.","position":{"start":{"line":30,"column":1},"end":{"line":70,"column":1}},"key":"UTyHhW1SEs"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"The two constants are IEEE-754 doubles. 3.3 and 5.6 are rounded to the values these bytes store, little-endian:","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"b5M8rzFyye"}],"key":"DKquuqyJdR"},{"type":"code","lang":"text","value":"_$ADD_FLOATS$_Ld1  66 66 66 66 66 66 0a 40    3.3\n_$ADD_FLOATS$_Ld2  66 66 66 66 66 66 16 40    5.6","position":{"start":{"line":74,"column":1},"end":{"line":77,"column":1}},"key":"PtIA2Ezfio"},{"type":"paragraph","position":{"start":{"line":79,"c