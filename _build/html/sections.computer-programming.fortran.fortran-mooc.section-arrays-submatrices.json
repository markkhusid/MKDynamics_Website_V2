rtran-MOOC/tree/master/source_code/arrays","error":true,"key":"UbZh526AGp"}],"key":"im9uvtbstY"}],"key":"cIOVo9Lb7P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates matrix slicing in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QRglULwTF2"}],"identifier":"this-program-demonstrates-matrix-slicing-in-fortran","label":"This program demonstrates matrix slicing in Fortran.","html_id":"this-program-demonstrates-matrix-slicing-in-fortran","implicit":true,"key":"IN81gp8xPl"}],"key":"DY1Qgbyj7o"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program submatrices\n  implicit none\n  integer, dimension(3, 4) :: A\n  integer, dimension(12)   :: A_array\n  integer :: i, j\n\n  A_array = [ (((i - 1)*size(A, 2) + j, &\n                   j=1, size(A, 2)), &\n                   i=1, size(A, 1)) ]\n\n  A = reshape([ (((i - 1)*size(A, 2) + j, &\n                   j=1, size(A, 2)), &\n                   i=1, size(A, 1)) ], &\n              shape(A))\n              \n  \n  print *, \"A_array contains: \", A_array\n\n  print *, \"A matrix contains: \"\n  \n  do i = 1, size(A, 1)\n    print *, A(i, :)\n  end do\n\n  print *\n  print *, \"Row 2 contains: \"\n  print *, A(2, :)\n  print *, \"Column 3 contains: \"\n  print *, A(:, 3)\n  print '(A, I0)', 'rank = ', rank(A(2, :))\n  print '(A, I0)', 'shape = ', shape(A(2, :))\nend program submatrices","position":{"start":{"line":1,"column":1},"end":{"line":34,"column":1}},"key":"t728buRMf0"}],"key":"mERnJ0EG1L"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"l