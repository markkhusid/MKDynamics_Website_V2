:"Procedure pointers allow calling each algorithm uniformly.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Rc2bmP2h6D"}],"key":"W9nItoF1St"}],"key":"Twam125Yej"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each n, every algorithm result is printed in a table.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"gE9MqND2Qr"}],"key":"p8mexgQDcr"}],"key":"Hdmogy9PZT"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Agreement across methods is a sanity check before larger benchmarks.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"mybqWRBA6T"}],"key":"WpAAmxuTDS"}],"key":"xdyRhVXhz0"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Naive recursion is fine for small n only.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"TGkjtvtybv"}],"key":"fRnltnxbrj"}],"key":"q4682Spxbv"}],"key":"BHM3wJqfHj"}],"key":"eOesYqV9NA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VHKDU9Vx1Q"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"oxlnFlXUHy"}],"key":"pEc9uBK7Ke"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"fibonacci_verify.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vgvIb1F6Gj"}],"identifier":"fibonacci-verify-f90","label":"fibonacci_verify.f90","html_id":"fibonacci-verify-f90","implicit":true,"key":"UosgJ0oTvt"},{"type":"include","file":"Fortran_Code/Section_Fibonacci_Verify/app/fibonacci_verify.f90","literal":true,"children":[{"type":"code","value":"program fibonacci_test\n    use, intrinsic :: iso_fortran_env, only : I8 => INT64, output_unit\n    use :: fib_mod\n    implicit none\n    integer(kind=I8), parameter :: n_max = 15\n    integer(kind=I8) :: n, func_nr\n    type :: func_t\n        procedure(fib_func_t), nopass, pointer :: func => null()\n    end type\n    interface\n        function fib_func_t(n) result(fib)\n            use, intrinsic :: iso_fortran_env, only : I8 => INT64\n            implicit none\n            integer(kind=I8), value :: n\n            integer(kind=I8) :: fib\n        end function fib_func_t\n    end interface\n    integer, parameter :: nr_functions = 5\n    type(func_t), dimension(nr_functions) :: functions\n    character(len=15), dimension(nr_functions) :: names = [ &\n            '      recursive', &\n            '     skip ahead', &\n            '       memoized', &\n            '      iterative', &\n            '    closed form'  &\n        ]\n\n    functions(1)%func => fib_recursive\n    functions(2)%func => fib_skip_ahead\n    functions(3)%func => fib_memoization\n    functions(4)%func => fib_iterative\n    functions(5)%func => fib_closed_form\n\n    print '(A)', 'sanity check:'\n    print '(6A15)', 'n', names\n    do n = 0, n_max\n        write (unit=output_unit, fmt='(I15)', advance='no') n\n        do func_nr = 1, nr_functions\n            write (unit=output_unit, fmt='(I15)', advance='no') &\n                functions(func_nr)%func(n)\n        end do\n        print '(A)', ''\n    end do\n\n    print '(A)', 'check for closed form:'\n    n = 0\n    do while (fib_memoization(n) == fib_closed_form(n))\n        n = n + 1\n    end do\n    print '(A, I0)', 'closed form breaks for ', n\n\nend program fibonacci_test\n","lang":"fortran","filename":"fibonacci_verify.f90","key":"bW7G180CwX"}],"key":"sFOqcLM0zA"}],"key":"GuRn2boczm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"fib_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WBRi9meQRx"},{"type":"text","value":" (module)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pNyv6glWHM"}],"identifier":"fib-mod-f90-module","label":"fib_mod.f90 (module)","html_id":"fib-mod-f90-module","implicit":true,"key":"PSYcjg70lL"},{"type":"include","file":"Fortran_Code/Section_Fibonacci_Verify/src/fib_mod.f90","literal":true,"children":[{"type":"code","value":"module fib_mod\n    use, intrinsic :: iso_fortran_env, only : I8 => INT64, DP => REAL64\n    implicit none\n\n    private\n    public :: fib_recursive, fib_skip_ahead, fib_memoization, &\n        fib_iterative, fib_closed_form\n\ncontains\n\n    recursive function fib_recursive(n) result(fib)\n        implicit none\n        integer(Kind=I8), value :: n\n        integer(kind=I8) :: fib\n\n        if (n == 0_I8) then\n            fib = 0_I8\n        else if (n == 1_I8) then\n            fib = 1_I8\n        else\n            fib = fib_recursive(n - 1_I8) + fib_recursive(n - 2_I8)\n        end if\n    end function fib_recursive\n\n    recursive function fib_skip_ahead(n) result(fib)\n        implicit none\n        integer(kind=I8), value :: n\n        integer(kind=I8) :: fib\n        if (n == 0_I8) then\n            fib = 0_I8\n        else if (n == 1_I8 .or. n == 2_I8) then\n            fib = 1_I8\n        else if (mod(n, 2_I8) == 0) then\n            fib = fib_skip_ahead(n/2_I8)*(fib_skip_ahead(n/2_I8 + 1_I8) + &\n                                          fib_skip_ahead(n/2_I8 - 1_I8))\n        else\n            fib = fib_skip_ahead(n/2_I8 + 1_I8)**2 + fib_skip_ahead(n/2_I8)**2\n        end if\n    end function fib_skip_ahead\n\n    recursive function fib_memoization(n) result(fib)\n        implicit none\n        integer(kind=I8), value :: n\n        integer(kind=I8) :: fib\n        integer(kind=I8), parameter :: buffer_size = 1000000\n        integer(kind=I8), dimension(0:buffer_size), save :: buffer = -1_I8\n\n        buffer(0) = 0_I8\n        buffer(1) = 1_I8\n        if (n <= buffer_size) then\n            if (buffer(n) == -1_I8) then\n                buffer(n) = fib_memoization(n - 1_I8) + fib_memoization(n - 2_I8)\n            end if\n            fib = buffer(n)\n        else\n            fib = fib_memoization(n - 1_I8) + fib_memoization(n - 2_I8)\n        end if\n    end function fib_memoization\n\n    function fib_iterative(n) result(fib)\n        implicit none\n        integer(kind=I8), value :: n\n        integer(kind=I8) :: fib\n        integer(kind=I8) :: fib_n_1, i, tmp\n\n        if (n == 0_I8) then\n            fib = 0_I8\n        else\n            fib_n_1 = 0_I8\n            fib = 1_I8\n            do i = 2_I8, n\n                tmp = fib\n                fib = fib + fib_n_1\n                fib_n_1 = tmp\n            end do\n        end if\n    end function fib_iterative\n\n    function fib_closed_form(n) result(fib)\n        implicit none\n        integer(kind=I8), value :: n\n        integer(kind=I8) :: fib\n        real(kind=DP) :: alpha = (1.0_DP + sqrt(5.0_DP))/2.0_DP, &\n                         beta  = (1.0_DP - sqrt(5.0_DP))/2.0_DP, &\n                         pre_factor = 1.0_DP/sqrt(5.0_DP)\n\n        fib = nint(pre_factor*(alpha**n - beta**n), kind=I8)\n    end function fib_closed_form\n\nend module fib_mod\n","lang":"fortran","filename":"fib_mod.f90","key":"ImdiBUaVHy"}],"key":"CASduRfQc2"}],"key":"R8Mjj3ICGO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,