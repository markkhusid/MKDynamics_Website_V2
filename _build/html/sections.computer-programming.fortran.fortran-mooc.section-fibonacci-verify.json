      13            233            233            233            233            233\n             14            377            377            377            377            377\n             15            610            610            610            610            610\ncheck for closed form:\nclosed form breaks for 76\n"},"children":[],"key":"vkBrJAqYy5"}],"key":"U3nwIlj9n5"}],"key":"Rb65aHoH9h"}],"key":"WxY2pPoq8e"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Section: Primes","url":"/sections/computer-programming/fortran/fortran-mooc/section-primes","group":"Computer Programming"},"next":{"title":"Section: Kaprekar’s Routine","url":"/sections/computer-programming/fortran/fortran-mooc/section-kaprekar","group":"Computer Programming"}}},"domain":"http://localhost:3000"}