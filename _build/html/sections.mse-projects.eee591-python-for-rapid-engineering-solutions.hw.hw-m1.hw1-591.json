 — first 64 magnitude bins","html_id":"optional-plot-first-64-magnitude-bins","implicit":true,"key":"bX1vUxmEnN"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A quick visual check that all three methods overlie each other (they should look identical at this scale).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a4OmFMlP2J"}],"key":"BuQPBREgWk"}],"key":"Ozh9WlIrpU"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:23:17.827783Z","iopub.status.busy":"2026-07-25T16:23:17.787612Z","iopub.status.idle":"2026-07-25T16:23:18.740621Z","shell.execute_reply":"2026-07-25T16:23:18.723894Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nbins = np.arange(min(64, N))\nplt.figure(figsize=(9, 4))\nplt.plot(bins, x_freq_fft_mag[bins], 'k-', linewidth=2, label='FFT')\nplt.plot(bins, x_freq_loops_mag[bins], 'r--', alpha=0.8, label='Loops')\nplt.plot(bins, x_freq_matrix_mag[bins], 'b:', alpha=0.8, label='Matrix')\nplt.xlabel('Frequency bin k')\nplt.ylabel('|X[k]|')\nplt.title('DFT magnitude comparison (first bins)')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()\n","key":"EOZZmZliRO"},{"type":"outputs","id":"mHNBM4UbCVqqGNv23X0AQ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"1ca7a0ba3d010eb764b5bf9f9c24d83a","path":"/build/1ca7a0ba3d010eb764b5bf9f9c24d83a.png"},"text/plain":{"content":"<Figure size 900x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"KB6ToBoazk"}],"key":"lU7NsxBCvW"}],"key":"OzsUArm6oJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Takeaways","position":{"start":{"line