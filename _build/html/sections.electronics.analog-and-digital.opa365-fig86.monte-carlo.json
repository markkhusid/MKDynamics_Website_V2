":"code","lang":"python","executable":true,"value":"# MC histograms with WC (red --) and RSS (green -.) overlays\nfig, axes = plt.subplots(1, 2, figsize=(11, 4.2))\n\n# --- fc ---\nax = axes[0]\nax.hist(mc.frame[\"fc_hz\"].dropna(), bins=40, color=\"C0\", edgecolor=\"k\", alpha=0.8, label=\"MC\")\nannotate_wc_rss_on_axis(\n    ax,\n    wc_low=wc.minimum[\"fc_hz\"],\n    wc_high=wc.maximum[\"fc_hz\"],\n    rss_low=rss[\"fc_hz\"][\"low\"],\n    rss_high=rss[\"fc_hz\"][\"high\"],\n    nominal=wc.nominal[\"fc_hz\"],\n)\nax.axvline(mc.frame[\"fc_hz\"].mean(), color=\"C4\", ls=\":\", lw=1.2, label=\"MC mean\")\nax.set_xlabel(r\"$f_c$ (Hz)\")\nax.set_ylabel(\"Count\")\nax.set_title(r\"MC of $f_c$ with WC & RSS\")\nax.grid(True, alpha=0.3)\nax.legend(fontsize=7, loc=\"best\")\n\n# --- DC error ---\nax = axes[1]\nax.hist(mc.frame[\"dc_error\"].dropna() * 1e6, bins=40, color=\"C0\", edgecolor=\"k\", alpha=0.8, label=\"MC\")\nannotate_wc_rss_on_axis(\n    ax,\n    wc_low=wc.minimum[\"dc_error\"] * 1e6,\n    wc_high=wc.maximum[\"dc_error\"] * 1e6,\n    rss_low=rss[\"dc_error\"][\"low\"] * 1e6,\n    rss_high=rss[\"dc_error\"][\"high\"] * 1e6,\n    nominal=wc.nominal[\"dc_error\"] * 1e6,\n)\nax.axvline(mc.frame[\"dc_error\"].mean() * 1e6, color=\"C4\", ls=\":\", lw=1.2, label=\"MC mean\")\nax.set_xlabel(r\"DC error $V_{\\mathrm{out}}-V_{\\mathrm{in}}$ (µV)\")\nax.set_ylabel(\"Count\")\nax.set_title(fr\"MC of DC accuracy @ $V_{{\\mathrm{{in}}}}={VIN_DC:g}$ V\")\nax.grid(True, alpha=0.3)\nax.legend(fontsize=7, loc=\"best\")\n\nfig.suptitle(f\"Analytical uniform MC (N={N_MC}) — WC endpoint vs RSS stack-up\")\nfig.tight_layout()\nfig.savefig(FIG / \"05_mc_fc_dc_wc_rss.png\", dpi=150)\nplt.show()\n","key":"azpUcS5MYW"},{"type":"outputs","id":"s-ozVxLv_Tih8ypbXRyJQ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8a1a7e23da820a5b9faa881084297bc7","path":"/build/8a1a7e23da820a5b9faa881084297bc7.png"},"text/plain":{"content":"<Figure size 1100x420 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"sqgNsgNXS8"}],"key":"urY2b2NfEK"}],"identifier":"a40af24b","html_id":"a40af24b","key":"SVS5BUlwTv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-28T16:14:48.586235Z","iopub.status.busy":"2026-07-28T16:14:48.586046Z","iopub.status.idle":"2026-07-28T16:14:49.320404Z","shell.execute_reply":"2026-07-28T16:14:49.319766Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib.ticker import FormatStrFormatter, MaxNLocator\n# Secondary: |H|@f_design and Vout histograms (with WC/RSS on Vout via dc path)\nfig, axes = plt.subplots(1, 2, figsize=(11, 3.8))\n\nax = axes[0]\nax.hist(mc.frame[\"gain_at_fdesign\"].dropna(), bins=40, color=\"C0\", edgecolor=\"k\", alpha=0.85)\nax.axvline(mc.frame[\"gain_at_fdesign\"].mean(), color=\"C3\", ls=\"--\", label=\"mean\")\nax.set_xlabel(r\"$|H|$ @ $f_{\\mathrm{design}}$\")\nax.set_ylabel(\"Number of trials\")\nax.set_title(\"Passband-edge gain (MC)\")\nax.grid(True, alpha=0.3)\nax.legend(fontsize=8)\n\nax = axes[1]\nax.hist(mc.frame[\"dc_vout\"].dropna(), bins=40, color=\"C0\", edgecolor=\"k\", alpha=0.85, label=\"MC Vout\")\n# WC/RSS on Vout = Vin + dc_error bounds\nannotate_wc_rss_on_axis(\n    ax,\n    wc_low=VIN_DC + wc.minimum[\"dc_error\"],\n    wc_high=VIN_DC + wc.maximum[\"dc_error\"],\n    rss_low=VIN_DC + rss[\"dc_error\"][\"low\"],\n    rss_high=VIN_DC + rss[\"dc_error\"][\"high\"],\n    nominal=VIN_DC + wc.nominal[\"dc_error\"],\n)\nax.axvline(VIN_DC, color=\"C1\", ls=\":\", lw=1.2, label=\"ideal Vin\")\nax.set_xlabel(r\"$V_{\\mathrm{out}}$ (V)\")\nax.set_title(fr\"$V_{{\\mathrm{{out}}}}$ @ $V_{{\\mathrm{{in}}}}={VIN_DC:g}$ V\")\nax.grid(True, alpha=0.3)\nax.legend(fontsize=7)\n# Offset labels on this narrow Vout span overlap. Show plain volts.\nax.xaxis.set_major_locator(MaxNLocator(nbins=4))\nax.xaxis.set_major_formatter(FormatStrFormatter(\"%.4f\"))\n\nfig.tight_layout()\nfig.savefig(FIG / \"05_mc_gain_vout.png\", dpi=150)\nplt.show()\n","key":"Zr2htuPEiK"},{"type":"outputs","id":"nNQ4ZP-dIQCCRHzRt75N6","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5b0b8bc414b9da631c2d0ce909768c3b","path":"/build/5b0b8bc414b9da631c2d0ce909768c3b.png"},"text/plain":{"content":"<Figure size 1100x380 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"gcTkKwHTAt"}],"key":"xnwMp4X9dK"}],"identifier":"b0a9370a","html_id":"b0a9370a","key":"Y9gs7eWokJ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-28T16:14:49.323660Z","iopub.status.busy":"2026-07-28T16:14:49.323430Z","iopub.status.idle":"2026-07-28T16:15:05.558915Z","shell.execute_reply":"2026-07-28T16:15:05.557813Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# ngspice MC subset for fc (cached); overlay analytical MC + WC/RSS\ntry:\n    smc = spice_monte_carlo(\n        p, n=N_SPICE_MC, seed=SEED,\n        workdir=ROOT / \"results\" / \"ngspice_mc\",\n        root=ROOT, opamp_model=\"ideal\", cache=True,\n    )\n    display(smc.summary)\n    fig, ax = plt.subplots(figsize=(7, 3.8))\n    ax.hist(mc.frame[\"fc_hz\"], bins=40, alpha=0.35, label=\"analytical MC\", color=\"C0\", edgecolor=\"k\")\n    ax.hist(smc.frame[\"fc_spice_hz\"].dropna(), bins=20, alpha=0.75, label=\"ngspice MC\", color=\"C1\", edgecolor=\"k\")\n    annotate_wc_rss_on_axis(\n        ax,\n        wc_low=wc.minimum[\"fc_hz\"],\n        wc_high=wc.maximum[\"fc_hz\"],\n        rss_low=rss[\"fc_hz\"][\"low\"],\n        rss_high=rss[\"fc_hz\"][\"high\"],\n        nominal=wc.nominal[\"fc_hz\"],\n    )\n    ax.set_xlabel(r\"$f_c$ (Hz)\")\n    ax.set_title(\"fc: analytical MC vs ngspice MC + WC/RSS\")\n    ax.legend(fontsize=7)\n    ax.grid(True, alpha=0.3)\n    fig.tight_layout()\n    fig.savefig(FIG / \"05_mc_fc_compare.png\", dpi=150)\n    plt.show()\nexcept Exception as e:\n    print(\"SPICE MC skipped/failed:\", e)\n","key":"OobsRHJmuf"},{"type":"outputs","id":"arrpG7Q4a50pdXy-Bmclc","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>mean</th>\n      <th>std</th>\n      <th>min</th>\n      <th>max</th>\n      <th>p05</th>\n      <th>p50</th>\n      <th>p95</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>fc_spice_hz</th>\n      <td>19778.866060</td>\n      <td>1.073249e+02</td>\n      <td>19577.716918</td>\n      <td>19970.388453</td>\n      <td>19624.110727</td>\n      <td>19788.670191</td>\n      <td>19904.745789</td>\n    </tr>\n    <tr>\n      <th>passband_gain_spice</th>\n      <td>0.999999</td>\n      <td>1.324377e-09</td>\n      <td>0.999999</td>\n      <td>0.999999</td>\n      <td>0.999999</td>\n      <td>0.999999</td>\n      <td>0.999999</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"                             mean           std           min           max  \\\nfc_spice_hz          19778.866060  1.073249e+02  19577.716918  19970.388453   \npassband_gain_spice      0.999999  1.324377e-09      0.999999      0.999999   \n\n                              p05           p50           p95  \nfc_spice_hz          19624.110727  19788.670191  19904.745789  \npassband_gain_spice      0.999999      0.999999      0.999999  ","content_type":"text/plain"}}},"children":[],"key":"PuVLdVJQ3z"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"34c549173c94d67e08a135508c0e8668","path":"/build/34c549173c94d67e08a135508c0e8668.png"},"text/plain":{"content":"<Figure size 700x380 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Tos3JLyLdi"}],"key":"Q8FG1Jhz6M"}],"identifier":"8197fa0a","html_id":"8197fa0a","key":"bfzVPEwkS5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Passband transient at 10 kHz — Monte Carlo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GlVHRTVVFE"}],"identifier":"passband-transient-at-10-khz-monte-carlo","label":"Passband transient at 10 kHz — Monte Carlo","html_id":"passband-transient-at-10-khz-monte-carlo","implicit":true,"key":"UjiaKVDLWZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Five hundred uniform draws of the six passives, seed 42. The same draw is evaluated three ways: the analytical (H(j\\omega)), ngspice, and LTspice. All three use the ideal voltage-controlled source. The stimulus is the 10 kHz, 1 V peak sine about 2.5 V. This sample is separate from the AC Monte Carlo above; the count is 500 on every solver so the histograms are the same size.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cLBgZmRoja"}],"key":"BID0p5wt9X"}],"identifier":"565d521f","html_id":"565d521f","key":"YoN9H35lO2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib.ticker import MaxNLocator\nfrom opamp_design.transient import load_or_run_mc, summary_table\n\nmc = load_or_run_mc(\n    p,\n    root=ROOT,\n    cache_csv=ROOT / \"results\" / \"tran\" / \"mc_10khz.csv\",\n    n=500,\n    seed=42,\n)\nif len(mc) != 500 or not bool(mc[\"ng_ok\"].all()):\n    raise RuntimeError(\"Monte Carlo cache is incomplete\")\n\nstats = summary_table(\n    mc,\n    [\n        (\"analytical gain\", \"an_gain\"),\n        (\"ngspice gain\", \"ng_gain\"),\n        (\"LTspice gain\", \"lt_gain\"),\n        (\"analytical phase (deg)\", \"an_phase_deg\"),\n        (\"ngspice phase (deg)\", \"ng_phase_deg\"),\n        (\"LTspice phase (deg)\", \"lt_phase_deg\"),\n    ],\n)\nshow = stats.copy()\nfor col in (\"mean\", \"std\", \"min\", \"p05\", \"p95\", \"max\"):\n    show[col] = show[col].map(lambda v: f\"{v:.6f}\")\ndisplay(show)\nng_ppm = 1e6 * (mc[\"ng_gain\"] - mc[\"an_gain\"]) / mc[\"an_gain\"]\nlt_ppm = 1e6 * (mc[\"lt_gain\"] - mc[\"an_gain\"]) / mc[\"an_gain\"]\nprint(\n    f\"Max |ngspice − analytical| = {ng_ppm.abs().max():.1f} ppm gain, \"\n    f\"{(mc.ng_phase_deg - mc.an_phase_deg).abs().max():.4f} deg phase.\"\n)\nprint(\n    f\"Max |LTspice − analytical| = {lt_ppm.abs().max():.1f} ppm gain, \"\n    f\"{(mc.lt_phase_deg - mc.an_phase_deg).abs().max():.4f} deg phase.\"\n)\n\ndef _edges(frame, cols, nbins=25):\n    vals = np.concatenate([frame[c].to_numpy() for c in cols])\n    lo, hi = float(vals.min()), float(vals.max())\n    pad = 0.08 * (hi - lo) if hi > lo else 1e-4\n    return np.linspace(lo - pad, hi + pad, nbins + 1)\n\ngain_cols = [\n    (\"an_gain\", \"Analytical\", \"C0\"),\n    (\"ng_gain\", \"ngspice\", \"C1\"),\n    (\"lt_gain\", \"LTspice\", \"C2\"),\n]\nphase_cols = [\n    (\"an_phase_deg\", \"Analytical\", \"C0\"),\n    (\"ng_phase_deg\", \"ngspice\", \"C1\"),\n    (\"lt_phase_deg\", \"LTspice\", \"C2\"),\n]\nfig, axes = plt.subplots(2, 3, figsize=(11, 6.4), sharey=\"row\")\ngain_edges = _edges(mc, [c for c, _, _ in gain_cols])\nphase_edges = _edges(mc, [c for c, _, _ in phase_cols])\nfor ax, (col, title, color), edges, xlab in (\n    *[(axes[0, i], gain_cols[i], gain_edges, \"Gain |H| at 10 kHz\") for i in range(3)],\n    *[(axes[1, i], phase_cols[i], phase_edges, \"Phase (deg) at 10 kHz\") for i in range(3)],\n):\n    series = mc[col].to_numpy()\n    ax.hist(series, bins=edges, color=color, edgecolor=\"white\", linewidth=0.4)\n    ax.axvline(series.mean(), color=\"k\", lw=1.0, ls=\"--\")\n    ax.set_title(f\"{title}\\nmean {series.mean():.5f}, std {series.std():.5f}\")\n    ax.set_xlabel(xlab)\n    ax.grid(True, axis=\"y\", alpha=0.3)\n    ax.xaxis.set_major_locator(MaxNLocator(nbins=4))\naxes[0, 0].set_ylabel(\"Number of trials\")\naxes[1, 0].set_ylabel(\"Number of trials\")\nfig.suptitle(\"500-run Monte Carlo at 10 kHz, seed 42\", y=1.01)\nfig.tight_layout()\nfig.savefig(FIG / \"05_tran_mc_hist.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n","key":"cSo8RpLLxO"},{"type":"outputs","id":"nR7VcfDmW2Bej8MDgasmK","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"                result       mean      std        min        p05        p95        max\n       analytical gain   0.927419 0.001169   0.924062   0.925438   0.929187   0.930496\n          ngspice gain   0.927369 0.001169   0.924010   0.925386   0.929137   0.930447\n          LTspice gain   0.927326 0.001167   0.923986   0.925388   0.929099   0.930396\nanalytical phase (deg) -50.715938 0.199419 -51.181448 -51.039263 -50.381589 -50.237627\n   ngspice phase (deg) -50.732796 0.199479 -51.198458 -51.056220 -50.398356 -50.254323\n   LTspice phase (deg) -50.714580 0.199552 -51.180000 -51.040500 -50.379500 -50.240000\n","content_type":"text/plain"},"text/html":{"content":"<table class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th>result</th>\n      <th>mean</th>\n      <th>std</th>\n      <th>min</th>\n      <th>p05</th>\n      <th>p95</th>\n      <th>max</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>analytical gain</td>\n      <td>0.927419</td>\n      <td>0.001169</td>\n      <td>0.924062</td>\n      <td>0.925438</td>\n      <td>0.929187</td>\n      <td>0.930496</td>\n    </tr>\n    <tr>\n      <td>ngspice gain</td>\n      <td>0.927369</td>\n      <td>0.001169</td>\n      <td>0.924010</td>\n      <td>0.925386</td>\n      <td>0.929137</td>\n      <td>0.930447</td>\n    </tr>\n    <tr>\n      <td>LTspice gain</td>\n      <td>0.927326</td>\n      <td>0.001167</td>\n      <td>0.923986</td>\n      <td>0.925388</td>\n      <td>0.929099</td>\n      <td>0.930396</td>\n    </tr>\n    <tr>\n      <td>analytical phase (deg)</td>\n      <td>-50.715938</td>\n      <td>0.199419</td>\n      <td>-51.181448</td>\n      <td>-51.039263</td>\n      <td>-50.381589</td>\n      <td>-50.237627</td>\n    </tr>\n    <tr>\n      <td>ngspice phase (deg)</td>\n      <td>-50.732796</td>\n      <td>0.199479</td>\n      <td>-51.198458</td>\n      <td>-51.056220</td>\n      <td>-50.398356</td>\n      <td>-50.254323</td>\n    </tr>\n    <tr>\n      <td>LTspice phase (deg)</td>\n      <td>-50.714580</td>\n      <td>0.199552</td>\n      <td>-51.180000</td>\n      <td>-51.040500</td>\n      <td>-50.379500</td>\n      <td>-50.240000</td>\n    </tr>\n  </tbody>\n</table>\n","content_type":"text/html"}}},"children":[],"key":"WhCf40Xe1b"},{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Max |ngspice − analytical| = 56.9 ppm gain, 0.0170 deg phase.\nMax |LTspice − analytical| = 157.8 ppm gain, 0.0064 deg phase.\n"},"children":[],"key":"HSphUaqXlr"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"09da6734cad7e9b6db84c10d96221989","path":"/build/09da6734cad7e9b6db84c10d96221989.png"},"text/plain":{"content":"<Figure>\n","content_type":"text/plain"}}},"children":[],"key":"uPvpjZedvf"}],"key":"XOzHhmzjtI"}],"identifier":"328f98de","html_id":"328f98de","key":"skyH9xMUPF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reading the histograms","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WXqzh3VAj8"}],"identifier":"reading-the-histograms","label":"Reading the histograms","html_id":"reading-the-histograms","implicit":true,"key":"l80eByuxCY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The three gain histograms, and the three phase histograms, are the same 500 draws. Means and standard deviations agree to the width of the line. The dashed line on each panel is that panel’s mean. Solver differences stay under 160 ppm in gain, far inside the Monte Carlo spread of about 0.13 %.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pewLfxlJ2j"}],"key":"xAdSivCWTk"}],"identifier":"c4c51873","html_id":"c4c51873","key":"z0Kd5ilJjd"}],"key":"cJxpXtJoaa"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"04 — Worst-case analysis","url":"/sections/electronics/analog-and-digital/opa365-fig86/worst-case","group":"Electronics"},"next":{"title":"06 — Temperature sweep (−40 °C … +125 °C)","url":"/sections/electronics/analog-and-digital/opa365-fig86/temperature-sweep","group":"Electronics"}}},"domain":"https://www.mkdynamics.net"}