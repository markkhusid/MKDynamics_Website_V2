 \"vect1.h\"\n\nusing namespace std;    // Added. MK\n\nint main()\n{\n   vect a(60), b[20];\n\n   b[1].element(5) = 7;\n   cout << b[1].element(5) << \" 1 element 5\\n\";\n   for (int i = 0; i <= a.ub(); ++i) {\n      a.element(i) = i;\n      cout << a.element(i) << \"\\t\";\n   }\n   cout << endl;     // Added for output clarity\n}","position":{"start":{"line":1,"column":1},"end":{"line":30,"column":1}},"key":"FfQncTtUP1"}],"key":"zVfVQmJC1f"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nozzaKzKoE"}],"key":"Scz5Gpca7Y"}],"key":"BoHtameKlA"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"C++","value":"/*********************************************************************\n\n  Filename:  vect1.h\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.5    A class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>    // changed iostream.h to iostream. MK\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"xIQ2ONrJJM"}],"key":"yQYofSmyrW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uj2MYcx3Jf"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"Tox9NsSCz0"}],"key":"QOBL2jF1kG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"scvpNNLE9U"}],"key":"E3vUTKV5xS"}],"key":"k8L0eOrx2u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ofEIe87lVG"},{"type":"outputs","id":"JCX7oH2Asgy4gCoiJTNAp","children":[],"key":"M2zOBiDOoq"}],"key":"ZOxZnzDnu8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_5_A_Class_Vect\"","key":"ZIpp350oDC"},{"type":"outputs","id":"Z7t98EzrKfIguaV_Ta6Lm","children":[],"key":"YR8i9bnGcY"}],"key":"mlVdaVHhlN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"kmFefSqeqz"},{"type":"outputs","id":"nIiML5VvovyHLsadie7GJ","children":[],"key":"G2G3ZZ3HGq"}],"key":"nZup0PAiIH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ vect1.cpp -w -o vect1\")","key":"t5fMvTAO6v"},{"type":"outputs","id":"zD-mrAtq500UaOY4lDbn_","children":[],"key":"BV9LI6Ao8A"}],"key":"R8AvuwqEG4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading",