tion":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pfr59ktIqT"}],"identifier":"a-class-vect","label":"A Class Vect","html_id":"a-class-vect","implicit":true,"key":"HOT9xXlbpe"}],"identifier":"4fae3c47-7ba5-411e-929d-45543f813a61","html_id":"4fae3c47-7ba5-411e-929d-45543f813a61","visibility":"show","key":"eirVdVLo0G"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KkyWZ75LoO"}],"key":"xkgH1XkYYL"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"LcLJTuDq0n"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates a dynamic array or vector in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NG6YEWARV9"}],"identifier":"program-that-demonstrates-a-dynamic-array-or-vector-in-c","label":"Program that demonstrates a dynamic array or vector in C++","html_id":"program-that-demonstrates-a-dynamic-array-or-vector-in-c","implicit":true,"key":"uo2sB7yBnX"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"qBOXqzIrEn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H6Koem6C6e"}],"key":"E5YDTcuWk2"}],"identifier":"17067957","html_id":"17067957","key":"zY6nO0bFYE"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"/*********************************************************************\n\n  Filename:  vect1.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.7    A Class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//test of safe array type vect\n\n#include \"vect1.h\"\n\nusing namespace std;    // Added. MK\n\nint main()\n{\n   vect a(60), b[20];\n\n   b[1].element(5) = 7;\n   cout << b[1].element(5) << \" 1 element 5\\n\";\n   for (int i = 0; i <= a.ub(); ++i) {\n      a.element(i) = i;\n      cout << a.element(i) << \"\\t\";\n   }\n   cout << endl;     // Added for output clarity\n}","position":{"start":{"line":1,"column":1},"end":{"line":30,"column":1}},"key":"RRksoLGZTS"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"DODh2P6iYr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wU36s5iB5F"}],"key":"e0cMHK0eCy"}],"identifier":"a417fe12","html_id":"a417fe12","key":"cjmiDHHeNU"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"C++","value":"/*********************************************************************\n\n  Filename:  vect1.h\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.5    A class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>    // changed iostream.h to iostream. MK\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"iNEDyY4PlE"}],"identifier":"98e72bd7","html_id":"98e72bd7","key":"QyWh4vgwB1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JG8h7AeMKf"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"luqw1s40j1"}],"identifier":"3e111038","html_id":"3e111038","key":"y7gmQVoAgN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QfLSABXj3i"}],"key":"ZIjEEhTPNH"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"uFpbLu5hjQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"hJC4KOCpzr"},{"type":"outputs","id":"CFnOolla8hLiiAl5euxRj","children":[],"key":"rt9yhFEYV8"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"LObfgEQNbw"},{"type":"block","kind":"notebook-