 \"vect1.h\"\n\nusing namespace std;    // Added. MK\n\nint main()\n{\n   vect a(60), b[20];\n\n   b[1].element(5) = 7;\n   cout << b[1].element(5) << \" 1 element 5\\n\";\n   for (int i = 0; i <= a.ub(); ++i) {\n      a.element(i) = i;\n      cout << a.element(i) << \"\\t\";\n   }\n   cout << endl;     // Added for output clarity\n}","position":{"start":{"line":1,"column":1},"end":{"line":30,"column":1}},"key":"fhSx044JX2"}],"key":"iJudcvV7zp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jn1nUcPWQT"}],"key":"Sq1tdns1Ua"}],"key":"xVGDB8d9cH"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"C++","value":"/*********************************************************************\n\n  Filename:  vect1.h\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.5    A class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>    // changed iostream.h to iostream. MK\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"fGQpnokmAX"}],"key":"VUVbuRzSTh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q64AzEtZJc"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"A8EKrQ1pH3"}],"key":"Lou7PaIRj3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MIjOkhJLDB"}],"key":"BufVdPEvFE"}],"key":"mqwuX5R5Wv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"g7LHecKO87"},{"type":"outputs","id":"7dHI5cZK3Jbp_IiMeLfVB","children":[],"key":"ivIbM9Q5de"}],"key":"eW9wbvsWaf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_5_A_Class_Vect\"","key":"t6hwUet64t"},{"type":"outputs","id":"zMwDrEYkrCSniaFTarwAJ","children":[],"key":"HVmujRmbgo"}],"key":"ttDWqbyYIR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"WY1KedJbea"},{"type":"outputs","id":"Fcg0vJAgQpMSGPs_2PigD","children":[],"key":"Ubkr3hPR6L"}],"key":"BSz2C16CP5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ vect1.cpp -w -o vect1\")","key":"TzSzrvWeJT"},{"type":"outputs","id":"kszPaa7OFeWNxR580pgcG","children":[],"key":"RJYHyPIMJq"}],"key":"w8VtZhbflV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading",