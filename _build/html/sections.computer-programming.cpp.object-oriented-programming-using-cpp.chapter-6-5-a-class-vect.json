":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yXcFI6xYfY"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"Sswo5aup7p"},{"type":"text","value":" by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JJSbXiw8dZ"}],"key":"gVTMC0dQik"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"JQVFWJ5Xqh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates a dynamic array or vector in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rJBI5HR7Um"}],"identifier":"program-that-demonstrates-a-dynamic-array-or-vector-in-c","label":"Program that demonstrates a dynamic array or vector in C++","html_id":"program-that-demonstrates-a-dynamic-array-or-vector-in-c","implicit":true,"key":"k3jlZdQfL6"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"OXCkCGlrDK"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fBz62vDBdY"}],"key":"RV1DEsUaoe"}],"identifier":"17067957","html_id":"17067957","key":"kEem1fSdH5"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  vect1.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.7    A Class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//test of safe array type vect\n\n#include \"vect1.h\"\n\nusing namespace std;    // Added. MK\n\nint main()\n{\n   vect a(60), b[20];\n\n   b[1].element(5) = 7;\n   cout << b[1].element(5) << \" 1 element 5\\n\";\n   for (int i = 0; i <= a.ub(); ++i) {\n      a.element(i) = i;\n      cout << a.element(i) << \"\\t\";\n   }\n   cout << endl;     // Added for output clarity\n}","position":{"start":{"line":1,"column":1},"end":{"line":30,"column":1}},"key":"U55mR5Sdc6"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"KR9STaKzuy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file vect1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TAVf9Zh2rV"}],"key":"EE6cAajpc6"}],"identifier":"a417fe12","html_id":"a417fe12","key":"rF5kn7fxQI"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  vect1.h\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.5    A class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>    // changed iostream.h to iostream. MK\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"rcSxrYgBay"}],"identifier":"98e72bd7","html_id":"98e72bd7","key":"T0BaetpPR0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R08M7acEH1"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"VrlFm1fqxl"}],"identifier":"3e111038","html_id":"3e111038","key":"HyfSl41kAh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cNjKv88lZU"}],"key":"UuMvq8y7lv"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"Sif4OM9Ikz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"DHdeOUOv6e"},{"type":"outputs","id":"CXKgZRuHEPPGloeBx34RJ","children":[],"key":"LEqui3Q994"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"acI7Gh6K3M"},{"type":"block","kind":"notebook-