ointer types in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ySVGNRCGcc"}],"identifier":"program-that-demonstrates-pointer-types-in-c","label":"Program that demonstrates pointer types in C++","html_id":"program-that-demonstrates-pointer-types-in-c","implicit":true,"key":"oZdOKDA2jC"}],"key":"bnUeHD3EZr"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Pointer - based call - by - reference\n#include <iostream>\n\nusing namespace std;\n\nvoid order (int *, int *);\n\nint main()\n{\n    int i = 7, j = 3;\n\n    cout << i << '\\t' << j << endl; // 7 3 is printed\n    order(&i, &j);\n    cout << i << '\\t' << j << endl; // 3 7 is printed\n}\n\nvoid order(int * p, int * q)\n{\n    int temp;\n\n    if (*p > *q) {\n        temp = *p;\n        *p = *q;\n        *q = temp;\n    }\n}","key":"gOD0hJaK3N"}],"key":"z3mmCfGP5u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ed9h11bPod"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"EaXw2IMg30"}],"key":"MTuHMiFmxl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aHtXXZWs80"}],"key":"kgoKIjy7zz"}],"key":"pfATTXbb88"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"c4todgUmtt"},{"type":"outputs","id":"BF_LNutQ