ointer types in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ky2lLX8t94"}],"identifier":"program-that-demonstrates-pointer-types-in-c","label":"Program that demonstrates pointer types in C++","html_id":"program-that-demonstrates-pointer-types-in-c","implicit":true,"key":"EAYIOIjR4Q"}],"key":"duMw0YXNYY"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Pointer - based call - by - reference\n#include <iostream>\n\nusing namespace std;\n\nvoid order (int *, int *);\n\nint main()\n{\n    int i = 7, j = 3;\n\n    cout << i << '\\t' << j << endl; // 7 3 is printed\n    order(&i, &j);\n    cout << i << '\\t' << j << endl; // 3 7 is printed\n}\n\nvoid order(int * p, int * q)\n{\n    int temp;\n\n    if (*p > *q) {\n        temp = *p;\n        *p = *q;\n        *q = temp;\n    }\n}","key":"an1xuGLk3K"}],"key":"BDPw3agbre"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wiNWefTFAG"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"UcXLM8lvPe"}],"key":"ZEKfLWndr1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HzvqKdGsYU"}],"key":"BbNzga95Il"}],"key":"deUw1ikg7Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"o7fT0NPEfS"},{"type":"outputs","id":"OEzpDocj