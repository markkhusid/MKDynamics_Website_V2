urce":"https://www.manning.com/books/modern-fortran","key":"UyG3sVffwO"},{"type":"text","value":"” by Milan Curcic (Manning)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aquzMt5Tzb"}],"key":"Rab2vhtAiB"}],"identifier":"1cc435d1-3cdd-4825-88c9-ebe2506d3bd8","html_id":"1cc435d1-3cdd-4825-88c9-ebe2506d3bd8","key":"Y8SXepaDBa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In this section the Tsunami Simulator with Modules data is plotted using Python and Matplotlib.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hBfmaQSSrI"}],"key":"Pc0k3hNQin"}],"identifier":"14a0a3c0-3bb0-4f05-b4f5-62464b845983","html_id":"14a0a3c0-3bb0-4f05-b4f5-62464b845983","key":"CWtCWEgc2g"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib inline\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib\n\n#matplotlib.use('Agg')\n#matplotlib.rcParams.update({'font.size': 16})","key":"pnRcF1jxJj"},{"type":"outputs","id":"joxdJmquKekJ0U4GPNRid","children":[],"key":"TWcxs3mzxi"}],"identifier":"31de1f60-eefc-4dc4-b445-df454987dc57","html_id":"31de1f60-eefc-4dc4-b445-df454987dc57","key":"rEXRUEEuXk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = \"Fortran_Code/Tsunami_Simulator_with_Modules/\"\noutput_filename = 'tsunami_simulator_with_modules_data.txt'\ndatafile_full_path = code_dir + output_filename","key":"VWSt9KUEs6"},{"type":"outputs","id":"rZb7JeAE0iwbDo0tXJQ2j","children":[],"key":"IgIT1VC90v"}],"identifier":"1dfdf66e-e72b-4050-8ca3-98980cbd8198","html_id":"1dfdf66e-e72b-4050-8ca3-98980cbd8198","key":"mvYirQLsDm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# read data into a list\ndata = [line.rstrip().split() for line in open(datafile_full_path).readlines()]\n#data","key":"W3ytlNXJsW"},{"type":"outputs","id":"B5zoD6AXc2LXIj1omLn_4","children":[],"key":"Y0c8SaHfLP"}],"identifier":"a2d6edc1-c935-4b2a-aa69-957377a24980","html_id":"a2d6edc1-c935-4b2a-aa69-957377a24980","key":"aJRtYe7QcH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time = [float(line[0]) for line in data]\nh = np.array([[float(x) for x in line[1:]] for line in data])\nx = np.arange(1, h.shape[1]+1)\ntime_steps = [0, 25, 50, 75]","key":"g5pSIpMZ6Y"},{"type":"outputs","id":"3R-LHuhGuTLiryfDbLiFQ","children":[],"key":"dNIAFNi0m5"}],"identifier":"a1a19036-0863-488a-aeb3-2941c514a62d","html_id":"a1a19036-0863-488a-aeb3-2941c514a62d","key":"hZCgN8az0p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8, 10))\naxes = [plt.subplot2grid((4, 1), (row, 0), colspan=1, rowspan=1)\n        for row in range(4)]\n\nfor ax in axes:\n    n = axes.index(ax)\n    ax.plot(x, h[time_steps[n], :], 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch03.svg')\n#plt.close(fig)","key":"TTDlEOq0KS"},{"type":"outputs","id":"9OBDRFmse-LILoUSCPSC0","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"ac56cd06c5cc13c8dbdcb95f4882df82","path":"/build/ac56cd06c