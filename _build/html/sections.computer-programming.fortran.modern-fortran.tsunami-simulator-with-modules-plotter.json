urce":"https://www.manning.com/books/modern-fortran","key":"ZY2Wp5yudY"},{"type":"text","value":"” by Milan Curcic (Manning)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HiqVAhdMR7"}],"key":"X4VDDKViuR"}],"identifier":"1cc435d1-3cdd-4825-88c9-ebe2506d3bd8","html_id":"1cc435d1-3cdd-4825-88c9-ebe2506d3bd8","key":"bc4BlcnbHU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In this section the Tsunami Simulator with Modules data is plotted using Python and Matplotlib.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JVZ5xJr2Kc"}],"key":"myx3atKN3C"}],"identifier":"14a0a3c0-3bb0-4f05-b4f5-62464b845983","html_id":"14a0a3c0-3bb0-4f05-b4f5-62464b845983","key":"m6zFikYe6x"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib inline\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib\n\n#matplotlib.use('Agg')\n#matplotlib.rcParams.update({'font.size': 16})","key":"PRU9Lr3dVo"},{"type":"outputs","id":"ee5giCYA30JTfNp5j_LLK","children":[],"key":"zRpC0Sqwqv"}],"identifier":"31de1f60-eefc-4dc4-b445-df454987dc57","html_id":"31de1f60-eefc-4dc4-b445-df454987dc57","key":"HQPpmzGaBH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = \"Fortran_Code/Tsunami_Simulator_with_Modules/\"\noutput_filename = 'tsunami_simulator_with_modules_data.txt'\ndatafile_full_path = code_dir + output_filename","key":"gSp6Zkj8gM"},{"type":"outputs","id":"zD7rpu3KAfkWcAI0dXn6x","children":[],"key":"fGD1sunVve"}],"identifier":"1dfdf66e-e72b-4050-8ca3-98980cbd8198","html_id":"1dfdf66e-e72b-4050-8ca3-98980cbd8198","key":"Ii9BfDFMQH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# read data into a list\ndata = [line.rstrip().split() for line in open(datafile_full_path).readlines()]\n#data","key":"QBkimnU9Ct"},{"type":"outputs","id":"F3q6p1xPvs6x2mBmLe_Id","children":[],"key":"z9p2Gfx24L"}],"identifier":"a2d6edc1-c935-4b2a-aa69-957377a24980","html_id":"a2d6edc1-c935-4b2a-aa69-957377a24980","key":"Vi03JG40PK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time = [float(line[0]) for line in data]\nh = np.array([[float(x) for x in line[1:]] for line in data])\nx = np.arange(1, h.shape[1]+1)\ntime_steps = [0, 25, 50, 75]","key":"TXIEBJSFzD"},{"type":"outputs","id":"D6amYA2PlKXf7nungyoyO","children":[],"key":"gCi7pYQNyc"}],"identifier":"a1a19036-0863-488a-aeb3-2941c514a62d","html_id":"a1a19036-0863-488a-aeb3-2941c514a62d","key":"TQNA28jvve"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8, 10))\naxes = [plt.subplot2grid((4, 1), (row, 0), colspan=1, rowspan=1)\n        for row in range(4)]\n\nfor ax in axes:\n    n = axes.index(ax)\n    ax.plot(x, h[time_steps[n], :], 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch03.svg')\n#plt.close(fig)","key":"bqRu91p2y9"},{"type":"outputs","id":"btUdDliZ-6-iyHuLRTHcp","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"ac56cd06c5cc13c8dbdcb95f4882df82","path":"/build/ac56cd06c5cc13c8dbdcb95f4882df82.png"},"text/plain":{"content":"<Figure size 576x720 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZvRwyvrfO9"}],"key":"McHPxsVzBr"}],"identifier":"eab643c3-486b-41b9-b31b-f02bdba2472b","html_id":"eab643c3-486b-41b9-b31b-f02bdba2472b","key":"gDewGEDmhJ"}],"key":"O39kA7cY8Q"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tsunami Simulator with Modules","url":"/sections/computer-programming/fortran/modern-fortran/tsunami-simulator-with-modules","group":"Computer Programming"},"next":{"title":"Print Compiler Version","url":"/sections/computer-programming/fortran/modern-fortran/print-compiler-version","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}