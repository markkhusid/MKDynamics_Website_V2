ource_code/arrays","error":true,"key":"DhZPtlfkID"}],"key":"oa9r2Y37op"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"UY1J4Ty4bx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program reshapes an array into a matrix in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qEDZCUaKHd"}],"identifier":"this-program-reshapes-an-array-into-a-matrix-in-fortran","label":"This program reshapes an array into a matrix in Fortran.","html_id":"this-program-reshapes-an-array-into-a-matrix-in-fortran","implicit":true,"key":"iM8pId52Ay"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"ugAFNSRKCs"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program reshape_test\n    implicit none\n    integer, parameter :: nr_values = 12\n    integer :: i\n    integer, dimension(nr_values) :: values = [ (i, i=1, nr_values) ]\n    integer, dimension(2, 5) :: too_small\n    integer, dimension(3, 5) :: too_large\n\n    too_small = reshape(values, shape(too_small))\n    call print_matrix(too_small)\n\n    too_large = reshape(values, shape(too_large), pad=[-1, -2])\n    call print_matrix(too_large)\n\ncontains\n\n    subroutine print_matrix(A)\n        implicit none\n        integer, dimension(:, :), intent(in) :: A\n        integer :: i\n\n        do i = 1, size(A, 1)\n            print *, A(i, :)\n        end do\n    end subroutine print_matrix\n\nend program reshape_test","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"v29l21kld3"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"V3j6m6uTQB"},{"type":"block","kind":"notebook-content","children":[{"type":"par