_large), pad=[-1, -2])\n    call print_matrix(too_large)\n\ncontains\n\n    subroutine print_matrix(A)\n        implicit none\n        integer, dimension(:, :), intent(in) :: A\n        integer :: i\n\n        do i = 1, size(A, 1)\n            print *, A(i, :)\n        end do\n    end subroutine print_matrix\n\nend program reshape_test","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"lGEMhv9yyE"}],"key":"yXaC312tTC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dj2jXaGVNk"}],"key":"aeCe7SwxJj"}],"key":"W5H61PbPpd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RDcv7JqPQn"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"QEMMjsOPjN"}],"key":"blY3pi7bGq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ovJmmtOGq7"},{"type":"outputs","id":"NJE8a-_znURQmppw0ZwIJ","children":[],"key":"mG2OHX3fhl"}],"key":"Fsw20APXRF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Reshape\"","key":"ucjy5Ijoh3"},{"type":"outputs","id":"H9Dn2gexJAs4XzUtdGO0K","children":[],"key":"uJWHpcHdIl"}],"key":"SvMfPC6Vme"},{"