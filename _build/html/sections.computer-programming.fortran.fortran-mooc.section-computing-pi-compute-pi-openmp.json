6s-26,-26,-26,-26s76,-59,76,-59s76,-60,76,-60z\nM1001 80h400000v40h-400000z'/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1795em;\"><span></span></span></span></span></span><span class=\"mord mathnormal sizing reset-size6 size8\">d</span><span class=\"mord mathnormal sizing reset-size6 size8\">x</span></span></span></span></span>","enumerator":"1","key":"SlcITlIFnr"}],"identifier":"9fd8964a-042e-4bcd-a90a-93bfa6acd96a","html_id":"9fd8964a-042e-4bcd-a90a-93bfa6acd96a","key":"KMUGVWleEa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file section_computing_pi_compute_pi_openmp.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zodZq6ikMD"}],"identifier":"in-file-section-computing-pi-compute-pi-openmp-f90","label":"In file section_computing_pi_compute_pi_openmp.f90","html_id":"in-file-section-computing-pi-compute-pi-openmp-f90","implicit":true,"key":"ObAYRLGEv0"}],"identifier":"ae43bd88","html_id":"ae43bd88","key":"ua6NG5kZKa"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Computing_Pi_Compute_Pi_OpenMP/app/section_computing_pi_compute_pi_openmp.f90","literal":true,"children":[{"type":"code","value":"program compute_pi_omp\n  use, intrinsic :: iso_fortran_env, only : DP => REAL64, I8 => INT64\n  implicit none\n  integer(kind=I8) :: i, nr_iters\n  real(kind=DP) :: delta, x, pi_val\n  real(kind=DP) :: pi_val_actual\n\n  pi_val = 0.0_DP\n  pi_val_actual = 2.0_DP * acos(0.0_DP)\n  nr_iters = get_nr_iters()\n  delta = 1.0_DP/nr_iters\n  x = 0.0_DP\n\n  !$omp parallel do default(none) private(x) shared(delta, nr_iters) reduction(+:pi_val)\n  do i = 1, nr_iters\n      x = i*delta\n      pi_val = pi_val + sqrt(1.0_DP - x**2)\n  end do\n  !$omp end parallel do\n\n  pi_val = 4.0_DP*pi_val/nr_iters\n  print '(A, I15, A, F25.15)', \"After \", nr_iters, \" loops, Pi = \", pi_val\n  print '(A, F25.15)', \"Actual value of Pi = \", pi_val_actual\n  print '(A, F25.15)', \"Absolute difference = \", abs(pi_val - pi_val_actual)\ncontains\n   \n  function get_nr_iters() result(nr_iters)\n      use, intrinsic :: iso_fortran_env, only : error_unit\n      implicit none\n      integer(kind=I8) :: nr_iters\n      integer(kind=I8), parameter :: default_nr_iters = 1000_I8\n      character(len=1024) :: buffer, msg\n      integer :: istat\n\n      if (command_argument_count() >= 1) then\n          call get_command_argument(1, buffer)\n          read (buffer, fmt=*, iostat=istat, iomsg=msg) nr_iters\n          if (istat /= 0) then\n              write (unit=error_unit, fmt='(2A)') &\n                  'error: ', msg\n              stop 1\n          end if\n      else\n          nr_iters = default_nr_iters\n      end if\n  end function get_nr_iters\n\nend program compute_pi_omp\n","lang":"fortran","filename":"section_computing_pi_compute_pi_openmp.f90","key":"XTt9NuyPN7"}],"key":"ZpvfmPNsTJ"}],"identifier":"49f81255","html_id":"49f81255","key":"IxBAswz1IC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dhFPWGPD9e"}],"key":"XWJCVRKDbR"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"OfNmExtYUL"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"lin