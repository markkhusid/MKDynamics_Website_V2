 A(i, :)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"gQJNbVhtaG"}],"key":"hSmcLcZAcW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hCHNhUG9A4"}],"key":"Dn9wSs5Mr0"}],"key":"gGgJ7pxvDG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"QIxkhQbeG4"},{"type":"outputs","id":"ClA25HvBp_LfnGCu_1YJf","children":[],"key":"BqhtFczbxt"}],"key":"hM6txIHmfc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Elemental_Subroutine\"","key":"t5HkREFBjr"},{"type":"outputs","id":"1veLtsiqO1BthJ_Ml4XGf","children":[],"key":"CIUfTcr1yy"}],"key":"tl0t0axT7l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"tSqE1tAXZC"},{"type":"outputs","id":"FjVQu1qdxtE2a24yaurn9","children":[],"key":"amk7TJxvm3"}],"key":"uXfk7noriP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"yLUJaF3SSS"},{"type":