:"mtDV4vXTag"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"oa9eui0uZz"}],"key":"YHTW1Y5F5x"}],"key":"ZydgAaQVCe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates elemental subroutines in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P6roagcXyZ"}],"identifier":"this-program-demonstrates-elemental-subroutines-in-fortran","label":"This program demonstrates elemental subroutines in Fortran.","html_id":"this-program-demonstrates-elemental-subroutines-in-fortran","implicit":true,"key":"AhyOtB6YUM"}],"key":"lG91HbmWQ3"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program elemental_subroutine\n    implicit none\n    real, dimension(3, 4) :: A, B, C\n    integer :: i\n\n    A = reshape([ (i, i=1, 12) ], shape(A))\n    call compute(A, B, C)\n    print '(A)', 'A'\n    do i = 1, 3\n        print '(*(F7.2))', A(i, :)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"umrEfxeka2"}],"key":"DHcc4uxTTn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":