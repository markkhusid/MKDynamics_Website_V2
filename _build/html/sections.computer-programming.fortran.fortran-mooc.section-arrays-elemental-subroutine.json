:"ysTvFdDxPx"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"IppLw0Zgpz"}],"key":"ZX10TMH7nC"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"NhNs5mnGOs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates elemental subroutines in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Fa5K3NmkKX"}],"identifier":"this-program-demonstrates-elemental-subroutines-in-fortran","label":"This program demonstrates elemental subroutines in Fortran.","html_id":"this-program-demonstrates-elemental-subroutines-in-fortran","implicit":true,"key":"vbWDgLirHi"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"r10m3u1t7L"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program elemental_subroutine\n    implicit none\n    real, dimension(3, 4) :: A, B, C\n    integer :: i\n\n    A = reshape([ (i, i=1, 12) ], shape(A))\n    call compute(A, B, C)\n    print '(A)', 'A'\n    do i = 1, 3\n        print '(*(F7.2))', A(i, :)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"gpx28G2L1b"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","k