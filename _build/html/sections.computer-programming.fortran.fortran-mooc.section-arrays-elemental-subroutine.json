 A(i, :)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"IDUJbCRnFE"}],"key":"ZhBxaTQpAv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SiYTQIjLz7"}],"key":"tzQYJTfaCc"}],"key":"nkhmTQkW5a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"Yzow9q93ob"},{"type":"outputs","id":"1k2utly5H2wrXC2_-lZ7t","children":[],"key":"o0YZo1bdtm"}],"key":"AAeYVhdMoh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Elemental_Subroutine\"","key":"Wxa4KJ5777"},{"type":"outputs","id":"Mz0cLjWlPpTXkXpGC9XgP","children":[],"key":"FoI06YUJWA"}],"key":"IviR0Pbfbn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"CvYlnq5jKU"},{"type":"outputs","id":"IRWvlxCcnxPyk1dmYKW75","children":[],"key":"ZWCEYSOyPX"}],"key":"NWkTAXCu8v"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"WrMQf1bCWl"},{"type":