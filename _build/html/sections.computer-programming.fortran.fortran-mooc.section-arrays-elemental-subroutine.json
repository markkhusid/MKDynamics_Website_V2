 A(i, :)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"g59y1YD4nT"}],"key":"h6LVXbOXdm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DgWMT0UKob"}],"key":"eE1Rbonvnd"}],"key":"shm8Cxhc1u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"HjSvKQTVf0"},{"type":"outputs","id":"-gOrz32vbz53ADAdKjbI6","children":[],"key":"KQPyrdvhe6"}],"key":"Rb6vhWNbBj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Elemental_Subroutine\"","key":"P0O6k3hH2H"},{"type":"outputs","id":"EACRfE1CpBSd6MxarMQDT","children":[],"key":"VPkRYT6wpG"}],"key":"ty2JJcXZaj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"DmyTUvJ3L2"},{"type":"outputs","id":"zsuV4w2ngbaU2WbjFdkQz","children":[],"key":"G3odW1hAtD"}],"key":"VRyYCHzuQv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"rb4VTai8JT"},{"type":