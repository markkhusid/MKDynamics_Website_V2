s%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s3vNLpX7M2"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"oLyWUt31G3"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pVQuYb5K5O"}],"key":"SnWTvBgiCS"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"Ey3QO0ouYy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates program structure in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gBhKErKm97"}],"identifier":"program-that-demonstrates-program-structure-in-c","label":"Program that demonstrates program structure in C++","html_id":"program-that-demonstrates-program-structure-in-c","implicit":true,"key":"D9plaUMoEU"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"uEldcngaQM"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Greatest common divisor program.\n#include <iostream>\n#include <assert.h>\n\nint gcd(int m, int n)   // function declartion\n{                       // block\n    int r;              // declaration of remainder\n\n    while (n != 0) {    // not equal\n        r = m % n;      // modulo operator\n        m = n;          // assignment\n        n = r;\n    }                   // end while loop\n\n    return m;           // exit gcd with value m\n}\n\nint main()\n{\n    int x, y, g;\n\n    std::cout << \"\\nProgram GCD C++\";\n    do {\n        std::cout << \"\\nEnter two integers: \";\n        std::cin >> x >> y;\n        assert(x * y != 0); // precondition on GCD\n        std::cout << \"\\nGCD(\" << x << \", \" << y << \") = \"\n             << (g = gcd(x, y)) << std::endl;\n        assert(x % g == 0 && y % g ==0); // postcondition\n    } while (x != y);\n}","key":"xCE64ZQxVE"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"oBuKxxd4oB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fpSr91Fs9F"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"u6uwYstALD"}],"identifier":"92c7a436","html_id":"92c7a436","key":"KNYzueopHd"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dKQC1apuIi"}],"key":"HSBGubetZS"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"SZhjd0ga12"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ACPsHNU0hp"},{"type":"outputs","id":"anM-f1gMQk1Dzei7s2K0I","children":[],"key":"W8RrEkmJAV"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f9