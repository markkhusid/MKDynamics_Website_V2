t i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"oT289eBdZD"}],"key":"DhC3OjZbU8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YX5rbWxJq8"}],"key":"v8olz6K0t4"}],"key":"RyDfjLtxjc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"jgxhIhMdeQ"},{"type":"outputs","id":"c3e_LdoiC3uv4e33otHNP","children":[],"key":"MuAvIcbft0"}],"key":"po1FwVhu0C"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"ufhz2Fu0r1"},{"type":"outputs","id":"pzzxYTwFgbzxjTOHU3lKW","children":[],"key":"wfqd9xFsen"}],"key":"RpGkDR7LCj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"HIG0iHCK6Q"},{"type":"outputs","id":"irm3_I5reGz2t6IiDj56D","children":[],"key":"PXYccxsrb7"}],"key":"lSGEJZ2ghy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")","key":"xdX0TlfFHF"},{"type":"outputs","id":"