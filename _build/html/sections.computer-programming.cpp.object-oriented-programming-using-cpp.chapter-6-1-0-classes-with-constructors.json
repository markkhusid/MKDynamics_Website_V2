ented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Modulo numbers and constructor initialization\n\n#include  <iostream>\n\nusing namespace std;\n\nconst int  modulus = 60;\n\n// Modulo numbers and constructor initialization\nclass  mod_int {\npublic:\n   mod_int(int i);     //constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"fd84GUlTDi"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"AYmmZVt6VH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Fko1mXrWLv"}],"key":"E7ONXkJG9P"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"cA8VOD99ZU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"puYbSRpinH"},{"type":"outputs","id":"sbeWeZNLzcyweCkhWuzaa","children":[],"key":"OwPtgbf6KE"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"BX47r88DpI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"F3OSNJu26r"},{"type":"outputs","id":"jIXvuV70uMBM_lsXqpI1-","children":[],"key":"guBqy91CSt"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"PrWM95Jc2w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"r7UaJ2sxZd"},{"type":"outputs","id":"_8yyGJmOX5ulzU6oE98L9","children":[],"key":"DpSibQRsjx"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"VnxKYuuhsA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")","key":"SAZA3AJEdv"},{"type":"outputs","id":"XV0ghk3NDEaHnUUpc00wY","children":[],"key":"iAEpGXF9dH"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"RxpTD84Mza"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./modulo\")","key":"Po0WwsPooV"},{"type":"outputs","id":"W3LdRe_z3KF1RIy9I8-5I","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"400 seconds equals 6 minutes 40\t seconds\n"},"children":[],"key":"LspYH5wBzb"}],"key":"EfnwlhwMF9"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"VRQez5nJS8"}],"key":"ZDiyYnVTBS"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chapter 6: Object Creation and Destruction","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/object-oriented-programming-using-cpp-ch-6","group":"Computer Programming"},"next":{"title":"Constructors as Conversions","url":"/sections/computer-progr