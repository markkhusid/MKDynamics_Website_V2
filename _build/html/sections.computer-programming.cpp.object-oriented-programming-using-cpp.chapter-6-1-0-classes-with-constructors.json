ented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Modulo numbers and constructor initialization\n\n#include  <iostream>\n\nusing namespace std;\n\nconst int  modulus = 60;\n\n// Modulo numbers and constructor initialization\nclass  mod_int {\npublic:\n   mod_int(int i);     //constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"FaiEK557o7"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"PaXj87TvAy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"U5ASUZEnoW"}],"key":"phB6WHG9Uy"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"w1s5CNFCVZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"yKMkUwgfnw"},{"type":"outputs","id":"UQr_0YAKnQysQrrvSt7Y7","children":[],"key":"JI64pEa5ND"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"lhavKj77Ww"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python",