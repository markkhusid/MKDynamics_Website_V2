     //constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"iRhxa3xQPn"}],"key":"cijwtdKVwM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MYDPxYpkXh"}],"key":"Gj8zSKVuiM"}],"key":"PtCrFceho8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"o6cRAqsvZr"},{"type":"outputs","id":"zg7KGX1H-vOJ76ZNeTrSr","children":[],"key":"Zfek4zMby5"}],"key":"pkX3zQAVYA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"tIvYVtFLbn"},{"type":"outputs","id":"7syix9_Ttbz5c-R2xDfFl","children":[],"key":"hioOv0Xjoq"}],"key":"B9Ymz9WTgy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"UCV7gS4I6Q"},{"type":"outputs","id":"1NuFzOvwFbSPA6NQNLU3i","children":[],"key":"yBr9xbkTwT"}],"key":"dCWOES38xf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modul