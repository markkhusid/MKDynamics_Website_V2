:[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates classes with constructors in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZG48fXwh6X"}],"identifier":"program-that-demonstrates-classes-with-constructors-in-c","label":"Program that demonstrates classes with constructors in C++","html_id":"program-that-demonstrates-classes-with-constructors-in-c","implicit":true,"key":"lvpZQPOYxD"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"GZbipr7IW5"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  modulo.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.1    Classes with Constructors\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Modulo numbers and constructor initialization\n\n#include  <iostream>\n\nusing namespace std;\n\nconst int  modulus = 60;\n\n// Modulo numbers and constructor initialization\nclass  mod_int {\npublic:\n   mod_int(int i);     //constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"lk7mFqGXL0"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"LZhZuo2zzj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CDcPkiNld2"}],"key":"dAxUPUPjfk"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"LmxfcuCUTE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"mfw2sI6qQ2"},{"type":"outputs","id":"fk65-0BWHsLLB_6OD_dE-","children":[],"key":"H1dvj9tsP0"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"AJJjiYbffm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"i1Foc30wbO"},{"type":"outputs","id":"_PW5aKNOAEdB5J5ODVb4q","children":[],"key":"rUAtKPpkRd"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"BbKOl025CB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"IpBLDu8nIR"},{"type":"outputs","id":"ROD4NuQaWY5Yi2Etk-qe1","children":[],"key":"etlMOTqBZC"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"nv4GrsQD7Q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")","key":"POjwYgMlfH"},{"type":"outputs","id":"X6FtRQLe9PsxS_nskkHRK","children":[],"key":"Gd5vGjYoaA"}],"identifier":"a7