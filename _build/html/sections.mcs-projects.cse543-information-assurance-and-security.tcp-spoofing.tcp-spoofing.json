{"version":3,"kind":"Article","sha256":"35d847e7e48a858776a52985bd75ca68b84b0455e605839a747eb878ee67ffee","slug":"sections.mcs-projects.cse543-information-assurance-and-security.tcp-spoofing.tcp-spoofing","location":"/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/TCP_Spoofing/TCP_Spoofing.md","dependencies":[],"frontmatter":{"title":"CSE543 Information Assurance and Security - TCP Spoofing","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/TCP_Spoofing/TCP_Spoofing.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE543_Information_Assurance_and_Security/TCP_Spoofing/TCP_Spoofing.md","exports":[{"format":"md","filename":"TCP_Spoofing.md","url":"/build/TCP_Spoofing-94b532cccc413e9783d29b3caec9e97c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b3A4GaKoBL"}],"key":"wwEz1XpujL"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"TCP names a connection by addresses, ports, and sequence numbers. The sequence number is supposed to be hard to guess. This lab asked for a conversation that appeared to come from a host that was not the one sending the packets.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bOjehvqrhe"}],"key":"UbM5Igu1Jl"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What the submission did","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Q41lERi3qS"}],"identifier":"what-the-submission-did","label":"What the submission did","html_id":"what-the-submission-did","implicit":true,"key":"jIy38H9q7m"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The submission watched the sequence numbers a lab server chose, then sent packets whose source address was not the machine that transmitted them. A raw socket let the script fill in that address itself, instead of leaving it to the operating system. The server accepted a guessed sequence and continued the exchange.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"XpQGoic2qj"}],"key":"MORH20CMcd"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Why that is a weak authenticator","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"J4LC4pntFx"}],"identifier":"why-that-is-a-weak-authenticator","label":"Why that is a weak authenticator","html_id":"why-that-is-a-weak-authenticator","implicit":true,"key":"j0oqvtc70w"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"A source address is a field the sender writes. It is not proof of who sent the packet. The sequence number is the only secret in a classic handshake, and only when it is unpredictable. When the numbers follow a pattern, a third party can try likely values until one is accepted. The host that owns the address is not in the conversation.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Xmn2FEtSsq"}],"key":"xGmRkiHfk9"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Current stacks randomize the initial sequence number and drop packets that do not belong to a socket they opened. An application should still not treat a finished handshake as proof of a user. That proof belongs in a protocol above TCP.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"A775ojWHda"}],"key":"bO0j6Qr5YL"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"What stayed off this page","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"hWI6Yo313C"}],"identifier":"what-stayed-off-this-page","label":"What stayed off this page","html_id":"what-stayed-off-this-page","implicit":true,"key":"LBvlGfmw6w"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The packet layouts, the search over sequence numbers, the lab host name, and the script that sent the packets are not published.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Sv5b6ZiRAz"}],"key":"t7bOwn0nmA"}],"key":"o9sL7HB4R7"}],"key":"NHJyfG47OV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE543 Information Assurance and Security - Pwn Them All","url":"/sections/mcs-projects/cse543-information-assurance-and-security/pwn-them-all/pwn-them-all","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"CSE543 Information Assurance and Security - UDP Spoofing","url":"/sections/mcs-projects/cse543-information-assurance-and-security/udp-spoofing/udp-spoofing","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"https://www.mkdynamics.net"}