/tree/master/source_code/arrays","error":true,"key":"RzBCKNeGrL"}],"key":"Fj52Bg8OUr"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"FTG0jylfJP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zt2MG1Tsgh"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"maxval","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hwoJP7HsLN"}],"key":"sGZ9SpmKSd"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mq4iJjPNrn"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"maxloc","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PC2O6GzMKm"}],"key":"u2Ozl12Kcb"},{"type":"text","value":" intrinsic functions in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OczPQKdofG"}],"identifier":"this-program-demonstrates-the-maxval-and-maxloc-intrinsic-functions-in-fortran","label":"This program demonstrates the maxval and maxloc intrinsic functions in Fortran.","html_id":"this-program-demonstrates-the-maxval-and-maxloc-intrinsic-functions-in-fortran","implicit":true,"key":"cXbpRlxxi9"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"zFF85re2Wu"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program max_array\n    implicit none\n    integer, dimension(3, 4) :: A\n    integer :: i, j\n    character(len=10), parameter :: FMT = '(A, 4I13)'\n\n    A = reshape (  [ &\n                    ( &\n                      ((i - 1)*size(A, 2) + j, &\n                        j=1,size(A, 2)), &\n                        i=1,size(A, 1) &\n                    ) &\n                  ], &\n                  shape(A) &\n                ) - 8\n\n    ! Print out array\n    do i = 1, size(A, 1)\n        print *, A(i, :)\n    end do\n\n    print *\n\n    print FMT, 'maximum =                       ', maxval(A)\n    print FMT, 'row maximum =                   ', maxval(A, dim=1)\n    print FMT, 'column maximum =                ', maxval(A, dim=2)\n    print FMT, 'maximum odd elment =            ', maxval(A, mask=mod(A, 2) /= 0)\n    print FMT, 'row maximum negative element =  ', maxval(A, dim=2, mask=A < 0)\n    print FMT, 'maxloc (row, col) =             ', maxloc(A)\n    print FMT, 'column maxloc (columns) =       ', maxloc(A, dim=2)\nend program max_array","position":{"start":{"line":1,"column":1},"end":{"line":33,"column":1}},"key":"y7uevFwMp2"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"tOetKTbqte"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FbOOP2y0P0"}],"key":"pgotxsKAfy"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"TaECSaG7d6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YXorTqST8M"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Pr