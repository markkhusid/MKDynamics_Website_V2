          << w1.comp_tot() \n            << \" w2 \" \n            << w2.comp_tot() \n            << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":52,"column":1}},"key":"VmEAdRy1s2"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"HfpoI7zLMk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bemhQsPmY7"}],"key":"fIW0RlooMH"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"sGUFyPbbZ7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"AV8JfXcPOF"},{"type":"outputs","id":"zv0bucJEtCngUNPRmlxuC","children":[],"key":"OZeAym5gqJ"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"stcceZvtLa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_8_Static_and_Const_Member_Functions\"","key":"MxQbIN5kj6"},{"type":"outputs","id":"VGyRMNkHN43MZh1cZjGd_","children":[],"key":"AdwoWNGAEK"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"zKpGca7UlQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"Fd7ZoPdadW"},{"type":"outputs","id":"8IAismKwDyw-UXYiW1Dcg","children":[],"key":"XuPKtrpJYx"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"dM1ZqAfPiH"},{"type":"block","kind":"notebook-code","chi