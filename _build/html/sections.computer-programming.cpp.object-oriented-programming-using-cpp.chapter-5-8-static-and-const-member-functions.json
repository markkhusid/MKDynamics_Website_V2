tart":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"CONST","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QwuifdBD2C"}],"key":"FNRpeoUjLq"},{"type":"text","value":" member functions in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KFq6vjICE2"}],"identifier":"program-that-demonstrates-the-static-and-const-member-functions-in-c","label":"Program that demonstrates the STATIC and CONST member functions in C++","html_id":"program-that-demonstrates-the-static-and-const-member-functions-in-c","implicit":true,"key":"aHmWzz06hF"}],"key":"RpJVFuhpPs"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"#include <iostream>\n\nusing namespace std;\n\n// Calculate salary using static members\nclass salary {\npublic:\n    void init(int b) {\n        b_sal = b;\n        your_bonus = 0;\n    }\n\n    void calc_bonus(double perc) {\n        your_bonus = b_sal * perc;\n    }\n\n    static void reset_all(int p) {\n        all_bonus = p;\n    }\n\n    int comp_tot() const {\n        return (b_sal + your_bonus + all_bonus);\n    }\n\nprivate:\n    int         b_sal;\n    int         your_bonus;\n    static int  all_bonus;      // declaration\n};\n\n// declaration and definition\nint salary::all_bonus = 100;\n\nint main() {\n    salary w1, w2;\n\n    w1.init(1000);\n    w2.init(2000);\n\n    w1.calc_bonus(0.2);\n    w2.calc_bonus(0.15);\n\n    salary::reset_all(400);\n\n    cout    << \" w1 \"\n            << w1.comp_tot() \n            << \" w2 \" \n            << w2.comp_tot() \n            << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":52,"column":1}},"key":"Zixi0MuqEy"}],"key":"ExWkhqulGP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu C