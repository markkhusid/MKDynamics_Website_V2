_sal;\n    int         your_bonus;\n    static int  all_bonus;      // declaration\n};\n\n// declaration and definition\nint salary::all_bonus = 100;\n\nint main() {\n    salary w1, w2;\n\n    w1.init(1000);\n    w2.init(2000);\n\n    w1.calc_bonus(0.2);\n    w2.calc_bonus(0.15);\n\n    salary::reset_all(400);\n\n    cout    << \" w1 \"\n            << w1.comp_tot() \n            << \" w2 \" \n            << w2.comp_tot() \n            << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":52,"column":1}},"key":"ehmaRiBJoM"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"FnnTPV4XtQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"onZ7aLf1Ph"}],"key":"d2WJJdirx2"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"gYMTGrEWHt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"gpcNlhBfZn"},{"type":"outputs","id":"NeMNnwtTN63fUkvLdMJWI","children":[],"key":"bbgvnvQGyy"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"Tq3Isx86ov"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_8_Static_and_Const_Member_Functions\"","key":"S4dU2Y60Zy"},{"type":"outputs","id":"fbwSDjBsogCqmScoBsfGN","children":[],"key":"rGdXXZCUzb"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"QbfDqaYbuf"},{"type":"block","kind":"notebook-code","children":[{"