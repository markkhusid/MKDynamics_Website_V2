umn":1}},"key":"sXdNyG5VvD"}],"identifier":"program-that-demonstrates-the-static-and-const-member-functions-in-c","label":"Program that demonstrates the STATIC and CONST member functions in C++","html_id":"program-that-demonstrates-the-static-and-const-member-functions-in-c","implicit":true,"key":"DiPgnVhPPK"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"jXR5t3mh9L"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"#include <iostream>\n\nusing namespace std;\n\n// Calculate salary using static members\nclass salary {\npublic:\n    void init(int b) {\n        b_sal = b;\n        your_bonus = 0;\n    }\n\n    void calc_bonus(double perc) {\n        your_bonus = b_sal * perc;\n    }\n\n    static void reset_all(int p) {\n        all_bonus = p;\n    }\n\n    int comp_tot() const {\n        return (b_sal + your_bonus + all_bonus);\n    }\n\nprivate:\n    int         b_sal;\n    int         your_bonus;\n    static int  all_bonus;      // declaration\n};\n\n// declaration and definition\nint salary::all_bonus = 100;\n\nint main() {\n    salary w1, w2;\n\n    w1.init(1000);\n    w2.init(2000);\n\n    w1.calc_bonus(0.2);\n    w2.calc_bonus(0.15);\n\n    salary::reset_all(400);\n\n    cout    << \" w1 \"\n            << w1.comp_tot() \n            << \" w2 \" \n            << w2.comp_tot() \n            << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":52,"column":1}},"key":"oEqY8rlURZ"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"Tleaphcpj3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GGXyrOA0my"}],"key":"zVYCKOAQR7"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"eQ2avY7aoW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"r1ubFl1FkU"},{"type":"outputs","id":"-7bhp-Gj4WTkVbqJnAvnw","children":[],"key":"AjqgN0ow4B"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"CTwoANtYDQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_8_Static_and_Const_Member_Functions\"","key":"bf4EuLeFzy"},{"type":"outputs","id":"-bBvFA9a8RQmBsMPb6cn8","children":[],"key":"pYs0pPPEQt"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"OgZzQjXa1q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"j8AJH5Q1Vs"},{"type":"outputs","id":"HXRffMw40ih-fTcuYs-g2","children":[],"key":"tGKTcLv6lU"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"LT4HBRWhVx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ salary.cpp -w -o salary\")","key":"zzRkTvehNQ"},{"type":"outputs","id":"L4I4dl2yY2sB9kCT2zwgi","children":[],"key":"J7R5PcwHqW"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"P6REmkHwXv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./salary\")","key":"Axgp1DimeT"},{"type":"outputs","id":"BphVGv9PIqqI92PcOztPa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" w1 1600 w2 2700\n"},