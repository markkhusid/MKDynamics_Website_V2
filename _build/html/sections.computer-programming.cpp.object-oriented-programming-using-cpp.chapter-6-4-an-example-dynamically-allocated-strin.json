{"version":3,"kind":"Notebook","sha256":"ce7101bb81f44e586c1052701881898c73f96bae2869ee68628f52f64220728e","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-6-4-an-example-dynamically-allocated-strin","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_6_4_An_Example__Dynamically_Allocated_Strings.ipynb","dependencies":[],"frontmatter":{"title":"An Example:  Dynamically Allocated Strings","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_6_4_An_Example__Dynamically_Allocated_Strings.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_6_4_An_Example__Dynamically_Allocated_Strings.ipynb","exports":[{"format":"ipynb","filename":"Chapter_6_4_An_Example__Dynamically_Allocated_Strings.ipynb","url":"/build/Chapter_6_4_An_Examp-c1cf3760da3c1661a3f929b5775d54c6.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i9Qb14O5Ta"}],"key":"WwPVYXyPKh"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"oBeivpUwSP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates dynamically allocated strings using classes in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"raD7D9gYHK"}],"identifier":"program-that-demonstrates-dynamically-allocated-strings-using-classes-in-c","label":"Program that demonstrates dynamically allocated strings using classes in C++","html_id":"program-that-demonstrates-dynamically-allocated-strings-using-classes-in-c","implicit":true,"key":"hmuWlcfgPH"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"Rc4Tvinnph"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"//An implementation of dynamically allocated strings.\n#include <iostream>\n#include <string.h>\n#include <assert.h>\n\nusing namespace std;\n\nclass my_string {\npublic:\n    my_string() : len(0) {\n        s = new char[1];\n        assert (s != 0);\n        s[0] - 0;\n    }\n\n    my_string(const my_string& str);    // copy constructor\n    \n    my_string(const char* p);           // conversion constructor\n    \n    ~my_string () {\n        delete []s;\n    }\n\n    void assign(const my_string& str);\n\n    void print() const {\n        cout << s << endl;\n    }\n\n    void concat(const my_string& a, const my_string& b);\n\nprivate:\n    char* s;\n    int len;\n};\n\nmy_string::my_string(const char* p)\n{\n    len = strlen(p);\n    s = new char[len +1];\n    assert (s != 0);\n    strcpy(s, p);\n}\n\nmy_string::my_string(const my_string& str) : len(str.len)\n{\n    s = new char[len + 1];\n    assert(s != 0);\n    strcpy(s, str.s);\n}\n\nvoid my_string::assign(const my_string& str)\n{\n    if (this == &str)       // a = a; do nothing\n        return;\n    delete []s;\n    len = str.len;\n    s = new char[len + 1];\n    assert(s != 0);\n    strcpy(s, str.s);\n}\n\nvoid my_string::concat(const my_string& a, const my_string& b)\n{\n    char* temp = new char[a.len + b.len + 1];\n    len = a.len + b.len;\n    strcpy(temp, a.s);\n    strcat(temp, b.s);\n    delete []s;\n    s = new char[len + 1];\n    assert(s != 0);\n    strcpy(s, temp);\n}\n\nint main()\n{\n    char* str = \"The wheel that squeaks the loudest\\n\";\n    my_string a(str), b, author(\"Josh Billings\\n\"), both, quote;\n\n    b.assign(\"Is the one that gets the grease\\n\");\n    both.concat(a, b);\n    quote.concat(both, author);\n    quote.print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":86,"column":1}},"key":"hxAnr0FBsF"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"Mk7awYdRik"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xNcsc6AApa"}],"key":"XW2eRuRYJj"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"qPxGJExTFx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ABYHG2EEth"},{"type":"outputs","id":"nX92uHoiAwv6C8HF_5BzV","children":[],"key":"vrdtVl3Ie1"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"Posk3a1KVD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_4_An_Example__Dynamically_Allocated_Strings\"","key":"LAgKKn61kk"},{"type":"outputs","id":"SOyLdps3wKEmV5kZXTYEB","children":[],"key":"Zj0813Djzj"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"aXue6hoco6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"qfT3FPgJr8"},{"type":"outputs","id":"n2GsjYP5mE1tNQPe7uKox","children":[],"key":"ltMsclVxNF"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"c326mIJb9b"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ string5.cpp -w -o string5\")","key":"AFd4z19xtq"},{"type":"outputs","id":"MWODgTEcgL3T_1S82PrnF","children":[],"key":"ASQcU1nHZm"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"xTN3AAFIY5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./string5\")","key":"nwDNilHPvd"},{"type":"outputs","id":"atXaHChpWyx6V2w4t6a4P","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The wheel that squeaks the loudest\nIs the one that gets the grease\nJosh Billings\n\n"},"children":[],"key":"Z87WnepAb5"}],"key":"InGc2PYDt6"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"wvxt67may0"}],"key":"QGz8iyGDj1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"6.3 Classes with Destructors","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-6-3-classes-with-destructors","group":"Computer Programming"},"next":{"title":"A Class Vect","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-6-5-a-class-vect","group":"Computer Programming"}}},"domain":"https://www.mkdynamics.net"}