(lat1, lon1, lat2, lon2))\n    dlat = lat2 - lat1\n    dlon = lon2 - lon1\n    a = sin(dlat / 2) ** 2 + cos(lat1) * cos(lat2) * sin(dlon / 2) ** 2\n    return radius_km * 2 * atan2(sqrt(a), sqrt(1 - a))\n\nsite_lat, site_lon = 28.563197, -80.576820\npoints = {\n    \"coastline\": (28.56284, -80.56788),\n    \"highway\": (28.56258, -80.57067),\n    \"railway\": (28.57205, -80.58525),\n    \"Melbourne\": (28.10159, -80.64229),\n}\ndistances_km = {\n    name: kilometers(site_lat, site_lon, lat, lon)\n    for name, (lat, lon) in points.items()\n}","position":{"start":{"line":5,"column":1},"end":{"line":27,"column":1}},"key":"hGsbEpXSMN"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"inlineCode","value":"distances_km","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"mvYNiv1oqd"},{"type":"text","value":" rounds to 0.874 km, 0.605 km, 1.284 km, and 51.743 km. The figures quoted above are those values to two or three significant digits: 0.87, 0.60, 1.28, and 51.7.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Jt558ZT22l"}],"key":"h5VfPwmbEO"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"The dashboard is a dropdown of launch sites, a success pie, a payload slider, and a scatter of payload against landing class colored by booster version. The screenshots below are the two views saved on 6 November 2022.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"wfvto6CJOP"}],"key":"bWPLtuCl1X"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Dashboard table","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"qbbHiLNZ1t"}],"identifier":"dashboard-table","label":"Dashboard table","html_id":"dashboard-table","implicit":true,"ke