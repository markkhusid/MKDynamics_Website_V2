{"version":3,"kind":"Notebook","sha256":"89bb81a0a673ba07172dd7dc2d746830a6012a2e56e2d1216fdc85d92a8ad8ea","slug":"sections.computer-programming.fortran.guide-to-fortran-2008-programming.section-3-4-putting-procedures-in-a-module","location":"/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_4_Putting_Procedures_in_a_Module.ipynb","dependencies":[],"frontmatter":{"title":"Section 3.4: Putting Procedures in a Module","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":4}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_4_Putting_Procedures_in_a_Module.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Guide_to_Fortran_2008_Programming/Section_3_4_Putting_Procedures_in_a_Module.ipynb","exports":[{"format":"ipynb","filename":"Section_3_4_Putting_Procedures_in_a_Module.ipynb","url":"/build/Section_3_4_Putting_-985d7b0024e8425789149cdb024e3e2b.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Guide to Fortran 2008 Programming” by Walter S. Brainerd (Springer 2015)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OM5fVS2Mov"}],"key":"i0cbUHogPX"}],"identifier":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","html_id":"edfc7d7e-9803-4b96-82f1-bc0d47385f43","key":"GmQM079J3Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates putting procedures into a module.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"abwMUBiIA8"}],"identifier":"program-that-demonstrates-putting-procedures-into-a-module","label":"Program that demonstrates putting procedures into a module.","html_id":"program-that-demonstrates-putting-procedures-into-a-module","implicit":true,"key":"hZbbDKIqNn"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"TEVeZdonFG"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"module sort_3_module\n\n    implicit none\n    private\n    real :: n1, n2, n3\n\n    public ::   read_the_numbers, &\n                sort_the_numbers, &\n                print_the_numbers\n\n    private swap\n\ncontains\n\n    subroutine swap(a, b)\n        real, intent(in out) :: a, b\n        real temp\n        temp = a\n        a = b\n        b = temp\n    end subroutine swap\n\n    subroutine read_the_numbers()\n        !print *, \"Enter three numbers separated by spaces:\"\n        read *, n1, n2, n3\n        write (*, '(a, f20.3)') \"Input data n1:\", n1\n        write (*, '(a, f20.3)') \"Input data n2:\", n2\n        write (*, '(a, f20.3)') \"Input data n3:\", n3\n   end subroutine read_the_numbers\n\n   subroutine sort_the_numbers()\n        if (n1 > n2) then\n            call swap(n1, n2)\n        end if\n        if (n1 > n3) then\n            call swap(n1, n3)\n        end if\n        if (n2 > n3) then\n            call swap(n2, n3)\n        end if\n    end subroutine sort_the_numbers\n\n    subroutine print_the_numbers()\n        write (*, '(a)') \"The numbers, in ascending order, are:\"\n        write (*, '(3f20.3)') n1, n2, n3\n    end subroutine print_the_numbers\n\nend module sort_3_module\n\nprogram sort_3\n\n    use sort_3_module\n    implicit none\n\n    call read_the_numbers()\n    call sort_the_numbers()\n    call print_the_numbers()\n\nend program sort_3","position":{"start":{"line":1,"column":1},"end":{"line":61,"column":1}},"key":"lMMzrqVmVb"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"Id2xYSD6IC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T6Hr4DrEnJ"}],"key":"MdyrkY4gkE"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"m20NF2bdb8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"NR2DBV48bv"},{"type":"outputs","id":"3oiIMti1TtEH4DKWCWpyR","children":[],"key":"lOQ0APnzuq"}],"identifier":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","html_id":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","key":"sVdBQplusV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_3_4_Putting_Procedures_in_a_Module\"","key":"CFnMyPHsxs"},{"type":"outputs","id":"UpXQk8ESR3XBCIcFwh399","children":[],"key":"k1tuMFyJCF"}],"identifier":"bdaf795d-554a-46e6-b4da-faeb331e1b13","html_id":"bdaf795d-554a-46e6-b4da-faeb331e1b13","key":"yVPKJmOakH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"vMnQNh1CEI"},{"type":"outputs","id":"VzoQ2c5Hg56ZKjVSr5ItE","children":[],"key":"trSXgEb0tz"}],"identifier":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","html_id":"a7d9f1b1-ba0d-4