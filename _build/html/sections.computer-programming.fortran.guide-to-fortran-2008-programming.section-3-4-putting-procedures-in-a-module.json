,"kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates putting procedures into a module.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZTGH5Iq3Sv"}],"identifier":"program-that-demonstrates-putting-procedures-into-a-module","label":"Program that demonstrates putting procedures into a module.","html_id":"program-that-demonstrates-putting-procedures-into-a-module","implicit":true,"key":"j0MHoODnYn"}],"identifier":"59ec1bec-3fd7-4061-aa24-c7765d25786f","html_id":"59ec1bec-3fd7-4061-aa24-c7765d25786f","key":"ifrS2pa414"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"module sort_3_module\n\n    implicit none\n    private\n    real :: n1, n2, n3\n\n    public ::   read_the_numbers, &\n                sort_the_numbers, &\n                print_the_numbers\n\n    private swap\n\ncontains\n\n    subroutine swap(a, b)\n        real, intent(in out) :: a, b\n        real temp\n        temp = a\n        a = b\n        b = temp\n    end subroutine swap\n\n    subroutine read_the_numbers()\n        !print *, \"Enter three numbers separated by spaces:\"\n        read *, n1, n2, n3\n        write (*, '(a, f20.3)') \"Input data n1:\", n1\n        write (*, '(a, f20.3)') \"Input data n2:\", n2\n        write (*, '(a, f20.3)') \"Input data n3:\", n3\n   end subroutine read_the_numbers\n\n   subroutine sort_the_numbers()\n        if (n1 > n2) then\n            call swap(n1, n2)\n        end if\n        if (n1 > n3) then\n            call swap(n1, n3)\n        end if\n        if (n2 > n3) then\n            call swap(n2, n3)\n        end if\n    end subroutine sort_the_numbers\n\n    subroutine print_the_numbers()\n        write (*, '(a)') \"The numbers, in ascending order, are:\"\n        write (*, '(3f20.3)') n1, n2, n3\n    end subroutine print_the_numbers\n\nend module sort_3_module\n\nprogram sort_3\n\n    use sort_3_module\n    implicit none\n\n    call read_the_numbers()\n    call sort_the_numbers()\n    call print_the_numbers()\n\nend program sort_3","position":{"start":{"line":1,"column":1},"end":{"line":61,"column":1}},"key":"DCP6FKg5FZ"}],"identifier":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","html_id":"c36821c7-3b26-404c-8a7c-2f978dfb65d4","key":"qhRmP9bSl4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iChkDgdAe1"}],"key":"mhLRyZpkPR"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"Bv0DbGucAA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"FW88cbbf9M"},{"type":"outputs","id":"F6vrTRCzMmM6H1OsvTTDy","children":[],"key":"AcmMj3Uw6h"}],"identifier":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","html_id":"e8ba1050-b7b1-4e9e-87bf-28791145e5e7","key":"hyBZyDBiMn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_3_4_Putting_Procedures_in_a_Module\"","key":"eCzcBRrhlP"},{"type":"outputs","id":"YmbdtOqQm9M3DQilNDiEK","children":[],"key":"uBMXttbFGV"}],"identifier":"bdaf795d-554a-46e6-b4da-faeb331e1b13","html_id":"bdaf795d-554a-46e6-b4da-faeb331e1b13","key":"PlmyyLfLMC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"oZL2mNCR2R"},{"type":"outputs","id":"QOzKRvSQMXRLDkW4n08aw","children":[],"key":"aI8cHe9Ngf"}],"identifier":"a7d9f1b1-ba0d-4db1-84ef-7a358f0453a6","html_id":"a7d9f1b1-ba0d-4