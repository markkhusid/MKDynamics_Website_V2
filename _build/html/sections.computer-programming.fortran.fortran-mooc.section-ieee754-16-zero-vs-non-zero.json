 '0 /= -0'\n    end if\n    print '(A, F5.1)', 'sqrt(0.0) = ', sqrt(zero)\n    print '(A, F5.1)', 'sqrt(-0.0) = ', sqrt(minus_zero)\nend program zero_vs_minus_zero","position":{"start":{"line":1,"column":1},"end":{"line":18,"column":1}},"key":"wrsE1zCTym"}],"key":"vE7DTdiERq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VWitbCIyrj"}],"key":"rOJtLPNNjk"}],"key":"ziMmZ4aUZg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ysX80AoPch"},{"type":"outputs","id":"NVjCSjhHW2H56MvUtsDaY","children":[],"key":"CvkBvBetie"}],"key":"IIi9cOLgQA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_IEEE754_Zero_vs_Non_Zero\"","key":"v1YSt7ohIF"},{"type":"outputs","id":"G7DMxBmI3kTCNuTxQhWJY","children":[],"key":"abLRCAgtO1"}],"key":"eWfp9bq2xh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"bUFQcmBClS"},{"type":"outputs","id":"q6kdFq6ZafZ8n2gNO3fci","children":[],"key":"uvp486HZg1"}],"key":"G8eU3kxrhu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"IIHubi7Bzm"},{"type":"outputs","id":"rwKKUT68YpuG_erhDtgof","children":[],"key":"gxPKDZ4TES"}],"key":"NnuAFqxmyE"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"fpm run output is piped into sed to su