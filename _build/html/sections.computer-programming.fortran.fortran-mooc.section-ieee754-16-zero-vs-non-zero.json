 '0 /= -0'\n    end if\n    print '(A, F5.1)', 'sqrt(0.0) = ', sqrt(zero)\n    print '(A, F5.1)', 'sqrt(-0.0) = ', sqrt(minus_zero)\nend program zero_vs_minus_zero","position":{"start":{"line":1,"column":1},"end":{"line":18,"column":1}},"key":"ZRZAwDgJ7t"}],"key":"GbiyYEY8ZA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RlmXW3IygH"}],"key":"mJHA7e60Wd"}],"key":"PG3wYlunj9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"KAU9rR9zp1"},{"type":"outputs","id":"UYxPhw9bvJT_RoTNN4uF-","children":[],"key":"dQoqoY99AU"}],"key":"HdH2Jq24wN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_IEEE754_Zero_vs_Non_Zero\"","key":"YLMrqaNdB7"},{"type":"outputs","id":"CZHiL1Sf7eahw4D7B40go","children":[],"key":"x1vPymh0NB"}],"key":"XWrSGq6mws"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"g3c8FS60s3"},{"type":"outputs","id":"PcCV5sMydqMKCzDWV-229","children":[],"key":"BUqaMehhO3"}],"key":"IdUJtRo5lj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"TPUB2K68qP"},{"type":"outputs","id":"BC-bMWFaUcs9oitvR820x","children":[],"key":"jM9QZuRPsF"}],"key":"Jn5oPf1NLz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"fpm run output is piped into sed to su