></span></span>","enumerator":"1","key":"XbnVL854u2"}],"key":"ING0t1rNDs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file section_computing_pi_compute_pi.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vxTlyN0b6w"}],"identifier":"in-file-section-computing-pi-compute-pi-f90","label":"In file section_computing_pi_compute_pi.f90","html_id":"in-file-section-computing-pi-compute-pi-f90","implicit":true,"key":"JNPu7dbbdx"}],"key":"uMlSfqDjMe"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Computing_Pi_Compute_Pi/app/section_computing_pi_compute_pi.f90","literal":true,"children":[{"type":"code","value":"program compute_pi\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64, I8 => INT64\n    implicit none\n    integer(kind=I8) :: i, nr_iters\n    real(kind=DP) :: delta, x, pi_val\n    real(kind=DP) :: pi_val_actual\n\n    pi_val = 0.0_DP\n    pi_val_actual = 2.0_DP * acos(0.0_DP)\n    nr_iters = get_nr_iters()\n    delta = 1.0_DP/nr_iters\n    x = 0.0_DP\n    do i = 1, nr_iters\n        pi_val = pi_val + sqrt(1.0_DP - x**2)\n        x = x + delta\n    end do\n    pi_val = 4.0_DP*pi_val/nr_iters\n    print '(A, I10, A, F25.15)', \"After \", nr_iters, \" loops, Pi = \", pi_val\n    print '(A, F25.15)', \"Actual value of Pi = \", pi_val_actual\n    print '(A, F25.15)', \"Absolute difference = \", abs(pi_val - pi_val_actual)\n\ncontains\n     \n    function get_nr_iters() result(nr_iters)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer(kind=I8) :: nr_iters\n        integer(kind=I8), parameter :: default_nr_iters = 1000_I8\n        character(len=1024) :: buffer, msg\n        integer :: istat\n\n        if (command_argument_count() >= 1) then\n            call get_command_argument(1, buffer)\n            read (buffer, fmt=*, iostat=istat, iomsg=msg) nr_iters\n            if (istat /= 0) then\n                write (unit=error_unit, fmt='(2A)') &\n                    'error: ', msg\n                stop 1\n            end if\n        else\n            nr_iters = default_nr_iters\n        end if\n    end function get_nr_iters\n\nend program compute_pi\n","lang":"fortran","filename":"section_computing_pi_compute_pi.f90","key":"FyVg675220"}],"key":"rBBPZlaMul"}],"key":"T4zlo8QOD7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VDcU4mSXHV"}],"key":"vydq0e4PrJ"}],"key":"XajZKP8AFX"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"d7oUBIBlWi"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"zi7yb0lOIJ"}],"visibility":"show","key":"b7oTxNdr0D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"cy1rH55slX"},{"type":"outputs","id":"5iwMfulKjt9FOdDc2vGrl","children":[],"key":"O0XH4L7cnY"}],"key":"d6BvdEnnDk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following 