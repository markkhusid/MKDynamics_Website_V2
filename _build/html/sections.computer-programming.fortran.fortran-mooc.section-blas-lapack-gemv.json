il_mod\n    implicit none\n    integer, parameter :: rows = 3, cols = 2\n    integer :: i\n    real, dimension(rows, cols) :: A = reshape( [ (real(i), i=1, rows*cols) ], [ rows, cols ])\n    real, dimension(cols) :: v = [ 1.0, 2.0 ]\n    real, dimension(rows) :: u\n    character(len=12) :: fmt_str = '(*(F6.1))'\n   \n    ! Define explicit interface for the BLAS subroutine sgemv\n    interface\n        subroutine sgemv(trans, m, n, alpha, A, lda, x, incx, beta, y, incy)\n            character :: trans\n            integer :: m, n, lda, incx, incy\n            real :: alpha, beta\n            real, dimension(lda, *) :: A\n            real, dimension(*) :: x, y\n        end subroutine sgemv\n    end interface\n\n    call print_matrix(A, 'A', fmt_str)\n    call print_vector(v, 'v', fmt_str)\n    call sgemv('n', rows, cols, 1.0, A, rows, v, 1, 0.0, u, 1)\n    call print_vector(u, 'u', fmt_str)\n\nend program gemv_test\n","lang":"fortran","filename":"section_blas_lapack_gemv.f90","key":"msujqbw4xa"}],"key":"djJ3s6TqZK"}],"identifier":"49f81255","html_id":"49f81255","key":"P1xXLhRANL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m2u3ATgQCE"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"util_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G2gUECd69a"}],"key":"uuClcXtFB5"}],"key":"ysmUuAenE8"}],"identifier":"452abd72","html_id":"452abd72-1","key":"HJ0mQ03rlo"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/src/util_mod.f90","literal":true,"children":[{"type":"code","value":"module util_mod\n    implicit none\n\n    private\n\n    public :: print_vector, print_matrix\n\ncontains\n\n    subroutine print_vector(vector, label, fmt_str_in)\n        implicit none\n        real, dimension(:), intent(in) :: vector\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        print fmt_str, vector\n    end subroutine print_vector\n\n    subroutine print_matrix(matrix, label, fmt_str_in)\n        implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n        integer :: row\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        do row = 1, size(matrix, 1)\n            print fmt_str, matrix(row, :)\n        end do\n    end subroutine print_matrix\n\nend module util_mod\n","lang":"fortran","filename":"util_mod.f90","key":"DbJcmB5lei"}],"key":"sRxqzh23tz"}],"identifier":"49f81255","html_id":"49f81255-1","key":"vcYaBPTJWu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uR8QK4lbx7"}],"key":"IxY89hnlhq"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"U1hUMxHBHd"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jskIUIQf2O"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"adajkulmPi"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility":"show","key":"iGkVVacOIo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"i5VYst9K6m"},{"type":"outputs","id":"5yBxf8YX4ad9BR7p1HvMJ","children":[],"key":"p4nuwvzc6a"}],"identifier":"f16472aa-c965-4bad-a218-fee33f7b456a","html_id":"f16472aa-c965-4bad-a218-fee33f7b456a","key":"xSUtuyzN5r"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Since the code makes use of the LAPACK library, the following FPM configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dtKUkhQ6BZ"}],"key":"jY4I8kdl45"}],"identifier":"48d176ac","html_id":"48d176ac","key":"IFcRKZgfiu"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/fpm.toml","literal":true,"children":[{"type":"code","value":"name = \"Section_BLAS_LAPACK_GEMV\"\n\n[build]\nauto-executables = true\nauto-tests = true\nauto-examples = true\nlink = [\"blas\", \"lapack\"]\n\n[install]\nlibrary = false\n\n[[executable]]\nname=\"Section_BLAS_LAPACK_GEMV\"\nsource-dir=\"app\"\nmain=\"section_blas_lapack_gemv.f90\"","lang":"toml","filename":"fpm.toml","key":"BQWfcrX4xT"}],"key":"KIUKykS8kg"}],"identifier":"48ce3430","html_id":"48ce3430","key":"OelVDBUbpR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":