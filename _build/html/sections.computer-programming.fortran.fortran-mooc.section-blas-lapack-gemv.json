id":"section-blas-lapack-gemv","implicit":true,"key":"slHGxPhBdw"}],"visibility":"show","key":"aaulMP5xi7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BXj1z76HpR"},{"type":"link","url":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/blas_lapack","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/gjbex​/Fortran​-MOOC​/tree​/master​/source​_code​/blas​_lapack","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jGeRsGaU0c"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/blas_lapack","error":true,"key":"YqahSDRQZL"}],"key":"NJ4RTtg8Fu"}],"key":"iEgI3uhBF1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates using the GEMV BLAS/LAPACK subroutine to perform a matrix vector product in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eMSBVmdRuj"}],"identifier":"this-program-demonstrates-using-the-gemv-blas-lapack-subroutine-to-perform-a-matrix-vector-product-in-fortran","label":"This program demonstrates using the GEMV BLAS/LAPACK subroutine to perform a matrix vector product in Fortran.","html_id":"this-program-demonstrates-using-the-gemv-blas-lapack-subroutine-to-perform-a-matrix-vector-product-in-fortran","implicit":true,"key":"erytFjxarU"}],"key":"kcNGDLdVnt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"I6NBRleqfw"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"section_blas_lapack_gemv.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BvszXrQ1jq"}],"key":"MtST5r9NbI"}],"key":"CUOcZ1l2OY"}],"key":"oK24aRAFA2"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/app/section_blas_lapack_gemv.f90","literal":true,"children":[{"type":"code","value":"program gemv_test\n    use :: util_mod\n    implicit none\n    integer, parameter :: rows = 3, cols = 2\n    integer :: i\n    real, dimension(rows, cols) :: A = reshape( [ (real(i), i=1, rows*cols) ], [ rows, cols ])\n    real, dimension(cols) :: v = [ 1.0, 2.0 ]\n    real, dimension(rows) :: u\n    character(len=12) :: fmt_str = '(*(F6.1))'\n   \n    ! Define explicit interface for the BLAS subroutine sgemv\n    interface\n        subroutine sgemv(trans, m, n, alpha, A, lda, x, incx, beta, y, incy)\n            character :: trans\n            integer :: m, n, lda, incx, incy\n            real :: alpha, beta\n            real, dimension(lda, *) :: A\n            real, dimension(*) :: x, y\n        end subroutine sgemv\n    end interface\n\n    call print_matrix(A, 'A', fmt_str)\n    call print_vector(v, 'v', fmt_str)\n    call sgemv('n', rows, cols, 1.0, A, rows, v, 1, 0.0, u, 1)\n    call print_vector(u, 'u', fmt_str)\n\nend program gemv_test\n","lang":"fortran","filename":"section_blas_lapack_gemv.f90","key":"Nk8QOmYHc5"}],"key":"P67z8lYNbK"}],"key":"NbWb6uRoNe"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vpmzIzCXNO"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"util_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mUHyUdfsWe"}],"key":"e0pWzoeBUG"}],"key":"RTIBK6e2NB"}],"key":"p0loqn4zpg"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/src/util_mod.f90","literal":true,"children":[{"type":"code","value":"module util_mod\n    implicit none\n\n    private\n\n    public :: print_vector, print_matrix\n\ncontains\n\n    subroutine print_vector(vector, label, fmt_str_in)\n        implicit none\n        real, dimension(:), intent(in) :: vector\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        print fmt_str, vector\n    end subroutine print_vector\n\n    subroutine print_matrix(matrix, label, fmt_str_in)\n        implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n        integer :: row\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        do row = 1, size(matrix, 1)\n            print fmt_str, matrix(row, :)\n        end do\n    end subroutine print_matrix\n\nend module util_mod\n","lang":"fortran","filename":"util_mod.f90","key":"caZTAQzKlZ"}],"key":"lHU8s5QJFx"}],"key":"jhzNOqYBhL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"c