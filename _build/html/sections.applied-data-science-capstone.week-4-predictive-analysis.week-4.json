":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"ujG47ycVk2"}],"key":"Hs3R7FNeSJ"},{"type":"code","lang":"python","value":"import numpy as np\nimport pandas as pd\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import confusion_matrix\nfrom sklearn.model_selection import GridSearchCV, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.svm import SVC\nfrom sklearn.tree import DecisionTreeClassifier\n\nflights = pd.read_csv(\"dataset_part_2.csv\")\nfeatures = pd.read_csv(\"dataset_part_3.csv\")\nX = StandardScaler().fit_transform(features.to_numpy(dtype=float))\ny = flights[\"Class\"].to_numpy()\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.2, random_state=2\n)\n\nsearches = {\n    \"logistic regression\": (\n        LogisticRegression(),\n        {\"C\": [0.01, 0.1, 1], \"penalty\": [\"l2\"], \"solver\": [\"lbfgs\"]},\n    ),\n    \"support vector machine\": (\n        SVC(),\n        {\n            \"kernel\": [\"linear\", \"rbf\", \"poly\", \"sigmoid\"],\n            \"C\": np.logspace(-3, 3, 5),\n            \"gamma\": np.logspace(-3, 3, 5),\n        },\n    ),\n    \"decision tree\": (\n        DecisionTreeClassifier(),\n        {\n            \"criterion\": [\"gini\", \"entropy\"],\n            \"splitter\": [\"best\", \"random\"],\n            \"max_depth\": [2 * n for n in range(1, 10)],\n            \"max_features\": [\"auto\", \"sqrt\"],\n            \"min_samples_leaf\": [1, 2, 4],\n            \"min_samples_split\": [2, 5, 10],\n        },\n    ),\n    \"k nearest neighbors\": (\n        KNeighborsClassifier(),\n        {\n            \"n_neighbors\": list(range(1, 11)),\n            \"algorithm\": [\"auto\", \"ball_tree\", \"kd_tree\", \"brute\"],\n            \"p\": [1, 2],\n        },\n    ),\n}\n\nfitted = {}\nfor name, (model, grid) in searches.items():\n    search = GridSearchCV(model, grid, scoring=\"accuracy\", cv=10)\n    search.fit(X_train, y_train)\n    fitted[name] = {\n        \"cv_score\": search.best_score_,\n        \"test_accuracy\": search.score(X_test, y_test),\n        \"confusion_matrix\": confusion_matrix(y_test, search.predict(X_test)),\n    }","position":{"start":{"line":16,"column":1},"end":{"line":78,"column":1}},"key":"mAJz0Vedvn"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"inlineCode","value":"X","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"SFOMX2egWS"},{"type":"text","value":" is the 90 by 72 dummy matrix from week 2, after ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"Q4HIQCt8IH"},{"type":"inlineCode","value":"StandardScaler","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"WjYcU4Xv94"},{"type":"text","value":". ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"yfYxvLdTpo"},{"type":"inlineCode","value":"test_size=0.2","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"c5wr5BRwej"},{"type":"text","value":" and ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"okjdEnaUvB"},{"type":"inlineCode","value":"random_state=2","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"l9djH2HGV5"},{"type":"text","value":" hold out 18 rows. ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"OmkmKn0slG"},{"type":"inlineCode","value":"fitted[...][\"test_accuracy\"]","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"iNusFrq0Yv"},{"type":"text","value":" is the test column above, and ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"LHLX60Xuxk"},{"type":"inlineCode","value":"fitted[...][\"cv_score\"]","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"