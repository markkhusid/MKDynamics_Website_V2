hildren":[{"type":"inlineCode","value":"gcd.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ePzSFNa8E2"}],"identifier":"gcd-f90","label":"gcd.f90","html_id":"gcd-f90","implicit":true,"key":"eGdnOdHgnv"},{"type":"include","file":"Fortran_Code/Section_GCD/app/gcd.f90","literal":true,"children":[{"type":"code","value":"program compute_gcd\n    implicit none\n    integer, parameter :: MAX_VALUE = 10\n    integer :: a, b\n    do a = 1, MAX_VALUE\n        do b = 1, MAX_VALUE\n            print '(3I10)', a, b, gcd(a, b)\n        end do\n    end do\n\ncontains\n\n    integer function gcd(a, b)\n        implicit none\n        integer, value :: a, b\n\n        do while (a /= b)\n            if (a > b) then\n                a = a - b\n            else if (b > a) then\n                b = b - a\n            end if\n        end do\n        gcd = a\n    end function gcd\n\nend program compute_gcd\n","lang":"fortran","filename":"gcd.f90","key":"zI8wOCffY0"}],"key":"lVjFOQCm5B"}],"key":"PgL8Jjlg4q"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SubsLPixU7"}],"key":"PPpO5q69f4"}],"key":"ou1E9fn9rw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EjXEMlsvfZ"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"kuJ8yq37p8"}],"key":"V