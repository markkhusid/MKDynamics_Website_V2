nax.axhline(-3, color=\"gray\", ls=\"--\", lw=0.8)\nax.axvline(p.op.f_design_hz, color=\"C3\", ls=\":\")\nax.set_xlabel(\"Frequency (Hz)\")\nax.set_ylabel(\"|H| (dB)\")\nax.set_title(\"Bode family vs temperature (passive tempco only on H_vin)\")\nax.legend()\nax.grid(True, which=\"both\", alpha=0.3)\nfig.tight_layout()\nfig.savefig(FIG / \"06_bode_vs_temp.png\", dpi=150)\nplt.show()","key":"nDgtU9qPQy"},{"type":"outputs","id":"jw7l2sgaCy8dVK6KegPMH","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9f8a20f7a8031dd2a0a076cbfc53c451","path":"/build/9f8a20f7a8031dd2a0a076cbfc53c451.png"},"text/plain":{"content":"<Figure size 900x450 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"knWA5L4rHc"}],"key":"CPYBsciqRt"}],"identifier":"52b7cda9","html_id":"52b7cda9","key":"xjioJXaeY3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-28T15:04:57.141900Z","iopub.status.busy":"2026-07-28T15:04:57.141444Z","iopub.status.idle":"2026-07-28T15:04:58.654147Z","shell.execute_reply":"2026-07-28T15:04:58.653250Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Optional coarse SPICE temp sweep (ideal + scaled passives)\ntry:\n    temps = [-40, 25, 85, 125]\n    sts = spice_temp_sweep(\n        p, temps_c=temps,\n        workdir=ROOT / \"results\" / \"ngspice_temp\",\n        root=ROOT, opamp_model=\"ideal\",\n    )\n    display(sts.frame)\n    merged = ts.frame[ts.frame.temp_c.isin(temps)].merge(sts.frame, on=\"temp_c\")\n    fig, ax = plt.subplots(figsize=(6, 3.5))\n    ax.plot(merged.temp_c, merged.fc_hz, \"o-\", label=\"analytical\")\n    ax.plot(merged.temp_c, merged.fc_spice_hz, \"s--\", label=\"ngspice\")\n    ax.set_xlabel(\"T (°C)\")\n    ax.set_ylabel(r\"$f_c$ (Hz)\")\n    ax.legend()\n    ax.grid(True, alpha=0.3)\n    fig.tight_layout()\n    fig.savefig(FIG / \"06_fc_temp_spice_vs_an.png\", dpi=150)\n