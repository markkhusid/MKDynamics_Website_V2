,"identifier":"64c40f9e","html_id":"64c40f9e","key":"x1fXEzHFTp"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Reverse a string with a ch_stack.\n#include <iostream>\n#include \"ch_stac3.h\"\n\nusing namespace std;\n\nint main ()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Don Knuth!\"};\n    int i = 0;\n\n    cout << str << endl;\n    s.reset();  // s.top = EMPTY would be illegal\n\n    while (str[i] && !s.full())\n    {\n        s.push(str[i++]);\n    }\n\n    while (!s.empty())      // print the reverse\n    {\n        cout << s.pop();\n    }\n\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"p7RM3J0vji"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"qSxZY58O5w"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ItfBhXC4Jv"}],"key":"Pw7efrUmzY"}],"identifier":"ab0a294d","html_id":"ab0a294d","key":"BHnNUSuVCk"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"struct ch_stack {\n    public:\n        void reset ()       { top = EMPTY; }\n        void push (char c)  { top++; s[top] = c; }\n        char pop ()         { return s[top--]; }\n        char top_of ()      { return s[top]; }\n        bool empty ()       { return ( top == EMPTY ); }\n        bool full ()        { return ( top == FULL  ); }\n\n    private:\n        enum \n        {  \n            max_len = 100,\n            EMPTY = -1,\n            FULL = max_len-1\n                \n        };\n\n        char s[max_len];\n        int top;\n};","position":{"start":{"line":1,"column":1},"end":{"line":23,"column":1}},"key":"RvxaY3q9WT"}],"identifier":"4b1fdf78","html_id":"4b1fdf78","key":"aDTMcgOZ6n"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MBo84NXZeu"}],"key":"QE6DT50atC"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"ADkVRQXgkR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"oXdw1DPvyx"},{"type":"outputs","id":"Iqcp1xWMhXlfrcfZr0kTV","children":[],"key":"qBFyYqFXmm"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"Dv1XJKEHZu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_2_Access_Private_and_Public\"","key":"A4YhVlzTDB"},{"type":"outputs","id":"4vfi6-TYTJYQO8hlt16Vo","children":[],"key":"m37xCrYuYm"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"JTGHQatL8K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"CFvyX13oAg"},{"type":"outputs","id":"XkVBqI2-hz3c6ka8wzOqp","children":[],"key":"ggg5pl560g"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"D5sfdJcmIi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac3.cpp -w -o ch_stac3\")","key":"M7DcIUPRhl"},{"type":"outputs","id":"enTLVdE7UCe9l21dyygtd","children":[],"key":"abLxUtfmEW"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455