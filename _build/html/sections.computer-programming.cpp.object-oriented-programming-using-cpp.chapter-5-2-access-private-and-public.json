:{"line":1,"column":1}},"children":[{"type":"text","value":"Access: Private and Public","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gg24yFIfq8"}],"identifier":"access-private-and-public","label":"Access: Private and Public","html_id":"access-private-and-public","implicit":true,"key":"aCw9oR5wNl"}],"identifier":"4fae3c47-7ba5-411e-929d-45543f813a61","html_id":"4fae3c47-7ba5-411e-929d-45543f813a61","visibility":"show","key":"mY6Y3lwKwV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LOCE8pR9vh"}],"key":"GBPGfyM253"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"ASLSOPYZQl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates private and public access of object items in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kdF5b8iQOn"}],"identifier":"program-that-demonstrates-private-and-public-access-of-object-items-in-c","label":"Program that demonstrates private and public access of object items in C++","html_id":"program-that-demonstrates-private-and-public-access-of-object-items-in-c","implicit":true,"key":"d0nkA34opr"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"gZB9uMdTMP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hu3GeoyNuv"}],"key":"o2o1lYKOcY"}],"identifier":"64c40f9e","html_id":"64c40f9e","key":"O3YENSkUyx"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// Reverse a string with a ch_stack.\n#include <iostream>\n#include \"ch_stac3.h\"\n\nusing namespace std;\n\nint main ()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Don Knuth!\"};\n    int i = 0;\n\n    cout << str << endl;\n    s.reset();  // s.top = EMPTY would be illegal\n\n    while (str[i] && !s.full())\n    {\n        s.push(str[i++]);\n    }\n\n    while (!s.empty())      // print the reverse\n    {\n        cout << s.pop();\n    }\n\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"rslZOR83i6"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"JISq2HSFD4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lCIFsvzvVC"}],"key":"wFDp6cQPwW"}],"identifier":"ab0a294d","html_id":"ab0a294d","key":"QilEUcj1yd"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"struct ch_stack {\n    public:\n        void reset ()       { top = EMPTY; }\n        void push (char c)  { top++; s[top] = c; }\n        char pop ()         { return s[top--]; }\n        char top_of ()      { return s[top]; }\n        bool empty ()       { return ( top == EMPTY ); }\n        bool full ()        { return ( top == FULL  ); }\n\n    private:\n        enum \n        {  \n            max_len = 100,\n            EMPTY = -1,\n            FULL = max_len-1\n                \n        };\n\n        char s[max_len];\n        int top;\n};","position":{"start":{"line":1,"column":1},"end":{"line":23,"column":1}},"key":"ywSkz790yM"}],"identifier":"4b1fdf78","html_id":"4b1fdf78","key":"Vc16rjBs21"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Oenk0qvu98"}],"key":"LyBdvTbsgC"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"vcuwhRJgEA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"o3Y0ZoUWsQ"},{"type":"outputs","id":"LFuucOaDLO4Pj_ptuMAx4","children":[],"key":"H1hzySbw9g"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"hN2w0S3AeG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_2_Access_Private_and_Public\"","key":"WHaEV8WAjq"},{"type":"outputs","id":"2YObpwAackKpYXSgycS18","children":[],"key":"A36NwMF0Yb"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"kTrT9pfxWf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"xDBZBz1Tep"},{"type":"outputs","id":"nnaNt71gbsK72mxv2djDo","children":[],"key":"bxjMFJP0aB"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"FzR5KEaxhh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac3.cpp -w -o ch_stac3\")","key":"Y5z1bf0aad"},{"type":"outputs","id":"isdJivSUoD8rBwsgAE15E","children":[],"key":"lPFOY2pfTb"}],"identifier":"a734c6b9-cf2