,"identifier":"64c40f9e","html_id":"64c40f9e","key":"kuwFJVfLKI"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Reverse a string with a ch_stack.\n#include <iostream>\n#include \"ch_stac3.h\"\n\nusing namespace std;\n\nint main ()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Don Knuth!\"};\n    int i = 0;\n\n    cout << str << endl;\n    s.reset();  // s.top = EMPTY would be illegal\n\n    while (str[i] && !s.full())\n    {\n        s.push(str[i++]);\n    }\n\n    while (!s.empty())      // print the reverse\n    {\n        cout << s.pop();\n    }\n\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"xwaQ280mnE"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"ghM1lCRugo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Eno5mBlIrF"}],"key":"ot0cZuHI8j"}],"identifier":"ab0a294d","html_id":"ab0a294d","key":"rEvScFQYLJ"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"struct ch_stack {\n    public:\n        void reset ()       { top = EMPTY; }\n        void push (char c)  { top++; s[top] = c; }\n        char pop ()         { return s[top--]; }\n        char top_of ()      { return s[top]; }\n        bool empty ()       { return ( top == EMPTY ); }\n        bool full ()        { return ( top == FULL  ); }\n\n    private:\n        enum \n        {  \n            max_len = 100,\n            EMPTY = -1,\n            FULL = max_len-1\n                \n        };\n\n        char s[max_len];\n        int top;\n};","position":{"start":{"line":1,"column":1},"end":{"line":23,"column":1}},"key":"WnrmtEZ5k2"}],"identifier":"4b1fdf78","html_id":"4b1fdf78","key":"pJ8BEXCQaS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LGhRM7YZmU"}],"key":"UlzfRvSXEC"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"XNWGnuMdwJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"VfIMrelE4L"},{"type":"outputs","id":"qUsth-ZvQEgPH_aqnRxZg","children":[],"key":"krRWFYm93q"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"jr5VPtJ9nS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_2_Access_Private_and_Public\"","key":"vnYpQRKLtH"},{"type":"outputs","id":"SjDoWJUeHCrgvadnNl2Rw","children":[],"key":"iy2o04iehC"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"eCvqITlkLV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"jh302C02NQ"},{"type":"outputs","id":"SDFYa1fhum3B9UIkRc0ca","children":[],"key":"lti2quYsQU"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"rmzZVFDi4i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac3.cpp -w -o ch_stac3\")","key":"tr06lfXxTp"},{"type":"outputs","id":"_KvpWK1rSyqfWs5A87He4","children":[],"key":"bN9JQiv50J"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455