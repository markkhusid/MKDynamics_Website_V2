:"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates private and public access of object items in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Hk6V9DTInq"}],"identifier":"program-that-demonstrates-private-and-public-access-of-object-items-in-c","label":"Program that demonstrates private and public access of object items in C++","html_id":"program-that-demonstrates-private-and-public-access-of-object-items-in-c","implicit":true,"key":"FO0kYHKtKE"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"BE9osDyNu3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BwxIhMBGwp"}],"key":"Zw9rCOaOA9"}],"identifier":"64c40f9e","html_id":"64c40f9e","key":"x3Vu1XKh9k"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Reverse a string with a ch_stack.\n#include <iostream>\n#include \"ch_stac3.h\"\n\nusing namespace std;\n\nint main ()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Don Knuth!\"};\n    int i = 0;\n\n    cout << str << endl;\n    s.reset();  // s.top = EMPTY would be illegal\n\n    while (str[i] && !s.full())\n    {\n        s.push(str[i++]);\n    }\n\n    while (!s.empty())      // print the reverse\n    {\n        cout << s.pop();\n    }\n\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"qaGG8TwIN6"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"JKyxrBDBQU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac3.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sQOScn696Y"}],"key":"Iu9IYV6q46"}],"identifier":"ab0a294d","html_id":"ab0a294d","key":"lmcuvq2DR8"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"struct ch_stack {\n    public:\n        void reset ()       { top = EMPTY; }\n        void push (char c)  { top++; s[top] = c; }\n        char pop ()         { return s[top--]; }\n        char top_of ()      { return s[top]; }\n        bool empty ()       { return ( top == EMPTY ); }\n        bool full ()        { return ( top == FULL  ); }\n\n    private:\n        enum \n        {  \n            max_len = 100,\n            EMPTY = -1,\n            FULL = max_len-1\n                \n        };\n\n        char s[max_len];\n        int top;\n};","position":{"start":{"line":1,"column":1},"end":{"line":23,"column":1}},"key":"FxTRBv0qEO"}],"identifier":"4b1fdf78","html_id":"4b1fdf78","key":"i9S8cW1vvp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IVKGPNrDin"}],"key":"pps9kwLuYj"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"PkhUB9JiZ6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"rAiH8pr0R6"},{"type":"outputs","id":"OTPqw46iqiazihSRghkP0","children":[],"key":"O5OhNvdhjn"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"g0EndRAyaX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"v