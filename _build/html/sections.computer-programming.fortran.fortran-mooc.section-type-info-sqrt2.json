line":1,"column":1},"end":{"line":1,"column":1}},"key":"D3c4GEmyDZ"}],"identifier":"sqrt2-f90","label":"sqrt2.f90","html_id":"sqrt2-f90","implicit":true,"key":"hgmAzHrcGr"},{"type":"include","file":"Fortran_Code/Section_Type_Info_Sqrt2/app/sqrt2.f90","literal":true,"children":[{"type":"code","value":"program sqrt_2\n    use, intrinsic :: iso_fortran_env, only : SP => REAL32, DP => REAL64\n    implicit none\n    real(kind=SP) :: sqr_root\n    real(kind=DP) :: sqr_root_dp\n\n    sqr_root = sqrt(2.0_SP)\n    sqr_root_dp = sqrt(2.0_DP)\n    print '(A, L)', 'sqrt(2)**2 == 2 (SP): ', sqr_root**2 == 2.0_SP\n    print '(A, L)', 'sqrt(2)**2 =~ 2 (SP): ', abs(sqr_root**2 - 2.0_SP) <= 1.0e-6_SP\n    print '(A, L)', 'sqrt(2)**2 == 2 (DP): ', sqr_root_dp**2 == 2.0_DP\n    print '(A, L)', 'sqrt(2)**2 =~ 2 (DP): ', abs(sqr_root_dp**2 - 2.0_DP) <= 1.0e-14_DP\nend program sqrt_2\n","lang":"fortran","filename":"sqrt2.f90","key":"KsUoQ0ybrt"}],"key":"fIr579i11Y"}],"key":"NNoglHq3rQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wmcTDzrwPy"}],"key":"XIz53tr2gj"}],"key":"yDsRqNsX99"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UbTlpzBsNa"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"QP8TXGQmgu"}],"key":"nD27CCZkZf"},{"type":"block","kind":"notebook-code","ch