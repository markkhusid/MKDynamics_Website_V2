{"version":3,"kind":"Notebook","sha256":"51dd5560563a751de0c48f48ec17acac319a01402a06c1e43f0db4e3169957cb","slug":"sections.mcs-projects.cse548-advanced-network-security.project-1.project-1","location":"/Sections/MCS_Projects/CSE548_Advanced_Network_Security/Project_1/Project_1.ipynb","dependencies":[],"frontmatter":{"title":"CSE548 Advanced Network Security - Project 1 - Packet Filter Firewall","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/MCS_Projects/CSE548_Advanced_Network_Security/Project_1/Project_1.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/MCS_Projects/CSE548_Advanced_Network_Security/Project_1/Project_1.ipynb","thumbnail":"/build/client-settings-6865676dc62a33ee6b2b874c8aad9dd6.png","exports":[{"format":"ipynb","filename":"Project_1.ipynb","url":"/build/Project_1-8c64d1cdac33093ee3e5d3918919a03c.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Created with Grok Build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xMZMrhquoK"}],"key":"D2cfZwKDPx"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A packet filter sits on a dual-homed gateway. One side of the gateway faces a single client. The other side faces an upstream network that can reach 8.8.8.8. The filter lets the client do two things, and it drops the rest: ping that one address, and fetch a web page hosted on the gateway itself.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"n0OyxZ6KD2"}],"key":"VRiaLI2xTo"}],"key":"nn0UhjaE8j"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Project overview","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qpZ2ryIyVF"}],"identifier":"project-overview","label":"Project overview","html_id":"project-overview","implicit":true,"key":"LTiXB0RBte"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The gateway enforces the policy with iptables. A packet is compared with the rules in a chain from top to bottom, and the first matching rule wins. Three chains in the filter table do the work.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"STi3J4gWkm"}],"key":"A4RVmNSi6O"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"INPUT handles packets addressed to the gateway.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ia5ii9PfPG"}],"key":"BCHYiSvawB"}],"key":"nEqsZwvYCX"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"FORWARD handles packets the gateway is passing from one network to the other.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"gX5rJZhEQd"}],"key":"uMJIJ2n2co"}],"key":"JkYK9oG63f"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"OUTPUT handles packets the gateway creates itself.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"JnS21g2KgR"}],"key":"mcZVoQpCOR"}],"key":"beyCEHWCLz"}],"key":"xZwP8TGJjB"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"All three chains use policy DROP. A packet that matches nothing is discarded rather than forwarded.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"UjLLt8zEnu"}],"key":"xeDIeEvwfr"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The installed policy is meant to do eight things:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"gtmbXestmN"}],"key":"Dm0cPMMDqk"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":13,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The client can ping 8.8.8.8 through the gateway.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"d2t5F1IzxK"}],"key":"mhJsoL7vXh"}],"key":"yBhIBLUApj"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The client can open the web page hosted on the gateway.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"BUI9mUYRgF"}],"key":"YlF4mpfENU"}],"key":"itp562q4QR"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The client cannot reach any other address.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"znnr57pKQu"}],"key":"aymngxAf6y"}],"key":"H7r3pQNRdW"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The client cannot ping the gateway.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Yv1054T8iB"}],"key":"OIwAoOSDEY"}],"key":"Cg7PIFxFr1"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The gateway cannot ping its own loopback address.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"oG10fEh8ec"}],"key":"BEiaHvfgSo"}],"key":"Xx1w1Rg9Kf"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The gateway cannot ping the client.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"nFA46cd3DJ"}],"key":"YlqmRrdSVO"}],"key":"dOBWsiDkEj"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The gateway cannot ping 8.8.8.8.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"llRpNZ4e9f"}],"key":"f4bWrMNXTD"}],"key":"UjtaGkr4p8"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Packets the client sends on toward 8.8.8.8 are rewritten so they appear to come from the gateway.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Aydyb2jgLu"}],"key":"R68zbOkFNJ"}],"key":"yzbEVhQUPE"}],"key":"PVwNKN9di4"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The order of the rules is the policy. A DROP that is reached first hides an ACCEPT written below it. ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"QVXaIIWHPa"},{"type":"inlineCode","value":"-A","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"MXFX6dk9NY"},{"type":"text","value":" appends a rule at the bottom of a chain. ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"FPLZEiwgfn"},{"type":"inlineCode","value":"-I","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"QfCByzoA3S"},{"type":"text","value":" inserts a rule at the top. Printing the chain after each change, with ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"FD4Gm98Lmn"},{"type":"inlineCode","value":"iptables -L","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"biXRqvyh68"},{"type":"text","value":", is how that order stays visible. ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"zqI4naDHml"},{"type":"inlineCode","value":"--line-numbers","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"j2JMouR0mV"},{"type":"text","value":" names the rule that ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ObuNvBwe2O"},{"type":"inlineCode","value":"-D","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ob17qnb9N3"},{"type":"text","value":" should delete when one of them is wrong. When a chain gets tangled, flushing it and starting over is cleaner than trying to patch a rule that sits in the wrong place.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ytNfZ0ZJ74"}],"key":"YhuOaFaBTg"}],"key":"zcch8kBtcw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Network setup","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vFrbJFi0kp"}],"identifier":"network-setup","label":"Network setup","html_id":"network-setup","implicit":true,"key":"UBlHrMPW3U"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The client has one interface, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YIS9LBXYNJ"},{"type":"inlineCode","value":"enp0s3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nKi1wQ4FSR"},{"type":"text","value":", at 10.0.2.4/24. The gateway has two. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UVF8LiaOVL"},{"type":"inlineCode","value":"enp0s8","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a64nAFKZHS"},{"type":"text","value":" is on the client network at 10.0.2.6/24, and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jeKe0fhxZi"},{"type":"inlineCode","value":"enp0s3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vOI8nY3ekx"},{"type":"text","value":" is on the upstream network at 10.0.1.7/24. 8.8.8.8 is reached from the upstream side. The client never talks to that address directly. Its default route hands the packet to 10.0.2.6, and the gateway decides whether to forward it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tzuoVbtPqa"}],"key":"juzNyqn9RJ"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"VirtualBox is the hypervisor. The client is attached to one NAT network. The gateway is attached to two, which is what makes the machine dual-homed. Both guests are Ubuntu. The settings panels record Ubuntu 23.04, 8 GB of memory, and a 40 GB disk.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oFkgbSFL2c"}],"key":"wT7SkDBgyI"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/client-settings-6865676dc62a33ee6b2b874c8aad9dd6.png","alt":"The client has a single adapter, on the private NAT network.","data":{"altTextIsAutoGenerated":true},"key":"e8VMB3Z3km","urlSource":"images/client-settings.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"The client has a single adapter, on the private NAT network.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"FGpAdGrAjK"}],"key":"hq9F2JSc5Q"}],"key":"XRmXA2e2x0"}],"enumerator":"1","key":"t71W43oa4Y"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/server-settings-6e75a584662a54862f9b169d4f1cdb10.png","alt":"The gateway has two adapters: one on the client network and one on the upstream network.","data":{"altTextIsAutoGenerated":true},"key":"XL13JKl48A","urlSource":"images/server-settings.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"The gateway has two adapters: one on the client network and one on the upstream network.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Tc4HVQ5EBy"}],"key":"vUKS2BJEfx"}],"key":"U3NV220Euh"}],"enumerator":"2","key":"e6bOGTFcx0"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The client’s routing table has two default routes. The one that matters for the lab points at 10.0.2.6, the gateway. The other, via 10.0.2.1, belongs to the VirtualBox NAT engine. ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"cDylAOOhDt"},{"type":"inlineCode","value":"route","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"qC839VSQ0J"},{"type":"text","value":" prints the lab next hop as the name ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"VL4MstzsUw"},{"type":"inlineCode","value":"_gateway","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"w9fBKgNCaf"},{"type":"text","value":". ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"nvSG4QPTQT"},{"type":"inlineCode","value":"route -n","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"GGCmsXL6ni"},{"type":"text","value":" prints the same route as the address 10.0.2.6.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"qrqCm9CyZ5"}],"key":"zZmpQH8vtN"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/client-routes-ac34abe46d23cd8472c667a320ed2eb5.png","alt":"The client’s default route for the lab is 10.0.2.6. A second default, 10.0.2.1, is the VirtualBox NAT gateway.","data":{"altTextIsAutoGenerated":true},"key":"wSZmt4Rkxd","urlSource":"images/client-routes.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The client’s default route for the lab is 10.0.2.6. A second default, 10.0.2.1, is the VirtualBox NAT gateway.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"VM1EVLjHS9"}],"key":"xZQefh5sIr"}],"key":"BK5OxHPCt1"}],"enumerator":"3","key":"a684wgXcYt"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/client-interfaces-96a6806300b928288bfdd9e4da879beb.png","alt":"The client address is 10.0.2.4/24 on enp0s3.","data":{"altTextIsAutoGenerated":true},"key":"EpGnU5Uxt2","urlSource":"images/client-interfaces.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The client address is 10.0.2.4/24 on ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"LZPfnei5Pn"},{"type":"inlineCode","value":"enp0s3","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"XzqQqFPtYs"},{"type":"text","value":".","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"VxwIfPwWG4"}],"key":"UvhTI2W2cr"}],"key":"qGNX2sgIK7"}],"enumerator":"4","key":"Z3R6oqDnxy"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/server-interfaces-98e56da6c957855f81ea671ec3dba684.png","alt":"On the gateway, enp0s3 is 10.0.1.7/24 toward the upstream network and enp0s8 is 10.0.2.6/24 toward the client.","data":{"altTextIsAutoGenerated":true},"key":"pIacFP0Kca","urlSource":"images/server-interfaces.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"On the gateway, ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"xOaP4k1iST"},{"type":"inlineCode","value":"enp0s3","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"DWfm1wuHXF"},{"type":"text","value":" is 10.0.1.7/24 toward the upstream network and ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ZkbLOk87gz"},{"type":"inlineCode","value":"enp0s8","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"L53dAcmt61"},{"type":"text","value":" is 10.0.2.6/24 toward the client.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ln3BBFxQ4P"}],"key":"Mz5ugfNDdJ"}],"key":"twipLFCC7m"}],"enumerator":"5","key":"BZIocYPfhM"}],"key":"OoHdCNaea3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Software","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gjWrccmylD"}],"identifier":"software","label":"Software","html_id":"software","implicit":true,"key":"HanUTfl0uH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"VirtualBox supplies the two guests. On the gateway, the packet filter is iptables and the page is served by Apache. Nothing else in the path rewrites or inspects the traffic.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PUgOUmzBXs"}],"key":"iSYk12vRm9"}],"key":"TTcgc4VgRY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Project description","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qSYujiJpxV"}],"identifier":"project-description","label":"Project description","html_id":"project-description","implicit":true,"key":"tsL2WMYGw4"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Filter rules","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ry9DQu8EKQ"}],"identifier":"filter-rules","label":"Filter rules","html_id":"filter-rules","implicit":true,"key":"dMkOOIRYPC"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/filter-rules-1ee399e30f829a65e81ad94c46bc706e.png","alt":"Filter table after the rules were installed. Every chain has policy DROP.","data":{"altTextIsAutoGenerated":true},"key":"tToLFneYdW","urlSource":"images/filter-rules.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Filter table after the rules were installed. Every chain has policy DROP.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XReQKHGHNN"}],"key":"bxuW5x56wF"}],"key":"kfohwcjCz3"}],"enumerator":"6","key":"w2X44T90E0"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"INPUT drops ICMP from the loopback address and drops ICMP from the client at 10.0.2.4. That second drop is why the client cannot ping the gateway. TCP port 80 from the client is accepted, which is the exception for the web page. A later rule accepts ICMP from anywhere. It does not reopen the client’s pings, because those packets already matched the DROP higher in the chain.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"H33rMh9Ubg"}],"key":"LZ8qZRbrn5"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"FORWARD accepts ICMP to 8.8.8.8 and accepts every protocol from the client to 8.8.8.8. It also accepts TCP from anywhere to anywhere. That last rule is wider than the requirement that the client reach only 8.8.8.8 and the page on the gateway. A forwarded TCP connection to some other host would match it.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"BsQJuxfgB0"}],"key":"TSvWLnSET7"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"OUTPUT drops ICMP from the gateway to anywhere, so the gateway cannot ping the client, the loopback address, or 8.8.8.8. It accepts TCP whose source port is 80, which is Apache answering.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"HGKE1HgkyL"}],"key":"Y6frn3SO25"},{"type":"heading","depth":3,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Address translation","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"WmLzBoQSez"}],"identifier":"address-translation","label":"Address translation","html_id":"address-translation","implicit":true,"key":"HXvwqgblNy"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/nat-rules-6ad1fdfaab1092499eb8dbad3d11af72.png","alt":"POSTROUTING masquerades traffic to 8.8.8.8, and a second rule masquerades every other forwarded packet.","data":{"altTextIsAutoGenerated":true},"key":"W7Y3RhgPgI","urlSource":"images/nat-rules.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"POSTROUTING masquerades traffic to 8.8.8.8, and a second rule masquerades every other forwarded packet.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"iSX06MKXyN"}],"key":"YbRhDtJkNa"}],"key":"mAlYeTCzZr"}],"enumerator":"7","key":"TMA0qvoFB8"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Masquerade rewrites the source address to the address the gateway uses on the outgoing interface. From the upstream network, a packet that started at 10.0.2.4 looks like it came from 10.0.1.7. The first rule is the specific case the lab asked for. The second rule does the same translation for anything else that is forwarded.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"YqaL3u1wnK"}],"key":"ghsJebaaIl"},{"type":"heading","depth":3,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Web server","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"S2s0hV0D1F"}],"identifier":"web-server","label":"Web server","html_id":"web-server","implicit":true,"key":"gBjiPtwsek"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Apache serves a one-line page from ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"yBpwLAdAVn"},{"type":"inlineCode","value":"/var/www/html/index.html","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"zNRlUz9ukE"},{"type":"text","value":". The client requests it at 10.0.2.6, which is the gateway’s address on the client network, so the packet is delivered locally and hits the INPUT chain rather than FORWARD.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"HjlCI3qfGr"}],"key":"KP3pAzqT8H"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/web-page-36300d7095a5b9169015452d90a7ffb1.png","alt":"The page stored on the gateway.","data":{"altTextIsAutoGenerated":true},"key":"teO7h9xxLh","urlSource":"images/web-page.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"The page stored on the gateway.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"adZVjLB0i0"}],"key":"iHduGRIQMm"}],"key":"PVFbyPWfSG"}],"enumerator":"8","key":"pyNKRRvDQl"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/apache-status-ef7169ae33d651c9aafaf2ba38ccd2b4.png","alt":"Apache is running. The fully-qualified-domain-name warning does not stop it from answering.","data":{"altTextIsAutoGenerated":true},"key":"WPuxMo0vTH","urlSource":"images/apache-status.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Apache is running. The fully-qualified-domain-name warning does not stop it from answering.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"hv0q8mRmdX"}],"key":"yUgMe4SvZX"}],"key":"dW2ZBcXJjP"}],"enumerator":"9","key":"V85QjmpLSa"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/client-curl-6bf16a57b42a0b8db6f8ccee1f4dc753.png","alt":"The client receives the page from 10.0.2.6.","data":{"altTextIsAutoGenerated":true},"key":"aHr78fdfy9","urlSource":"images/client-curl.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The client receives the page from 10.0.2.6.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"bEKYOYO1DJ"}],"key":"GBgv9ZvskR"}],"key":"fGAXef56DM"}],"enumerator":"10","key":"VVbpIULmo4"},{"type":"heading","depth":3,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Port scans","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"h3IkyD8Oz7"}],"identifier":"port-scans","label":"Port scans","html_id":"port-scans","implicit":true,"key":"lBwHnTSjHS"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"A TCP scan of every port on the gateway, run from the client, finds port 80 open and reports the other 65,534 ports as filtered. Filtered is what a DROP looks like to a scanner: the probe is not answered, and it is not rejected with a reset either.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ltGinXnGXA"}],"key":"dW4NmFAwhZ"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/tcp-scan-590532f277060e989317edef16300116.png","alt":"Only TCP port 80 on the gateway answers the client.","data":{"altTextIsAutoGenerated":true},"key":"bayRIV64NA","urlSource":"images/tcp-scan.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Only TCP port 80 on the gateway answers the client.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"YGKJyQAM7g"}],"key":"NyyjIu6UyK"}],"key":"FrTkJ6pIjM"}],"enumerator":"11","key":"Z0hgRBdI5B"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"A UDP scan of the same host reports every port as open or filtered. A dropped UDP probe and an open UDP port that simply does not reply look the same, so the scan cannot separate them. What it does show is that the gateway is not sending ICMP port-unreachable errors back to the client.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"FHiYFnpdE6"}],"key":"pgDlJSLqjL"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/udp-scan-1031a8a52bc9afc1468107fdc2af97c1.png","alt":"The UDP scan gets no replies, so every port is reported open or filtered.","data":{"altTextIsAutoGenerated":true},"key":"NMvcqT4x1z","urlSource":"images/udp-scan.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"The UDP scan gets no replies, so every port is reported open or filtered.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"qR3dBnvbtJ"}],"key":"K2wqBNpRMs"}],"key":"x7sTxIT7za"}],"enumerator":"12","key":"ygCqgutrEZ"},{"type":"heading","depth":3,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Ping tests","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"wK3Fa5meVZ"}],"identifier":"ping-tests","label":"Ping tests","html_id":"ping-tests","implicit":true,"key":"qFK10BlEi9"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/ping-8888-4359d9740c3df5d32720dba95a5d59da.png","alt":"The client can ping 8.8.8.8. The forward path and the masquerade are both in use.","data":{"altTextIsAutoGenerated":true},"key":"M52ZqsnVkL","urlSource":"images/ping-8888.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"The client can ping 8.8.8.8. The forward path and the masquerade are both in use.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"xXEqVeAjiM"}],"key":"cmILQYEif7"}],"key":"gzJDr5pNZl"}],"enumerator":"13","key":"D2rrtv8i1I"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/ping-8844-0c1e3627448a7f605e63b6c0800fcaf9.png","alt":"A ping from the client to 8.8.4.4 is lost. That address is not the one allowed destination.","data":{"altTextIsAutoGenerated":true},"key":"pS4Gh7E7nX","urlSource":"images/ping-8844.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"A ping from the client to 8.8.4.4 is lost. That address is not the one allowed destination.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"oJoc5SeVml"}],"key":"WXqazqnhoh"}],"key":"aBzZyI561q"}],"enumerator":"14","key":"yMjSt7xjNC"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/ping-gateway-8683f688b84ecc816d24ba35840a3bd6.png","alt":"The client cannot ping the gateway. INPUT already dropped ICMP from 10.0.2.4.","data":{"altTextIsAutoGenerated":true},"key":"H8ApzvsGSy","urlSource":"images/ping-gateway.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The client cannot ping the gateway. INPUT already dropped ICMP from 10.0.2.4.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"aMUx7MTyjM"}],"key":"DqDUjYo7lc"}],"key":"UdyQzdMDHK"}],"enumerator":"15","key":"M942VXztC6"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/ping-localhost-75aa64c58cfbeb1135c198080c34c92a.png","alt":"The gateway cannot ping 127.0.0.1. The kernel reports sendmsg: Operation not permitted, which is the OUTPUT drop, not a missing route.","data":{"altTextIsAutoGenerated":true},"key":"PGALpuIgAu","urlSource":"images/ping-localhost.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"The gateway cannot ping 127.0.0.1. The kernel reports ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"MgEuVLpa5m"},{"type":"inlineCode","value":"sendmsg: Operation not permitted","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"bQPM0q60S4"},{"type":"text","value":", which is the OUTPUT drop, not a missing route.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"Ybwx8ruRpo"}],"key":"WbZ2E9y721"}],"key":"tki0fojKXK"}],"enumerator":"16","key":"SsZYK3UW8R"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/ping-client-2f3f5675c838061975131222e77cf2c1.png","alt":"The gateway cannot ping the client. The same OUTPUT drop refuses the ICMP.","data":{"altTextIsAutoGenerated":true},"key":"oQndOIMYBv","urlSource":"images/ping-client.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"The gateway cannot ping the client. The same OUTPUT drop refuses the ICMP.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"CTgV0TEXNg"}],"key":"zuOFX8VtgN"}],"key":"P2arK6Oydb"}],"enumerator":"17","key":"mSp0BCNc6k"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"The OUTPUT chain drops ICMP to anywhere, so a ping from the gateway to 8.8.8.8 is covered by the same rule. The report does not include a separate screenshot of that ping.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"vOjieSQ5nZ"}],"key":"SLzPVBArHj"}],"key":"b2fOMM82vh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JUJIw6Cywj"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"r5ObzF2X8V"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The useful habit was to add one rule, print the chain, and only then add the next. A chain is a list that is read from the top, and a mistake high in the list makes every later exception dead. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I7unMm4kic"},{"type":"inlineCode","value":"--line-numbers","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"G9cyJ2zigF"},{"type":"text","value":" and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QnpkgRtZzC"},{"type":"inlineCode","value":"-D","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aRYYbZ2ze7"},{"type":"text","value":" are enough to pull one bad rule out. Flushing the chain is the faster repair once several of them are in the wrong order.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HAwhiMIYaW"}],"key":"zohjIIskYp"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The ping results are that ordering made visible. Traffic to 8.8.8.8 matches an ACCEPT and comes back. ICMP from the client to the gateway matches an earlier DROP. ICMP created by the gateway matches the OUTPUT policy and is refused before it leaves the machine.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vfKbMcdubD"}],"key":"vZQLXYpd14"}],"key":"NEDBiE376E"}],"key":"Lu7BU6Rxre"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CSE548 Advanced Network Security","url":"/sections/mcs-projects/cse548-advanced-network-security/cse548-advanced-network-security-head","group":"Master's in Computer Science (Cybersecurity) Projects"},"next":{"title":"CSE548 Advanced Network Security - Project 2 - SDN-Based Stateless Firewall","url":"/sections/mcs-projects/cse548-advanced-network-security/project-2/project-2","group":"Master's in Computer Science (Cybersecurity) Projects"}}},"domain":"https://www.mkdynamics.net"}