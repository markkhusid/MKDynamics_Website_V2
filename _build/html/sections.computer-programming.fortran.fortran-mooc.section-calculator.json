G6HCOlfFQ"}],"key":"X8qomWY7Y5"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"get_expression","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"kXNDb7d5y9"},{"type":"text","value":" uses list-directed read on that string to extract x, op, and y.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NBb67FCNg4"}],"key":"UFuHAvZFvY"}],"key":"R252lLUD7M"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"calculate","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rpa46rtori"},{"type":"text","value":" uses select case (op) to choose addition, subtraction, or multiplication.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"FKSSo7PH30"}],"key":"oYCGWGgi4i"}],"key":"vPn25qV7tH"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Unsupported operators trigger an error on error_unit and stop.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"gywN6fUnV0"}],"key":"CRAjsmMieZ"}],"key":"AZ2YWGyQDr"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The result is printed in scientific format using double precision (REAL64).","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"LShEvPUGPU"}],"key":"KZ0E8JEKMC"}],"key":"B990WVOXHr"}],"key":"VAkVJnynWm"}],"key":"ufEU9RdpIp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a8wj8dwDYt"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"mSkylXVUM4"}],"key":"OYFQ1A1VNo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"calculator.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Eh2ZOEVeMq"}],"identifier":"calculator-f90","label":"calculator.f90","html_id":"calculator-f90","implicit":true,"key":"iwKXqrq2cl"},{"type":"include","file":"Fortran_Code/Section_Calculator/app/calculator.f90","literal":true,"children":[{"type":"code","value":"program calculator\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64\n    implicit none\n    real(kind=DP) :: x, y\n    character(len=1) :: op\n\n    call get_expression(op, x, y)\n    print '(E15.7)', calculate(op, x, y)\n\ncontains\n\n    subroutine get_expression(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        real(kind=DP), intent(out) :: x, y\n        character, intent(out) :: op\n        character(len=1024) :: string\n        integer :: status\n        character(len=1024) :: msg\n\n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting real operand real on command line'\n            stop 1\n        end if\n        call get_command_argument(1, string)\n        print *, trim(string)\n        read(string, fmt=*, iostat=status, iomsg=msg) x, op, y\n        if (status /= 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'parse error: ', msg\n            stop 2\n        end if\n    end subroutine get_expression\n\n    real(kind=DP) function calculate(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=1), intent(in) :: op\n        real(kind=DP), intent(in) :: x, y\n\n        select case (op)\n            case ('+')\n                calculate = x + y\n            case ('-')\n                calculate = x - y\n            case ('*')\n                calculate = x*y\n            case default\n                write (unit=error_unit, fmt='(3A)') &\n                    'error: ', op, ' is not a valid operator'\n                stop 3\n        end select\n    end function calculate\n\nend program calculator\n","lang":"fortran","filename":"calculator.f90","key":"ga8SZjhr44"}],"key":"bxpP46Ni6J"}],"key":"lmw6GxDwpm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E5WcExBpga"}],"key":"hhaHdX9eZ6"}],"key":"FdvqY2JbKA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KVp0CYDwdt"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"GEDinKIo30"}],"key":"aX8aYN5uVY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"kKMU1TUCpK"},{"type":"outputs","id":"3uTiCMHgFH_aeKJLGysQ7","children":[],"key":"xgcCTRZprP"}],"key":"QFh7hWZqFz"},{"type":"block","kind":"notebook-content","children":[{"t