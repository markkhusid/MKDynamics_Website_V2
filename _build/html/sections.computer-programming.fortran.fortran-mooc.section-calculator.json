"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SJvqU4JtKe"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"AkNbIQPdDj"}],"key":"jtc6NYxbWz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"calculator.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YEyUWALb7H"}],"identifier":"calculator-f90","label":"calculator.f90","html_id":"calculator-f90","implicit":true,"key":"kbqSmezAAc"},{"type":"include","file":"Fortran_Code/Section_Calculator/app/calculator.f90","literal":true,"children":[{"type":"code","value":"program calculator\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64\n    implicit none\n    real(kind=DP) :: x, y\n    character(len=1) :: op\n\n    call get_expression(op, x, y)\n    print '(E15.7)', calculate(op, x, y)\n\ncontains\n\n    subroutine get_expression(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        real(kind=DP), intent(out) :: x, y\n        character, intent(out) :: op\n        character(len=1024) :: string\n        integer :: status\n        character(len=1024) :: msg\n\n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting real operand real on command line'\n            stop 1\n        end if\n        call get_command_argument(1, string)\n        print *, trim(string)\n        read(string, fmt=*, iostat=status, iomsg=msg) x, op, y\n        if (status /= 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'parse error: ', msg\n            stop 2\n        end if\n    end subroutine get_expression\n\n    real(kind=DP) function calculate(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=1), intent(in) :: op\n        real(kind=DP), intent(in) :: x, y\n\n        select case (op)\n            case ('+')\n                calculate = x + y\n            case ('-')\n                calculate = x - y\n            case ('*')\n                calculate = x*y\n            case default\n                write (unit=error_unit, fmt='(3A)') &\n                    'error: ', op, ' is not a valid operator'\n                stop 3\n        end select\n    end function calculate\n\nend program calculator\n","lang":"fortran","filename":"calculator.f90","key":"dItMWLf8Jd"}],"key":"iZUVawOiYV"}],"key":"idR97nQ0TB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MEW1UOdDAS"}],"key":"VOHkxlAIiu"}],"key":"GHvyMjo56a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oGb0Prf0ry"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"oT9fjdcVx1"}],"key":"qHHwOx4TLY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"Qxvq2dtyje"},{"type":"outputs","id":"Bq9PID6MImDHhLtGjYADq","children":[],"key":"zB0PK3EYIT"}],"key":"Ta4rih1XC6"},{"type":"block","kind":"notebook-content","children":[{"t