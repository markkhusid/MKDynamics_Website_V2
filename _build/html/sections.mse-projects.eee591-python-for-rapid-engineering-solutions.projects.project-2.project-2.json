16:00:56.360456Z","shell.execute_reply":"2026-07-25T16:00:56.358518Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.model_selection import train_test_split\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X,\n    y_encoded,\n    test_size=0.30,\n    random_state=0,\n    stratify=y\n)\n","key":"KSLyt9Nd6t"},{"type":"outputs","id":"I5YJcX2k6xuEezAhrhBe0","children":[],"key":"R54FpjqwAQ"}],"key":"febQaWcZhX"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.362752Z","iopub.status.busy":"2026-07-25T16:00:56.362531Z","iopub.status.idle":"2026-07-25T16:00:56.367089Z","shell.execute_reply":"2026-07-25T16:00:56.365962Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_train[0:10])\n","key":"zsh5ix1EOm"},{"type":"outputs","id":"AwTHNH31P2-SUFdL5pYqj","children":[],"key":"gbopi4E2Cw"}],"key":"QeVNftPFM6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.370283Z","iopub.status.busy":"2026-07-25T16:00:56.369738Z","iopub.status.idle":"2026-07-25T16:00:56.375471Z","shell.execute_reply":"2026-07-25T16:00:56.373938Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(y_train[0:10])\n","key":"a67YZlbd6P"},{"type":"outputs","id":"e7IvV_AbRiSkDyXHECmQW","children":[],"key":"PnMEe1G7ff"}],"key":"pU9rX2GJ7e"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scale the Data using StandardScaler","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SPR8zHpW0v"}],"identifier":"scale-the-data-using-standardscaler","label":"Scale the Data using StandardScaler","html_id":"scale-the-data-using-standardscaler","implicit":true,"key":"FWIiJLMMRL"}],"key":"jkD2aIigUb"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.382772Z","iopub.status.busy":"2026-07-25T16:00:56.382242Z","iopub.status.idle":"2026-07-25T16:00:56.405561Z","shell.execute_reply":"2026-07-25T16:00:56.403410Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.preprocessing import StandardScaler\n\nscaler = StandardScaler()\n\nX_train_std = scaler.fit_transform(X_train)\nX_test_std = scaler.transform(X_test)\n","key":"sBlSNbOa7X"},{"type":"outputs","id":"4OBTKTWzoLbgABSKjfz_G","children":[],"key":"VUUKe4tdix"}],"key":"MjCEC9PheJ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.408792Z","iopub.status.busy":"2026-07-25T16:00:56.408403Z","iopub.status.idle":"2026-07-25T16:00:56.431682Z","shell.execute_reply":"2026-07-25T16:00:56.413046Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_train_std[0:1])\n","key":"Mcpuaue2np"},{"type":"outputs","id":"yFqY9DFWgTuaLzzm7Bp-H","children":[],"key":"BZeXzI7NzB"}],"key":"dKZzByalVp"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.436459Z","iopub.status.busy":"2026-07-25T16:00:56.435767Z","iopub.status.idle":"2026-07-25T16:00:56.441166Z","shell.execute_reply":"2026-07-25T16:00:56.439969Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_test_std[0:1])\n","key":"DR9bYXn48F"},{"type":"outputs","id":"hb5jdcgc-7kwzjPc3LS-c","children":[],"key":"kWDkVITOEq"}],"key":"MNUx46AA61"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform PCA on Variable Number of Components","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"f1vwANq39E"}],"identifier":"perform-pca-on-variable-number-of-components","label":"Perform PCA on Variable Number of Components","html_id":"perform-pca-on-variable-number-of-components","implicit":true,"key":"qzmgR1hvP2"}],"key":"c9h9vD3PAS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.447049Z","iopub.status.busy":"2026-07-25T16:00:56.446641Z","iopub.status.idle":"2026-07-25T16:00:56.773693Z","shell.execute_reply":"2026-07-25T16:00:56.772122Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.decomposition import PCA\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.metrics import accuracy_score\n\ndef run_one_pca_model(ncomp, seed):\n\n    pca = PCA(n_components=ncomp)\n\n    X_train_pca = pca.fit_transform(X_train_std)\n    X_test_pca = pca.transform(X_test_std)\n\n    model = MLPClassifier(\n        hidden_layer_sizes=(100,),\n        activation='logistic',\n        max_iter=20000,\n        alpha=1e-5,\n        solver='adam',\n        random_state=seed\n    )\n\n    model.fit(X_train_pca, y_train)\n\n    predictions = model.predict(X_test_pca)\n    acc = accuracy_score(y_test, predictions)\n\n    return ncomp, acc, predictions\n","key":"LF9eC2mh3A"},{"type":"outputs","id":"m0vAkEe6rPKxohizN8Bkl","children":[],"key":"zCqbiXFIqP"}],"key":"HGUtpF1iUV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Function to Parallelize","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w6gMYvQGlr"}],"identifier":"create-function-to-parallelize","label":"Create Function to Parallelize","html_id":"create-function-to-parallelize","implicit":true,"key":"XTzHBCVgfV"}],"key":"jf8qrIcTph"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.777217Z","iopub.status.busy":"2026-07-25T16:00:56.776895Z","iopub.status.idle":"2026-07-25T16:00:56.782450Z","shell.execute_reply":"2026-07-25T16:00:56.780774Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from joblib import Parallel, delayed\n\ndef run_seed(seed):\n\n    results = Parallel(n_jobs=8, verbose=0)(\n        delayed(run_one_pca_model)(ncomp, seed)\n        for ncomp in range(1, 61)\n    )\n\n    return seed, results\n","key":"NBMnWTqPrH"},{"type":"outputs","id":"uWihxI5ZKZp__0Ktkt33C","children":[],"key":"gHrKw1qMn3"}],"key":"C0sxAFh0hG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.784832Z","iopub.status.busy":"2026-07-25T16:00:56.784615Z","iopub.status.idle":"2026-07-25T16:00:56.789641Z","shell.execute_reply":"2026-07-25T16:00:56.788242Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"#accuracies = []\n#best_accuracy = 0\n#best_components = 0\n#best_predictions = None\n\n#for ncomp, acc, predictions in results:\n#    accuracies.append(acc)\n\n#    if debug:\n#        print(f\"Components={ncomp:2d} Accuracy={acc:.4f}\")\n\n#    if acc > best_accuracy:\n#        best_accuracy = acc\n#        best_components = ncomp\n#        best_predictions = predictions\n\n#print(\"\\nBest Result\")\n#print(f\"Best Components = {best_components}\")\n#print(f\"Best Accuracy   = {best_accuracy:.4f}\")\n","key":"yoFP6D3Sfx"},{"type":"outputs","id":"IwOdns6R9FhVmQggdIBdv","children":[],"key":"L22R5Wxmv4"}],"key":"M2XtPXV77J"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.791623Z","iopub.status.busy":"2026-07-25T16:00:56.791438Z","iopub.status.idle":"2026-07-25T16:01:39.677953Z","shell.execute_reply":"2026-07-25T16:01:39.674562Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# List of random seeds to test.\n# Using a variety of small + larger seeds helps check stability across different data splits.\nseeds = [0, 1, 2, 3, 4, 5, 10]\n\n# Container to store the final summary for every seed\nall_results = []\n\nprint('****** Initiating Paraellel Computation (8 cores) ******')\nprint()\n\n# === Main loop over seeds ===\nfor seed in seeds:\n\n    # Call the function that runs all n_components for this particular seed.\n    seed, results = run_seed(seed)\n\n    # Initialize variables to track the best configuration for this seed\n    best_ncomp = None\n    best_acc = 0\n    best_predictions = None\n\n    # Iterate through all (n_components, accuracy) pairs returned for this seed\n    for ncomp, acc, predictions in results:\n\n        # Keep track of the highest accuracy and its corresponding number of components\n        if acc > best_acc:\n            best_acc = acc\n            best_ncomp = ncomp\n            best_predictions = predictions\n\n    # Store a structured record for this seed\n    all_results.append(\n        {\n            \"seed\": seed,\n            \"best_ncomp\": best_ncomp,\n            \"best_acc\": best_acc,\n            \"best_predictions\": best_predictions,\n            \"results\": results # full list of all (ncomp, acc) pairs\n        }\n    )\n\n    # Print a nice one-line summary for this seed\n    print(\n        f\"Seed = {seed:3d},  \"\n        f\"Best Components = {best_ncomp:2d}, \"\n        f\"Accuracy = {best_acc:.4f}\"\n    )\n\nprint()\nprint('***** Parallel Computations Complete ******')\n","key":"OY6MomJFuI"},{"type":"outputs","id":"TO0ylH0hOjQCfBq1YSJYj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"****** Initiating Paraellel Computation (8 cores) ******\n\n"},"children":[],"key":"BSFrhfyR8e"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   0,  Best Components = 13, Accuracy = 0.9206\n"},"children":[],"key":"WFec8JZjKq"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   1,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"DTfYVPsLth"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   2,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"kIdUrTfqzX"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   3,  Best Components = 16, Accuracy = 0.9206\n"},"children":[],"key":"YMGr5P092h"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   4,  Best Components = 17, Accuracy = 0.9365\n"},"children":[],"key":"VleMyGA0XE"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   5,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"lUvnx8j58N"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =  10,  Best Components = 17, Accuracy = 0.9365\n\n***** Parallel Computations Complete ******\n"},"children":[],"key":"wlroAIW7bf"}],"key":"iZBihIX92N"}],"key":"lATeJrgNkQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Find the Best Seed Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Nym8QRFR7l"}],"identifier":"find-the-best-seed-results","label":"Find the Best Seed Results","html_id":"find-the-best-seed-results","implicit":true,"key":"d6chIlRyIE"}],"key":"kKgpi14MXm"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.681570Z","iopub.status.busy":"2026-07-25T16:01:39.681156Z","iopub.status.idle":"2026-07-25T16:01:39.688517Z","shell.execute_reply":"2026-07-25T16:01:39.686002Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Find the result with the highest best_acc\nbest_seed_result = max(\n    all_results,\n    key=lambda x: x[\"best_acc\"]\n)\n\nprint()\nprint(f\"Best Seed: {best_seed_result['seed']}\")\nprint(f\"Best Number of Compnents: {best_seed_result['best_ncomp']}\")\nprint(f\"Best Accuracy: {best_seed_result['best_acc']:.4f}\")   \n","key":"z3fZtnmjwz"},{"type":"outputs","id":"OxCSOiMA_2-ywF_rdmEwU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nBest Seed: 1\nBest Number of Compnents: 16\nBest Accuracy: 0.9365\n"},"children":[],"key":"zjXe94Y5Hi"}],"key":"jquH5ONXBu"}],"key":"x9ullq79zN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot the Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PpPzDFuymX"}],"identifier":"plot-the-results","label":"Plot the Results","html_id":"plot-the-results","implicit":true,"key":"pwoDprCa1A"}],"key":"zSeNfFjRjy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.692425Z","iopub.status.busy":"2026-07-25T16:01:39.691979Z","iopub.status.idle":"2026-07-25T16:01:39.859238Z","shell.execute_reply":"2026-07-25T16:01:39.857546Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\n\n# Get results for the best seed\nresults = best_seed_result[\"results\"]\n\n# Extract component counts and accuracies\nncomps = np.array([r[0] for r in results])\naccuracies = np.array([r[1] for r in results])\n\n# Find best accuracy\nbest_idx = np.argmax(accuracies)\nbest_ncomp = ncomps[best_idx]\nbest_acc = accuracies[best_idx]\n\nplt.figure(figsize=(12, 6))\n\nplt.plot(\n    ncomps,\n    accuracies,\n    marker='o',\n    linestyle='-',\n    color='blue'\n)\n\n# Highlight best point\nplt.plot(\n    best_ncomp,\n    best_acc,\n    marker='o',\n    markersize=12,\n    color='red',\n    markeredgecolor='darkred',\n    markerfacecolor='none',\n    linewidth=2\n)\n\n# Annotate best point\nplt.annotate(\n    f'Best: {best_acc:.4f}\\n({best_ncomp} components)',\n    xy=(best_ncomp, best_acc),\n    xytext=(best_ncomp + 2, best_acc - 0.3),\n    fontsize=12,\n    fontweight='bold',\n    color='red',\n    arrowprops=dict(\n        arrowstyle='->',\n        color='red',\n        lw=1.5\n    ),\n    bbox=dict(\n        boxstyle='round,pad=0.4',\n        facecolor='yellow',\n        alpha=0.3\n    )\n)\n\nplt.xlabel(\"Number of PCA Components\")\nplt.ylabel(\"Test Accuracy\")\nplt.title(\n    f\"Accuracy vs Number of PCA Components\\n\"\n    f\"(Best Seed = {best_seed_result['seed']})\"\n)\n\nplt.ylim(0, 1)\nplt.xlim(1, 60)\nplt.xticks(np.arange(0, 61, 5))\nplt.grid(True)\n\n# Optional\nplt.axhline(\n    y=best_acc,\n    color='red',\n    linestyle='--',\n    alpha=0.5\n)\n\nplt.show()\n\nprint(\n    f\"Best seed: {best_seed_result['seed']}\"\n)\nprint(\n    f\"Best accuracy: {best_acc:.4f} \"\n    f\"using {best_ncomp} PCA components\"\n)\n","key":"AITb8bx0fQ"},{"type":"outputs","id":"nXxudelOzO8AK9ADZLZxf","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9e41737c096e02aeb19779b9e43114dd","path":"/build/9e41737c096e02aeb19779b9e43114dd.png"},"text/plain":{"content":"<Figure size 1200x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZyPj8P67M1"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Best seed: 1\nBest accuracy: 0.9365 using 16 PCA components\n"},"children":[],"key":"gQE2CKflKc"}],"key":"JjBhv3oaOH"}],"key":"Jfad5HT0dK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Confusion Matrix","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Yseq5zAsGy"}],"identifier":"create-confusion-matrix","label":"Create Confusion Matrix","html_id":"create-confusion-matrix","implicit":true,"key":"AITTsOBmsH"}],"key":"xdSmQ8isK8"},{"type":"block","kind":"note