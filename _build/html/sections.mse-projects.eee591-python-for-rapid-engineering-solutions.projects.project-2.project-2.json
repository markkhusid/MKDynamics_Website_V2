nput":"2026-07-25T16:00:56.362752Z","iopub.status.busy":"2026-07-25T16:00:56.362531Z","iopub.status.idle":"2026-07-25T16:00:56.367089Z","shell.execute_reply":"2026-07-25T16:00:56.365962Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_train[0:10])\n","key":"uBHPAZ6YEs"},{"type":"outputs","id":"-cdum7ZLg98XRBTM_Pcqt","children":[],"key":"wc6EpgdjX7"}],"key":"zAN3z7tZt0"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.370283Z","iopub.status.busy":"2026-07-25T16:00:56.369738Z","iopub.status.idle":"2026-07-25T16:00:56.375471Z","shell.execute_reply":"2026-07-25T16:00:56.373938Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(y_train[0:10])\n","key":"eCzNkyzzpa"},{"type":"outputs","id":"5XtoExfaBn07nDexUP-Gl","children":[],"key":"b6eYicE0pN"}],"key":"ZNiBCGQAWA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scale the Data using StandardScaler","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HucWtBHO1l"}],"identifier":"scale-the-data-using-standardscaler","label":"Scale the Data using StandardScaler","html_id":"scale-the-data-using-standardscaler","implicit":true,"key":"w1GNwlueBz"}],"key":"mIBLpARlYU"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.382772Z","iopub.status.busy":"2026-07-25T16:00:56.382242Z","iopub.status.idle":"2026-07-25T16:00:56.405561Z","shell.execute_reply":"2026-07-25T16:00:56.403410Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.preprocessing import StandardScaler\n\nscaler = StandardScaler()\n\nX_train_std = scaler.fit_transform(X_train)\nX_test_std = scaler.transform(X_test)\n","key":"IfNyqDm0mU"},{"type":"outputs","id":"pNocQM9Eco4eXrSbdCQXv","children":[],"key":"WB4hhhlZYT"}],"key":"LrZpGTJEjB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.408792Z","iopub.status.busy":"2026-07-25T16:00:56.408403Z","iopub.status.idle":"2026-07-25T16:00:56.431682Z","shell.execute_reply":"2026-07-25T16:00:56.413046Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_train_std[0:1])\n","key":"hRGdXxo0Nm"},{"type":"outputs","id":"Jn09TeXO_EH_n96lMwROl","children":[],"key":"Zq30vpIXJw"}],"key":"zpBkdgcXvT"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.436459Z","iopub.status.busy":"2026-07-25T16:00:56.435767Z","iopub.status.idle":"2026-07-25T16:00:56.441166Z","shell.execute_reply":"2026-07-25T16:00:56.439969Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_test_std[0:1])\n","key":"EiHdJlK8RX"},{"type":"outputs","id":"Kl1LKOxvXe12-4s2SVQVZ","children":[],"key":"z4ON2QA5rq"}],"key":"MZwmjJtfEQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform PCA on Variable Number of Components","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JV551DjidJ"}],"identifier":"perform-pca-on-variable-number-of-components","label":"Perform PCA on Variable Number of Components","html_id":"perform-pca-on-variable-number-of-components","implicit":true,"key":"OdDQu7Ed04"}],"key":"Z6rmh53NxF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.447049Z","iopub.status.busy":"2026-07-25T16:00:56.446641Z","iopub.status.idle":"2026-07-25T16:00:56.773693Z","shell.execute_reply":"2026-07-25T16:00:56.772122Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.decomposition import PCA\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.metrics import accuracy_score\n\ndef run_one_pca_model(ncomp, seed):\n\n    pca = PCA(n_components=ncomp)\n\n    X_train_pca = pca.fit_transform(X_train_std)\n    X_test_pca = pca.transform(X_test_std)\n\n    model = MLPClassifier(\n        hidden_layer_sizes=(100,),\n        activation='logistic',\n        max_iter=20000,\n        alpha=1e-5,\n        solver='adam',\n        random_state=seed\n    )\n\n    model.fit(X_train_pca, y_train)\n\n    predictions = model.predict(X_test_pca)\n    acc = accuracy_score(y_test, predictions)\n\n    return ncomp, acc, predictions\n","key":"Ew0auPnEA3"},{"type":"outputs","id":"17Tka2Yn0CBvENv1Z891L","children":[],"key":"Nqk8ytvETv"}],"key":"ffnnRl9hF7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Function to Parallelize","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xgIjnYOBZe"}],"identifier":"create-function-to-parallelize","label":"Create Function to Parallelize","html_id":"create-function-to-parallelize","implicit":true,"key":"yhR1p2qqn0"}],"key":"uXiVuKvCxB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.777217Z","iopub.status.busy":"2026-07-25T16:00:56.776895Z","iopub.status.idle":"2026-07-25T16:00:56.782450Z","shell.execute_reply":"2026-07-25T16:00:56.780774Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from joblib import Parallel, delayed\n\ndef run_seed(seed):\n\n    results = Parallel(n_jobs=8, verbose=0)(\n        delayed(run_one_pca_model)(ncomp, seed)\n        for ncomp in range(1, 61)\n    )\n\n    return seed, results\n","key":"e5rsYy0r9m"},{"type":"outputs","id":"vs1vwfMGtkzy4YLoVrCp8","children":[],"key":"UIG0cmHMcb"}],"key":"zmGqhNdngZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.784832Z","iopub.status.busy":"2026-07-25T16:00:56.784615Z","iopub.status.idle":"2026-07-25T16:00:56.789641Z","shell.execute_reply":"2026-07-25T16:00:56.788242Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"#accuracies = []\n#best_accuracy = 0\n#best_components = 0\n#best_predictions = None\n\n#for ncomp, acc, predictions in results:\n#    accuracies.append(acc)\n\n#    if debug:\n#        print(f\"Components={ncomp:2d} Accuracy={acc:.4f}\")\n\n#    if acc > best_accuracy:\n#        best_accuracy = acc\n#        best_components = ncomp\n#        best_predictions = predictions\n\n#print(\"\\nBest Result\")\n#print(f\"Best Components = {best_components}\")\n#print(f\"Best Accuracy   = {best_accuracy:.4f}\")\n","key":"NOUiqZXfxe"},{"type":"outputs","id":"qq01GcEgOFZ5wx_Z-lU2p","children":[],"key":"V4DOQU55I7"}],"key":"ZPe1iX5nTO"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.791623Z","iopub.status.busy":"2026-07-25T16:00:56.791438Z","iopub.status.idle":"2026-07-25T16:01:39.677953Z","shell.execute_reply":"2026-07-25T16:01:39.674562Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# List of random seeds to test.\n# Using a variety of small + larger seeds helps check stability across different data splits.\nseeds = [0, 1, 2, 3, 4, 5, 10]\n\n# Container to store the final summary for every seed\nall_results = []\n\nprint('****** Initiating Paraellel Computation (8 cores) ******')\nprint()\n\n# === Main loop over seeds ===\nfor seed in seeds:\n\n    # Call the function that runs all n_components for this particular seed.\n    seed, results = run_seed(seed)\n\n    # Initialize variables to track the best configuration for this seed\n    best_ncomp = None\n    best_acc = 0\n    best_predictions = None\n\n    # Iterate through all (n_components, accuracy) pairs returned for this seed\n    for ncomp, acc, predictions in results:\n\n        # Keep track of the highest accuracy and its corresponding number of components\n        if acc > best_acc:\n            best_acc = acc\n            best_ncomp = ncomp\n            best_predictions = predictions\n\n    # Store a structured record for this seed\n    all_results.append(\n        {\n            \"seed\": seed,\n            \"best_ncomp\": best_ncomp,\n            \"best_acc\": best_acc,\n            \"best_predictions\": best_predictions,\n            \"results\": results # full list of all (ncomp, acc) pairs\n        }\n    )\n\n    # Print a nice one-line summary for this seed\n    print(\n        f\"Seed = {seed:3d},  \"\n        f\"Best Components = {best_ncomp:2d}, \"\n        f\"Accuracy = {best_acc:.4f}\"\n    )\n\nprint()\nprint('***** Parallel Computations Complete ******')\n","key":"QtBbjnichM"},{"type":"outputs","id":"mu4Dq6fs_oJ0pwGNkIxD4","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"****** Initiating Paraellel Computation (8 cores) ******\n\n"},"children":[],"key":"bocp5Da3Fx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   0,  Best Components = 13, Accuracy = 0.9206\n"},"children":[],"key":"YTD2GXZ3Fa"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   1,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"On45gipypS"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   2,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"ddW8CZB9Nt"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   3,  Best Components = 16, Accuracy = 0.9206\n"},"children":[],"key":"chAZRqD47u"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   4,  Best Components = 17, Accuracy = 0.9365\n"},"children":[],"key":"FPfJow7A5v"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   5,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"ErRhBNx77Q"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =  10,  Best Components = 17, Accuracy = 0.9365\n\n***** Parallel Computations Complete ******\n"},"children":[],"key":"sbprMxkChL"}],"key":"uZuBEWeuA0"}],"key":"yaHl6v7YKW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Find the Best Seed Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jSKq1EkJwU"}],"identifier":"find-the-best-seed-results","label":"Find the Best Seed Results","html_id":"find-the-best-seed-results","implicit":true,"key":"eWD8gxqEt2"}],"key":"xBxvfsmjI4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.681570Z","iopub.status.busy":"2026-07-25T16:01:39.681156Z","iopub.status.idle":"2026-07-25T16:01:39.688517Z","shell.execute_reply":"2026-07-25T16:01:39.686002Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Find the result with the highest best_acc\nbest_seed_result = max(\n    all_results,\n    key=lambda x: x[\"best_acc\"]\n)\n\nprint()\nprint(f\"Best Seed: {best_seed_result['seed']}\")\nprint(f\"Best Number of Compnents: {best_seed_result['best_ncomp']}\")\nprint(f\"Best Accuracy: {best_seed_result['best_acc']:.4f}\")   \n","key":"FUWWyddA8K"},{"type":"outputs","id":"pMqiw4N3_Pq75oIvojHR-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nBest Seed: 1\nBest Number of Compnents: 16\nBest Accuracy: 0.9365\n"},"children":[],"key":"t4yKFIae0a"}],"key":"Rbbfm8PIDV"}],"key":"ScVRVWKjWv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot the Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VJzkZc0W0h"}],"identifier":"plot-the-results","label":"Plot the Results","html_id":"plot-the-results","implicit":true,"key":"cfgTu7MmON"}],"key":"n808vCk0c2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.692425Z","iopub.status.busy":"2026-07-25T16:01:39.691979Z","iopub.status.idle":"2026-07-25T16:01:39.859238Z","shell.execute_reply":"2026-07-25T16:01:39.857546Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\n\n# Get results for the best seed\nresults = best_seed_result[\"results\"]\n\n# Extract component counts and accuracies\nncomps = np.array([r[0] for r in results])\naccuracies = np.array([r[1] for r in results])\n\n# Find best accuracy\nbest_idx = np.argmax(accuracies)\nbest_ncomp = ncomps[best_idx]\nbest_acc = accuracies[best_idx]\n\nplt.figure(figsize=(12, 6))\n\nplt.plot(\n    ncomps,\n    accuracies,\n    marker='o',\n    linestyle='-',\n    color='blue'\n)\n\n# Highlight best point\nplt.plot(\n    best_ncomp,\n    best_acc,\n    marker='o',\n    markersize=12,\n    color='red',\n    markeredgecolor='darkred',\n    markerfacecolor='none',\n    linewidth=2\n)\n\n# Annotate best point\nplt.annotate(\n    f'Best: {best_acc:.4f}\\n({best_ncomp} components)',\n    xy=(best_ncomp, best_acc),\n    xytext=(best_ncomp + 2, best_acc - 0.3),\n    fontsize=12,\n    fontweight='bold',\n    color='red',\n    arrowprops=dict(\n        arrowstyle='->',\n        color='red',\n        lw=1.5\n    ),\n    bbox=dict(\n        boxstyle='round,pad=0.4',\n        facecolor='yellow',\n        alpha=0.3\n    )\n)\n\nplt.xlabel(\"Number of PCA Components\")\nplt.ylabel(\"Test Accuracy\")\nplt.title(\n    f\"Accuracy vs Number of PCA Components\\n\"\n    f\"(Best Seed = {best_seed_result['seed']})\"\n)\n\nplt.ylim(0, 1)\nplt.xlim(1, 60)\nplt.xticks(np.arange(0, 61, 5))\nplt.grid(True)\n\n# Optional\nplt.axhline(\n    y=best_acc,\n    color='red',\n    linestyle='--',\n    alpha=0.5\n)\n\nplt.show()\n\nprint(\n    f\"Best seed: {best_seed_result['seed']}\"\n)\nprint(\n    f\"Best accuracy: {best_acc:.4f} \"\n    f\"using {best_ncomp} PCA components\"\n)\n","key":"sR5WRLtUP5"},{"type":"outputs","id":"iOoMUu0sNNH_quk6_NXB_","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9e41737c096e02aeb19779b9e43114dd","path":"/build/9e41737c096e02aeb19779b9e43114dd.png"},"text/plain":{"content":"<Figure size 1200x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"nYDe0fMqzb"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Best seed: 1\nBest accuracy: 0.9365 using 16 PCA components\n"},"children":[],"key":"jH665C1xL8"}],"key":"Q7wIK6sch3"}],"key":"bHUjrT02Dj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Confusion Matrix","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZGWvjcfpO0"}],"identifier":"create-confusion-matrix","label":"Create Confusion Matrix","html_id":"create-confusion-matrix","implicit":true,"key":"W5JiaurTbU"}],"key":"GQN5EktAwY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.861813Z","iopub.status.busy":"2026-07-25T16:01:39.861582Z","iopub.status.idle":"2026-07-25T16:01:39.870433Z","shell.execute_reply":"2026-07-25T16:01:39.868939Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"best_predictions = best_seed_result[\"best_predictions\"]\n","key":"o4NfPXsetu"},{"type":"outputs","id":"h0SHNw1lhqpUzYIhCIzeR","children":[],"key":"mwM2WnDUH1"}],"key":"wbZNCAczRX"},{"type":"block","kind":"notebook-code","data":