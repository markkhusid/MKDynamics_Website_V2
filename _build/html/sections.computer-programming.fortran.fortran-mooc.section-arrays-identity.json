{"version":3,"kind":"Notebook","sha256":"090f661be1fed13c65c24a44d834969e712df6878baf9ac88e934ad0287e3393","slug":"sections.computer-programming.fortran.fortran-mooc.section-arrays-identity","location":"/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","dependencies":[],"frontmatter":{"title":"Section Arrays: Identity","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3.9.15 ('base')","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","exports":[{"format":"ipynb","filename":"Section_Arrays_Identity.ipynb","url":"/build/Section_Arrays_Ident-fff7bb1ebb4633aff1b31f3ab06c1271.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DPOoiGsNyL"},{"type":"link","url":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/gjbex​/Fortran​-MOOC​/tree​/master​/source​_code​/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jdJxfA8ZF8"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"jsNZK5on4x"}],"key":"ClwdD65KDS"}],"key":"UrzZDIYSja"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates reading in command line arguments in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aJqey1GhSx"}],"identifier":"this-program-demonstrates-reading-in-command-line-arguments-in-fortran","label":"This program demonstrates reading in command line arguments in Fortran.","html_id":"this-program-demonstrates-reading-in-command-line-arguments-in-fortran","implicit":true,"key":"XDBDK9RWz5"}],"key":"wiNBFFBMqD"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program identity\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer :: n, i, istat\n    real, dimension(:, :), allocatable :: A\n\n    n = get_size()\n    allocate(A(n, n), stat=istat)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(A)') &\n            'error: can not allocate array'\n        stop 3\n    end if\n    A = eye(n)\n    do i = 1, size(A, 1)\n        print *, A(i, :)\n    end do\n    deallocate(A)\n\ncontains\n\n    function get_size() result(n)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer :: n\n        integer :: istat\n        character(len=1024) :: buffer, msg\n\n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting an integer argument, size of array'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, fmt=*, iostat=istat, iomsg=msg) n\n        if (istat /= 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'error: ', msg\n            stop 2\n        end if\n    end function get_size\n\n    function eye(n) result(matrix)\n        implicit none\n        integer, value :: n\n        real, dimension(n, n) :: matrix\n        integer :: i\n\n        matrix = 0.0\n        do i = 1, size(A, 1)\n            matrix(i, i) = 1.0\n        end do\n    end function eye\n\nend program identity","position":{"start":{"line":1,"column":1},"end":{"line":57,"column":1}},"key":"ydPmzEKKWf"}],"key":"xmRnjA9YIW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L2IQWeTi89"}],"key":"KF43Ds8Xc2"}],"key":"UwOBY55nfp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jmIVpvfzy9"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"djPAVF8uwv"}],"key":"HSLSNAtiC5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"gaEk561Pjz"},{"type":"outputs","id":"bfLMSQYxdRtaoyQDxwKbL","children":[],"key":"xA4joDm7um"}],"key":"mgeSTUpowL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Identity\"","key":"AUGZiPtJUL"},{"type":"outputs","id":"Q3-Y1q2CfmFhdycqEoTi9","children":[],"key":"cNVQmnbtZS"}],"key":"wGiM2VRJUd"