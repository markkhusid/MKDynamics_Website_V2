fier":"step-by-step-explanation","label":"Step-by-step explanation","html_id":"step-by-step-explanation","implicit":true,"key":"PO2CpR9iqO"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"random_seed(size=...) reports how many integers the seed needs.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"alsKOykPs8"}],"key":"FhkbZvFxgA"}],"key":"GVPFYFJ858"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Allocate seed arrays and random_seed(get=...) to capture the current seed.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"BKVo41XvYJ"}],"key":"yvD0KEp9RM"}],"key":"vys1s2wiuK"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Draw a few random_number samples and print them.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"NjxAShpOFX"}],"key":"irTv53XbtL"}],"key":"MXorIH5LIL"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Put the saved seed back with random_seed(put=...).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"TQjqWSwsDB"}],"key":"VjJLfIieKa"}],"key":"Al5PkSaC1f"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Drawing again reproduces the same sequence after reseeding.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ygiM5JBQuV"}],"key":"o0JJCWtuoO"}],"key":"ZeyVG22cJB"}],"key":"V2gQSlxeGs"}],"key":"Vhbmiez9Oa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lfaUHpFlRW"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"cX3YJ1omgw"}],"key":"x9F0mPnaEK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"random_numbers.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ylb9pChNvK"}],"identifier":"random-numbers-f90","label":"random_numbers.f90","html_id":"random-numbers-f90","implicit":true,"key":"qClwg3lpz8"},{"type":"include","file":"Fortran_Code/Section_Random_Numbers/app/random_numbers.f90","literal":true,"children":[{"type":"code","value":"program random_numbers\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, parameter :: nr_vals = 3\n    integer :: seed_size, istat, i\n    integer, dimension(:), allocatable :: seed_vals, new_seed_vals\n    real :: r\n\n    ! check how many integers are required to seed the RNG\n    call random_seed(size=seed_size)\n    print '(A, I0)', 'number of seeds: ', seed_size\n\n    ! allocate the array to hold the seeds\n    allocate (seed_vals(seed_size), new_seed_vals(seed_size), stat=istat)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(A)') 'error: can not allocate seed'\n        stop 1\n    end if\n\n    ! get the current seed values\n    call random_seed(get=seed_vals)\n    print '(A, *(I12))', 'seeds: ', seed_vals\n\n    ! print some random numbers\n    print '(A)', 'values:'\n    do i = 1, nr_vals\n        call random_number(r)\n        print '(F10.7)', r\n    end do\n\n    ! get current seed\n    call random_seed(get=new_seed_vals)\n    print '(A, *(I12))', 'current seeds: ', new_seed_vals\n\n    ! reseed\n    call random_seed(put=seed_vals)\n    print '(A)', 'values after reseed:'\n    do i = 1, nr_vals\n        call random_number(r)\n        print '(F10.7)', r\n    end do\n\n    ! clean up\n    deallocate(seed_vals)\nend program random_numbers\n","lang":"fortran","filename":"random_numbers.f90","key":"WlJ9t1DUQT"}],"key":"WZhb8sAW6k"}],"key":"P8QoNkAltI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Nk5fFPmszH"}],"key":"jnP2IR6i3s"}],"key":"lSjQ5savQh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aLbc3R2PP6"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"S4ZxMFn6zK"}],"key":"w6ha3s8Mme"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"vpUH2xT8Km"},{"type":"outputs","id":"OKUCGbzXq1TxpogbOYgEG","children":[],"key":"tw50wHgWR8"}],"key":"qa6M51mwW4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"typ