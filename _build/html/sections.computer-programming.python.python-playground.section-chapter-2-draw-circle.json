pe":"outputs","id":"aFcXA7Pzd4meDUoHYWC3w","children":[],"visibility":"show","key":"kQTABdFi1t"}],"identifier":"f77f9126-86cc-4a1b-89b9-5ad5f61cf72c","html_id":"f77f9126-86cc-4a1b-89b9-5ad5f61cf72c","visibility":"show","key":"vqWvkMtMP7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"JeDgz6zyUV"},{"type":"outputs","id":"6cgkd09M3JXf2VJnxtv3A","children":[],"key":"ygcRi3fEbA"}],"identifier":"c2eeda29-613f-48fd-904b-af9aef8813a2","html_id":"c2eeda29-613f-48fd-904b-af9aef8813a2","key":"zPZrR13COx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# %load drawcircle.py\nimport math\nimport turtle\n\n# draw the circle using turtle\ndef drawCircleTurtle(x, y, r):\n\t# move to the start of the circle\n\tturtle.up()\n\tturtle.setpos(x + r, y)\n\tturtle.down()\n\n\t# draw the circle\n\tfor i in range(0, 365, 5):\n\t\ta = math.radians(i)\n\t\tturtle.setpos(x + r * math.cos(a), y + r * math.sin(a))\n\ndrawCircleTurtle(100, 100, 50)\nturtle.mainloop()","key":"bDoTYfLCnP"},{"type":"outputs","id":"yp8tWBTcgAFxLLyopiLMI","children":[],"key":"viLFdG7xYn"}],"identifier":"0fbd7621-e800-4235-ab30-80560cc3e1a8","html_id":"0fbd7621-e800-4235-ab30-80560cc3e1a8","key":"dfokmLIJHY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A window opens up with the output.  The output is saved to an image file.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XvoEdwvWEK"}],"key":"nWuw9oUbuc"}],"identifier":"6dc08bad-6ea2-4b16-bb7a-61f788e49844","html_id":"6dc08bad-6ea2-4b16-bb7a-61f788e49844","key":"mvHE4bGrPE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from IPython.display import display\nfrom PIL import Image\nimg_PIL = Ima