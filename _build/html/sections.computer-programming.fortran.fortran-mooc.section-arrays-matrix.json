l = ', total\nend program matrix","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"h1eyQaemd9"}],"key":"k7Q9GSPaxL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gIVEWW1tol"}],"key":"A7e79gKdLn"}],"key":"yCVZNIJhDI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R3eLBVqNG5"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"TtMGCdOeLq"}],"key":"nYZN1FpMdV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"H9BOfEndcr"},{"type":"outputs","id":"vROUvfnxZfFBFjm2-w-F8","children":[],"key":"RjgGvv5rSw"}],"key":"jL43PJieJT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Matrix\"","key":"CXx4p251WQ"},{"type":"outputs","id":"xsZ1-wBPou8Lkas-sT40i","children":[],"key":"XVbAupxIq3"}],"key":"nnNc3QXY13"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"h6x4xvH0Ja"},{"type":"outputs","id":"ttvpunc7zeUNuE4qQAR5i","children":[],"key":"hR5hMnuWv9"}],"key":"tZPY4tFLD4"},{"type":"block","kind":"notebook-code","children":[{"type