  end do\n  end do\n  print '(/, A, F10.2)', 'total = ', total\nend program matrix","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"hYLIk1RXQS"}],"key":"iIDFF1mIAw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HoL2PRAvlY"}],"key":"XWRK9TLhDw"}],"key":"rNecL2mvA6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m11fMCX0F6"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"UcwQK1jN1U"}],"key":"Y6uDe71TEV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"r2rvqkaqdI"},{"type":"outputs","id":"ff99u_43XSVz_IYcYetjw","children":[],"key":"A2jAcOXTF7"}],"key":"YIe6Gemzxt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Matrix\"","key":"WvRiYZwH1J"},{"type":"outputs","id":"ts8qWTmZiMg6S8bzYr_9b","children":[],"key":"rWhztETE5v"}],"key":"S4DXv7cBum"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"al13v9qy0o"},{"type":"outputs","id":"WzwNTUb3H8L7k6ei-4r49","children":[],"key":"M5pvwqBiNS"}],"key":"B0m4YsWg0s"},{"type"