ntifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"BBVJd9YAxl"}],"identifier":"4883d54d-377f-427c-b3c7-b3e4878aa8e4","html_id":"4883d54d-377f-427c-b3c7-b3e4878aa8e4","key":"i9nzIPAAYz"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Bit_Manipulations_Create_Lookup_Table/app/section_bit_manipulations_create_lookup_table.f90","literal":true,"children":[{"type":"code","value":"program create_lookup_table\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, dimension(256) :: lookup_table\n    character(len=1024) :: file_name, msg\n    integer :: i, unit_nr, istat\n\n    lookup_table = init_lookup_table()\n    if (command_argument_count() /= 1) then\n        write (unit=error_unit, fmt='(A)') 'error: expacting file name as argument'\n        stop 1\n    end if\n    call get_command_argument(1, file_name)\n    open (newunit=unit_nr, file=trim(file_name), status='replace', &\n        access='sequential', form='formatted', iostat=istat, iomsg=msg)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(2A)') 'error: ', trim(msg)\n        stop 1\n    end if\n    do i = 1, 15\n        write (unit=unit_nr, fmt='(\"        \", 16(I3, \",\"), \" &\")') &\n            lookup_table((i - 1)*16 + 1:i*16) \n    end do\n    write (unit=unit_nr, fmt='(\"        \", 15(I3, \",\"))', advance='no') &\n                lookup_table(15*16 + 1:16*16 - 1) \n    write (unit=unit_nr, fmt='(I3, \" &\")') lookup_table(256)\n    close (unit=unit_nr)\n\ncontains\n\n    function init_lookup_table() result(lookup_table)\n        implicit none\n        integer, dimension(0:255) :: lookup_table\n        integer :: i\n\n        lookup_table(0) = 0\n        do i = 1, 255\n            lookup_table(i) = and(i, 1) + lookup_table(i/2)\n        end do\n    end function init_lookup_table\n\nend program create_lookup_table\n","lang":"fortran","filename":"section_bit_manipulations_create_lookup_table.f90","key":"EzQ745hPzj"}],"key":"A4mgFnITH3"}],"identifier":"49f81255","html_id":"49f81255","key":"buXXlrfSir"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm).  The following FPM configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"f4aWZZzPSC"}],"key":"MXsnd3WsFY"}],"identifier":"4c6b9985-c0cb-4602-8309-4e3369dd3226","html_id":"4c6b9985-c0cb-4602-8309-4e3369dd3226","key":"goq313VG21"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Bit_Manipulations_Create_Lookup_Table/fpm.toml","literal":true,"children":[{"type":"code","value":"name = \"Section_Bit_Manipulations_Create_Lookup_Table\"\n\n[build]\nauto-executables = true\nauto-tests = true\nauto-examples = true\n\n[install]\nlibrary = false\n\n[[executable]]\nname=\"Section_Bit_Manipulations_Create_Lookup_Table\"\nsource-dir=\"app\"\nmain=\"section_bit_manipulations_create_lookup_table.f90\"\n","lang":"toml","filename":"fpm.toml","key":"X1nwfk6XNQ"}],"key":"KHzvcLdBK3"}],"identifier":"eee45759","html_id":"eee45759","key":"dSVAMMEhII"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w8jjBkIlg3"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"LnUuW4Hqmm"}],"identifier":"c6f9ed20","html_id":"c6f9ed20","visibility