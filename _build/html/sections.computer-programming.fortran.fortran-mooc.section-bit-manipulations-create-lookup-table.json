}},"key":"jFuIVBNE3Z"}],"key":"rZisqAU7PW"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Generating lookup tables for bit-counting applications.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"SDSgxGpCue"}],"key":"GVxFwMTpny"}],"key":"LgiNgNZFRL"},{"type":"listItem","spread":true,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Demonstrating efficient table initialization using recursion.","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"oyoLpYmgrH"}],"key":"ZWXUJu4uHh"}],"key":"Th1SfNDj0w"},{"type":"listItem","spread":true,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Creating formatted output for use in other programs or as human-readable data.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"BuQGdQJDD6"}],"key":"HICOSqY6CE"}],"key":"lvr7w7g44D"}],"key":"lRX25azgVE"}],"key":"GtUCIvyDLp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P9LfWJ1RgA"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"hzxpMI2TNr"}],"key":"McrnGfCYqS"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Bit_Manipulations_Create_Lookup_Table/app/section_bit_manipulations_create_lookup_table.f90","literal":true,"children":[{"type":"code","value":"program create_lookup_table\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, dimension(256) :: lookup_table\n    character(len=1024) :: file_name, msg\n    integer :: i, unit_nr, istat\n\n    lookup_table = init_lookup_table()\n    if (command_argument_count() /= 1) then\n        write (unit=error_unit, fmt='(A)') 'error: expacting file name as argument'\n        stop 1\n    end if\n    call get_command_argument(1, file_name)\n    open (newunit=unit_nr, file=trim(file_name), status='replace', &\n        access='sequential', form='formatted', iostat=istat, iomsg=msg)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(2A)') 'error: ', trim(msg)\n        stop 1\n    end if\n    do i = 1, 15\n        write (unit=unit_nr, fmt='(\"        \", 16(I3, \",\"), \" &\")') &\n            lookup_table((i - 1)*16 + 1:i*16) \n    end do\n    write (unit=unit_nr, fmt='(\"        \", 15(I3, \",\"))', advance='no') &\n                lookup_table(15*16 + 1:16*16 - 1) \n    write (unit=unit_nr, fmt='(I3, \" &\")') lookup_table(256)\n    close (unit=unit_nr)\n\ncontains\n\n    function init_lookup_table() result(lookup_table)\n        implicit none\n        integer, dimension(0:255) :: lookup_table\n        integer :: i\n\n        lookup_table(0) = 0\n        do i = 1, 255\n            lookup_table(i) = and(i, 1) + lookup_table(i/2)\n        end do\n    end function init_lookup_table\n\nend program create_lookup_table\n","lang":"fortran","filename":"section_bit_manipulations_create_lookup_table.f90","key":"YZ4Z8fjgGi"}],"key":"u5u5oALHNL"}],"key":"qJThSwwxwB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm).  The following FPM configuration file (fpm.toml) was used:","position":{"start":{"line":1,"colu