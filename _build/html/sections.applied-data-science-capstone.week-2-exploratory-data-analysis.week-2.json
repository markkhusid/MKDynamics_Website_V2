},"end":{"line":56,"column":1}},"key":"torZjQR8Ju"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Mission outcomes are 99 Success, 1 Failure (in flight), and 1 Success (payload status unclear). One success row is stored as ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"tValTvKhly"},{"type":"inlineCode","value":"Success","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"ECnzojyePn"},{"type":"text","value":" with a trailing space, so a raw ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"NirslFe087"},{"type":"inlineCode","value":"GROUP BY","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"qGpAjXsuPu"},{"type":"text","value":" splits the 99 into 98 and 1. ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"CiYiRvb7JA"},{"type":"inlineCode","value":"TRIM","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"nagK8M38CU"},{"type":"text","value":" puts them back together.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"xMtXdMSBU8"}],"key":"py6RggS7jO"},{"type":"code","lang":"sql","value":"SELECT TRIM(Mission_Outcome) AS mission_outcome, COUNT(*) AS flights\nFROM SPACEXTBL\nGROUP BY TRIM(Mission_Outcome);","position":{"start":{"line":60,"column":1},"end":{"line":64,"column":1}},"key":"QFnVCk4d4O"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"The maximum payload is 15,600 kg, on twelve B5 boosters: B1048.4, B1049.4, B1051.3, B1056.4, B1048.5, B1051.4, B1049.5, B1060.2, B1058.3, B1051.6, B1060.3, and B1049.7.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"l3GZRIImaM"}],"key":"IYbb0hDpkh"},{"type":"code","lang":"sql","value":"SELECT Booster_Version, PAYLOAD_MASS__KG