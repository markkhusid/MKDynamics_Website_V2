float(np.ravel(p2_y_t)[-1]) - 3),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.3\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    print(f\"y(T_END) ≈ {float(np.ravel(p2_y_t)[-1]):.6f}\")\n","key":"LkDwPitztp"},{"type":"outputs","id":"XVqXDr2m9zxVE08dBUsXk","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5f67f0f0281284a3911a02ba4e354dbb","path":"/build/5f67f0f0281284a3911a02ba4e354dbb.png"},"text/plain":{"content":"<Figure size 1100x450 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"HgUDivNQEr"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y(T_END) ≈ 9.992651\n"},"children":[],"key":"PL0YWL8OXP"}],"key":"P5r5xoj78x"}],"key":"Z9fdVrN15D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Problem 3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BjJ90lUa6g"}],"identifier":"problem-3","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"DH4fGsXq9H"}],"key":"akfKCuTHtr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k8bLq8KrPi"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"FPDALWUg3f"}],"key":"gmgeuyYSYE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:29.890374Z","iopub.status.busy":"2026-07-25T18:52:29.879313Z","iopub.status.idle":"2026-07-25T18:52:29.975023Z","shell.execute_reply":"2026-07-25T18:52:29.936164Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"DJdDn1aRPy"},{"type":"outputs","id":"R0Dt8QfAgP0ACqoEqcKqk","children":[],"key":"g2sBRRZguJ"}],"key":"axDncpXFuU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Kiqbsk3NJ3"}],"identifier":"define-problem-3s-initial-conditions","label":"Define Problem 3’s Initial Conditions","html_id":"define-problem-3s-initial-conditions","implicit":true,"key":"Xz6iaUQZZd"}],"key":"c3uDZGsFpo"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.007394Z","iopub.status.busy":"2026-07-25T18:52:30.006924Z","iopub.status.idle":"2026-07-25T18:52:30.098450Z","shell.execute_reply":"2026-07-25T18:52:30.085343Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"p3_y_init = np.array([1, 1], dtype=float) # [y(0), y'(0)]\n","key":"SLiUlBwoJK"},{"type":"outputs","id":"ScxwKOLyDYtkxXuSqmm8z","children":[],"key":"o2RvQJV30G"}],"key":"gjOHApEWUd"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.12