","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"M5xGtpTT0h"}],"key":"pXpe283swM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uUsu95C2ar"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"NmqvvBTvJH"}],"key":"QAMQBAeiKI"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.608897Z","iopub.status.busy":"2026-07-25T15:59:39.608385Z","iopub.status.idle":"2026-07-25T15:59:39.620318Z","shell.execute_reply":"2026-07-25T15:59:39.616796Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"g6y84L4PCz"},{"type":"outputs","id":"6vRP_OMZwbh5r4w7k78-0","children":[],"key":"DqziPrDC8B"}],"key":"kJlv8vKhAY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pRpG3Os53I"}],"identifier":"define-problem-3s-initial-conditions","label":"Define Problem 3’s Initial Conditions","html_id":"define-problem-3s-initial-conditions","implicit":true,"key":"aMQKvjyin5"}],"key":"d6hbCj55e1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.627581Z","iopub.status.busy":"2026-07-25T15:59:39.627024Z","iopub.status.idle":"2026-07-25T15:59:39.676189Z","shell.execute_reply":"2026-07-25T15:59:39.632077Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"p3_y_init = np.array([1, 1], dtype=float) # [y(0), y'(0)]\n","key":"tnoJiWYoQL"},{"type":"outputs","id":"3fl6j6yPUNKrKUeh86IEr","children":[],"key":"ZLTiGhpF5w"}],"key":"Z84fIwCqYL"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.709788Z","iopub.status.busy":"2026-07-25T15:59:39.695816Z","iopub.status.idle":"2026-07-25T15:59:39.803387Z","shell.execute_reply":"2026-07-25T15:59:39.746109Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(p3_y_init)\n","key":"ymJyyd7jIT"},{"type":"outputs","id":"1JcrFmgUVDuBSraNl-Fc4","children":[],"key":"KbSz9RWrqb"}],"key":"Veo67LvQYy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solve ODE using ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CkCHpNuv1m"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"odeint","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Or8YiMEO7g"}],"key":"LVja1R36mz"}],"identifier":"solve-ode-using-odeint","label":"Solve ODE using odeint","html_id":"solve-ode-using-odeint-2","implicit":true,"key":"ZZibWMRURi"}],"key":"ycKzwhQSAB"},{"type":"block","kind":"notebook-code","d