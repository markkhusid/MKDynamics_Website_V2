, float(np.ravel(p3_y_t)[450])),\n             xytext=(3.0, float(np.max(np.ravel(p3_y_t))) - 0.5),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.35\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    print(f\"y range: [{p3_y_t.min():.4f}, {p3_y_t.max():.4f}]\")\n    print(f\"y' range: [{p3_y_prime_t.min():.4f}, {p3_y_prime_t.max():.4f}]\")\n","key":"ABOC5Q5l6h"},{"type":"outputs","id":"lxpmitVgEYsBt8J5tKzZ9","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8bab48539cce5e9f82833ac1849100c1","path":"/build/8bab48539cce5e9f82833ac1849100c1.png"},"text/plain":{"content":"<Figure size 1100x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"CJQN7gs0Zl"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y range: [-7.0715, 7.0247]\ny' range: [-7.0610, 7.0711]\n"},"children":[],"key":"Dv1ZgzapDa"}],"key":"UcOJEzotHb"}],"key":"EgioPjcbxs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary comparison of all three solutions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mhAxvmkwLI"}],"identifier":"summary-comparison-of-all-three-solutions","label":"Summary comparison of all three solutions","html_id":"summary-comparison-of-all-three-solutions","implicit":true,"key":"ws9tGbfdHJ"}],"key":"YM8uQCkyn8"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:31.865911Z","iopub.status.busy":"2026-07-25T18:52:31.863392Z","iopub.status.idle":"2026-07-25T18:52:34.579487Z","shell.execute_reply":"2026-07-25T18:52:34.511162Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(3, 1, figsize=(11, 9), sharex=True, constrained_layout=True)\naxes[0].plot(t, p1_y_t, color=\"C0\", lw=2)\naxes[0].set_ylabel(r\"$y$\")\naxes[0].set_title(r\"P1: $y'=\\cos t$\")\naxes[0].grid(True, alpha=0.35)\naxes[0].annotate(\"sinusoidal + offset\", xy=(2, float(np.ravel(p1_y_t)[200])), xytext=(3.5, 2.0),\n                 arrowprops=dict(arrowstyle=\"->\", color=\"C0\"), fontsize=9)\n\naxes[1].plot(t, p2_y_t, color=\"C1\", lw=2)\naxes[1].set_ylabel(r\"$y$\")\naxes[1].set_title(r\"P2: linear 1st-order with forcing\")\naxes[1].grid(True, alpha=0.35)\n\naxes[2].plot(t, p3_y_t, color=\"C2\", lw=2, label=r\"$y$\")\naxes[2].plot(t, p3_y_prime_t, color=\"C3\", lw=1.8, label=r\"$y'$\")\naxes[2].set_xlabel(\"t\")\naxes[2].set_ylabel(r\"$y$, $y'$\")\naxes[2].set_title(r\"P3: reduced 2nd-order system\")\naxes[2].grid(True, alpha=0.35)\naxes[2].legend(loc=\"best\")\nplt.show()\n","key":"hDDuZkUenv"},{"type":"outputs","id":"M2ZeyyjHm3kCCr2RPvTi7","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b4e20a753c2259362db39202288b05fc","path":"/build/b4e20a753c2259362db39202288b05fc.png"},"text/plain":{"content":"<Figure size 1100x900 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"rLjGrynBDb"}],"key":"SAWaOFy7Cz"}],"key":"Pc35Mu7dRS"}],"key":"W5IW1a072s"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Homework Module 4 — Classical Bit Demodulator (BPSK)","url":"/sections/mse-projects/eee591-python-for-rapid-engineering-solutions/hw/hw-m4/hw4-591","group":"Master of Science in Engineering - Electrical Engineering Projects"},"next":{"title":"Homework Module 11 — Monte Carlo Estimation of $\\pi$","url":"/sections/mse-projects/eee591-python-for-rapid-engineering-solutions/hw/hw-m11/hw-m11","group":"Master of Science in Engineering - Electrical Engineering Projects"}}},"domain":"http://localhost:3000"}