e":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y(T_END) ≈ 9.992651\n"},"children":[],"key":"w3XCPwH1sf"}],"key":"tiKzOiTBM0"}],"key":"FNrvH8ktfJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Problem 3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F4TkZs7VAg"}],"identifier":"problem-3","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"lhEOnrMrCx"}],"key":"KxixAlHhVM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OzPW0JSXXg"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"fn81YBZiTY"}],"key":"N6LSMdDavP"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:29.890374Z","iopub.status.busy":"2026-07-25T18:52:29.879313Z","iopub.status.idle":"2026-07-25T18:52:29.975023Z","shell.execute_reply":"2026-07-25T18:52:29.936164Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"ExEQsmBNer"},{"type":"outputs","id":"gGFY4NkUXOtl4mMts8TCU","children":[],"key":"qjL7zV7kRM"}],"key":"YcahlXm9nQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uSYxFYCoz8"}],"identifier":"define-problem-3s-initial-conditions","label":"Define Problem 3’s Initial Conditions","html_id":"define-problem-3s-initial-conditions","implicit":true,"key":"D5uCRdapHj"}],"key":"HhglnpTGK4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.007394Z","iopub.status.busy":"2026-07-25T18:52:30.006924Z","iopub.status.idle":"2026-07-25T18:52:30.098450Z","shell.execute_reply":"2026-07-25T18:52:30.085343Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"p3_y_init = np.array([1, 1], dtype=float) # [y(0), y'(0)]\n","key":"cSIKt9U68c"},{"type":"outputs","id":"Iri4RNZRtEmlkNv61MRop","children":[],"key":"LYN7Ja3Qah"}],"key":"iTeX1Rjo3s"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.126478Z","iopub.status.busy":"2026-07-25T18:52:30.124489Z","iopub.status.idle":"2026-07-25T18:52:30.180742Z","shell.execute_reply":"2026-07-25T18:52:30.178992Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(p3_y_init)\n","key":"ujbH7sCtZP"},{"type":"outputs","id":"HHGzgUMYDryjrQ4C7Ros5","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[1. 1.]\n"},"children":[],"key":"qypqzIeTNx"}],"key":"YRMSbKzu2F"}],"key":"YLNxuRA6T7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line