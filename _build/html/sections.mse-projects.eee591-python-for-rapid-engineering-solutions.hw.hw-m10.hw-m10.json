ct(arrowstyle=\"->\", color=\"C0\"), fontsize=10)\nplt.annotate(\"IC: $y'=1$\", xy=(0, 1), xytext=(0.6, -2.0),\n             arrowprops=dict(arrowstyle=\"->\", color=\"C1\"), fontsize=10)\nplt.annotate(\"forced 2nd-order linear ODE\", xy=(4.5, float(np.ravel(p3_y_t)[450])),\n             xytext=(3.0, float(np.max(np.ravel(p3_y_t))) - 0.5),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.35\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    print(f\"y range: [{p3_y_t.min():.4f}, {p3_y_t.max():.4f}]\")\n    print(f\"y' range: [{p3_y_prime_t.min():.4f}, {p3_y_prime_t.max():.4f}]\")\n","key":"OuruO0BFoN"},{"type":"outputs","id":"HByUkxtiyRbf8_KHuW7Qu","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8bab48539cce5e9f82833ac1849100c1","path":"/build/8bab48539cce5e9f82833ac1849100c1.png"},"text/plain":{"content":"<Figure size 1100x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"D6Qx90yV5O"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y range: [-7.0715, 7.0247]\ny' range: [-7.0610, 7.0711]\n"},"children":[],"key":"A0g1iHElfZ"}],"key":"eW6qBhx0DW"}],"identifier":"0b97ad7b-217f-4295-a615-27eba544a686","html_id":"0b97ad7b-217f-4295-a615-27eba544a686","key":"lCKJPPKFJs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary comparison of all three solutions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yO2SwaT2Dm"}],"identifier":"summary-comparison-of-all-three-solutions","label":"Summary comparison of all three solutions","html_id":"summary-comparison-of-all-three-solutions","implicit":true,"key":"aZgBHHL3Fn"}],"identifier":"61852c14","html_id":"61852c14","key":"hBdO15jtR2"},{"type":"block","kind":"notebook-code","data":{"executio