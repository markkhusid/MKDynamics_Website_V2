}+10$, $y(0)=0$\")\nplt.grid(True, alpha=0.35)\nplt.legend(loc=\"best\")\nplt.annotate(\"starts at 0\", xy=(0, 0), xytext=(1.0, 2.0),\n             arrowprops=dict(arrowstyle=\"->\", color=\"C0\"), fontsize=10)\n# asymptotic trend ~ 10 as steady-ish from forcing\nplt.annotate(\"rises toward quasi-steady regime\", xy=(6.0, float(np.ravel(p2_y_t)[-1])),\n             xytext=(3.5, float(np.ravel(p2_y_t)[-1]) - 3),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.3\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    print(f\"y(T_END) ≈ {float(np.ravel(p2_y_t)[-1]):.6f}\")\n","key":"IyeKJ2NltL"},{"type":"outputs","id":"cPHMrG-HePdZpIOINa5LA","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5f67f0f0281284a3911a02ba4e354dbb","path":"/build/5f67f0f0281284a3911a02ba4e354dbb.png"},"text/plain":{"content":"<Figure size 1100x450 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"UaR0uiZzhq"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y(T_END) ≈ 9.992651\n"},"children":[],"key":"kVlgn5dfOq"}],"key":"Uh62KAqj4d"}],"identifier":"3bddfb45-2853-4bb1-a7b6-42dfd2e5d7b8","html_id":"3bddfb45-2853-4bb1-a7b6-42dfd2e5d7b8","key":"cbPyHXOWWK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Problem 3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Y12OoNexXA"}],"identifier":"problem-3","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"h8NLXl4uuU"}],"identifier":"6b2ecd48-5d12-4329-aef0-770e9ad67fc0","html_id":"6b2ecd48-5d12-4329-aef0-770e9ad67fc0","key":"ijp5TFGWG3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zfVg5KpAbn"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"PmZL2JcxfH"}],"identifier":"f5dc4ccc-e9a4-43ee-b5d9-75c09f9e3065","html_id":"f5dc4ccc-e9a4-43ee-b5d9-75c09f9e3065","key":"feAvvn3WoE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:29.890374Z","iopub.status.busy":"2026-07-25T18:52:29.879313Z","iopub.status.idle":"2026-07-25T18:52:29.975023Z","shell.execute_reply":"2026-07-25T18:52:29.936164Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"GmplPUojdh"},{"type":"outputs","id":"PhkCWQaVU7MJA4BVCfKjB","children":[],"key":"cfJTyQRa0V"}],"identifier":"d15cac53-7edd-4d73-86c8-e9e42d942dee","html_id":"d15cac53-7edd-4d73-86c8-e9e42d942dee","key":"L0M3qqyLaH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tBmcxAUwYP"}],"identifier":"define-problem-3s-initial-condi