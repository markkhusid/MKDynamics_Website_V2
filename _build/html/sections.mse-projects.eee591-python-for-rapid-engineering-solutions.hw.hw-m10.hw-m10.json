","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"TZrjSgUshi"}],"key":"Ta0XrpL7IO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TooCfNrfBc"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"lUPhuAk7k9"}],"key":"WZ6uXNuFvX"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.608897Z","iopub.status.busy":"2026-07-25T15:59:39.608385Z","iopub.status.idle":"2026-07-25T15:59:39.620318Z","shell.execute_reply":"2026-07-25T15:59:39.616796Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"FhM9dw7td1"},{"type":"outputs","id":"4FmgQyoi4mwKw_6LSDeE9","children":[],"key":"AJJ4FyM5Gr"}],"key":"gfMXpiN4i0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AOMXUqcmnQ"}],"identifier":"define-problem-3s-initial-conditions","label":"Define Problem 3’s Initial Conditions","html_id":"define-problem-3s-initial-conditions","implicit":true,"key":"oDcjxGmWSS"}],"key":"uyd0xJX1YC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.627581Z","iopub.status.busy":"2026-07-25T15:59:39.627024Z","iopub.status.idle":"2026-07-25T15:59:39.676189Z","shell.execute_reply":"2026-07-25T15:59:39.632077Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"p3_y_init = np.array([1, 1], dtype=float) # [y(0), y'(0)]\n","key":"YOUkXaP5zt"},{"type":"outputs","id":"3CJfBkQerRCK_GAN9X9t-","children":[],"key":"qIbcVQhtu2"}],"key":"K7WSf2RLOS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T15:59:39.709788Z","iopub.status.busy":"2026-07-25T15:59:39.695816Z","iopub.status.idle":"2026-07-25T15:59:39.803387Z","shell.execute_reply":"2026-07-25T15:59:39.746109Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(p3_y_init)\n","key":"vhNHQuisd9"},{"type":"outputs","id":"CQfLZ75em7mirIfdV3e9R","children":[],"key":"tDc5nxLsGE"}],"key":"g6uKcpoQ8k"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solve ODE using ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qOIjs1gy3i"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"odeint","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CHfpNnM9Os"}],"key":"H5RdKELtpX"}],"identifier":"solve-ode-using-odeint","label":"Solve ODE using odeint","html_id":"solve-ode-using-odeint-2","implicit":true,"key":"hviFWKMYmC"}],"key":"Xz3Ck36xwF"},{"type":"block","kind":"notebook-code","d