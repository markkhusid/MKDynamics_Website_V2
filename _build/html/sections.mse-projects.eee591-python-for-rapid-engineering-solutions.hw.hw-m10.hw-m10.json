"$y(t)$ from odeint\", lw=2)\nif debug:\n    plt.plot(t, p1_f_prime_y_t(0, t), \"--\", label=r\"$y'(t)=\\cos(t)$ (RHS)\", alpha=0.85)\n# Analytic: y = sin(t) + 1\ny_exact = np.sin(t) + 1.0\nplt.plot(t, y_exact, \":\", label=r\"exact $y=\\sin t+1$\", lw=2)\nplt.xlabel(\"t\")\nplt.ylabel(\"y\")\nplt.title(r\"Problem 1: $y'=\\cos t$, $y(0)=1$\")\nplt.grid(True, alpha=0.35)\nplt.legend(loc=\"best\")\nplt.annotate(\"IC $y(0)=1$\", xy=(0, 1), xytext=(0.8, 1.7),\n             arrowprops=dict(arrowstyle=\"->\", color=\"C0\"), fontsize=10)\nplt.annotate(\"oscillates about 1\", xy=(4.5, float(np.ravel(p1_y_t)[450])), xytext=(5.0, 2.0),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.3\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    err = np.max(np.abs(p1_y_t[:, 0] - y_exact))\n    print(f\"max |y_odeint - y_exact| = {err:.3e}\")\n","key":"QZg4vFOEWF"},{"type":"outputs","id":"lUik0-lNI_tFZ27G_dihm","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"78259868c882c541d418fc071e9a07da","path":"/build/78259868c882c541d418fc071e9a07da.png"},"text/plain":{"content":"<Figure size 1100x450 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"AvEmzxyg6I"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"max |y_odeint - y_exact| = 2.853e-07\n"},"children":[],"key":"Wqmi31qWan"}],"key":"qiIcAtgF2Y"}],"identifier":"55bf9618-d41e-4574-a662-e556965b973f","html_id":"55bf9618-d41e-4574-a662-e556965b973f","key":"W3seQYa2HC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Problem 2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vd9e7n1icY"}],"identifier":"problem-2","label":"Problem 2","html_id":"problem-2","implicit":true,"key":"OwBAQIGhTr"}],"identifier":"3bd3c9