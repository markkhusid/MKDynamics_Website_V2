, float(np.ravel(p3_y_t)[450])),\n             xytext=(3.0, float(np.max(np.ravel(p3_y_t))) - 0.5),\n             arrowprops=dict(arrowstyle=\"->\", color=\"0.35\"), fontsize=9)\nplt.tight_layout()\nplt.show()\nif debug:\n    print(f\"y range: [{p3_y_t.min():.4f}, {p3_y_t.max():.4f}]\")\n    print(f\"y' range: [{p3_y_prime_t.min():.4f}, {p3_y_prime_t.max():.4f}]\")\n","key":"blrBdqQMCP"},{"type":"outputs","id":"9ZO6XayeBdsRSGPugzEey","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8bab48539cce5e9f82833ac1849100c1","path":"/build/8bab48539cce5e9f82833ac1849100c1.png"},"text/plain":{"content":"<Figure size 1100x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Tf5ZpDJarE"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"y range: [-7.0715, 7.0247]\ny' range: [-7.0610, 7.0711]\n"},"children":[],"key":"Gc9mCInrYe"}],"key":"nl0LlqK3IJ"}],"key":"cbi6yy0Iib"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary comparison of all three solutions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hUNnHVojmB"}],"identifier":"summary-comparison-of-all-three-solutions","label":"Summary comparison of all three solutions","html_id":"summary-comparison-of-all-three-solutions","implicit":true,"key":"K57rEbEpvE"}],"key":"x7Oqlrj6pB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:31.865911Z","iopub.status.busy":"2026-07-25T18:52:31.863392Z","iopub.status.idle":"2026-07-25T18:52:34.579487Z","shell.execute_reply":"2026-07-25T18:52:34.511162Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(3, 1, figsize=(11, 9), sharex=True, constrained_layout=True)\naxes[0].plot(t, p1_y_