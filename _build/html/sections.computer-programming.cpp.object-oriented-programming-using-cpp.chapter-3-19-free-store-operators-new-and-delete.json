       cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"f1j6IHshIJ"}],"key":"Vmy0OwWXQu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z5Jwn0BBlC"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ZIbMiwMHKr"}],"key":"FcOravPAt2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MKl74CbLsv"}],"key":"gZI5hE3VSF"}],"key":"KwuqBuG742"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"rF5hDtc16C"},{"type":"outputs","id":"XLYhqAVNo0O-U0sq9IKPI","children":[],"key":"YR4rDdOAiG"}],"key":"tetgzCoVB7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"tp2kvkmfZ7"},{"type":"outputs","id":"ckv1Q8Z3hYsEvaSD2v8ev","children":[],"key":"aZTnyz6hsI"}],"key":"PcXBhYUmXe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"pCO6Wcgfsl"},{"type":"outputs","id":"jY-Fzfvb30A_hkDDtosJb","children":[],"key":"QRNLxd8V6o"}],"key":"iHqLul6qp0"},{"type":"block","kind":"notebook-code","children":[{"type":"code