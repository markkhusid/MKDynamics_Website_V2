       cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"A4J2zMcuz3"}],"key":"c5NIuGqPkp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A2eGz4wg0Y"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"oZwPO8gmIq"}],"key":"C9VxvZfBqy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MD7aM7Ctql"}],"key":"SmpZDVvXbN"}],"key":"Kw8cqK5i4E"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"IpXl8hFLd6"},{"type":"outputs","id":"I3MDt7ndiylPhUdfO64xa","children":[],"key":"a8kXzkaFWa"}],"key":"sUtSBhsWFj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"I0pQMMVNyz"},{"type":"outputs","id":"0hgjJah5MxzaT7LFFY5ST","children":[],"key":"OI5lkqoN9j"}],"key":"V3OjXxIGpV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"R4V3SHfUqB"},{"type":"outputs","id":"X70tlZCKufN3aZR_i5fR8","children":[],"key":"h2leCjgGED"}],"key":"wfgmGQec8Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code