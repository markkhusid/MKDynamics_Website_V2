  assert(size > 0);\n\n        data = new int[size];\n        assert (data != 0);\n\n        for (int j = 0; j < size; ++j) {\n            cout << \"\\nEnter data at position \" << j << \" -> \";\n            cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"Iw26BwplaF"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"LFgHKMd0AY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YOv1WCIeTp"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"wZXQ036hMr"}],"identifier":"edff7cdd","html_id":"edff7cdd","key":"BSUgStWIpx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Yh5OP20GCx"}],"key":"gIC7euVNzL"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"NJZ8wpvTBK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"OuRdC33jU6"},{"type":"outputs","id":"_cVg2iBN5fix6HDjjNnKf","children":[],"key":"EqKoaKmiZ6"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"SiJgqzGyOw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"va