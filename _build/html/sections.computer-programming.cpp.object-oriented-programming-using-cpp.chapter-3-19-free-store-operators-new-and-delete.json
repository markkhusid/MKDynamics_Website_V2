e":1,"column":1},"end":{"line":1,"column":1}},"key":"ll3xzfA2ZL"}],"identifier":"program-that-demonstrates-the-free-store-operators-new-and-delete-in-c","label":"Program that demonstrates the free store operators new and delete in C++","html_id":"program-that-demonstrates-the-free-store-operators-new-and-delete-in-c","implicit":true,"key":"KIO7UuofrT"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"LGOAQqzimR"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"#include <iostream>\n#include <assert.h>\nusing namespace std;\n\ndouble avg_arr(const int a[], int size)\n{\n    int sum = 0;\n    for (int i = 0; i < size; ++i)\n        sum += a[i];\n    return static_cast<double>(sum) / size;\n}\n\nint main()\n{\n    int *   data;\n    int     size;\n\n    for (int n_loop = 0; n_loop < 1; ++n_loop) {\n        cout << \"\\nEnter array size: \";\n        cin >> size;\n        assert(size > 0);\n\n        data = new int[size];\n        assert (data != 0);\n\n        for (int j = 0; j < size; ++j) {\n            cout << \"\\nEnter data at position \" << j << \" -> \";\n            cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"mHZUkq65NH"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"eAO44VbVAh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LplzZAtAoj"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ZxBkGIJC6W"}],"identifier":"edff7cdd","html_id":"edff7cdd",