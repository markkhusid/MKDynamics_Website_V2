  assert(size > 0);\n\n        data = new int[size];\n        assert (data != 0);\n\n        for (int j = 0; j < size; ++j) {\n            cout << \"\\nEnter data at position \" << j << \" -> \";\n            cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"zIm2a3NyFA"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"mNVDLDeYQv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RyzIQ2Cse7"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"rHKwU6V1l3"}],"identifier":"edff7cdd","html_id":"edff7cdd","key":"mLxZtaRjqF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EltmUpCqiC"}],"key":"zPCDTIrfT0"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"yDwaZvI80H"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ZZSrUl1pBO"},{"type":"outputs","id":"JNmDfWfo8-0yo0UftPABu","children":[],"key":"gN3T890FGW"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"TJigT2Kvjj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"va