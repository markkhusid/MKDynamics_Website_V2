el":"An Example Stack","html_id":"an-example-stack","implicit":true,"key":"JvauIL44Fa"}],"visibility":"show","key":"lxoM6wFDak"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UjkEtBlAMz"}],"key":"xHjgofg5sR"}],"key":"JtlQ8NLDSv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates an example stack data structure in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LNYTmn3hpW"}],"identifier":"program-that-demonstrates-an-example-stack-data-structure-in-c","label":"Program that demonstrates an example stack data structure in C++","html_id":"program-that-demonstrates-an-example-stack-data-structure-in-c","implicit":true,"key":"lNlw57cKKP"}],"key":"opALIguEmR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch1_stac1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hAR7RsMwRX"}],"key":"Coc1t0yzkz"}],"key":"KifNy46srq"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// Test of ch_stack by reversing a string.\n#include \"ch_stac1.h\"\n#include <iostream>\n\nusing namespace std;\n\nint main()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Betty Dolsberry!\"};\n    int i = 0;\n\n    cout << str << endl;\n    reset(&s);\n    while (str[i] && !full(&s))\n        push (&s, str[i++]);\n    while (!empty(&s))\n        cout << pop(&s);\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"r3df4aSZTE"}],"key":"aV8HPjTzmc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MAhZzozy0Y"}],"key":"MxJZslxZpn"}],"key":"gFWewrpGXC"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// A simple implementation of type ch_stack\n\nconst int max_len = 1000;\nenum { EMPTY = -1, FULL = max_len -1 };\n\nstruct ch_stack\n{\n    char s[max_len];\n    int top;\n};\n\n// A standard set of ch_stack operations.\n\nvoid reset(ch_stack * stk)\n{\n    stk -> top = EMPTY;\n}\n\nvoid push(ch_stack * stk, char c)\n{\n    stk -> s[++stk -> top] = c;  \n}\n\nchar pop(ch_stack * stk)\n{\n    return (stk -> s[stk -> top--]);\n}\n\nchar top(ch_stack * stk)\n{\n    return (stk -> s[stk -> top]);\n}\n\nbool empty(const ch_stack * stk)\n{\n    return (stk -> top == EMPTY); \n}\n\nbool full(const ch_stack * stk)\n{\n    return (stk -> top == FULL);\n}","position":{"start":{"line":1,"column":1},"end":{"line":44,"column":1}},"key":"MamuP2Dh6y"}],"key":"wPwGv8T61N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WihqsMuxNe"}],"key":"TGgh276CIY"}],"key":"TXrSsXSqgn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"p6uiwrdHX5"},{"type":"outputs","id":"B8DCAOd_tlIBrC2cwfXr1","children":[],"key":"wmllRayZqX"}],"key":"MSErJ8cjTd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","