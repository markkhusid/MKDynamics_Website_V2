umn":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates an example stack data structure in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zUM2f5VS1Z"}],"identifier":"program-that-demonstrates-an-example-stack-data-structure-in-c","label":"Program that demonstrates an example stack data structure in C++","html_id":"program-that-demonstrates-an-example-stack-data-structure-in-c","implicit":true,"key":"PrhaGjP1QG"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"k8hK7gQmyN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch1_stac1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tVv7ZA41LO"}],"key":"pwDxa5Z41q"}],"identifier":"6f76fa55","html_id":"6f76fa55","key":"niGmnrf7Vw"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Test of ch_stack by reversing a string.\n#include \"ch_stac1.h\"\n#include <iostream>\n\nusing namespace std;\n\nint main()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Betty Dolsberry!\"};\n    int i = 0;\n\n    cout << str << endl;\n    reset(&s);\n    while (str[i] && !full(&s))\n        push (&s, str[i++]);\n    while (!empty(&s))\n        cout << pop(&s);\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"OO0XvFaKZZ"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"ODRdkBaXGA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KNPmB4u6He"}],"key":"sgzNW24IbK"}],"identifier":"cd790b5d","html_id":"cd790b5d","key":"VpzewIloQ0"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// A simple implementation of type ch_stack\n\nconst int max_len = 1000;\nenum { EMPTY = -1, FULL = max_len -1 };\n\nstruct ch_stack\n{\n    char s[max_len];\n    int top;\n};\n\n// A standard set of ch_stack operations.\n\nvoid reset(ch_stack * stk)\n{\n    stk -> top = EMPTY;\n}\n\nvoid push(ch_stack * stk, char c)\n{\n    stk -> s[++stk -> top] = c;  \n}\n\nchar pop(ch_stack * stk)\n{\n    return (stk -> s[stk -> top--]);\n}\n\nchar top(ch_stack * stk)\n{\n    return (stk -> s[stk -> top]);\n}\n\nbool empty(const ch_stack * stk)\n{\n    return (stk -> top == EMPTY); \n}\n\nbool full(const ch_stack * stk)\n{\n    return (stk -> top == FULL);\n}","position":{"start":{"line":1,"column":1},"end":{"line":44,"column":1}},"key":"FwT4zOhKjA"}],"identifier":"f4d910a9","html_id":"f4d910a9","key":"wOU5xNAnP6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h60BDTuZQA"}],"key":"sfDYI2ad6W"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"QhDhBdZtB6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"hSdkApcvdL"},{"type":"outputs","id":"7kSnXdi6aVPLBtsondwvP","children":[],"key":"raUWFcrQ7T"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"Hutq4VVrYj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_3_An_Example_Stack\"","key":"rQ7sJ1tcas"},{"type":"outputs","id":"C24w31o0QAAJU0Y1xYh0O","children":[],"key":"DqeowV1Sc7"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"wA6IyebsOZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"RhDGFTGYpk"},{"type":"outputs","id":"TT4vzLsrwH_rk4J-6792t","children":[],"key":"TjCNTS7Vlk"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"rjtw8bgA8Q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac1.cpp -w -o ch_stac1\")","key":"bYVPZcKTer"},{"type":"outputs","id":"9afY4Vb-ND5pif_xct8SY","children":[],"key":"TjhdNLOSeg"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"jIJnPlQNKl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./ch_stac1\")","key":"V5ctp87NT4"},{"type":"outputs","id":"betQmfT3m4ZeLoQcfPvRo","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"My name is Betty Dolsberry!\n!yrrebsloD ytteB si eman yM\n"},"children":[],"key":"bWgCaANPGa"}],"key":"XKPLLsVvHe"}],"identifier":"e58df301-ac7c-4090-bc7f-87caea2890fa","html_id":"e58df301-ac7c-4090-bc7f-87caea2890fa","key":"bcGcUv9zdT"}],"key":"nyU8czrkwP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chapter 4: Implementing ADTs in the Base Language","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/object-oriented-programming-using-cpp-ch-4","group":"Computer Programming"},"next":{"title":"Bit Fields","url":"/sections/computer-programming/cpp/object-oriented-programming-using-cpp/chapter-4-7-bit-fields","group":"Computer Program