osition":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MfXealGwCB"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"Yg1qddFI78"},{"type":"text","value":" by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zCtzKikC9n"}],"key":"X3ykaoB3IK"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"WUpvCDBkec"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates an example stack data structure in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iYC0wvFP1A"}],"identifier":"program-that-demonstrates-an-example-stack-data-structure-in-c","label":"Program that demonstrates an example stack data structure in C++","html_id":"program-that-demonstrates-an-example-stack-data-structure-in-c","implicit":true,"key":"dBzPASemiW"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"UYW5sM3AxH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch1_stac1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hckSUnhLsE"}],"key":"gIuTEpuMaq"}],"identifier":"6f76fa55","html_id":"6f76fa55","key":"wh7iH9Cavk"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Test of ch_stack by reversing a string.\n#include \"ch_stac1.h\"\n#include <iostream>\n\nusing namespace std;\n\nint main()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Betty Dolsberry!\"};\n    int i = 0;\n\n    cout << str << endl;\n    reset(&s);\n    while (str[i] && !full(&s))\n        push (&s, str[i++]);\n    while (!empty(&s))\n        cout << pop(&s);\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"enUEmzZB9z"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"BmdBZE4tuU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E8XVJLMRuJ"}],"key":"Oi4CDYEs5o"}],"identifier":"cd790b5d","html_id":"cd790b5d","key":"c7uSg7AyBV"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// A simple implementation of type ch_stack\n\nconst int max_len = 1000;\nenum { EMPTY = -1, FULL = max_len -1 };\n\nstruct ch_stack\n{\n    char s[max_len];\n    int top;\n};\n\n// A standard set of ch_stack operations.\n\nvoid reset(ch_stack * stk)\n{\n    stk -> top = EMPTY;\n}\n\nvoid push(ch_stack * stk, char c)\n{\n    stk -> s[++stk -> top] = c;  \n}\n\nchar pop(ch_stack * stk)\n{\n    return (stk -> s[stk -> top--]);\n}\n\nchar top(ch_stack * stk)\n{\n    return (stk -> s[stk -> top]);\n}\n\nbool empty(const ch_stack * stk)\n{\n    return (stk -> top == EMPTY); \n}\n\nbool full(const ch_stack * stk)\n{\n    return (stk -> top == FULL);\n}","position":{"start":{"line":1,"column":1},"end":{"line":44,"column":1}},"key":"PK21vDJYp8"}],"identifier":"f4d910a9","html_id":"f4d910a9","key":"FcOB3w6oJI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xrOFjIbord"}],"key":"bXtLtwN5Yg"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"PqkmPICiBA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"humkVs23l1"},{"type":"outputs","id":"WM-wX6WmyC4yRtBi5awgZ","children":[],"key":"viKvHejx6S"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"WLa8tTG1JI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_3_An_Example_Stack\"","key":"Q67QlImO20"},{"type":"outputs","id":"8L6nj41yjHItf94X2U6Mb","children":[],"key":"QnH3Ka8ooA"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"hYHbtLIq40"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"Cg9v4AwGrA"},{"type":"outputs","id":"ehFem0m-_5B5wIW0HG1AH","children":[],"key":"GGzUYcQAFv"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"rHX9WeTdZD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac1.cpp -w -o ch_stac1\")","key":"H8n0s86j6V"},{"type":"outputs","id":"UMay3HpHaX6_xtisf-Upw","children":[],"key":"MBuN1dTL9Z"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"peGNDCxLTH"},{"type":"block","kind":"notebook-code"