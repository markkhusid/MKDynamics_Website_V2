ue":"An Example Stack","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tyniBnpasM"}],"identifier":"an-example-stack","label":"An Example Stack","html_id":"an-example-stack","implicit":true,"key":"I4lFEJ7JsN"}],"identifier":"4fae3c47-7ba5-411e-929d-45543f813a61","html_id":"4fae3c47-7ba5-411e-929d-45543f813a61","visibility":"show","key":"gtuMEXvQyx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H2YlVNYg3r"}],"key":"VVARJpeyF7"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"cFGk1Qbq8j"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates an example stack data structure in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NprRU6H5ii"}],"identifier":"program-that-demonstrates-an-example-stack-data-structure-in-c","label":"Program that demonstrates an example stack data structure in C++","html_id":"program-that-demonstrates-an-example-stack-data-structure-in-c","implicit":true,"key":"gSNKupAFCS"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"q7cGTpfOXb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch1_stac1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Sd0899xPuy"}],"key":"uFIyLZtjPy"}],"identifier":"6f76fa55","html_id":"6f76fa55","key":"NhL4LGB3yE"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// Test of ch_stack by reversing a string.\n#include \"ch_stac1.h\"\n#include <iostream>\n\nusing namespace std;\n\nint main()\n{\n    ch_stack s;\n    char str[40] = {\"My name is Betty Dolsberry!\"};\n    int i = 0;\n\n    cout << str << endl;\n    reset(&s);\n    while (str[i] && !full(&s))\n        push (&s, str[i++]);\n    while (!empty(&s))\n        cout << pop(&s);\n    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"rB7WedcEKI"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"ulg7YlX7yP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EA83k6rOLQ"}],"key":"v2UX8cVAtU"}],"identifier":"cd790b5d","html_id":"cd790b5d","key":"a3bkTLDtzf"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// A simple implementation of type ch_stack\n\nconst int max_len = 1000;\nenum { EMPTY = -1, FULL = max_len -1 };\n\nstruct ch_stack\n{\n    char s[max_len];\n    int top;\n};\n\n// A standard set of ch_stack operations.\n\nvoid reset(ch_stack * stk)\n{\n    stk -> top = EMPTY;\n}\n\nvoid push(ch_stack * stk, char c)\n{\n    stk -> s[++stk -> top] = c;  \n}\n\nchar pop(ch_stack * stk)\n{\n    return (stk -> s[stk -> top--]);\n}\n\nchar top(ch_stack * stk)\n{\n    return (stk -> s[stk -> top]);\n}\n\nbool empty(const ch_stack * stk)\n{\n    return (stk -> top == EMPTY); \n}\n\nbool full(const ch_stack * stk)\n{\n    return (stk -> top == FULL);\n}","position":{"start":{"line":1,"column":1},"end":{"line":44,"column":1}},"key":"MfiOHlCJyw"}],"identifier":"f4d910a9","html_id":"f4d910a9","key":"wsSQriR8wW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"abpbt3tuAJ"}],"key":"qUFiHMicYV"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"sQNTfseSxf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"YMmGQOAe4U"},{"type":"outputs","id":"Sz0-xFd12f_i_u6WdTWyj","children":[],"key":"ELx3SeHoiB"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"dOZrBa1ERs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_4_3_An_Example_Stack\"","key":"gVRLwH2NBB"},{"type":"outputs","id":"0z2Qfb1WisC6VROZRporC","children":[],"key":"LSMadQMarL"}],"identifier":"9836a2e4-d065-4ba0-928b-66a4e7cce418","html_id":"9836a2e4-d065-4ba0-928b-66a4e7cce418","key":"wWNFVqcVXZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"DovwHdNHpU"},{"type":"outputs","id":"7LnC5qDofBv9AhSsDFAqT","children":[],"key":"VMFJUulTOG"}],"identifier":"af912e98-7de3-40d7-8825-217493f6a66b","html_id":"af912e98-7de3-40d7-8825-217493f6a66b","key":"ZMoWXRz1hH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ ch_stac1.cpp -w -o ch_stac1\")","key":"wh72vQcxkJ"},{"type":"outputs","id":"6IzJjKMSd2Ww3OUAEq5NT","children":[],"key":"Hf9tQCzNCE"}],"identifier":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","html_id":"a734c6b9-cf2b-455b-a921-40f7efc58bd2","key":"HDheSANCJB"},{"type":"block","kind"