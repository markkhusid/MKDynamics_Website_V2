Hx"},{"type":"include","file":"Fortran_Code/Section_Primes/app/prime_test.f90","literal":true,"children":[{"type":"code","value":"program prime_test\n    use :: primes_mod, only : is_prime\n    implicit none\n    integer, parameter :: max_value = 100\n    integer :: n\n\n    do n = 0, max_value\n        if (is_prime(n)) print '(I4)', n\n    end do\nend program prime_test\n","lang":"fortran","filename":"prime_test.f90","key":"y6aKC6Arij"}],"key":"X7dRkAfjud"}],"key":"sEpsl07Xb4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"primes_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ciW55n35XA"},{"type":"text","value":" (module)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e3zG52UuMU"}],"identifier":"primes-mod-f90-module","label":"primes_mod.f90 (module)","html_id":"primes-mod-f90-module","implicit":true,"key":"dxHOB8JEHF"},{"type":"include","file":"Fortran_Code/Section_Primes/src/primes_mod.f90","literal":true,"children":[{"type":"code","value":"module primes_mod\n    implicit none\n\n    private\n    public :: is_prime\n\ncontains\n\n    function is_prime(n) result(prime)\n        implicit none\n        integer, value :: n\n        logical :: prime\n        integer :: i\n\n        if (n > 1) then\n            prime = .true.\n            do i = 2, nint(sqrt(real(n)))\n                if (mod(n, i) == 0) then\n                    prime = .false.\n                    exit\n                end if\n            end do\n        else\n            prime = .false.\n        end if\n    end function is_prime\n\nend module primes_mod\n","lang":"fortran","filename":"primes_mod.f90","key":"xDgQT5aYO5"}],"key":"LUmrVc2bHg"}],"key":"PK9FHdlSgQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{