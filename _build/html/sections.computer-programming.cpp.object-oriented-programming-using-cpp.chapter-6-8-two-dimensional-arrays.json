ented+programming+using+c%2B%2Caps%2C420&sr=8-4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“Object-Oriented Programming Using C++”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TgkIfn915q"}],"urlSource":"https://www.amazon.com/Object-Oriented-Programming-Using-C-2nd/dp/0201895501/ref=sr_1_4?crid=3F67JR9WX9E2K&keywords=object+oriented+programming+using+c%2B%2B&qid=1667165033&qu=eyJxc2MiOiIwLjAwIiwicXNhIjoiMC4wMCIsInFzcCI6IjAuMDAifQ%3D%3D&sprefix=object+oriented+programming+using+c%2B%2Caps%2C420&sr=8-4","key":"H5OIBcB2E5"},{"type":"text","value":" by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xA6ufWX25N"}],"key":"oJU3F7X5ww"}],"identifier":"da8da31b-2a7d-4e52-a914-442ca5a67839","html_id":"da8da31b-2a7d-4e52-a914-442ca5a67839","key":"tnk8tXKGLI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates matrices as an array of linked lists in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pf1q88iLmE"}],"identifier":"program-that-demonstrates-matrices-as-an-array-of-linked-lists-in-c","label":"Program that demonstrates matrices as an array of linked lists in C++","html_id":"program-that-demonstrates-matrices-as-an-array-of-linked-lists-in-c","implicit":true,"key":"L3knOVaAI1"}],"identifier":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","html_id":"6d7f6d49-ca5d-4d20-bf88-0bf99bdba5ea","key":"ALxUhtvgTS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file matrix1.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MXZv56vifG"}],"key":"ytusCNLN5n"}],"identifier":"17067957","html_id":"17067957","key":"Uo2uexucYz"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"/*********************************************************************\n\n  Filename:  matrix1.cpp\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.8    Two Dimensional Arrays\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// Adapted by Mark Khusid\n//A two-dimensional safe array type matrix\n\n#include  <iostream>       // Changed iostream.h to iostream.  MK.\n#include  <assert.h>\n\nusing namespace std;       // Added. MK.\n\n//A two-dimensional safe array type matrix\nclass matrix {\npublic:\n   matrix(int d1, int d2);\n   ~matrix();\n   int  ub1() const { return(s1 - 1); }\n   int  ub2() const { return(s2 - 1); }\n   int&  element(int i, int j);\nprivate:\n   int**  p;\n   int    s1, s2;\n};\n matrix::matrix(int d1, int d2) : s1(d1), s2(d2)\n{\n   cout << \"\\nActivated Constructor...\" << endl;      // Added instrumentation. MK.\n   assert(d1 > 0 && d2 > 0);\n   p = new int*[s1];\n   assert(p != 0);\n   for (int i = 0; i < s1; ++i){\n      p[i] = new int[s2];\n      assert(p[i] != 0);\n   }\n}\nmatrix::~matrix()\n{\n   cout << \"\\nActivated Destructor...\" << endl;       // Added instrumentation. MK.\n   for (int i = 0; i <= ub1(); ++i)\n      delete p[i];\n   delete []p;\n}\n\nint& matrix::element(int i, int j)\n{\n   assert(i >= 0 || i <= ub1() || j >= 0 || j <= ub2());\n   return p[i][j];\n}\n\nint main()\n{\n   matrix a(4, 4), b(4, 6);      // Removed extra variable c (not used). MK.\n   int i, j;\n\n   cout << \"\\nThe matrix a contains: \" << endl; // Added. MK.\n   for (i = 0; i <= a.ub1(); ++i) {\n      cout << \"\\n\";\n      for (j = 0; j <= a.ub2(); ++j) {\n         a.element(i, j) = i + j;\n         cout << a.element(i, j) << \"\\t\";\n      }\n   }\n   \n   cout << \"\\n\" << endl;   // Added. MK.\n\n   cout << \"\\nThe matrix b contains: \" << endl; // Added. MK.\n   for (i = 0; i <= b.ub1(); ++i) {\n      cout << \"\\n\";\n      for (j = 0; j <= b.ub2(); ++j) {\n         b.element(i, j) = i + j;\n         cout << b.element(i, j) << \"\\t\";\n      }\n   }\n\n   cout << \"\\n\" << endl;   // Added. MK.\n\n}","position":{"start":{"line":1,"column":1},"end":{"line":85,"column":1}},"key":"jti9Vsotnn"}],"identifier":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","html_id":"fae9a7ec-75a5-4a60-b10f-3b4693886d0c","key":"P58ngX5s1l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r9e7vpVvCh"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"sOEOzr855c"}],"identifier":"3e111038","html_id":"3e111038","key":"U6J5npzwhX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hO7iyhfhYT"}],"key":"HVEopftFbt"}],"identifier":"e7e2abf0-947f-407d-8084-28bf87186370","html_id":"e7e2abf0-947f-407d-8084-28bf87186370","key":"mRZVVaWFVV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ZBJEnG9gky"},{"type":"outputs","id":"E8re3MUBtaZ0BGusKtjjN","children":[],"key":"KVj2Cogooa"}],"identifier":"f091e74f-fca0-43fa-8114-1c526abb4f95","html_id":"f091e74f-fca0-43fa-8114-1c526abb4f95","key":"AKS21Mzhrq"},{"type":"block","kind":"notebook-code","childr