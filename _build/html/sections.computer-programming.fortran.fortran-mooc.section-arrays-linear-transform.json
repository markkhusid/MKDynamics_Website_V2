m_number(values)\n  print *, \"The contents of the valus array is:\"\n  print *, values\n  print *, \"lin_transform(values, 2.0, 1.0) = \"\n  print *, lin_transform(values, 2.0, 1.0)\n  print *, \"lin_transform(x, a, b) = \"\n  print *, lin_transform(x, a, b)\n\ncontains\n\n  elemental real function lin_transform(x, a, b)\n      implicit none\n      real, intent(in) :: x, a, b\n\n      lin_transform = a*x + b\n  end function lin_transform\n\nend program linear_transform","position":{"start":{"line":1,"column":1},"end":{"line":28,"column":1}},"key":"SnNQKywrS6"}],"key":"fMyoY1FKeq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cWUFCyJ4BP"}],"key":"h0YlUrApwt"}],"key":"iJn02iiGAi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dnGUBUcqU9"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"eNw9NxLRwQ"}],"key":"WPFFrsD8uP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vVdAYIUFsV"},{"type":"outputs","id":"r6Zo4R4m4JMWFD_HkcdVi","children":[],"key":"YICNItEOfy"}],"key":"DThngiV57T"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Array