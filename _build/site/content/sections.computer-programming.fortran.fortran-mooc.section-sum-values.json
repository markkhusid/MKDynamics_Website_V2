um-values-f90","implicit":true,"key":"nKxsRNckWk"},{"type":"include","file":"Fortran_Code/Section_Sum_Values/app/sum_values.f90","literal":true,"children":[{"type":"code","value":"program sum_values\n    use, intrinsic :: iso_fortran_env, only : input_unit\n    implicit none\n    real :: val, total\n    integer :: stat\n\n    total = 0.0\n    do\n        read (unit=input_unit, fmt=*, iostat=stat) val\n        if (stat < 0) exit\n        if (stat > 0) cycle\n        total = total + val\n    end do\n    print *, total\n\nend program sum_values\n","lang":"fortran","filename":"sum_values.f90","key":"a1fD7GIz5g"}],"key":"vVrfgagddQ"}],"key":"MksERFLX8E"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XePzvJ5ZyO"}],"key":"fBZI9H7ldB"}],"key":"QCCDl4w3W3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PJJPZogDu9"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"cYqZJiTfPO"}],"key":"jfy2Shr1fY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"YeFozKBEhB"},{"type":"outputs","id":"4ntAQ50EUrZmgGbeBQp2g","children":[],"key":"tKWOEtEWit"}],"key":"gbfrWUxHJb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"