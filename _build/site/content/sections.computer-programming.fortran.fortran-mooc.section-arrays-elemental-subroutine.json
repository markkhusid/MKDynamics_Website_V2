:)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"iJ1qmHqwTM"}],"key":"PcIIiXrwLD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DYNUqI31Sc"}],"key":"v7sAMqj79x"}],"key":"Z60XdEFbvw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"dIQLivIedq"},{"type":"outputs","id":"W_bkbSy-qIRGIAFOBMeJU","children":[],"key":"E7BQMzEsKp"}],"key":"LxYrRZyAqL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Elemental_Subroutine\"","key":"KWYPCbLcVq"},{"type":"outputs","id":"wT2_r1othBJTBQkItxGfD","children":[],"key":"P4nMNM6vtw"}],"key":"RiroySbjDr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"WzCf20A8Mu"},{"type":"outputs","id":"XIaNW_KL02rH-blxfFP_Z","children":[],"key":"lGoPZp3hBP"}],"key":"aGislZyX7Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"hlxHpBszPb"},{"type":"outpu