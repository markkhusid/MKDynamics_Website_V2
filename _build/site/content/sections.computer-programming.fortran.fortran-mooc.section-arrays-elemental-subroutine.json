:)\n    end do\n\n    print '(A)', 'B'\n    do i = 1, 3\n        print '(*(F7.2))', B(i, :)\n    end do\n\n    print '(A)', 'C'\n    do i = 1, 3\n        print '(*(F7.2))', C(i, :)\n    end do\n\ncontains\n\n    elemental subroutine compute(A, B, C)\n        implicit none\n        real, intent(in) :: A\n        real, intent(out) :: B\n        real, intent(out) :: C\n\n        B = 2*A\n        C = 3*A\n    end subroutine compute\n\nend program elemental_subroutine","position":{"start":{"line":1,"column":1},"end":{"line":37,"column":1}},"key":"CANBCtJaVJ"}],"key":"QoXyypC6FS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l2VkiTYvZL"}],"key":"JjVU3EZplZ"}],"key":"HkZmJQij80"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ClzLEbR5Yo"},{"type":"outputs","id":"ZH07w25PA1YmEATeC5NwE","children":[],"key":"cfZP1jtAFN"}],"key":"pkPv4v4krF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Elemental_Subroutine\"","key":"Nqt8whI6Eh"},{"type":"outputs","id":"ILziBCKFoEXqUweIvjR_P","children":[],"key":"DaewW2Osyh"}],"key":"T1nM1Jxtx8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"EVNjnGlBgZ"},{"type":"outputs","id":"9ZMT244Hv5ABVwFxFdSOu","children":[],"key":"qDunB90SGe"}],"key":"fuBJMqlKz1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"D5OVZFkWGJ"},{"type":"outpu