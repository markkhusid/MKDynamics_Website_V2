976773\n  N =       100:  zeta~ = 1.63498390\n  N =     1,000:  zeta~ = 1.64393457\n  N =    10,000:  zeta~ = 1.64483407\n  N =   100,000:  zeta~ = 1.64492407\n"},"children":[],"key":"zBFNVAreCx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  N = 1,000,000:  zeta~ = 1.64493307\n"},"children":[],"key":"tJGrb1ompM"}],"key":"ZHuU5av9ad"}],"key":"FFeaGh5kyw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional plot — convergence for ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NjQqaMPTbx"},{"type":"inlineMath","value":"s=2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">s=2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2</span></span></span></span>","key":"ylLdvacAoj"}],"identifier":"optional-plot-convergence-for-s-2","label":"Optional plot — convergence for s=2","html_id":"optional-plot-convergence-for-s-2","implicit":true,"key":"V5hmJVt2K1"}],"key":"HYQviFTrT6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:31:01.147385Z","iopub.status.busy":"2026-07-25T16:31:01.146624Z","iopub.status.idle":"2026-07-25T16:31:02.927290Z","shell.execute_reply":"2026-07-25T16:31:02.925194Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nNs = np.unique(np.logspace(1, 6, 40).astype(int))\npartial = []\nacc = 0.0\nn = 1\nfor N in Ns:\n    while n <= N:\n        acc += 1.0 / (n ** 2)\n        n += 1\n    partial.append(acc)\n\nexact = math.pi ** 2 / 6\nplt.figure(figsize=(8, 4))\nplt.semilogx(Ns, partial, 'b.-', label='Partial sum')\nplt.axhline(exact, color='r', linestyle='--', label=r'$\\pi^2/6$')\nplt.xlabel('Number of terms N')\nplt.ylabel(r'Partial sum $\\hat{\\zeta}(2)$')\nplt.title('Riemann zeta(2) partial-sum convergence')\nplt.legend()\nplt.grid(True, which='both', alpha=0.3)\nplt.tight_layout()\nplt.show()\n","key":"Zbj1Vs6q1z"},{"type":"outputs","id":"qReikswsKJqHFFB_8VL_J","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d621d528b0d5ecc722e3d2b57e948fdd","path":"/d621d528b0d5ecc722e3d2b57e948fdd.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"tw55OHGVzm"}],"key":"SHPHMphXS5"}],"key":"i2ovQyNZqj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Takeaways","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uuwiWImaV3"}],"identifier":"takeaways","label":"Takeaways","html_id":"takeaways","implicit":true,"key":"ByOKG09NEj"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Truncated zeta sums are a simple way to meet floating-point / looping objectives in early Python courses.","position":{"start":{"line":3,"column"