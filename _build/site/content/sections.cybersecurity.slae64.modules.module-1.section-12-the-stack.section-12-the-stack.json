{"version":3,"kind":"Article","sha256":"71239c29fa4f6629939cc3374119d07dbece8ff122e0b3afa75edbd6142d8e31","slug":"sections.cybersecurity.slae64.modules.module-1.section-12-the-stack.section-12-the-stack","location":"/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","dependencies":[],"frontmatter":{"title":"Section 12 - The Stack","authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","thumbnail":"/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","exports":[{"format":"md","filename":"section_12_the_stack.md","url":"/section_12_the_stack-f46feca81fb040f93a5060d9c441c2fb.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Built with Grok Build","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YTNMlDR7T8"}],"key":"aJttDMkvF1"}],"key":"VJizN7yKWp"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"egQ60w9cz7"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"rEcYeXSusF"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"In this section we will be following along with and completing course material from the Pentester Academy’s SecurityTube Linux Assembly language Expert 64 Bit course. As the title suggests, this assignment deals with the stack. The stack is a Last In First Out (LIFO) data structure. It is used extensively in high level programming languages, such as C.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"FsQ3jivh6H"}],"key":"tC6YDrnviz"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The stack is manipulated with the Push and Pop operations. The pointer to the top of the stack in 64 bit Intel based machines is called RSP. The stack grows from high memory to low memory.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Bdx9NsDe8s"}],"key":"EeUDHPougD"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We will write an assembly program that manipulates the stack in 64 bit Intel assembly instructions. This program will be coded, assembled, linked and run. Execution is then to be monitored via GDB. We will use the GEF add-on for GDB to enhance the visual presentation from GDB. We will also use Radare2 to run through the program execution to gain another perspective.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"hUUToZBsAY"}],"key":"NIF5t4vgWb"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Project code is contained in my ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"JZQh5eC4I9"},{"type":"link","url":"https://github.com/markkhusid/SLAE64","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"GitHub repository","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"WooPRdy6zR"}],"urlSource":"https://github.com/markkhusid/SLAE64","error":true,"key":"RiXl0J340Z"},{"type":"text","value":".","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"g55Gr8O4Zk"}],"key":"vt8oPovLtD"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"m4aJvpnVDS"}],"identifier":"the-program-stack-nasm","label":"The program stack.nasm","html_id":"the-program-stack-nasm","implicit":true,"key":"gab04Wa83u"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The screenshot below displays the contents of the program stack.nasm.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"g1MRaOUvdp"}],"key":"FcvMOv9DOq"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","alt":"stack nasm","align":"center","key":"hnwD1Wrs6f","urlSource":"images/stack_nasm.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","html_id":"slae-s12-stack-nasm-1","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"L0GICO4KAV"},{"type":"text","value":"1","key":"CDgJlKTmHj"},{"type":"text","value":":","key":"leIdsESPky"}],"template":"Figure %s:","key":"T93cB5lNsD"},{"type":"text","value":"stack nasm","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"DrSI5Aqd3X"}],"key":"q65IyITrUe"}],"key":"SHizunVChM"}],"label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","enumerator":"1","html_id":"slae-s12-stack-nasm-1","key":"RZM4oyuFCt"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"qQtmctu8jP"}],"key":"dmCVBhvGFt"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"The program pushes an immediate onto the stack. The immediate is: 0x1122334455667788. It does this by first moving the immediate into RAX and then pushing RAX.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"SdRjFY99z9"}],"key":"J9HPtyA0re"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Next it pushes data labled by sample. As shown in the program, this data is:","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"jgaRCy3JvT"}],"key":"utK3MCnwB1"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"sample:\tdb 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0x11, 0x22","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"D1uCmBYIsO"}],"key":"U6LvdYNEiU"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"First sample is pushed. What this does it push the memory address of sample onto the stack. Then the contents of the memory address labled as sample is pushed onto the stack, as denoted by the brackets (i.e. []) around the label.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"nAqOFePNdO"}],"key":"JwDWACxsxy"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Then the contents of the stack is popped off into R15, R14 and RBX. The first item pushed onto the stack is the last item to come out. Therefore, RBX will contain the contents of RAX.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"GxI2cmadzr"}],"key":"PCuooe4YLt"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Finally, the familiar exit syscall is executed to gracefully exit back to the shell.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"PEYKdhN9iw"}],"key":"r8LfYQxcke"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"The program is assembled with:","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Q7AiunTJCa"}],"key":"iutGiAeqLp"},{"type":"code","lang":"bash","value":"$ nasm -felf64 stack.nasm -o stack.o","position":{"start":{"line":45,"column":1},"end":{"line":47,"column":1}},"key":"l6N8fP5mDa"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"And linked with:","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"ZEjcp88Ssq"}],"key":"GTeOQ2Kiji"},{"type":"code","lang":"bash","value":"$ ld stack.o -o stack","position":{"start":{"line":51,"column":1},"end":{"line":53,"column":1}},"key":"egEVU2j4rY"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"We then run the executable and look at it’s objdump. The results of these operations is shown below:","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"kkNhSojqWL"}],"key":"hfSutMRKqW"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/assembling_linking_a-038456ac183485f6672791c608a20833.j