{"version":3,"kind":"Article","sha256":"20c00f68c8e812d38dc2e141adf03e5e3e874d6c8d045ccd4afd93453d40d113","slug":"sections.cybersecurity.slae64.modules.module-1.section-12-the-stack.section-12-the-stack","location":"/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","dependencies":[],"frontmatter":{"title":"Section 12 - The Stack","authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":3}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Cybersecurity/SLAE64/Modules/Module_1/Section_12_The_Stack/section_12_the_stack.md","thumbnail":"/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","exports":[{"format":"md","filename":"section_12_the_stack.md","url":"/section_12_the_stack-467a628dcf5ed00e419687d8a704ef22.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Built with Grok Build","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YQScreeC0T"}],"key":"GPU3InXw2Q"}],"key":"oZdSlIwED2"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Wl0LzBTsx5"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"W8PVRODKEw"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"In this section we will be following along with and completing course material from the Pentester Academy’s SecurityTube Linux Assembly language Expert 64 Bit course. As the title suggests, this assignment deals with the stack. The stack is a Last In First Out (LIFO) data structure. It is used extensively in high level programming languages, such as C.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Ry8byLgGyz"}],"key":"Kdf54VvYnA"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The stack is manipulated with the Push and Pop operations. The pointer to the top of the stack in 64 bit Intel based machines is called RSP. The stack grows from high memory to low memory.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"FDHlgHc0Pn"}],"key":"BIy9UiRx4q"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"We will write an assembly program that manipulates the stack in 64 bit Intel assembly instructions. This program will be coded, assembled, linked and run. Execution is then to be monitored via GDB. We will use the GEF add-on for GDB to enhance the visual presentation from GDB. We will also use Radare2 to run through the program execution to gain another perspective.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"gvwTqWAH1b"}],"key":"iPap2oSEok"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Project code is contained in my ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"rEawyi0PVr"},{"type":"link","url":"https://github.com/markkhusid/SLAE64","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"GitHub repository","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Srqw40EtFs"}],"urlSource":"https://github.com/markkhusid/SLAE64","error":true,"key":"zXIJcFgJNi"},{"type":"text","value":".","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"dhajD5E4ws"}],"key":"VCtZvH5i2v"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"iHveKMkuvh"}],"identifier":"the-program-stack-nasm","label":"The program stack.nasm","html_id":"the-program-stack-nasm","implicit":true,"key":"r42vcVx02Q"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The screenshot below displays the contents of the program stack.nasm.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"WBHErgt9x1"}],"key":"zJx8QQClTc"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","alt":"stack nasm","align":"center","key":"vz3jEeUXqh","urlSource":"images/stack_nasm.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","html_id":"slae-s12-stack-nasm-1","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"cj27azHlgv"},{"type":"text","value":"1","key":"EWTepKwrdZ"},{"type":"text","value":":","key":"gzq9lrUNGU"}],"template":"Figure %s:","key":"IkBTaAvOfx"},{"type":"text","value":"stack nasm","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"IByH9LGpYY"}],"key":"xA5A7iV6cC"}],"key":"h4pdR3KWSY"}],"class":"clickable-figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","enumerator":"1","html_id":"slae-s12-stack-nasm-1","key":"EhWqCq9rTR"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"JnYkvRX4gC"}],"key":"FL7U96vrCU"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The program pushes an immediate onto the stack. The immediate is: 0x1122334455667788. It does this by first moving the immediate into RAX and then pushing RAX.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"RNJiqi5Qnm"}],"key":"pLYkkgdvUI"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Next it pushes data labled by sample. As shown in the program, this data is:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"bt2ialdmv8"}],"key":"affDoxSBNA"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"sample:\tdb 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0x11, 0x22","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"Ospy9YcEkz"}],"key":"tCD6M4egHD"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"First sample is pushed. What this does it push the memory address of sample onto the stack. Then the contents of the memory address labled as sample is pushed onto the stack, as denoted by the brackets (i.e. []) around the label.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"nHjIe1RGPv"}],"key":"HpvCtVDyRT"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Then the contents of the stack is popped off into R15, R14 and RBX. The first item pushed onto the stack is the last item to come out. Therefore, RBX will contain the contents of RAX.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"oHnf8uVSc4"}],"key":"EdpzT5UTQC"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Finally, the familiar exit syscall is executed to gracefully exit back to the shell.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Ah9nhp6T5r"}],"key":"XwojbdnlI4"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The program is assembled with:","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"wDccAf2Kgz"}],"key":"U5QYzB5htX"},{"type":"code","lang":"bash","value":"$ nasm -felf64 stack.nasm -o stack.o","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"A6viywCIfs"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"And linked with:","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"RqWK4EXDI8"}],"key":"FbX3zmrM5m"},{"type":"code","lang":"bash","value":"$ ld stack.o -o stack","position":{"start":{"line":52,"column":1},"end":{"line":54,"column":1}},"key":"BGol7yDDN1"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"We then run the executable and look at it’s objdump. The results of these operations is shown below:","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"VQBIAa0c06"}],"key":"n9JtVMwDoj"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/assembling_linking_a-038456a