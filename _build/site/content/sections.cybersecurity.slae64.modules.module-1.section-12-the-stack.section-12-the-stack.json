implicit":true,"key":"bNgRE6mT1N"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"In this section we will be following along with and completing course material from the Pentester Academy’s SecurityTube Linux Assembly language Expert 64 Bit course. As the title suggests, this assignment deals with the stack. The stack is a Last In First Out (LIFO) data structure. It is used extensively in high level programming languages, such as C.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"mm9qvmMecS"}],"key":"XSqPq7Nrpf"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The stack is manipulated with the Push and Pop operations. The pointer to the top of the stack in 64 bit Intel based machines is called RSP. The stack grows from high memory to low memory.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"paguobZiP6"}],"key":"FHVlLSZxvB"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"We will write an assembly program that manipulates the stack in 64 bit Intel assembly instructions. This program will be coded, assembled, linked and run. Execution is then to be monitored via GDB. We will use the GEF add-on for GDB to enhance the visual presentation from GDB. We will also use Radare2 to run through the program execution to gain another perspective.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Hh9QIp717t"}],"key":"Wwg4hwaBMt"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Project code is contained in my ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ZlT93a0DTn"},{"type":"link","url":"https://github.com/markkhusid/SLAE64","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"GitHub repository","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"LRwVD1OwDn"}],"urlSource":"https://github.com/markkhusid/SLAE64","error":true,"key":"uYsDJu6UGL"},{"type":"text","value":".","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"NZCZSmHZM3"}],"key":"d5tIxlUEnf"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"dDwpvl279Q"}],"identifier":"the-program-stack-nasm","label":"The program stack.nasm","html_id":"the-program-stack-nasm","implicit":true,"key":"rKOeMwAZ7T"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The screenshot below displays the contents of the program stack.nasm.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"hchII3ZEDA"}],"key":"klOH8EhLyY"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/stack_nasm-77b411a0e80be1840c046db2abcbd5aa.jpg","alt":"stack nasm","align":"center","key":"P3a0bIuN1Z","urlSource":"images/stack_nasm.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","html_id":"slae-s12-stack-nasm-1","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"DcDWJLOVt3"},{"type":"text","value":"1","key":"rY7LlZjzCL"},{"type":"text","value":":","key":"dY98vYiqhg"}],"template":"Figure %s:","key":"ynwNzz3JI5"},{"type":"text","value":"stack nasm","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"G9nDKESauM"}],"key":"KJK5F