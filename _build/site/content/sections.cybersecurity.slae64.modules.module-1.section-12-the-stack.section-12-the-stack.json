},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Then the contents of the stack is popped off into R15, R14 and RBX. The first item pushed onto the stack is the last item to come out. Therefore, RBX will contain the contents of RAX.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Pbmamw33GV"}],"key":"kl2i2NSFCD"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Finally, the familiar exit syscall is executed to gracefully exit back to the shell.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"AiPvEPsSRo"}],"key":"kHTwiMDrzH"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The program is assembled with:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"FrDmjigr4S"}],"key":"VBa0opmXXk"},{"type":"code","lang":"bash","value":"$ nasm -felf64 stack.nasm -o stack.o","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"key":"aAGnaUcf6M"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"And linked with:","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"OLG5KrLSOf"}],"key":"i8EGNkzoPn"},{"type":"code","lang":"bash","value":"$ ld stack.o -o stack","position":{"start":{"line":49,"column":1},"end":{"line":51,"column":1}},"key":"PnmT9yl7Ys"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"We then run the executable and look at it’s objdump. The results of these operations is shown below:","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"SDDc1Wp1E6"}],"key":"wJTzo0ThIa"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/assembling_linking_a-038456a