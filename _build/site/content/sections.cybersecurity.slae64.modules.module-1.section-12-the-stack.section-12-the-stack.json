}],"class":"clickable-figure","label":"slae-s12-stack-nasm-1","identifier":"slae-s12-stack-nasm-1","enumerator":"1","html_id":"slae-s12-stack-nasm-1","key":"XBMQ3bD1No"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The program stack.nasm","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"QNbLg2hcF3"}],"key":"tumOeqe1Dh"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The program pushes an immediate onto the stack. The immediate is: 0x1122334455667788. It does this by first moving the immediate into RAX and then pushing RAX.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"JHaSy7PUQ5"}],"key":"TqYMM1gnGT"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Next it pushes data labled by sample. As shown in the program, this data is:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"qKhpFKEMuZ"}],"key":"THfnD4f2lg"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"sample:\tdb 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0x11, 0x22","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"UD3aeRSThd"}],"key":"JRbLbRWhV0"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"First sample is pushed. What this does it push the memory address of sample onto the stack. Then the contents of the memory address labled as sample is pushed onto the stack, as denoted by the brackets (i.e. []) around the label.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"OxmeTIMkXM"}],"key":"AJZDZ3yDT0"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Then the contents of the stack is popped off into R15, R14 and RBX. The first item pushed onto the stack is the last item to come out. Therefore, RBX will contain the contents of RAX.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"RgJSAbqMbv"}],"key":"CoLAlDKVUC"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Finally, the familiar exit syscall is executed to gracefully exit back to the shell.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"HMFbbLoiZR"}],"key":"hltOrRg53a"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The program is assembled with:","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"rL1HOoCUmM"}],"key":"wCPaMqkXCj"},{"type":"code","lang":"bash","value":"$ nasm -felf64 stack.nasm -o stack.o","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"EbvsPH6kvn"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"And linked with:","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"q4j7Yzy39t"}],"key":"KaghQpEvum"},{"type":"code","lang":"bash","value":"$ ld stack.o -o stack","position":{"start":{"line":52,"column":1},"end":{"line":54,"column":1}},"key":"u9HtPQuGaG"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"We then run the executable and look at it’s objdump. The results of these operations is shown below:","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"TpCfKWpRAm"}],"key":"HnVNVjmTMe"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/assembling_linking_a-038456a