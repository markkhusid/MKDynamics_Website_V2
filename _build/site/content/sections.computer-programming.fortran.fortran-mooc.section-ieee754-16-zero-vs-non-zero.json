) = ', sqrt(zero)\n    print '(A, F5.1)', 'sqrt(-0.0) = ', sqrt(minus_zero)\nend program zero_vs_minus_zero","position":{"start":{"line":1,"column":1},"end":{"line":18,"column":1}},"key":"w74RJZkEwl"}],"key":"VupnopC8HV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MuqAMmHn6T"}],"key":"kvw6nIia4J"}],"key":"eMmTdRoNnv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"s2Dgp5dlb3"},{"type":"outputs","id":"fblif9CFHs8h8TM5K2VuW","children":[],"key":"aLSJEHzaXZ"}],"key":"Ys7lcCzLKA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_IEEE754_Zero_vs_Non_Zero\"","key":"g12AtKZtp9"},{"type":"outputs","id":"bCB5CKqfShBgde9nN1DxK","children":[],"key":"e3OSJrrta6"}],"key":"dwW4XzVN0P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"dXiSJJtbAE"},{"type":"outputs","id":"5LvLvncFtqhWK6ruKPhac","children":[],"key":"qlK3Avdwal"}],"key":"al03lFHw6p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"y2fn4BiBp1"},{"type":"outputs","id":"1HptditmsHDfFBYsLKu5C","children":[],"key":"kRuIfCOivy"}],"key":"DgaLwBo9ca"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"fpm run output is piped into sed to suppress the status of the run command and only print the 