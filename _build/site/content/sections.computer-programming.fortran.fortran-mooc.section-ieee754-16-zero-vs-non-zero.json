 -0'\n    end if\n    print '(A, F5.1)', 'sqrt(0.0) = ', sqrt(zero)\n    print '(A, F5.1)', 'sqrt(-0.0) = ', sqrt(minus_zero)\nend program zero_vs_minus_zero","position":{"start":{"line":1,"column":1},"end":{"line":18,"column":1}},"key":"lPIr3xWqmP"}],"key":"LCbh8g7PFq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"t7mDsjArBl"}],"key":"M0pOsISGJk"}],"key":"unvAaFmZGx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"uHHmQnJ7oC"},{"type":"outputs","id":"DBkfdt0ODv1FtRHUnUYzG","children":[],"key":"x8Gx3fOUSn"}],"key":"zbl2WhBs6R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_IEEE754_Zero_vs_Non_Zero\"","key":"OlppTYm7Li"},{"type":"outputs","id":"QP_g0v9h8W-PVh9IBEm2A","children":[],"key":"CAYwwNtZbX"}],"key":"ShgfPaPzrt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"nZm2UG45rJ"},{"type":"outputs","id":"amtZN4lrL8KYBLJgpwU0K","children":[],"key":"WW738xZmFj"}],"key":"aCq1CUxBIa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"piyIHPB6rT"},{"type":"outputs","id":"UCtiD6blE-wIQRumr3SpI","children":[],"key":"tfHI96vLD8"}],"key":"QXiMQWxB2k"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"fpm run output is piped into sed to suppress