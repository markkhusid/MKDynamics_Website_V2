 -0'\n    end if\n    print '(A, F5.1)', 'sqrt(0.0) = ', sqrt(zero)\n    print '(A, F5.1)', 'sqrt(-0.0) = ', sqrt(minus_zero)\nend program zero_vs_minus_zero","position":{"start":{"line":1,"column":1},"end":{"line":18,"column":1}},"key":"LRNKIW4flP"}],"key":"In8CMtU5W5"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FJHlHZysvq"}],"key":"cOkBH0aqF6"}],"key":"qsc3jYsUF4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"QLYzgfOZNj"},{"type":"outputs","id":"GftN6npqIvcqpdCEMSqxU","children":[],"key":"gSrZNZfWyw"}],"key":"VkmoBLf5Z5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_IEEE754_Zero_vs_Non_Zero\"","key":"SFGnDgXndB"},{"type":"outputs","id":"pQwXQwYbAxfhARLE2mvDS","children":[],"key":"BACwOWcHoB"}],"key":"QRSRWk9wDl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"eZo1qUdzAk"},{"type":"outputs","id":"mlJmPswQspVRpTNgEfeDk","children":[],"key":"V5sKQ9eRrY"}],"key":"c2Y5qcHQVB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"qMM13s3Pvo"},{"type":"outputs","id":"BSChY83-4kA6qAh_TxW7Z","children":[],"key":"jorZWS0g71"}],"key":"F34BvK4bDh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"fpm run output is piped into sed to suppress