children":[],"key":"Tl0G6rh6uu"}],"key":"JBIFKCDwe9"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.408792Z","iopub.status.busy":"2026-07-25T16:00:56.408403Z","iopub.status.idle":"2026-07-25T16:00:56.431682Z","shell.execute_reply":"2026-07-25T16:00:56.413046Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_train_std[0:1])\n","key":"PSiEFax2hS"},{"type":"outputs","id":"UrnPcNGU77MuCkHaODemE","children":[],"key":"zjXSgnCWEM"}],"key":"SIBdFAtolc"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.436459Z","iopub.status.busy":"2026-07-25T16:00:56.435767Z","iopub.status.idle":"2026-07-25T16:00:56.441166Z","shell.execute_reply":"2026-07-25T16:00:56.439969Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(X_test_std[0:1])\n","key":"k7ImnGpF3r"},{"type":"outputs","id":"P34D1HjHwiiHZI5fQiz_P","children":[],"key":"ff6FMsjeGc"}],"key":"WDQkOJB2s1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform PCA on Variable Number of Components","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o82Rs7HfBO"}],"identifier":"perform-pca-on-variable-number-of-components","label":"Perform PCA on Variable Number of Components","html_id":"perform-pca-on-variable-number-of-components","implicit":true,"key":"kd2eVJBsPZ"}],"key":"wAZ15ZFcjf"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.447049Z","iopub.status.busy":"2026-07-25T16:00:56.446641Z","iopub.status.idle":"2026-07-25T16:00:56.773693Z","shell.execute_reply":"2026-07-25T16:00:56.772122Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.decomposition import PCA\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.metrics import accuracy_score\n\ndef run_one_pca_model(ncomp, seed):\n\n    pca = PCA(n_components=ncomp)\n\n    X_train_pca = pca.fit_transform(X_train_std)\n    X_test_pca = pca.transform(X_test_std)\n\n    model = MLPClassifier(\n        hidden_layer_sizes=(100,),\n        activation='logistic',\n        max_iter=20000,\n        alpha=1e-5,\n        solver='adam',\n        random_state=seed\n    )\n\n    model.fit(X_train_pca, y_train)\n\n    predictions = model.predict(X_test_pca)\n    acc = accuracy_score(y_test, predictions)\n\n    return ncomp, acc, predictions\n","key":"d8ZduekYZl"},{"type":"outputs","id":"jxFWlvB5LFUe-8j8twecY","children":[],"key":"PQft8OeLnU"}],"key":"lhX1jvs0Se"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Function to Parallelize","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zfMcWpF2RO"}],"identifier":"create-function-to-parallelize","label":"Create Function to Parallelize","html_id":"create-function-to-parallelize","implicit":true,"key":"uqnlO6B60l"}],"key":"euF62k571h"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.777217Z","iopub.status.busy":"2026-07-25T16:00:56.776895Z","iopub.status.idle":"2026-07-25T16:00:56.782450Z","shell.execute_reply":"2026-07-25T16:00:56.780774Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from joblib import Parallel, delayed\n\ndef run_seed(seed):\n\n    results = Parallel(n_jobs=8, verbose=0)(\n        delayed(run_one_pca_model)(ncomp, seed)\n        for ncomp in range(1, 61)\n    )\n\n    return seed, results\n","key":"P9WXDnU250"},{"type":"outputs","id":"SAwQd_JkiIlON0FjfYkGk","children":[],"key":"Dw5I8BMSET"}],"key":"w44WA0Bbms"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.784832Z","iopub.status.busy":"2026-07-25T16:00:56.784615Z","iopub.status.idle":"2026-07-25T16:00:56.789641Z","shell.execute_reply":"2026-07-25T16:00:56.788242Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"#accuracies = []\n#best_accuracy = 0\n#best_components = 0\n#best_predictions = None\n\n#for ncomp, acc, predictions in results:\n#    accuracies.append(acc)\n\n#    if debug:\n#        print(f\"Components={ncomp:2d} Accuracy={acc:.4f}\")\n\n#    if acc > best_accuracy:\n#        best_accuracy = acc\n#        best_components = ncomp\n#        best_predictions = predictions\n\n#print(\"\\nBest Result\")\n#print(f\"Best Components = {best_components}\")\n#print(f\"Best Accuracy   = {best_accuracy:.4f}\")\n","key":"TwwIs1SfjG"},{"type":"outputs","id":"kBsghEz6EcdRdy9hkDKvk","children":[],"key":"DUpO2Rgd3k"}],"key":"GSS3FbQXA3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:00:56.791623Z","iopub.status.busy":"2026-07-25T16:00:56.791438Z","iopub.status.idle":"2026-07-25T16:01:39.677953Z","shell.execute_reply":"2026-07-25T16:01:39.674562Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# List of random seeds to test.\n# Using a variety of small + larger seeds helps check stability across different data splits.\nseeds = [0, 1, 2, 3, 4, 5, 10]\n\n# Container to store the final summary for every seed\nall_results = []\n\nprint('****** Initiating Paraellel Computation (8 cores) ******')\nprint()\n\n# === Main loop over seeds ===\nfor seed in seeds:\n\n    # Call the function that runs all n_components for this particular seed.\n    seed, results = run_seed(seed)\n\n    # Initialize variables to track the best configuration for this seed\n    best_ncomp = None\n    best_acc = 0\n    best_predictions = None\n\n    # Iterate through all (n_components, accuracy) pairs returned for this seed\n    for ncomp, acc, predictions in results:\n\n        # Keep track of the highest accuracy and its corresponding number of components\n        if acc > best_acc:\n            best_acc = acc\n            best_ncomp = ncomp\n            best_predictions = predictions\n\n    # Store a structured record for this seed\n    all_results.append(\n        {\n            \"seed\": seed,\n            \"best_ncomp\": best_ncomp,\n            \"best_acc\": best_acc,\n            \"best_predictions\": best_predictions,\n            \"results\": results # full list of all (ncomp, acc) pairs\n        }\n    )\n\n    # Print a nice one-line summary for this seed\n    print(\n        f\"Seed = {seed:3d},  \"\n        f\"Best Components = {best_ncomp:2d}, \"\n        f\"Accuracy = {best_acc:.4f}\"\n    )\n\nprint()\nprint('***** Parallel Computations Complete ******')\n","key":"pdN9uI3MzM"},{"type":"outputs","id":"9rl52BSdArF_6yVPqaVBC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"****** Initiating Paraellel Computation (8 cores) ******\n\n"},"children":[],"key":"swQOv5CVSx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   0,  Best Components = 13, Accuracy = 0.9206\n"},"children":[],"key":"viYGweK48l"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   1,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"iODEH0mhkd"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   2,  Best Components = 16, Accuracy = 0.9365\n"},"children":[],"key":"d86yEpc3kM"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   3,  Best Components = 16, Accuracy = 0.9206\n"},"children":[],"key":"dn1OlckU4B"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Seed =   4,  Best Components = 17, Accuracy = 0.9365\n"},"children":[],"key":"daPm1pcKL3"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream"