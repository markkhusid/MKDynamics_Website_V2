range(0, 61, 5))\nplt.grid(True)\n\n# Optional\nplt.axhline(\n    y=best_acc,\n    color='red',\n    linestyle='--',\n    alpha=0.5\n)\n\nplt.show()\n\nprint(\n    f\"Best seed: {best_seed_result['seed']}\"\n)\nprint(\n    f\"Best accuracy: {best_acc:.4f} \"\n    f\"using {best_ncomp} PCA components\"\n)\n","key":"hY9o1C0T2O"},{"type":"outputs","id":"CsqxIq65OO63M3mtxSAFd","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9e41737c096e02aeb19779b9e43114dd","path":"/9e41737c096e02aeb19779b9e43114dd.png"},"text/plain":{"content":"<Figure size 1200x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"QaYxPldK4t"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Best seed: 1\nBest accuracy: 0.9365 using 16 PCA components\n"},"children":[],"key":"hJzgUdIn9b"}],"key":"F9wD5CXJpd"}],"key":"KK61qZDkqB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Confusion Matrix","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cda4leheiE"}],"identifier":"create-confusion-matrix","label":"Create Confusion Matrix","html_id":"create-confusion-matrix","implicit":true,"key":"fZ2OA2FSqP"}],"key":"zI1GVKcON2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.861813Z","iopub.status.busy":"2026-07-25T16:01:39.861582Z","iopub.status.idle":"2026-07-25T16:01:39.870433Z","shell.execute_reply":"2026-07-25T16:01:39.868939Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"best_predictions = best_seed_result[\"best_predictions\"]\n","key":"o2bF9kcr8D"},{"type":"outputs","id":"XvwTFYYSHsf9C_WwsWeUQ","children":[],"key":"kgfVwVLkne"}],"key":"Ks8sKfSu8j"},{"type":"block","kind":"notebook-code","data":{"execution":{"