range(0, 61, 5))\nplt.grid(True)\n\n# Optional\nplt.axhline(\n    y=best_acc,\n    color='red',\n    linestyle='--',\n    alpha=0.5\n)\n\nplt.show()\n\nprint(\n    f\"Best seed: {best_seed_result['seed']}\"\n)\nprint(\n    f\"Best accuracy: {best_acc:.4f} \"\n    f\"using {best_ncomp} PCA components\"\n)\n","key":"OPIlCZf0Sq"},{"type":"outputs","id":"C1gioPg127cWdas_NiXZh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9e41737c096e02aeb19779b9e43114dd","path":"/9e41737c096e02aeb19779b9e43114dd.png"},"text/plain":{"content":"<Figure size 1200x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"eLDbAfNtl1"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Best seed: 1\nBest accuracy: 0.9365 using 16 PCA components\n"},"children":[],"key":"nG4hVeroVt"}],"key":"G0wIElL9l2"}],"key":"of9oYhPNVN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Confusion Matrix","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zlS1qlQcVE"}],"identifier":"create-confusion-matrix","label":"Create Confusion Matrix","html_id":"create-confusion-matrix","implicit":true,"key":"PM8Wzj8RLj"}],"key":"HKYY3xw3IE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:01:39.861813Z","iopub.status.busy":"2026-07-25T16:01:39.861582Z","iopub.status.idle":"2026-07-25T16:01:39.870433Z","shell.execute_reply":"2026-07-25T16:01:39.868939Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"best_predictions = best_seed_result[\"best_predictions\"]\n","key":"AuIbTzA4Ln"},{"type":"outputs","id":"h8NMy_bZfY8v3x3h9hjQw","children":[],"key":"lTnpGweG3X"}],"key":"GGYaP9L4gp"},{"type":"block","kind":"notebook-code","data":{"execution":{"