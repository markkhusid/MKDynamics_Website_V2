, 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch02.svg')\n#plt.close(fig)","key":"dTni91HH4D"},{"type":"outputs","id":"R0NlVERw8kvSJ3v9ZokKI","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"1474dbdade8e83bd81dc2e5b2c444e54","path":"/1474dbdade8e83bd81dc2e5b2c444e54.png"},"text/plain":{"content":"<Figure size 576x720 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZWPxnec7NQ"}],"key":"joPYCUQBT5"}],"key":"NbRQJFXKSF"}],"key":"hCbapyE4QM"},"references":{"cite":{"order":[],"data":{}}}}