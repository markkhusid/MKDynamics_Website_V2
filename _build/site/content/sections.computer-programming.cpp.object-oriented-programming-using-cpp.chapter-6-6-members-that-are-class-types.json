ect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>                      // changed iostream.h to iostream. MK.\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"RgFPma5XQF"}],"key":"d4SVfePfbb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file pairvect.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x8TTT8QE4u"}],"key":"bHni8xfpSd"}],"key":"B4bYySmUq9"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"C++","value":"/*********************************************************************\n\n  Filename:  vect1.h\n  Chapter:   6      Object Creation and Destruction\n  Section:   6.5    A class vect\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n//Implementation of a safe array type vect\n\n#include  <iostream>                      // changed iostream.h to iostream. MK.\n#include  <assert.h>\n\n//Implementation of a safe array type vect\nclass vect {\npublic:\n   explicit vect(int n = 10);\n   ~vect() { delete []p; }\n   int&  element(int i);                 //access p[i]\n   int  ub() const {return (size - 1);}  //upper bound\nprivate:\n   int*  p;\n   int   size;\n};\n\nvect::vect(int n) : size(n)\n{\n   assert(n > 0);\n   p = new int[size];\n   assert(p != 0);\n}\n\nint& vect::element(int i)\n{\n   assert (i >= 0 && i < size);\n   return p[i];\n}","position":{"start":{"line":1,"column":1},"end":{"line":41,"column":1}},"key":"ca1HTdemd0"}],"key":"rQnXxOLLfm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bKSfARrrp4"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"WrX1cOU9zV"}],"key":"j7JeSzSyA1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DwSXbufq9F"}],"key":"UlnYik2mg7"}],"key":"GDqq78BAgu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"sGnyklp6TA"},{"type":"outputs","id":"gGP7EgCjTlap-MxCzKYDz","children":[],"key":"HC7wkAnlJu"}],"key":"BlgM2b1bAX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_6_Members_that_Are_Class_Types\"","key":"hRLaBWV2HG"},{"type":"outputs","id":"CHNds8xjtWXZKvDIAKRdy","children":[],"key":"hj9kWKmgxZ"}],"key":"sOYmArUANZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","ex