lumn":1}},"key":"BX44D0NmZe"}],"key":"zlspxejsS2"}],"key":"pMSihl0zzr"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"distance computes sqrt((x1-x2)^2 + (y1-y2)^2) in double precision.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PYzTmA11tl"}],"key":"BIAuLthQdl"}],"key":"bglMJ3NgBy"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Each distance is printed with list-directed format.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"PSct5FN9SD"}],"key":"TfWTrGUd7I"}],"key":"nxTEqDOh5f"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Useful pattern for stream processing numeric records.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"COojYsYIRI"}],"key":"hs4RLEoQSi"}],"key":"Pn4JQCnLf0"}],"key":"onBqXjbud5"}],"key":"UNYL4U4moe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NrQI1CMmWE"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"YzqLfVgU8I"}],"key":"zd4m1svoGx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"compute_distances.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IxMnmiMCYi"}],"identifier":"compute-distances-f90","label":"compute_distances.f90","html_id":"compute-distances-f90","implicit":true,"key":"ZVhHyNOVQ7"},{"type":"include","file":"Fortran_Code/Section_Distance/app/compute_distances.f90","literal":true,"children":[{"type":"code","value":"program compute_distances\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64, &\n                                              input_unit, error_unit\n    implicit none\n    real(kind=DP) :: x1, y1, x2, y2\n    integer :: status\n    character(len=1024) :: msg\n    \n    do while (.true.)\n        read (unit=input_unit, fmt=*, iostat=status, iomsg=msg) &\n            x1, y1, x2, y2\n        if (status < 0) exit\n        if (status > 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'I/O error: ', msg\n            stop 1\n        end if\n        print *, distance(x1, y1, x2, y2)\n    end do\n\ncontains\n\n    function distance(x1, y1, x2, y2) result(d)\n        implicit none\n        real(kind=DP), intent(in) :: x1, y1, x2, y2\n        real(kind=DP) :: d\n\n        d = sqrt((x1 - x2)**2 + (y1 - y2)**2)\n    end function distance\n\nend program compute_distances\n","lang":"fortran","filename":"compute_distances.f90","key":"Elo3eeffiO"}],"key":"SB7jO5sfOz"}],"key":"gTZR2bfK81"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zIko3q2Prg"}],"key":"Mvcz2lmqQE"}],"key":"aiVAbolORH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yE8BIlk1Sj"}],"identifier":"build-the-program-u