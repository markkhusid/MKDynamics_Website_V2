lumn":1}},"key":"vUpcFj5Pqm"}],"key":"MiTcu2HNY8"}],"key":"CDFu6rwsxn"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"distance computes sqrt((x1-x2)^2 + (y1-y2)^2) in double precision.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PKppD1RfFf"}],"key":"TBrkcvfxWj"}],"key":"k6fuVcxz7G"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Each distance is printed with list-directed format.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"vgWRaOSWeB"}],"key":"r8liqsjHfU"}],"key":"riLSMCW3cv"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Useful pattern for stream processing numeric records.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ZYoCZl9y3w"}],"key":"SRQG4dvcSy"}],"key":"hlpge9ybRu"}],"key":"myAFd2ZshH"}],"key":"xg02Hj4W47"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ERmOqNHICx"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"ZdBkrOlhWL"}],"key":"aetpu0pWN4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"compute_distances.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iBjP7wrBeB"}],"identifier":"compute-distances-f90","label":"compute_distances.f90","html_id":"compute-distances-f90","implicit":true,"key":"puB7dxEp3Y"},{"type":"include","file":"Fortran_Code/Section_Distance/app/compute_distances.f90","literal":true,"children":[{"type":"code","value":"program compute_distances\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64, &\n                                              input_unit, error_unit\n    implicit none\n    real(kind=DP) :: x1, y1, x2, y2\n    integer :: status\n    character(len=1024) :: msg\n    \n    do while (.true.)\n        read (unit=input_unit, fmt=*, iostat=status, iomsg=msg) &\n            x1, y1, x2, y2\n        if (status < 0) exit\n        if (status > 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'I/O error: ', msg\n            stop 1\n        end if\n        print *, distance(x1, y1, x2, y2)\n    end do\n\ncontains\n\n    function distance(x1, y1, x2, y2) result(d)\n        implicit none\n        real(kind=DP), intent(in) :: x1, y1, x2, y2\n        real(kind=DP) :: d\n\n        d = sqrt((x1 - x2)**2 + (y1 - y2)**2)\n    end function distance\n\nend program compute_distances\n","lang":"fortran","filename":"compute_distances.f90","key":"Uay1sm6NLP"}],"key":"tTvNvwq6f1"}],"key":"zaDiVcNopz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KBaa5BKINH"}],"key":"k20Coc6dl7"}],"key":"gECLoKAOi0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"swT1yfGguL"}],"identifier":"build-the-program-u