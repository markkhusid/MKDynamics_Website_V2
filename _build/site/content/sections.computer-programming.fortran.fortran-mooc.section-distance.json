lumn":1}},"key":"Yxl03FiU2d"}],"key":"O4mqs3cxlU"}],"key":"pHZKAoEavj"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"distance computes sqrt((x1-x2)^2 + (y1-y2)^2) in double precision.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"FzM2hjLrij"}],"key":"EXKvSufLQN"}],"key":"ET5WuS7vaC"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Each distance is printed with list-directed format.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"iGA8xVQFZf"}],"key":"TUYgSjmwV5"}],"key":"CfpxZDvjkP"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Useful pattern for stream processing numeric records.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"wwZ72nQXhE"}],"key":"lED0AUKNvm"}],"key":"f6iywaNJ8a"}],"key":"pXPTNOUkhK"}],"key":"zWX9Hqfxgu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rptEoDnANQ"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"i2Ke2AWRt0"}],"key":"trQgp9kpWa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"compute_distances.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m65PqNVEhx"}],"identifier":"compute-distances-f90","label":"compute_distances.f90","html_id":"compute-distances-f90","implicit":true,"key":"e4XJ1vdXsn"},{"type":"include","file":"Fortran_Code/Section_Distance/app/compute_distances.f90","literal":true,"children":[{"type":"code","value":"program compute_distances\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64, &\n                                              input_unit, error_unit\n    implicit none\n    real(kind=DP) :: x1, y1, x2, y2\n    integer :: status\n    character(len=1024) :: msg\n    \n    do while (.true.)\n        read (unit=input_unit, fmt=*, iostat=status, iomsg=msg) &\n            x1, y1, x2, y2\n        if (status < 0) exit\n        if (status > 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'I/O error: ', msg\n            stop 1\n        end if\n        print *, distance(x1, y1, x2, y2)\n    end do\n\ncontains\n\n    function distance(x1, y1, x2, y2) result(d)\n        implicit none\n        real(kind=DP), intent(in) :: x1, y1, x2, y2\n        real(kind=DP) :: d\n\n        d = sqrt((x1 - x2)**2 + (y1 - y2)**2)\n    end function distance\n\nend program compute_distances\n","lang":"fortran","filename":"compute_distances.f90","key":"paDvBMwQ5o"}],"key":"GeTQzLVsTP"}],"key":"yHxAgl5obR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pCsuAD0X6y"}],"key":"ESB9X0IMlE"}],"key":"x0xiaxQUfz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DnnHkJc5QO"}],"identifier":"build-the-program-u