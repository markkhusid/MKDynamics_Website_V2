rearrangements.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ue2SEVaKYV"}],"key":"J0kaFJqVwF"}],"key":"eprT5ushdN"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Replace the number by large - small and repeat.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"hxaPHum3Lm"}],"key":"uTnFyfMXzq"}],"key":"KqNDAJgFeC"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stop when the value no longer changes; print the fixed point.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rDYPbegLQe"}],"key":"r37XuyWouQ"}],"key":"V45Jej5WZN"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A classic recreational-math algorithm using arrays and sorting.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GBQtx3T0vu"}],"key":"FCOTtJvcCO"}],"key":"NqVwfVdOpR"}],"key":"oQ4v011INH"}],"key":"TGKieD6Ee5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oeX479AL9Z"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"Dgs3PVQtwq"}],"key":"HU3wCA00i4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"kaprekar.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Wn8nxT1zW8"}],"identifier":"kaprekar-f90","label":"kaprekar.f90","html_id":"kaprekar-f90","implicit":true,"key":"lE4wQbWxyB"},{"type":"include","file":"Fortran_Code/Section_Kaprekar/app/kaprekar.f90","literal":true,"children":[{"type":"code","value":"program kaprekar\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, parameter :: nr_digits = 4\n    integer, dimension(:), allocatable :: digits\n    integer :: number, prev_number, small, large, istat\n\n    number = get_argument()\n    allocate(digits(nr_digits), stat=istat)\n    if (istat /= 0) then\n        write (error_unit, '(A)') 'Error: can not allocate array'\n        stop 5\n    end if\n    prev_number = 0\n    do while (number /= prev_number)\n        call number2digits(number, digits)\n        call sort_digits(digits)\n        small = digits2number(digits)\n        large = reverse_digits2number(digits)\n        prev_number = number\n        number = large - small\n    end do\n    print '(I0)', number\n\ncontains\n\n    integer function get_argument() result(number)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=80) :: buffer\n        integer :: istat, first_digit, n, i\n        logical :: okay\n\n        if (command_argument_count() /= 1) then\n            write (error_unit, '(A)') &\n                'Error: expecting a single number as argument'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, '(I10)', iostat=istat) number\n        if (istat /= 0) then\n            write (error_unit, '(A)') &\n                'Error: expecting as integer as argument'\n            stop 2\n        end if\n        if (number < 1 .or.  number > 9999) then\n            write (error_unit, '(A)') &\n                'Error: argument should be between 1 and 9999'\n            stop 3\n        endif\n        okay = .false.\n        first_digit = mod(number, 10)\n        n = number/10\n        do i = 2, 4\n            if (first_digit /= mod(n, 10)) then\n                okay = .true.\n            exit\n            end if\n            n = n/10\n        end do\n        if (.not.  okay) then\n            write (error_unit, '(A)') &\n                'Error: number must have at least two distinct digits'\n            stop 4\n        end if\n\n    end function get_argument\n\n    subroutine number2digits(number, digits)\n        implicit none\n        integer, value :: number\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i\n\n        do i = 1, size(digits)\n            digits(i) = mod(number, 10)\n            number = number/10\n        end do\n\n    end subroutine number2digits\n\n    integer function digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = 1, size(digits)\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function digits2number\n\n    integer function reverse_digits2number(digits) result(number)\n        implicit none\n        integer, dimension(:), intent(in) :: digits\n        integer :: factor, i\n\n        number = 0\n        factor = 1\n        do i = size(digits), 1, -1\n            number = number + factor*digits(i)\n            factor = factor*10\n        end do\n\n    end function reverse_digits2number\n\n    subroutine sort_digits(digits)\n        implicit none\n        integer, dimension(:), intent(inout) :: digits\n        integer :: i, j, index, tmp\n\n        do i = 1, size(digits)\n            index = i\n            do j = i + 1, size(digits)\n                if (digits(index) < digits(j)) &\n                    index = j\n            end do\n            tmp = digits(index)\n            digits(index) = digits(i)\n            digits(i) = tmp\n        end do\n\n    end subroutine sort_digits\n\nend program kaprekar\n","lang":"fortran","filename":"kaprekar.f90","key":"gyOn0Yd87F"}],"key":"ZGO15f7iOQ"}],"key":"a7nrhxq5pF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yvmgGEp34I"}],"key":"Gy18ETNUVg"}],"key":"pHQ3BRWI7U"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b83LQjbvU0"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"UqwsPZbUB7"}],"key":"LcEK1xtSOc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"X7lC2njYiJ"},{"type":"outputs","id":"Gnu2IrJZxBBjcrHpgzRQI","children":[],"key":"nuwVSGKHU0"}],"key":"eJRjzLSnR1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following configuration file (fpm.toml) was used:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LWF0Ysl5SY"}],"key":"TqkWWVKCR7"}],"key":"wRnAMyNbdm"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Kaprekar/fpm.toml","literal":true,"children":[{"type":"code","value":"name = \"Section_Kaprekar\"\n\n[build]\nauto-executables = true\nauto-tests = true