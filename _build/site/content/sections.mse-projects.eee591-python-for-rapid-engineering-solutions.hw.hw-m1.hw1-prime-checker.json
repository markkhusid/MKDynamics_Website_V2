0) or (n % (i + 2) == 0):\n            print(f\"  Not prime because n % {i} == 0 or n % {i + 2} == 0: {n}\")\n            return False\n        i += 6\n\n    print(f\"  {n} is a prime\")\n    return True\n\n# Quick smoke tests\nfor n in [100, 101, 2, 3, 4, 5, 99]:\n    print(f\"is_prime({n}) -> {is_prime(n)}\")\n    print()\n","key":"ko1gElj1ix"},{"type":"outputs","id":"WPm_pRZ4-i4G9G39jUNh_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Not prime because n % 2 == 0 or n % 3 == 0: 100\nis_prime(100) -> False\n\n  101 is a prime\nis_prime(101) -> True\n\n  Prime because n == 2 or n == 3: 2\nis_prime(2) -> True\n\n  Prime because n == 2 or n == 3: 3\nis_prime(3) -> True\n\n  Not prime because n % 2 == 0 or n % 3 == 0: 4\nis_prime(4) -> False\n\n  5 is a prime\nis_prime(5) -> True\n\n  Not prime because n % 2 == 0 or n % 3 == 0: 99\nis_prime(99) -> False\n\n"},"children":[],"key":"pqjwfEKZct"}],"key":"qkUzIjI0Yf"}],"key":"b6cDME6PPm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parse mixed numeric tokens","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IJZTbz3xhF"}],"identifier":"parse-mixed-numeric-tokens","label":"Parse mixed numeric tokens","html_id":"parse-mixed-numeric-tokens","implicit":true,"key":"E9mSOvIMoG"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The demo input includes integers written as floats (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zcgxQtH143"},{"type":"inlineCode","value":"31.0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"T49KYgp6we"},{"type":"text","value":") and a true non-integer (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ApQTxmSON9"},{