 % 2 == 0 or n % 3 == 0: 100\nis_prime(100) -> False\n\n  101 is a prime\nis_prime(101) -> True\n\n  Prime because n == 2 or n == 3: 2\nis_prime(2) -> True\n\n  Prime because n == 2 or n == 3: 3\nis_prime(3) -> True\n\n  Not prime because n % 2 == 0 or n % 3 == 0: 4\nis_prime(4) -> False\n\n  5 is a prime\nis_prime(5) -> True\n\n  Not prime because n % 2 == 0 or n % 3 == 0: 99\nis_prime(99) -> False\n\n"},"children":[],"key":"w62VjEHOQF"}],"key":"irDTLE6wPh"}],"key":"XAEaPZFad8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parse mixed numeric tokens","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NJxP1drZ8O"}],"identifier":"parse-mixed-numeric-tokens","label":"Parse mixed numeric tokens","html_id":"parse-mixed-numeric-tokens","implicit":true,"key":"iUx32eEnRx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The demo input includes integers written as floats (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cvbJTxPxub"},{"type":"inlineCode","value":"31.0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u4MDGJOZ9i"},{"type":"text","value":") and a true non-integer (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ayBWcx4J8c"},{"type":"inlineCode","value":"81.4","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aTb9F5uXOJ"},{"type":"text","value":").\nWe convert each token with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AkyDfPRnrq"},{"type":"inlineCode","value":"float","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qnehdlJUmw"},{"type":"text","value":", then use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}}