:{"execution":{"iopub.execute_input":"2026-07-25T16:30:41.910346Z","iopub.status.busy":"2026-07-25T16:30:41.896151Z","iopub.status.idle":"2026-07-25T16:30:41.994387Z","shell.execute_reply":"2026-07-25T16:30:41.958667Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def gcd(a, b):\n    \"\"\"Return gcd(a, b) using Euclid's algorithm.\"\"\"\n    print(f\"gcd({a}, {b}) ...\")\n    mod = a % b\n    print(f\"  initial remainder a % b = {mod}\")\n\n    while mod != 0:\n        a = b\n        b = mod\n        int_div = a // b\n        mod = a % b\n        print(f\"  a={a}, b={b}, a//b={int_div}, a%b={mod}\")\n\n    print(f\"  -> gcd = {b}\")\n    return b\n\n# Quick unit checks\nfor pair in [(48, 18), (12, 2), (15, 10), (90, 25)]:\n    print(f\"GCD{pair} = {gcd(*pair)}\")\n    print()\n","key":"xGExfrsohY"},{"type":"outputs","id":"q5z27Xl0veAhgFvSAzyyv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"gcd(48, 18) ...\n  initial remainder a % b = 12\n  a=18, b=12, a//b=1, a%b=6\n  a=12, b=6, a//b=2, a%b=0\n  -> gcd = 6\nGCD(48, 18) = 6\n\ngcd(12, 2) ...\n  initial remainder a % b = 0\n  -> gcd = 2\nGCD(12, 2) = 2\n\ngcd(15, 10) ...\n  initial remainder a % b = 5\n  a=10, b=5, a//b=2, a%b=0\n  -> gcd = 5\nGCD(15, 10) = 5\n\ngcd(90, 25) ...\n  initial remainder a % b = 15\n  a=25, b=15, a//b=1, a%b=10\n  a=15, b=10, a//b=1, a%b=5\n  a=10, b=5, a//b=2, a%b=0\n  -> gcd = 5\nGCD(90, 25) = 5\n\n"},"children":[],"key":"RUUgub2Mlx"}],"key":"bcd4LMSakg"}],"key":"q8xK5bcrpV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parse a list of integers (assignment-style input format)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NPvJgUXpZg"}],"identifier":"parse-a-list-of-integers-assignment-style-input-format","label":"Parse a list of integers (assig