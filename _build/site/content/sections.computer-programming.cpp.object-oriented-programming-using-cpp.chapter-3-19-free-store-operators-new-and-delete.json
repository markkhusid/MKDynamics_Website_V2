 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"oSZrZxuf2w"}],"key":"newDuO9g8q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FCwCWqZJAn"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ErGKvchSeM"}],"key":"T93jvSt9Ol"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EH4AH8yPGr"}],"key":"KTkQguK2es"}],"key":"wzstN1lK2q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"TFWuggI8EM"},{"type":"outputs","id":"TprMJSjjl1PGuebbICdRH","children":[],"key":"AlUF9EqoF1"}],"key":"R7V3Y8dapu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"MAbuMMf02G"},{"type":"outputs","id":"hsO6CWbJusZJTLuldyN7j","children":[],"key":"E9LtCV8SKL"}],"key":"QWobikhJAN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"ljiy4cmgP5"},{"type":"outputs","id":"_ZeCeIm6g-L1fV6a2fUSR","children":[],"key":"IFlVCnPbci"}],"key":"xVgahMbyZO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan