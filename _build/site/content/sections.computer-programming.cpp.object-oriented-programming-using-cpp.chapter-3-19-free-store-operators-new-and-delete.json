 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"w3CMV23vvf"}],"key":"WfcvH3WFkL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a1YZCfUogC"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"CF0020R6Z5"}],"key":"nGjOrNGQi7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QlmDhGVIdO"}],"key":"e9tb3sSu78"}],"key":"B8wI76seCd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"N5RQzspWL7"},{"type":"outputs","id":"xSI75M5nnQ3h-usROALKt","children":[],"key":"cgw9o0uwxg"}],"key":"u2s6znmSag"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"Z2iNS9z2ab"},{"type":"outputs","id":"R-5a3pt_qd8PT4icFVrJ7","children":[],"key":"b5UeYOaxC1"}],"key":"qOmcnDxnbD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"TDSlJyknSx"},{"type":"outputs","id":"8gCEIpHoRRP7ME9B-NyLF","children":[],"key":"g9x0Zwm6aM"}],"key":"VyhqwQTkxd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan