 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"RjjkmEUNCQ"}],"key":"zQ8a93pbhc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jPLE076TXU"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"NlfBC7BDh8"}],"key":"aeDyNoZ11i"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ixaB6BTUas"}],"key":"JPaZeJ98bB"}],"key":"i2jSvIVADq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"N5XZX16rsx"},{"type":"outputs","id":"MZY5URJQyZUQAL0XSLQRS","children":[],"key":"o95XwOdSMP"}],"key":"h9HN5Blndg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"eoIvsV26io"},{"type":"outputs","id":"G56AsppX0FML7IbnI1cCy","children":[],"key":"ofJm9BnwKY"}],"key":"vl3sGUfy63"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"Ch8C5EuhpS"},{"type":"outputs","id":"DO1FugIgHXk5ooEuBAbpN","children":[],"key":"fO9alZ6Rib"}],"key":"mWovXL2LGp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan