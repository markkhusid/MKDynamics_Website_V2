 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"SZsXnX4JPl"}],"key":"uAOBevpt1Z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xFZ00jlZzW"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"uIbbw4JdQ4"}],"key":"eJTS4z0UA5"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"caSS0tHlYA"}],"key":"S7QBAqk51a"}],"key":"n4DLcq1jRF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"nhIZshw2E7"},{"type":"outputs","id":"pZQGV5xTQCZetFptVkaMC","children":[],"key":"Gdgqjoj9yn"}],"key":"yP9KO6xm8h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"U277HP3d8i"},{"type":"outputs","id":"ljKLJNgs2149eNHTQyjC1","children":[],"key":"X6BmZiG7tt"}],"key":"w4wKtYSnuJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"e0nvlBgczV"},{"type":"outputs","id":"ln5QplMyzaYflekgjbBOT","children":[],"key":"fF4UIQcxNi"}],"key":"YgqmqY2ZGo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan