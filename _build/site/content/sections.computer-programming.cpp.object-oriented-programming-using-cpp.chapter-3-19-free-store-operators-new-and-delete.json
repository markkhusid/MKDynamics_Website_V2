 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"yDLkadloXs"}],"key":"Xyh6uk1meZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YWVZtoFW3q"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ACyzrO6GKy"}],"key":"oRnweQjTki"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DpASos2iEr"}],"key":"oIewouc9bJ"}],"key":"t6NQxbC66o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"WCNn7FsUDX"},{"type":"outputs","id":"fu4Ouu16PWUh4SZkboXE2","children":[],"key":"cOydCfdfhT"}],"key":"TnjwhdehMA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"mV1i4M7JGX"},{"type":"outputs","id":"MRSDnixS_cHDyQ4-6VsY3","children":[],"key":"Nn2DIg20MW"}],"key":"YHEsvk5BQK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"HCDjW5hqyw"},{"type":"outputs","id":"OeL7laDevYW_efCYHnIOg","children":[],"key":"Dr38MNjDRJ"}],"key":"DoAPonXGbC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan