 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"c63upsBs0t"}],"key":"ATJNmdvjSp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R8R6hR640O"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"wR5yzhWzQV"}],"key":"mj3vhFlzXY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WuPf3l9dIs"}],"key":"Rva65VpKx4"}],"key":"BKxHZq45k4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"UUmsS85gKQ"},{"type":"outputs","id":"xSI75M5nnQ3h-usROALKt","children":[],"key":"pR92aly2Ar"}],"key":"pdT5WgS0gs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"OO1UnRec01"},{"type":"outputs","id":"R-5a3pt_qd8PT4icFVrJ7","children":[],"key":"Fvh67VsjCI"}],"key":"Vekh4cvzJv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"EwXhxEIo87"},{"type":"outputs","id":"8gCEIpHoRRP7ME9B-NyLF","children":[],"key":"IKjNADkw2t"}],"key":"TT9rOY5p1u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan