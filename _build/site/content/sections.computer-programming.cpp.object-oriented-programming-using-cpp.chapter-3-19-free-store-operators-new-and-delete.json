 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"nOhl4f6fqF"}],"key":"zfRYpPDbqI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K0DnCILCqg"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ZVasdKbakP"}],"key":"nN771eLtmZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Np2uqFRbH9"}],"key":"GEsVnMw85N"}],"key":"Med09vKofY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"rceFN2alpL"},{"type":"outputs","id":"uM3BXvcTMRfwfNOV02aMo","children":[],"key":"GOMX6LzsGN"}],"key":"EnJz9HZCXt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"kkVQVvY7oZ"},{"type":"outputs","id":"Bcvz8Uy1DF7n3gzhqCvij","children":[],"key":"OBmrdgbVny"}],"key":"Soe0RSwwNA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"qO4ObQFvSs"},{"type":"outputs","id":"u5-SnaYF3hAMGEybI-IuJ","children":[],"key":"StUAdClnd5"}],"key":"i0LgwS12bH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan