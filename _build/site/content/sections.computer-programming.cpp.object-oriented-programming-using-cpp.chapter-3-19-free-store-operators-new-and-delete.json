 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"jqibI6jcwJ"}],"key":"wFthuoY51A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fkhIwsZhDb"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"yYtd63lM1p"}],"key":"H1aihjTZmF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xdO24czUqH"}],"key":"RNJ8wf6vc7"}],"key":"iGeBrEMSPt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"BpUCXF4Fn8"},{"type":"outputs","id":"TprMJSjjl1PGuebbICdRH","children":[],"key":"huCHGdNF43"}],"key":"KLHnSK9at5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"vogcGZpBaW"},{"type":"outputs","id":"hsO6CWbJusZJTLuldyN7j","children":[],"key":"fn7rvhaAQ2"}],"key":"VTh2shmZfS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"yGKQCi3gr9"},{"type":"outputs","id":"_ZeCeIm6g-L1fV6a2fUSR","children":[],"key":"wf4y5IBdqG"}],"key":"N07QSUx53E"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan