 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"NLEUzSgRuU"}],"key":"wQWjjg85sK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TXKkMP4r2F"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"jlJnImHguj"}],"key":"hzYVfGAn4Y"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wClagtkqIC"}],"key":"ZKtvZIDRIl"}],"key":"a17v2y2v3a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"xYnuNih3lX"},{"type":"outputs","id":"M8puCdFNapdn4mT9OPX7N","children":[],"key":"ZJu45jOn1G"}],"key":"tBAlBv9ChH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"zQiRbtfYux"},{"type":"outputs","id":"oo8NqWhe49AcYRMgzV5pB","children":[],"key":"pAiuA2cKIq"}],"key":"LsFY1TGUM1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"L9F6waHN87"},{"type":"outputs","id":"3mtB8TgTTGULF9p3erAyA","children":[],"key":"ZjxnEPLFvx"}],"key":"PX8rewAP8u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan