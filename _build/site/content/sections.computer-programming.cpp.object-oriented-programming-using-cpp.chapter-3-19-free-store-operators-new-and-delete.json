 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"jLEzNdLcIa"}],"key":"orwKCHBwqF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EHWabGBIQR"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"kklLsaTOq3"}],"key":"QEsvPnEYup"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FhC1oiPuAy"}],"key":"gSQAfLhi8g"}],"key":"oyw6b5WOwX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"RILjFYmlUT"},{"type":"outputs","id":"jhXcPyNcnZCdRKy55lGju","children":[],"key":"XiUm4fIgJV"}],"key":"f6FvO8vFFh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"SH26gLPaQ6"},{"type":"outputs","id":"NHTTiG1cgJfUBOP8hUUJG","children":[],"key":"vJOseH37vi"}],"key":"lqbq6DaFoj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"SMW5r8R3YO"},{"type":"outputs","id":"y6Bt1mwHWHmciKUYUa4z0","children":[],"key":"jjtsZywhQA"}],"key":"ILw4jruQqH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan