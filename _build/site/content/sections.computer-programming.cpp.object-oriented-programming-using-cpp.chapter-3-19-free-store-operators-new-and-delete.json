 cin >> data[j];\n        }\n        \n        cout << \" average is \" << avg_arr(data, size) << endl;\n        delete [] data;\n    }\n}","key":"PgJEbpq17p"}],"key":"PthUl6zZQS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l2frYNgfBt"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"ShjVV7SF51"}],"key":"mdHW7jZTW2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"U1scKzJ1RB"}],"key":"IaU7pw6Qmc"}],"key":"Bi0YgZiOGq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"OmtC5VGRYw"},{"type":"outputs","id":"BnQVG-e-p78-yPHJz6KFM","children":[],"key":"LE1qV0nI8y"}],"key":"QNzL6nrA8E"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_19_Free_Store_Operators_new_and_delete\"","key":"mYz3fy3CAD"},{"type":"outputs","id":"-Elcuy_RopYIEWS6LTJlO","children":[],"key":"pubUyUUH3y"}],"key":"vGcXWsi4aP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"DXXz14BREQ"},{"type":"outputs","id":"FdnAcworM3dMeR9XHEusI","children":[],"key":"wF0ju0fXpL"}],"key":"nvCljObz1J"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan