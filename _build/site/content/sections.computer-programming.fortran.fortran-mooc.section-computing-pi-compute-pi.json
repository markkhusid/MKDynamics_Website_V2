n></span>","enumerator":"1","key":"FuTBQfy4d3"}],"key":"erI651QCKE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file section_computing_pi_compute_pi.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CO6N35KJwU"}],"identifier":"in-file-section-computing-pi-compute-pi-f90","label":"In file section_computing_pi_compute_pi.f90","html_id":"in-file-section-computing-pi-compute-pi-f90","implicit":true,"key":"T5f9wb7Jh4"}],"key":"N92dgFxBHv"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_Computing_Pi_Compute_Pi/app/section_computing_pi_compute_pi.f90","literal":true,"children":[{"type":"code","value":"program compute_pi\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64, I8 => INT64\n    implicit none\n    integer(kind=I8) :: i, nr_iters\n    real(kind=DP) :: delta, x, pi_val\n    real(kind=DP) :: pi_val_actual\n\n    pi_val = 0.0_DP\n    pi_val_actual = 2.0_DP * acos(0.0_DP)\n    nr_iters = get_nr_iters()\n    delta = 1.0_DP/nr_iters\n    x = 0.0_DP\n    do i = 1, nr_iters\n        pi_val = pi_val + sqrt(1.0_DP - x**2)\n        x = x + delta\n    end do\n    pi_val = 4.0_DP*pi_val/nr_iters\n    print '(A, I10, A, F25.15)', \"After \", nr_iters, \" loops, Pi = \", pi_val\n    print '(A, F25.15)', \"Actual value of Pi = \", pi_val_actual\n    print '(A, F25.15)', \"Absolute difference = \", abs(pi_val - pi_val_actual)\n\ncontains\n     \n    function get_nr_iters() result(nr_iters)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer(kind=I8) :: nr_iters\n        integer(kind=I8), parameter :: default_nr_iters = 1000_I8\n        character(len=1024) :: buffer, msg\n        integer :: istat\n\n        if (command_argument_count() >= 1) then\n            call get_command_argument(1, buffer)\n            read (buffer, fmt=*, iostat=istat, iomsg=msg) nr_iters\n            if (istat /= 0) then\n                write (unit=error_unit, fmt='(2A)') &\n                    'error: ', msg\n                stop 1\n            end if\n        else\n            nr_iters = default_nr_iters\n        end if\n    end function get_nr_iters\n\nend program compute_pi\n","lang":"fortran","filename":"section_computing_pi_compute_pi.f90","key":"vQzvDdVr2r"}],"key":"VZFfRZU86C"}],"key":"TqVjj6GOlE"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RoORg4FgVg"}],"key":"wzQV4aUhyi"}],"key":"fT1Dpn9HpG"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BhqQrAVqdW"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"cQ73WyJSM4"}],"visibility":"show","key":"mrfpUHWYTR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.getcwd()","key":"V360P4sQw6"},{"type":"outputs","id":"3NbgDw1D7K0EO4P3-atHG","children":[],"key":"xCHqtewJx5"}],"key":"Wzi3WBpAZp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following config