ate seed arrays and random_seed(get=...) to capture the current seed.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GKVlxIUpcX"}],"key":"vMngO4TnJq"}],"key":"iEU3hhoqXb"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Draw a few random_number samples and print them.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DpNmVOynPZ"}],"key":"ntOYN5rkeS"}],"key":"arn8QnQWP1"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Put the saved seed back with random_seed(put=...).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"z4ZRqYvS4u"}],"key":"V07en3EfRP"}],"key":"UQy57Mnfn2"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Drawing again reproduces the same sequence after reseeding.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"TggGyw6bli"}],"key":"rNKF7FeeM0"}],"key":"uKluRhz10n"}],"key":"q7v54IOo5V"}],"key":"oDwVIAhsVv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wa1CV0Pngw"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"ouVPir0IXp"}],"key":"TlIuKLQQGu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"random_numbers.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LyAUWiGF7O"}],"identifier":"random-numbers-f90","label":"random_numbers.f90","html_id":"random-numbers-f90","implicit":true,"key":"itdneiMmXL"},{"type":"include","file":"Fortran_Code/Section_Random_Numbers/app/random_numbers.f90","literal":true,"children":[{"type":"code","value":"program random_numbers\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer, parameter :: nr_vals = 3\n    integer :: seed_size, istat, i\n    integer, dimension(:), allocatable :: seed_vals, new_seed_vals\n    real :: r\n\n    ! check how many integers are required to seed the RNG\n    call random_seed(size=seed_size)\n    print '(A, I0)', 'number of seeds: ', seed_size\n\n    ! allocate the array to hold the seeds\n    allocate (seed_vals(seed_size), new_seed_vals(seed_size), stat=istat)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(A)') 'error: can not allocate seed'\n        stop 1\n    end if\n\n    ! get the current seed values\n    call random_seed(get=seed_vals)\n    print '(A, *(I12))', 'seeds: ', seed_vals\n\n    ! print some random numbers\n    print '(A)', 'values:'\n    do i = 1, nr_vals\n        call random_number(r)\n        print '(F10.7)', r\n    end do\n\n    ! get current seed\n    call random_seed(get=new_seed_vals)\n    print '(A, *(I12))', 'current seeds: ', new_seed_vals\n\n    ! reseed\n    call random_seed(put=seed_vals)\n    print '(A)', 'values after reseed:'\n    do i = 1, nr_vals\n        call random_number(r)\n        print '(F10.7)', r\n    end do\n\n    ! clean up\n    deallocate(seed_vals)\nend program random_numbers\n","lang":"fortran","filename":"random_numbers.f90","key":"ymyob8gdd3"}],"key":"kAuUhFy5lb"}],"key":"tNwJXtj8Dl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran P