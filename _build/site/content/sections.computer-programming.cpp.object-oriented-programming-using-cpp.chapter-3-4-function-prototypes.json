{"version":3,"kind":"Notebook","sha256":"0825e85956adcccb4a746a6acb3799aad54687332bb41c7211375f3bae7f2794","slug":"sections.computer-programming.cpp.object-oriented-programming-using-cpp.chapter-3-4-function-prototypes","location":"/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_3_4_Function_Prototypes.ipynb","dependencies":[],"frontmatter":{"title":"Chapter 3.4: Function Prototypes","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_3_4_Function_Prototypes.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/CPP/Object_Oriented_Programming_Using_Cpp/Chapter_3_4_Function_Prototypes.ipynb","exports":[{"format":"ipynb","filename":"Chapter_3_4_Function_Prototypes.ipynb","url":"/Chapter_3_4_Function-f65a59a91df08e2810f145c0dd96a990.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison- Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FZz2khn4K8"}],"key":"g2LGsAClCp"}],"key":"PCIqwVdEhs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates function prototypes in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZEs8uE7TjD"}],"identifier":"program-that-demonstrates-function-prototypes-in-c","label":"Program that demonstrates function prototypes in C++","html_id":"program-that-demonstrates-function-prototypes-in-c","implicit":true,"key":"TemOujDGTl"}],"key":"nI9ae2GHhR"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"cpp","value":"// Add three ints - illustrating function prototypes\n#include <iostream>\n\nint add3(int, int, int);\ndouble average(int);\n\nusing namespace std;\n\nint main()\n{\n    int score_1, score_2, score_3, sum;\n\n    cout << \"\\nEnter 3 scores: \";\n    cin >> score_1 >> score_2 >> score_3;\n    sum = add3(score_1, score_2, score_3);\n    cout << \"\\nTheir sum is \" << sum;\n    cout << \"\\nTheir average is \" << average(sum);\n    sum = add3(1.5 * score_1, score_2, 0.5 * score_3);\n    cout << \"\\nTheir weighted sum is \" << sum << \".\";\n    cout << \"\\nTheir weighted average is \" << average(sum) << \".\" << endl;\n}\n\nint add3(int a, int b, int c)\n{\n    return (a + b + c);\n}\n\ndouble average(int s)\n{\n    return (s / 3.0);\n}","key":"rqiLvJa1qe"}],"key":"D1G19x0KND"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compile and Execute the Program","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sVVjdVPtsY"}],"identifier":"compile-and-execute-the-program","label":"Compile and Execute the Program","html_id":"compile-and-execute-the-program","implicit":true,"key":"oUQFCbpglc"}],"key":"d4SnjFl261"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kTfYXctBlr"}],"key":"GGqIOjlc7f"}],"key":"SCYXwMTmiT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"vTaLgsdSDV"},{"type":"outputs","id":"a6-OSVBB-Dw6h30lNNWYn","children":[],"key":"GrD5u8Ucr2"}],"key":"cUccqEN65D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_3_4_Function_Prototypes\"","key":"gkSRS80GI9"},{"type":"outputs","id":"ogEaSQjUVWXejWKsRx7dc","children":[],"key":"kj4yX2lZJ6"}],"key":"aZd5W6NFb5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ch_dir_stat = os.chdir(code_dir)","key":"dG3wD27nbg"},{"type":"outputs","id":"NJ1KTjRigjPbHGiS2SHfI","children":[],"key":"OKdczzORVs"}],"key":"xN9WMlgpXU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ add3.cpp -w -o add3\")","key":"Xg0J5xLYFR"},{"type":"outputs","id":"vHkT6grQHwVmf43Pi9RgO","children":[],"key":"DsdV6K2Xp0"}],"key":"YK9f2YHhmG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"echo \\\"10 20 30\\\" | ./add3\")","key":"GAApgQL3T0"},{"type":"outputs","id":"3BHAj8llD226F76sEwZTJ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nEnter 3 scores: \nTheir sum is 60\nTheir average is 20\nTheir weighted sum is 50.\nTheir weighted average is 16.6667.\n"},"children":[],"key":"MyvE6t9uFX"}],"key":"dJCNq0vSA2"}],"key":"T58BvwObSd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"echo \\\"1210 8750 54360\\\" | ./add3\")","k