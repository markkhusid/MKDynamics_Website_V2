:"Introduction","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"iwc5xR47jy"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"Sk8NPhlsVa"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"In this section, we will discuss and experiment with C++ programming. C++ is a high-level programming language that is used for general-purpose programming. It is a compiled language that is especially suited to systems programming and applications requiring high performance. C++ was developed by Bjarne Stroustrup in the 1980s as an extension of the C programming language. It has since been updated and improved, and is still widely used in systems programming, game development, and high-performance computing.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"W1lm9dhbgE"}],"key":"rzPkNHNwIv"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Table of Contents","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Eq9wlmMNsd"}],"identifier":"table-of-contents","label":"Table of Contents","html_id":"table-of-contents","implicit":true,"key":"koeLJp89cx"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Resources and Textbooks Used","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"yuOHSJ3Gs7"}],"identifier":"resources-and-textbooks-used","label":"Resources and Textbooks Used","html_id":"resources-and-textbooks-used","implicit":true,"key":"NOHYWAbgha"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"“Learn Modern C++” br cpptutor (Online Course)","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"qrkSJUyxP5"}],"identifier":"learn-modern-c-br-cpptutor-online-course","label":"“Learn Modern C++” br cpptutor (Online Course)","html_id":"learn-modern-c-br-cpptutor-online-course","implicit":true,"key":"EkcUCBWySH"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The course maye be found here: ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"fIMxsVo4Ih"},{"type":"break","key":"Je2EMQ0c1R"},{"type":"text","value":"\n","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"YF18jTJSxo"},{"type":"link","url":"https://learnmoderncpp.com/","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Learn Modern C++","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"hvs3NWKRaz"}],"urlSource":"https://learnmoderncpp.com/","key":"u06Z59lsvl"},{"type":"text","value":" ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"W7oMci4Tf3"},{"type":"break","key":"IvawRDmFam"},{"type":"break","key":"pPdr9lgt6r"},{"type":"text","value":"\nSource code may be found in GitHib here: ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"UJO3aW5V52"},{"type":"break","key":"vS25D11g9h"},{"type":"text","value":"\n","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"TpdVKLnCQz"},{"type":"link","url":"https://github.com/cpp-tutor/learnmoderncpp-tutorial","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Course source code","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"sPzzNyIAbt"}],"urlSource":"https://github.com/cpp-tutor/learnmoderncpp-tutorial","error":true,"key":"yKjSkzmvsy"}],"key":"wHVPaUy4FO"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Dockerfile Used to Setup the C++23 Environment","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"dunJAzGbqp"}],"identifier":"dockerfile-used-to-setup-the-c-23-environment","label":"Dockerfile Used to Setup the C++23 Environment","html_id":"dockerfile-used-to-setup-the-c-23-environment","implicit":true,"key":"M4Upgt9Yy2"},{"type":"include","file":"DockerFile/Dockerfile","literal":true,"children":[{"type":"code","value":"# Use Ubuntu 24.04 as the base image\r\nFROM ubuntu:24.04 AS build\r\n\r\n# Update package lists and install necessary tools\r\nRUN apt update && apt install -y \\\r\n    wget \\\r\n    gnupg \\\r\n    software-properties-common \\\r\n    && rm -rf /var/lib/apt/lists/*\r\n\r\n# Add the LLVM repository for Clang 18\r\nRUN wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - \\\r\n    && echo \"deb http://apt.llvm.org/noble/ llvm-toolchain-noble-18 main\" >> /etc/apt/sources.list \\\r\n    && apt update\r\n\r\n# Install Clang 18\r\nRUN apt install -y clang-18 lld-18 libc++-18-dev libc++abi-18-dev\r\n\r\n# Set Clang 18 as the default compiler\r\nRUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 \\\r\n    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-18 100\r\n\r\n# Set working directory\r\nWORKDIR /app\r\n\r\n# Copy your C++ source code into the container (optional)\r\nCOPY . .\r\n\r\n# Start an interactive shell\r\nCMD [\"bash\"]","lang":"dockerfile","filename":"Dockerfile","key":"n6KpQ3oWEl"}],"key":"yRDKK3TJzf"}],"key":"C549ic2Ycz"}],"key":"b3Yws88EAo"},"references":{"cite":{"order":[],"data":{}}}}