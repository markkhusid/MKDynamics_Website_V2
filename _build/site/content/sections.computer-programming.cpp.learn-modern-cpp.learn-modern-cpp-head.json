:"Introduction","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Ez01dRXikD"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"WZWVGKzh3G"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"In this section, we will discuss and experiment with C++ programming. C++ is a high-level programming language that is used for general-purpose programming. It is a compiled language that is especially suited to systems programming and applications requiring high performance. C++ was developed by Bjarne Stroustrup in the 1980s as an extension of the C programming language. It has since been updated and improved, and is still widely used in systems programming, game development, and high-performance computing.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"dtdcVhLq2A"}],"key":"pspu2RCw4i"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Table of Contents","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"KKBsT9C0Et"}],"identifier":"table-of-contents","label":"Table of Contents","html_id":"table-of-contents","implicit":true,"key":"LMzILkuvnk"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Resources and Textbooks Used","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"InpkMw6Tyl"}],"identifier":"resources-and-textbooks-used","label":"Resources and Textbooks Used","html_id":"resources-and-textbooks-used","implicit":true,"key":"oDy5BLAAye"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"“Learn Modern C++” br cpptutor (Online Course)","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"o3KzmfDOui"}],"identifier":"learn-modern-c-br-cpptutor-online-course","label":"“Learn Modern C++” br cpptutor (Online Course)","html_id":"learn-modern-c-br-cpptutor-online-course","implicit":true,"key":"LGSftlDR5P"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The course maye be found here: ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"e1NOAwEvtB"},{"type":"break","key":"MoAjHRIK41"},{"type":"text","value":"\n","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"THIgVMGb8Z"},{"type":"link","url":"https://learnmoderncpp.com/","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Learn Modern C++","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"xw1rTOhvF7"}],"urlSource":"https://learnmoderncpp.com/","key":"XiKBHM8hBT"},{"type":"text","value":" ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"W3Q88BeyC2"},{"type":"break","key":"Y8jO3BQ9kq"},{"type":"break","key":"c5CrSQekSr"},{"type":"text","value":"\nSource code may be found in GitHib here: ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"gPQYqT1iL8"},{"type":"break","key":"mq6Y1VjxZ2"},{"type":"text","value":"\n","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Jgq4ynyial"},{"type":"link","url":"https://github.com/cpp-tutor/learnmoderncpp-tutorial","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Course source code","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"bzL5mMQXuj"}],"urlSource":"https://github.com/cpp-tutor/learnmoderncpp-tutorial","error":true,"key":"QLuXuIBwt9"}],"key":"BvYHrD3Qlr"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Dockerfile Used to Setup the C++23 Environment","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"kEmYUh1caR"}],"identifier":"dockerfile-used-to-setup-the-c-23-environment","label":"Dockerfile Used to Setup the C++23 Environment","html_id":"dockerfile-used-to-setup-the-c-23-environment","implicit":true,"key":"Q0moG5vOFt"},{"type":"include","file":"DockerFile/Dockerfile","literal":true,"children":[{"type":"code","value":"# Use Ubuntu 24.04 as the base image\r\nFROM ubuntu:24.04 AS build\r\n\r\n# Update package lists and install necessary tools\r\nRUN apt update && apt install -y \\\r\n    wget \\\r\n    gnupg \\\r\n    software-properties-common \\\r\n    && rm -rf /var/lib/apt/lists/*\r\n\r\n# Add the LLVM repository for Clang 18\r\nRUN wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - \\\r\n    && echo \"deb http://apt.llvm.org/noble/ llvm-toolchain-noble-18 main\" >> /etc/apt/sources.list \\\r\n    && apt update\r\n\r\n# Install Clang 18\r\nRUN apt install -y clang-18 lld-18 libc++-18-dev libc++abi-18-dev\r\n\r\n# Set Clang 18 as the default compiler\r\nRUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 \\\r\n    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-18 100\r\n\r\n# Set working directory\r\nWORKDIR /app\r\n\r\n# Copy your C++ source code into the container (optional)\r\nCOPY . .\r\n\r\n# Start an interactive shell\r\nCMD [\"bash\"]","lang":"dockerfile","filename":"Dockerfile","key":"JWk8zEbWSb"}],"key":"qJ6B5s1ydz"}],"key":"qhQgxvBKej"}],"key":"I0QgB6wUQK"},"references":{"cite":{"order":[],"data":{}}}}