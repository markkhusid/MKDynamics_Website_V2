:"Introduction","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"XIrpDWJLs4"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"Ujl0xtpkDv"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"In this section, we will discuss and experiment with C++ programming. C++ is a high-level programming language that is used for general-purpose programming. It is a compiled language that is especially suited to systems programming and applications requiring high performance. C++ was developed by Bjarne Stroustrup in the 1980s as an extension of the C programming language. It has since been updated and improved, and is still widely used in systems programming, game development, and high-performance computing.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"cbs8Cg1Epi"}],"key":"tvshwX4J47"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Table of Contents","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"aPGhzduh4u"}],"identifier":"table-of-contents","label":"Table of Contents","html_id":"table-of-contents","implicit":true,"key":"ioQ2xXp1FG"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Resources and Textbooks Used","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"jjoJonEWFE"}],"identifier":"resources-and-textbooks-used","label":"Resources and Textbooks Used","html_id":"resources-and-textbooks-used","implicit":true,"key":"KJ6nFwsWME"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"“Learn Modern C++” br cpptutor (Online Course)","position":{"start":{"line":19,"colu