od.nasm. What we have done to helloworld.nasm to make it helloworld-small1_mod.nasm is to modify the instructions so that helloworld-small1_mod.nasm has a reduced size and removed nulls from an opcodes perspective. The screenshot below displays the objdump output of both assembled programs to elucidate this further.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"STuldknIec"}],"key":"en8JgIYGSU"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/helloworld_and_hello-0686e76f32e5d9e44ea3b91e4cba0471.jpg","alt":"helloworld and helloword small side by side with objdump","align":"center","key":"yFYd59rwL4","urlSource":"images/helloworld_and_helloword_small_side_by_side_with_objdump.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","identifier":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","html_id":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"gQH08tMEDh"},{"type":"text","value":"2","key":"Q3Cg8xpdHt"},{"type":"text","value":":","key":"hwwe8zBQjN"}],"template":"Figure %s:","key":"xux5ExI87B"},{"type":"text","value":"helloworld and helloword small side by side with objdump","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"y8Vl3rMXtJ"}],"key":"Ch0tNWjNWy"}],"key":"Bc9v9U9Ly3"}],"class":"clickable-figure","label":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","identifier":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","enumerator":"2","html_id":"slae-s7-helloworld-and-helloword-small-side-by-side-with-o-2","key":"ukNWmpxv03"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"The program helloworld.asm and helloworld-small1_mod.nasm with their opcodes.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Ha9MXRhCXn"}],"key":"WdlJEnxq1h"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"In the screenshot above, we show both programs as well as their generated opcodes. We can see from the opcodes of helloworld-small1_mod.nasm, that the first few opcodes are:","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"s76sKK78lt"}],"key":"DslHcJ5xHZ"},{"type":"code","lang":"text","value":"0:\tb0 01 mov $0x1,%al","position":{"start":{"line":47,"column":1},"end":{"line":49,"column":1}},"key":"vtdp2YJRXz"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"rather than the much longer and null ridden:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"qP6dc63SAs"}],"key":"E4aB3BD0g2"},{"type":"code","lang":"text","value":"0:\t48 b8 01 00 00 00 00 movabs $0x1,%rax\n7:\t00 00 00","position":{"start":{"line":53,"column":1},"end":{"line":56,"column":1}},"key":"FobAPCW28F"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"In both cases, the same action effectively occurs, the immediate 1 is moved into the register RAX; however, in the helloworld-small1_mod.nasm version, what was done is to move the 8 bit version of the immediate 1 into the 8 bit portion of RAX. Therefore, both the opcode and the immediate are more compact. Actually, the compact version uses only 2 bytes, while the non-compact version uses 10 bytes, for a savings of 8 bytes.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"wrk8Se60bF"}],"key":"X7ANcO4xMz"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"In the next line, we have implemented the instruction:","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"mJRo5V01oF"}],"key":"XihnF9fKv3"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"mov rdi, 1","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"dOHlWCQ7Sf"}],"key":"tExlOoPHm4"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"as:","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"GvYvOtqJ0G"}],"key":"Dj1pKLohIe"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"mov di, ax","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"pR9DGFyPke"}],"key":"vytRa0P9BQ"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"What this instruction has done is to copy the contents of the 16-bit register ax into the 16-bit register di. Since ax already contains the immediate value 1, this instruction effectively moves the immediate value 1 into the 16-bit register di as well.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"EJb2IFQnFR"}],"key":"cdPLIg6rtP"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Looking at the opcodes from both files, the opcodes generated from helloworld.nasm for this instruction were:","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"dMGq5FO3Rq"}],"key":"mpoQUG0Qz3"},{"type":"code","lang":"text","value":"a:\t48 bf 01 00 00 00 00 movabs $0x1,%rdi\n11:\t00 00 00","position":{"start":{"line":72,"column":1},"end":{"line":75,"column":1}},"key":"YrgVJP1QHi"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"while the opcodes generated from helloworld-small1_mods.nasm were:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"E9Gm52MbVT"}],"key":"wSj1moOvLW"},{"type":"code","lang":"text","value":"2:\t66 89 c7 mov %ax,%di","position":{"start":{"line":79,"column":1},"end":{"line":81,"column":1}},"key":"QyuXQ9ZcGX"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"for a savings of 7 bytes.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"aHAltUAVBK"}],"key":"aPgha3NEDy"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Such copying and reusing immediates from one register to another, or from the stack as we will see later, is a frequent “trick” used by shellcode composers to remove nulls and compactify code.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"OVRBApNLQu"}],"key":"nlKm4ZmVmz"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Note that we could have moved the immediate 1 into the 8-bit register DIL directly. In this case, the instruction would be:","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"nBZJcXI70y"}],"key":"rNRsHQslXg"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"mov dil, 1","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"edrXzwdshP"}],"key":"JGB02iVaPR"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"and the generated opcodes would be:","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"E9vImLlNIE"}],"key":"n10vRbustS"},{"type":"code","lang":"text","value":"2: 40 b7 01 mov $0x1,%dil","position":{"start":{"line":93,"column":1},"end":{"line":95,"column":1}},"key":"bn0ejhWhPN"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"for a savings of 7 bytes again. Or we could have moved the contents of the 8-bit register AL into the the 8-bit register DIL. In this case the instruction would be:","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"tueMFCoI1g"}],"key":"faOEG4GBeG"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"mov dil, al","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"jRZ4V9ZIUj"}],"key":"ENNLIZfD8e"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"and the generated opcodes would be:","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"lcpM0q15C4"}],"key":"pRx8hQQAnR"},{"type":"code","lang":"text","value":"2:\t40 88 c7 mov %al,%dil","position":{"start":{"line":103,"column":1},"end":{"line":105,"column":1}},"key":"HFR5VLE3rd"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"for a savings of 7 bytes in both cases.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"SkCa4CjAdp"}],"key":"Ou1a1uOPRu"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"This brings up an obvious point. There are many ways to accomplish the same thing. The idea is to compactify the generated opcodes as much as possible and remove all of the nulls.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"hxgYYCPRq2"}],"key":"pgG2A1EFg8"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"The astute observer will notice something else. We have not been able to remove the nulls when it comes to operations that involve memory addresses. Namely, the operation:","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"lx9BZLCdwV"}],"key":"oatQh0y5Sf"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"mov rsi, hello_world","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"QDXAptnTyc"}],"key":"TJbp2CW7LG"},{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"produces the opcodes:","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"rESjQx6w3K"}],"key":"azHKQ0h6S2"},{"type":"code","lang":"text","value":"5:\t48 be 00 00 00 00 00 movabs $0x0,%rsi\nc:\t00 00 00","position":{"start":{"line":117,"column":1},"end":{"line":120,"column":1}},"key":"NEtMYKkqvi"},{"type":"paragraph","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"for an operation that takes up 10 bytes. Also notice that at this point in the compilation process, the assembler moved the immediate 0 into the register RSI, rather than the memory address of the string hello_world. This is because the assembler left a placeholder for the linker to fill in the actual address when the executable is produced. So if we look at the objdump of the executable, we get the following:","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"DNWOCyFHrc"}],"key":"kXQCKvOjUu"},{"type":"code","lang":"bash","value":"$ objdump -d helloworld","position":{"start":{"line":124,"column":1},"end":{"line":126,"column":1}},"key":"UFITIuH3Fv"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"helloworld: file format elf64-x86-64","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"m4dWI2Rytu"}],"key":"sMu3EiQZCz"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"Disassembly of section .text:","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"Xsqnau40Eb"}],"key":"ONeLr9H2Je"},{"type":"paragraph","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"text","value":"0000000000401000 :","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"ckc9qDlcw6"}],"key":"CNdqamHXnr"},{"type":"code","lang":"text","value":"401000:\t48 b8 01 00 00 00 00 movabs $0x1,%rax\n401007:\t00 00 00\n40100a:\t48 bf 01 00 00 00 00 movabs $0x1,%rdi\n401011:\t00 00 00\n401014:\t48 be 00 20 40 00 00 movabs $0x402000,%rsi\n40101b:\t00 00 00\n40101e:\t48 ba 22 00 00 00 00 movabs $0x22,%rdx\n401025:\t00 00 00\n401028:\t0f 05 syscall\n40102a:\t48 b8 3c 00 00 00 00 movabs $0x3c,%rax\n401031:\t00 00 00\n401034:\t48 bf 0b 00 00 00 00 movabs $0xb,%rdi\n40103b:\t00 00 00\n40103e:\t0f 05 syscall","position":{"start":{"line":133,"column":1},"end":{"line":148,"column":1}},"key":"PAQJK4TpvA"},{"type":"paragraph","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"We can see from the above objdump that the linker has filled in the proper address for the string hello_world. Notice also that the memory address of the string hello_world contains nulls, making these opcodes not shellcode friendly.","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"bErFkLNiHa"}],"key":"l1GhFPA3kX"},{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"text","value":"There are techniques for removing nulls in memory address calls. One such technique is the JMP-CALL-POP technique, which we will see in later sections.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"Zo4DJOw0ZJ"}],"key":"x9TkmLSLuz"}],"key":"fCH4dZf1e5"}],"key":"tNdiJYVHeK"},"references":{"cite":{"order":[],"data":{}}}}