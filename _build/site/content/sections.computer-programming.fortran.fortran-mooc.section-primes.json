"type":"include","file":"Fortran_Code/Section_Primes/app/prime_test.f90","literal":true,"children":[{"type":"code","value":"program prime_test\n    use :: primes_mod, only : is_prime\n    implicit none\n    integer, parameter :: max_value = 100\n    integer :: n\n\n    do n = 0, max_value\n        if (is_prime(n)) print '(I4)', n\n    end do\nend program prime_test\n","lang":"fortran","filename":"prime_test.f90","key":"QgFMUJYRrV"}],"key":"MCUymzv7Ak"}],"key":"YdTYkX0fQ7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"primes_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rV0gn0E85G"},{"type":"text","value":" (module)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F6ouGIo1WB"}],"identifier":"primes-mod-f90-module","label":"primes_mod.f90 (module)","html_id":"primes-mod-f90-module","implicit":true,"key":"L8GrrQdgxk"},{"type":"include","file":"Fortran_Code/Section_Primes/src/primes_mod.f90","literal":true,"children":[{"type":"code","value":"module primes_mod\n    implicit none\n\n    private\n    public :: is_prime\n\ncontains\n\n    function is_prime(n) result(prime)\n        implicit none\n        integer, value :: n\n        logical :: prime\n        integer :: i\n\n        if (n > 1) then\n            prime = .true.\n            do i = 2, nint(sqrt(real(n)))\n                if (mod(n, i) == 0) then\n                    prime = .false.\n                    exit\n                end if\n            end do\n        else\n            prime = .false.\n        end if\n    end function is_prime\n\nend module primes_mod\n","lang":"fortran","filename":"primes_mod.f90","key":"NZRQMRN3Dn"}],"key":"XIrEnIfj3L"}],"key":"h7iu8EZQV7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line"