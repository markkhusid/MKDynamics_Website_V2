\n\ncontains\n\n    function is_prime(n) result(prime)\n        implicit none\n        integer, value :: n\n        logical :: prime\n        integer :: i\n\n        if (n > 1) then\n            prime = .true.\n            do i = 2, nint(sqrt(real(n)))\n                if (mod(n, i) == 0) then\n                    prime = .false.\n                    exit\n                end if\n            end do\n        else\n            prime = .false.\n        end if\n    end function is_prime\n\nend module primes_mod\n","lang":"fortran","filename":"primes_mod.f90","key":"N4pBZ9BErs"}],"key":"ObUOvDPv4m"}],"key":"HBIrBODCbi"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h3PQnR3daK"}],"key":"pb8SHkJdaY"}],"key":"DlJ74kYeNY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oZSgvO3Gwp"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"KqHuVEniLz"}],"key":"ySXEN9vw8P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"sWT1JShxB7"},{"type":"outputs","id":"SUgq4CWT1IAoo05sNCwsF","children":[],"key":"PIeKkvciat"}],"key":"v0fTINRm9B"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1