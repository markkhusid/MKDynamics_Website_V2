    cout << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"cvggRVNDfB"}],"key":"C7ivQrqeAf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ch_stac1.h","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Xb9uveCRCL"}],"key":"dowIWycngQ"}],"key":"urhA7S0gBj"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"c++","value":"// A simple implementation of type ch_stack\n\nconst int max_len = 1000;\nenum { EMPTY = -1, FULL = max_len -1 };\n\nstruct ch_stack\n{\n    char s[max_len];\n    int top;\n};\n\n// A standard set of ch_stack operations.\n\nvoid reset(ch_stack * stk)\n{\n    stk -> top = EMPTY;\n}\n\nvoid push(ch_stack * stk, char c)\n{\n    stk -> s[++stk -> top] = c;  \n}\n\nchar pop(ch_stack * stk)\n{\n    return (stk -> s[stk -> top--]);\n}\n\nchar top(ch_stack * stk)\n{\n    return (stk -> s[stk -> top]);\n}\n\nbool empty(const ch_stack * stk)\n{\n    return (stk -> top == EMPTY); \n}\n\nbool full(const ch_stack * stk)\n{\n    return (stk -> top == FULL);\n}","position":{"start":{"line":1,"column":1},"end":{"line":44,"column":1}},"key":"HSaWr74sou"}],"key":"DT4PT3kp72"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X2Zy8PEIwj"}],"key":"dRAc7pv0u1"}],"key":"r2G1BCfgAq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"RTZLWyMyx6"},{"type":"outputs","id":"3e3VsrLDC6GU9Dlx31Gdy","children":[],"key":"ZMMixiCzZo"}],"key":"T2HzcgGxk8"},{"type":"block","kind":