), pad=[-1, -2])\n    call print_matrix(too_large)\n\ncontains\n\n    subroutine print_matrix(A)\n        implicit none\n        integer, dimension(:, :), intent(in) :: A\n        integer :: i\n\n        do i = 1, size(A, 1)\n            print *, A(i, :)\n        end do\n    end subroutine print_matrix\n\nend program reshape_test","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"x63Ntu8d4R"}],"key":"pVph88l0sJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g2mlOGJoFF"}],"key":"FMFmX0n40z"}],"key":"thGmSNnX0I"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FHVa3JUlK0"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"SZdcoZcgBD"}],"key":"VKYoQqmkcl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"CVSsozUxUK"},{"type":"outputs","id":"5gJ47Lhqo7oNGCBMO2xej","children":[],"key":"GpCkpeAKG5"}],"key":"INO53vOS1C"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Reshape\"","key":"as6bKeApax"},{"type":"outputs","id":"NfyCK5VXmq9po3eSutWbT","children":[],"key":"zCdXoOCEyo"}],"key":"rYtVetA1e9"},{"type":