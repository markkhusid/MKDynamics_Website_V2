), pad=[-1, -2])\n    call print_matrix(too_large)\n\ncontains\n\n    subroutine print_matrix(A)\n        implicit none\n        integer, dimension(:, :), intent(in) :: A\n        integer :: i\n\n        do i = 1, size(A, 1)\n            print *, A(i, :)\n        end do\n    end subroutine print_matrix\n\nend program reshape_test","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"rcrwpVqiUc"}],"key":"X0Yadw7Xui"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CaBt6dNcZZ"}],"key":"zacSvpTse5"}],"key":"nx93knjy8g"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j5fkonneA1"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"Mh7m75rlxL"}],"key":"GWVxVh93MX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"TB8jgZeM5y"},{"type":"outputs","id":"0NbpIyeVaFEgnAVIjx_I8","children":[],"key":"sNufeVYK3p"}],"key":"FNxqwtsP20"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Reshape\"","key":"mWencyyXOK"},{"type":"outputs","id":"1CMf20mMYFvZHYmEgZyPS","children":[],"key":"hJamc38Do7"}],"key":"P5GBHpXJjQ"},{"type":