\n\ncontains\n\n    subroutine print_matrix(A)\n        implicit none\n        integer, dimension(:, :), intent(in) :: A\n        integer :: i\n\n        do i = 1, size(A, 1)\n            print *, A(i, :)\n        end do\n    end subroutine print_matrix\n\nend program reshape_test","position":{"start":{"line":1,"column":1},"end":{"line":29,"column":1}},"key":"VQYVi1dc57"}],"key":"Wq5qm5YWjY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rVFeFOMntl"}],"key":"ZOgT6veGx8"}],"key":"OxL4UghdcX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YVGjQf7lJG"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"vzCxFbeKWQ"}],"key":"ZEiJdLXJhr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"WP3tKx9coc"},{"type":"outputs","id":"L1V724JdDAxTBPnx1MzL6","children":[],"key":"Q1n7zbvU1x"}],"key":"yeW1S7BlHR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Reshape\"","key":"Thtzmb2VHb"},{"type":"outputs","id":"Sbsx5HGoD8Ts6MhAsiVP3","children":[],"key":"GsVgkRVUmn"}],"key":"OP1m5jjjQG"},{"type":"block","kind":"notebook-code","children":[{"type"