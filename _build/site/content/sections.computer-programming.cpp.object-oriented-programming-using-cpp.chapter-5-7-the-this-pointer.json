e <iostream>\n\nusing namespace std;\n\n// The this pointer\n\nclass c_pair {\n    public:\n        void init(char b) { c2 = 1 + (c1 = b); }\n        c_pair increment() { c1++; c2++; return (*this); }\n        c_pair* where_am_I() { return this; }\n        void print() { cout << c1 << c2 << '\\t'; }\n    private:\n        char c1, c2;\n};\n\nint main()\n{\n    c_pair a, b;\n\n    a.init('A');\n    a.print();\n    cout << \" is at \" << a.where_am_I() << endl;\n\n    b.init('B');\n    b.print();\n    cout << \" is at \" << b.where_am_I() << endl;\n    b.increment().print();\n}","position":{"start":{"line":1,"column":1},"end":{"line":31,"column":1}},"key":"Uut6HXE6Wi"}],"key":"YM04qE3Vkl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CXyLSxBO7r"}],"key":"rLe1GkQr0g"}],"key":"RucAtRzm78"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"bbSqhquUOz"},{"type":"outputs","id":"5yJSFEZxAz0rwhsK8_WL1","children":[],"key":"rGWC8wbWSQ"}],"key":"zIp9W0ZxeG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_7_The_this_Pointer\"","key":"u7xStrOk6F"},{"type":"outputs","id":"SkAbDCicqNc2uCrHtMlid","children":[],"key":"BMoiAvSzJR"}],"key":"VrdLDSB0W8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"qkUgxw52UY"},{"type":"outputs","id":"bzG2Mof78jYFzOO-BLsjh","children":[],"key":"X9TA0PF5mV"}],"key":"pXoRSwlPEW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executabl