bove program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aGsHP69h53"}],"key":"X35LmUG2j2"}],"key":"zFpTAzbQva"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"pZoIpY2c96"},{"type":"outputs","id":"9X3W4ZvIpCPd3ET_ZvCsP","children":[],"key":"WN41dsBXDU"}],"key":"pLnnGdRfjq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_8_Static_and_Const_Member_Functions\"","key":"iuTwqq6X52"},{"type":"outputs","id":"FazmsXNs6AqbgGfG6T1MK","children":[],"key":"KRhrxdyweQ"}],"key":"heHsfQfMG5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"QzqAB4n7tq"},{"type":"outputs","id":"UiaF5Yh82Qyp5-GyeG91r","children":[],"key":"NMIDa1h0kU"}],"key":"yQIjKLWXlI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ salary.cpp -w -o salary\")","key":"vYbVst2UQJ"},{"type":"outputs","id":"T3nxwrULrF0iRPtAKMTiY","children":[],"key":"QenFfkuQCp"}],"key":"rswaJ5Kkzc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./salary\")","key":"YQFrdfH7IO"},{"type":"outputs","id":"5K8tO5WpdCc1BxrkFP86Q","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" w1 1600 w2 2700\n"},"children":[],"key":"E7n1VwMAE6"}],"key":"VlDN2RIBXS"}],"key":"B4V1bJ9tfI"}],"key":"bBUMa5ttt2"},"references":{"cite":{"order":[],"data":{}}}}