bove program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YqOZzO7uxV"}],"key":"nwip0mdpSx"}],"key":"H4MFpN2YYs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"rElbbRnCXF"},{"type":"outputs","id":"oa_Yes9ge2V1st8Fd9Zym","children":[],"key":"jGr2e0znss"}],"key":"tWxRYIVzsp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_5_8_Static_and_Const_Member_Functions\"","key":"IV3kLux2YH"},{"type":"outputs","id":"0c6wWH3C9dAfKwgBIaAVm","children":[],"key":"jDqXpO9KCl"}],"key":"BnhyK4Zhm6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"MMha2CIseV"},{"type":"outputs","id":"Je_YWIYdMN9JgXmqBh2SH","children":[],"key":"RnaN6g3ELT"}],"key":"B8rw0i1fzL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ salary.cpp -w -o salary\")","key":"TIsWRKh0W3"},{"type":"outputs","id":"5fIcDnNa-vcBlwS8WC_Iz","children":[],"key":"kunmUWuBuL"}],"key":"BH2DvVzfFP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./salary\")","key":"oJdW8zKGId"},{"type":"outputs","id":"0jZk9hw6pitkwPj4sszgh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" w1 1600 w2 2700\n"},"children":[],"key":"OyCgO6Bhy0"}],"key":"u4GESDQ3RG"}],"key":"hHiIoqp6CK"}],"key":"sp0xMR9YuO"},"references":{"cite":{"order":[],"data":{}}}}