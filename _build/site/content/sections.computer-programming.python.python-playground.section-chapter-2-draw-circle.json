olumn":1},"end":{"line":1,"column":1}},"key":"tOPjpCRJYX"}],"identifier":"in-file-drawcircle-py","label":"In file drawcircle.py","html_id":"in-file-drawcircle-py","implicit":true,"key":"Hm7OY2nHHc"}],"key":"xkziMt1Zsn"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Python_Code/Chapter_2/drawcircle.py","literal":true,"children":[{"type":"code","value":"import math\nimport turtle\n\n# draw the circle using turtle\ndef drawCircleTurtle(x, y, r):\n\t# move to the start of the circle\n\tturtle.up()\n\tturtle.setpos(x + r, y)\n\tturtle.down()\n\n\t# draw the circle\n\tfor i in range(0, 365, 5):\n\t\ta = math.radians(i)\n\t\tturtle.setpos(x + r * math.cos(a), y + r * math.sin(a))\n\ndrawCircleTurtle(100, 100, 50)\nturtle.mainloop()","lang":"python","filename":"drawcircle.py","key":"T8Ob4g9DKg"}],"key":"xasKDggAbk"}],"key":"WgqawPStER"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is directly into Jupyter Lab and executed by the Python Kernel:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fu8ETHWfDe"}],"key":"iOYGCPhX9P"}],"key":"E3NGjIaLvZ"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and Run the Program in Jupyter Lab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xNicdIWf3n"}],"identifier":"load-and-run-the-program-in-jupyter-lab","label":"Load and Run the Program in Jupyter Lab","html_id":"load-and-run-the-program-in-jupyter-lab","implicit":true,"key":"Z0iFUKOpME"}],"visibility":"show","key":"KNhjNbY5cG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.ge