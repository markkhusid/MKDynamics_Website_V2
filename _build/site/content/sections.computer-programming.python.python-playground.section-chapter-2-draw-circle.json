olumn":1},"end":{"line":1,"column":1}},"key":"tUOp5B3hEl"}],"identifier":"in-file-drawcircle-py","label":"In file drawcircle.py","html_id":"in-file-drawcircle-py","implicit":true,"key":"Mk2FBBJznJ"}],"key":"CM0ZIkYq3x"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Python_Code/Chapter_2/drawcircle.py","literal":true,"children":[{"type":"code","value":"import math\nimport turtle\n\n# draw the circle using turtle\ndef drawCircleTurtle(x, y, r):\n\t# move to the start of the circle\n\tturtle.up()\n\tturtle.setpos(x + r, y)\n\tturtle.down()\n\n\t# draw the circle\n\tfor i in range(0, 365, 5):\n\t\ta = math.radians(i)\n\t\tturtle.setpos(x + r * math.cos(a), y + r * math.sin(a))\n\ndrawCircleTurtle(100, 100, 50)\nturtle.mainloop()","lang":"python","filename":"drawcircle.py","key":"crBUG7KexB"}],"key":"F4BLT8QSoT"}],"key":"k4nUxTlmUb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is directly into Jupyter Lab and executed by the Python Kernel:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ulfXxWavbk"}],"key":"l2Sw1BJpZL"}],"key":"Dlb9E8Wyo2"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and Run the Program in Jupyter Lab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u0N5TrkdNg"}],"identifier":"load-and-run-the-program-in-jupyter-lab","label":"Load and Run the Program in Jupyter Lab","html_id":"load-and-run-the-program-in-jupyter-lab","implicit":true,"key":"yW2gRlSTCb"}],"visibility":"show","key":"qjSW48VaCJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.ge