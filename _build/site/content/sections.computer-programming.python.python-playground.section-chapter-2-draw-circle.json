olumn":1},"end":{"line":1,"column":1}},"key":"qv0Ke4nsK7"}],"identifier":"in-file-drawcircle-py","label":"In file drawcircle.py","html_id":"in-file-drawcircle-py","implicit":true,"key":"TL81YgbWm3"}],"key":"xztq0MnqB1"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Python_Code/Chapter_2/drawcircle.py","literal":true,"children":[{"type":"code","value":"import math\nimport turtle\n\n# draw the circle using turtle\ndef drawCircleTurtle(x, y, r):\n\t# move to the start of the circle\n\tturtle.up()\n\tturtle.setpos(x + r, y)\n\tturtle.down()\n\n\t# draw the circle\n\tfor i in range(0, 365, 5):\n\t\ta = math.radians(i)\n\t\tturtle.setpos(x + r * math.cos(a), y + r * math.sin(a))\n\ndrawCircleTurtle(100, 100, 50)\nturtle.mainloop()","lang":"python","filename":"drawcircle.py","key":"O4qimRSPvG"}],"key":"JRoG9WmoCr"}],"key":"JxezWYeX1l"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is directly into Jupyter Lab and executed by the Python Kernel:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IoJFUuSssr"}],"key":"I4tICiqDy1"}],"key":"X0WW0aXMHY"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and Run the Program in Jupyter Lab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ep27pnqOAb"}],"identifier":"load-and-run-the-program-in-jupyter-lab","label":"Load and Run the Program in Jupyter Lab","html_id":"load-and-run-the-program-in-jupyter-lab","implicit":true,"key":"YO7ynO4MAd"}],"visibility":"show","key":"rdvQQIf8qZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.ge