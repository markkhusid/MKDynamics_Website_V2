olumn":1},"end":{"line":1,"column":1}},"key":"DTcC9fMarI"}],"identifier":"in-file-drawcircle-py","label":"In file drawcircle.py","html_id":"in-file-drawcircle-py","implicit":true,"key":"lWRJgHTka2"}],"key":"qePDAS8cmb"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Python_Code/Chapter_2/drawcircle.py","literal":true,"children":[{"type":"code","value":"import math\nimport turtle\n\n# draw the circle using turtle\ndef drawCircleTurtle(x, y, r):\n\t# move to the start of the circle\n\tturtle.up()\n\tturtle.setpos(x + r, y)\n\tturtle.down()\n\n\t# draw the circle\n\tfor i in range(0, 365, 5):\n\t\ta = math.radians(i)\n\t\tturtle.setpos(x + r * math.cos(a), y + r * math.sin(a))\n\ndrawCircleTurtle(100, 100, 50)\nturtle.mainloop()","lang":"python","filename":"drawcircle.py","key":"eoG6wuyCvw"}],"key":"hPa7FF9ZlX"}],"key":"zIm9Iypc2x"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is directly into Jupyter Lab and executed by the Python Kernel:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VqNK1c14HW"}],"key":"O1mghmcpmA"}],"key":"s44X0D3Ewf"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and Run the Program in Jupyter Lab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fBBt5nTkWA"}],"identifier":"load-and-run-the-program-in-jupyter-lab","label":"Load and Run the Program in Jupyter Lab","html_id":"load-and-run-the-program-in-jupyter-lab","implicit":true,"key":"gnsccreoGD"}],"visibility":"show","key":"RnFUgCAl4l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = \"\"\nroot_dir = os.ge