bNC"}],"key":"GblhlKC2nl"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"get_expression","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GelYSIUwZZ"},{"type":"text","value":" uses list-directed read on that string to extract x, op, and y.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Y5Tq8F32LV"}],"key":"tKVslZ3Vpu"}],"key":"LQhWW6tuJY"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"calculate","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"z6E3UNa73J"},{"type":"text","value":" uses select case (op) to choose addition, subtraction, or multiplication.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"eUTZcXOKAM"}],"key":"Y63XoTkhtY"}],"key":"HmC5mUloiU"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Unsupported operators trigger an error on error_unit and stop.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"mD970letfE"}],"key":"RZmsm9LpJh"}],"key":"yiE8WufKux"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The result is printed in scientific format using double precision (REAL64).","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Ye4HjrwPBt"}],"key":"h25Z0BEw9n"}],"key":"PNOdYmWo5U"}],"key":"U1eceK1gNB"}],"key":"haMrsjTyEm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program Code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mFJqskWH10"}],"identifier":"program-code","label":"Program Code","html_id":"program-code","implicit":true,"key":"KTiq97y1YD"}],"key":"XmZGOgafr3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"calculator.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cs9N4GVWBV"}],"identifier":"calculator-f90","label":"calculator.f90","html_id":"calculator-f90","implicit":true,"key":"Asd88ywavd"},{"type":"include","file":"Fortran_Code/Section_Calculator/app/calculator.f90","literal":true,"children":[{"type":"code","value":"program calculator\n    use, intrinsic :: iso_fortran_env, only : DP => REAL64\n    implicit none\n    real(kind=DP) :: x, y\n    character(len=1) :: op\n\n    call get_expression(op, x, y)\n    print '(E15.7)', calculate(op, x, y)\n\ncontains\n\n    subroutine get_expression(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        real(kind=DP), intent(out) :: x, y\n        character, intent(out) :: op\n        character(len=1024) :: string\n        integer :: status\n        character(len=1024) :: msg\n\n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting real operand real on command line'\n            stop 1\n        end if\n        call get_command_argument(1, string)\n        print *, trim(string)\n        read(string, fmt=*, iostat=status, iomsg=msg) x, op, y\n        if (status /= 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'parse error: ', msg\n            stop 2\n        end if\n    end subroutine get_expression\n\n    real(kind=DP) function calculate(op, x, y)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        character(len=1), intent(in) :: op\n        real(kind=DP), intent(in) :: x, y\n\n        select case (op)\n            case ('+')\n                calculate = x + y\n            case ('-')\n                calculate = x - y\n            case ('*')\n                calculate = x*y\n            case default\n                write (unit=error_unit, fmt='(3A)') &\n                    'error: ', op, ' is not a valid operator'\n                stop 3\n        end select\n    end function calculate\n\nend program calculator\n","lang":"fortran","filename":"calculator.f90","key":"kKLUVN3mnz"}],"key":"MRkz8BXU7L"}],"key":"eCGua0Eu5y"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oklt6yeRCL"}],"key":"KtvAAIHpRA"}],"key":"HK7UnDfx2N"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wNB9ThTVUc"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"Qcsl9HKhrt"}],"key":"Any6Y7CMMb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()\n","key":"M15SsWFLVR"},{"type":"outputs","id":"i4RYtnBsmGVg3mJN5zQ3H","children":[],"key":"yluqv2od4b"}],"key":"xlusQCSkTY"},{"type":"block","kind":"notebook-content","children":[{"type":"