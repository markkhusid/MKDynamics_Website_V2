a":{"name":"stdout","output_type":"stream","text":"y(T_END) ≈ 9.992651\n"},"children":[],"key":"PjZq6YfvDe"}],"key":"IKtpKSiOd7"}],"key":"dABlv3XSSG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Problem 3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"orK0yQbuhC"}],"identifier":"problem-3","label":"Problem 3","html_id":"problem-3","implicit":true,"key":"xVr2ldoipw"}],"key":"nfWV28emT7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Equation Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cjpqInApb8"}],"identifier":"define-problem-3s-equation-function","label":"Define Problem 3’s Equation Function","html_id":"define-problem-3s-equation-function","implicit":true,"key":"IEaDmvf154"}],"key":"QwtG0ThkeY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:29.890374Z","iopub.status.busy":"2026-07-25T18:52:29.879313Z","iopub.status.idle":"2026-07-25T18:52:29.975023Z","shell.execute_reply":"2026-07-25T18:52:29.936164Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# -----------------------------------------------------------------------------\n# Problem 3\n# y'' + 4y' + 4y = 25cos(t) + 25sin(t)\n# y(0) = 1, y'(0) = 1\n#\n# Convert the second-order ODE into two first-order ODEs.\n# Let v = y'. Then:\n#       y' = v\n#       v' = y'' = 25cos(t) + 25sin(t) - 4v - 4y\n# -----------------------------------------------------------------------------\ndef p3_f_derivatives_y_t(r, t):\n    \"\"\"Return [dy/dt, dv/dt] for Problem 3, where v = y'.\"\"\"\n    y = r[0]\n    v = r[1]\n\n    dydt = v\n    dvdt = 25*np.cos(t) + 25*np.sin(t) - 4*v - 4*y\n\n    return np.array([dydt, dvdt], float)\n","key":"TmzGGLXheV"},{"type":"outputs","id":"Z2YbxIBIWzaDQ449RMnq0","children":[],"key":"QULvHjoyIP"}],"key":"aMo4rHiLyo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Problem 3’s Initial Conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SR7PgFaPqY"}],"identifier":"define-problem-3s-initial-conditions","label":"Define Problem 3’s Initial Conditions","html_id":"define-problem-3s-initial-conditions","implicit":true,"key":"fHcDLbVNwf"}],"key":"jOuD5Wwfev"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.007394Z","iopub.status.busy":"2026-07-25T18:52:30.006924Z","iopub.status.idle":"2026-07-25T18:52:30.098450Z","shell.execute_reply":"2026-07-25T18:52:30.085343Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"p3_y_init = np.array([1, 1], dtype=float) # [y(0), y'(0)]\n","key":"BiaQVwp482"},{"type":"outputs","id":"Xjhaq2ioSlAYVkoY6BFQT","children":[],"key":"IDCpuU5c7y"}],"key":"gxgBYXCtGQ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T18:52:30.126478Z","iopub.status.busy":"2026-07-25T18:52:30.124489Z","iopub.status.idle":"2026-07-25T18:52:30.180742Z","shell.execute_reply":"2026-07-25T18:52:30.178992Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(p3_y_init)\n","key":"RRu1pUoj79"},{"type":"outputs","id":"M9XEbJbZtfS8CUq1bu2mw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[1. 1.]\n"},"children":[],"key":"d62DycJ5TX"}],"key":"FgYXWYK06J"}],"key":"W34DRMfVSJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"childr