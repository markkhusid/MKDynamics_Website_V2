 total\nend program matrix","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"Z8tapACdzJ"}],"key":"QP01P062Wk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Shzm1IFTnd"}],"key":"L3ZRDba3Fb"}],"key":"XDruVFUPrQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wfgBy52Oeb"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"y6kbsniu44"}],"key":"BwD087NwEz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"UhSOsbNYha"},{"type":"outputs","id":"ahTzG1zPRLAYB8h6nvHod","children":[],"key":"L2DZlhdulB"}],"key":"ryYKhHCXdR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Matrix\"","key":"BUoXRZjhas"},{"type":"outputs","id":"mbtOdlu7iBefP7g91OI5T","children":[],"key":"MSNH6UxSYb"}],"key":"syJSv86Ing"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"JHZ6w1fU5d"},{"type":"outputs","id":"Ga3KFuux8vV50qJMGmHo2","children":[],"key":"anjrpN9Rqg"}],"key":"azpVi6EPr7"},{"type":"block","kind":"notebook-code","children":[{"type":"cod