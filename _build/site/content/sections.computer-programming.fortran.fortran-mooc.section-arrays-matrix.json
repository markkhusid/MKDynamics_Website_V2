 total\nend program matrix","position":{"start":{"line":1,"column":1},"end":{"line":22,"column":1}},"key":"S40dJCGtxZ"}],"key":"GkG2hDtQw4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ODEgQLbdaf"}],"key":"BbyF8TxcuF"}],"key":"fpqoQZjkdg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WYTOaXUZs0"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"sN4sx4RWyZ"}],"key":"fCbDzccmDh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"iSsRLsnBlX"},{"type":"outputs","id":"wxpRInHS2K2oigAqqZaAm","children":[],"key":"RAaZQgeH3S"}],"key":"MQ7K1db4lQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Fortran_Code/Section_Arrays_Matrix\"","key":"UH4nWE2XOm"},{"type":"outputs","id":"uwW9O5p3q5stU2e0TijVq","children":[],"key":"K591Fx2kYZ"}],"key":"BeVjwNXWBe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"IBgYzRGl2Z"},{"type":"outputs","id":"E0ZD56J0Mai43do1Ck2kR","children":[],"key":"xqgm7wXYOc"}],"key":"xrIfSU8StW"},{"type":"block","kind":"notebook-code","children":[{"type":"cod