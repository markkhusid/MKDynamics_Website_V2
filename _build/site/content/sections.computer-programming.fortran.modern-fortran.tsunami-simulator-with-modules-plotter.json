 for line in data])\nx = np.arange(1, h.shape[1]+1)\ntime_steps = [0, 25, 50, 75]","key":"OWaHQ5dKks"},{"type":"outputs","id":"5UVSmakYrD39SV1O3VC6C","children":[],"key":"yrIkNQejTf"}],"key":"qQbYwohwN1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8, 10))\naxes = [plt.subplot2grid((4, 1), (row, 0), colspan=1, rowspan=1)\n        for row in range(4)]\n\nfor ax in axes:\n    n = axes.index(ax)\n    ax.plot(x, h[time_steps[n], :], 'b-')\n    ax.fill_between(x, 0, h[time_steps[n], :], color='b', alpha=0.4)\n    ax.grid()\n    ax.set_xlim(1, 100)\n    ax.set_ylim(0, 1)\n    ax.set_ylabel('Height', fontsize=16)\n    ax.set_xticks([25, 50, 75, 100])\n    ax.set_yticks([0, 0.25, 0.5, 0.75, 1])\n    \nfor ax in axes:\n    n = axes.index(ax)\n    ax.set_title('Time step ' + '%3i' % time_steps[n])\n\nfor ax in axes[:-1]:\n    ax.set_xticklabels([])\n\naxes[3].set_xlabel('', fontsize=16)\naxes[-1].set_xlabel('Spatial grid index')\nplt.show()\n#plt.savefig('water_height_ch03.svg')\n#plt.close(fig)","key":"HpwCVhc2aK"},{"type":"outputs","id":"XYE1hCjRtP17dYQOoFLXM","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"needs_background":"light"},"data":{"image/png":{"content_type":"image/png","hash":"ac56cd06c5cc13c8dbdcb95f4882df82","path":"/ac56cd06c5cc13c8dbdcb95f4882df82.png"},"text/plain":{"content":"<Figure size 576x720 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"rGSjgWapK8"}],"key":"XlVjqbT5Xu"}],"key":"SZMe3RY35H"}],"key":"jZnsuDqvk8"},"references":{"cite":{"order":[],"data":{}}}}