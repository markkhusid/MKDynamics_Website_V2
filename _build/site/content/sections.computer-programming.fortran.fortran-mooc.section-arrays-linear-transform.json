 -1.2, 2.5 ]\n  integer :: i\n\n  call random_number(values)\n  print *, \"The contents of the valus array is:\"\n  print *, values\n  print *, \"lin_transform(values, 2.0, 1.0) = \"\n  print *, lin_transform(values, 2.0, 1.0)\n  print *, \"lin_transform(x, a, b) = \"\n  print *, lin_transform(x, a, b)\n\ncontains\n\n  elemental real function lin_transform(x, a, b)\n      implicit none\n      real, intent(in) :: x, a, b\n\n      lin_transform = a*x + b\n  end function lin_transform\n\nend program linear_transform","position":{"start":{"line":1,"column":1},"end":{"line":28,"column":1}},"key":"ry9wF8TPMR"}],"key":"EHJX6LfWX8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g2iz6fX27r"}],"key":"Ctn1q2rSLl"}],"key":"xZ0Bbr5wdP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eZv6pE7qAt"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"XWqJihHkFH"}],"key":"ps9kXU84qz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"ZXS7HHRSCR"},{"type":"outputs","id":"wWzxTpbiQvvSpVx38oUug","children":[],"key":"gpWW5kpX6B"}],"key":"RTjgSjjvys"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = roo