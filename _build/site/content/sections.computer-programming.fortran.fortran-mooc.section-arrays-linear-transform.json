 -1.2, 2.5 ]\n  integer :: i\n\n  call random_number(values)\n  print *, \"The contents of the valus array is:\"\n  print *, values\n  print *, \"lin_transform(values, 2.0, 1.0) = \"\n  print *, lin_transform(values, 2.0, 1.0)\n  print *, \"lin_transform(x, a, b) = \"\n  print *, lin_transform(x, a, b)\n\ncontains\n\n  elemental real function lin_transform(x, a, b)\n      implicit none\n      real, intent(in) :: x, a, b\n\n      lin_transform = a*x + b\n  end function lin_transform\n\nend program linear_transform","position":{"start":{"line":1,"column":1},"end":{"line":28,"column":1}},"key":"X04hkMI8UV"}],"key":"ftZ1B1MhVZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C9n3k8d5iM"}],"key":"a8w9vwiDdJ"}],"key":"OFPFch8vAW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tjAyDKpmIV"}],"identifier":"build-the-program-using-fpm-fortran-package-manager","label":"Build the Program using FPM (Fortran Package Manager)","html_id":"build-the-program-using-fpm-fortran-package-manager","implicit":true,"key":"oTJQisR7sW"}],"key":"HcRTY1ryhT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"DSzYrvFfxH"},{"type":"outputs","id":"zYz6t9cuwy9JtEUAZzCwW","children":[],"key":"CANvW3Rqxa"}],"key":"Nj0j4JqtGt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = roo