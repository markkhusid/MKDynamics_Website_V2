g OpenMP.  The program uses the following equation for computation:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qUx2V6HN6C"}],"identifier":"this-program-demonstrates-computing-pi-in-fortran-using-openmp-the-program-uses-the-following-equation-for-computation","label":"This program demonstrates computing \\pi in Fortran using OpenMP.  The program uses the following equation for computation:","html_id":"this-program-demonstrates-computing-pi-in-fortran-using-openmp-the-program-uses-the-following-equation-for-computation","implicit":true,"key":"riY1PzZmlv"}],"key":"qOH9jEiA2w"},{"type":"block","kind":"notebook-content","children":[{"type":"math","value":"\\Large \\pi = 4 \\int_{0}^{1} \\sqrt{1-x^2}dx","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mstyle mathsize=\"1.44em\"><mi>π</mi><mo>=</mo><mn>4</mn><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></msqrt><mi>d</mi><mi>x</mi></mstyle></mrow><annotation encoding=\"application/x-tex\">\\Large \\pi = 4 \\int_{0}^{1} \\sqrt{1-x^2}dx</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.62em;\"></span><span class=\"mord mathnormal sizing reset-size6 size8\" style=\"margin-right:0.03588em;\">π</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel sizing reset-size6 size8\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:3.5085em;vertical-align:-1.2916em;\"></span><span class=\"mord sizing reset-size6 size8\">4</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mop sizing reset-