ection-blas-lapack-gemv","implicit":true,"key":"FooqiuWEb3"}],"visibility":"show","key":"yFk2NmJTEs"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kNvpJrpguS"},{"type":"link","url":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/blas_lapack","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/gjbex​/Fortran​-MOOC​/tree​/master​/source​_code​/blas​_lapack","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W5OWzH9B68"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/blas_lapack","error":true,"key":"RsAHwBOxHp"}],"key":"F84PH0xs0m"}],"key":"jWhGQa7WZ4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates using the GEMV BLAS/LAPACK subroutine to perform a matrix vector product in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HEhzVbojjG"}],"identifier":"this-program-demonstrates-using-the-gemv-blas-lapack-subroutine-to-perform-a-matrix-vector-product-in-fortran","label":"This program demonstrates using the GEMV BLAS/LAPACK subroutine to perform a matrix vector product in Fortran.","html_id":"this-program-demonstrates-using-the-gemv-blas-lapack-subroutine-to-perform-a-matrix-vector-product-in-fortran","implicit":true,"key":"pd2QOtI2is"}],"key":"AIBc8EX2gR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DpxtZB0BON"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"section_blas_lapack_gemv.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ncMVsZ8KM6"}],"key":"X4SXKz3sk5"}],"key":"WJ7bY0XRdo"}],"key":"uqxoQhk4ez"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/app/section_blas_lapack_gemv.f90","literal":true,"children":[{"type":"code","value":"program gemv_test\n    use :: util_mod\n    implicit none\n    integer, parameter :: rows = 3, cols = 2\n    integer :: i\n    real, dimension(rows, cols) :: A = reshape( [ (real(i), i=1, rows*cols) ], [ rows, cols ])\n    real, dimension(cols) :: v = [ 1.0, 2.0 ]\n    real, dimension(rows) :: u\n    character(len=12) :: fmt_str = '(*(F6.1))'\n   \n    ! Define explicit interface for the BLAS subroutine sgemv\n    interface\n        subroutine sgemv(trans, m, n, alpha, A, lda, x, incx, beta, y, incy)\n            character :: trans\n            integer :: m, n, lda, incx, incy\n            real :: alpha, beta\n            real, dimension(lda, *) :: A\n            real, dimension(*) :: x, y\n        end subroutine sgemv\n    end interface\n\n    call print_matrix(A, 'A', fmt_str)\n    call print_vector(v, 'v', fmt_str)\n    call sgemv('n', rows, cols, 1.0, A, rows, v, 1, 0.0, u, 1)\n    call print_vector(u, 'u', fmt_str)\n\nend program gemv_test\n","lang":"fortran","filename":"section_blas_lapack_gemv.f90","key":"soXOUOxeEw"}],"key":"pZ4trXOsWw"}],"key":"rMCckz1Cs6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cUcb1lqI6X"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"util_mod.f90","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tfUkmwkEcF"}],"key":"dcQxFPtHXb"}],"key":"cS9BwwuNZo"}],"key":"K1pDNFnyJr"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Fortran_Code/Section_BLAS_LAPACK_GEMV/src/util_mod.f90","literal":true,"children":[{"type":"code","value":"module util_mod\n    implicit none\n\n    private\n\n    public :: print_vector, print_matrix\n\ncontains\n\n    subroutine print_vector(vector, label, fmt_str_in)\n        implicit none\n        real, dimension(:), intent(in) :: vector\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        print fmt_str, vector\n    end subroutine print_vector\n\n    subroutine print_matrix(matrix, label, fmt_str_in)\n        implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        character(len=*), intent(in), optional :: label, fmt_str_in\n        character(len=20) :: fmt_str\n        integer :: row\n\n        if (present(fmt_str_in)) then\n            fmt_str = fmt_str_in\n        else\n            fmt_str = '(*(E18.7))'\n        end if\n        if (present(label)) print '(A)', label\n        do row = 1, size(matrix, 1)\n            print fmt_str, matrix(row, :)\n        end do\n    end subroutine print_matrix\n\nend module util_mod\n","lang":"fortran","filename":"util_mod.f90","key":"FtWrPLXqV6"}],"key":"feXwfCjfZx"}],"key":"PcOZ9UuZHy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column"