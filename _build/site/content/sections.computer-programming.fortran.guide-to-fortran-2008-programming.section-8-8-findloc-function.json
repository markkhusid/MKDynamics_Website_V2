gin findloc call...\nfindloc( X > 0, T )\nThe first element where (i,j) > 0 is: ( 2 1) in column major order.\n"},"children":[],"key":"i7j6Bzhjib"}],"key":"n83L7j6Vac"}],"key":"NwDbqycFqt"}],"key":"RGDJTXrujx"},"references":{"cite":{"order":[],"data":{}}}}