t element where (i,j) > 0 is: ( 2 1) in column major order.\n"},"children":[],"key":"dXYupN0ewo"}],"key":"oAEd0IQO3J"}],"key":"E8iTxEMgjp"}],"key":"CbaG5BuB1p"},"references":{"cite":{"order":[],"data":{}}}}