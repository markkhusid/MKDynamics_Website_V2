gin findloc call...\nfindloc( X > 0, T )\nThe first element where (i,j) > 0 is: ( 2 1) in column major order.\n"},"children":[],"key":"yY1mewG2wE"}],"key":"x46SC8DJck"}],"key":"ik4pgJaqFm"}],"key":"JY5F3N7Xdt"},"references":{"cite":{"order":[],"data":{}}}}