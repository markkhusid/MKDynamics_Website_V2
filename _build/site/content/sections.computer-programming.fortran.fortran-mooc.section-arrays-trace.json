"hwukkFlkWBheYAPLYREdZ","children":[],"visibility":"show","key":"GrMSJWQK9q"}],"visibility":"remove","key":"ethtrhXKUU"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"%%capture\n%%writefile section_arrays_trace.f90\nprogram compute_trace\n    implicit none\n    integer :: i\n    real, dimension(5, 5) :: A\n\n    call random_number(A)\n    do i = 1, size(A, 1)\n        print '(5F7.4)', A(i, :)\n    end do\n    print '(/, A, F7.4)', 'trace = ', trace(A)\n\ncontains\n\n    real function trace(matrix)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        integer :: i\n\n        if (size(matrix, 1) /= size(matrix, 2)) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: can not compute trace of a non-square matrix'\n            stop 1\n        end if\n        trace = 0.0\n        do i = 1, size(matrix, 1)\n            trace = trace + matrix(i, i)\n        end do\n    end function trace\n\nend program compute_trace","visibility":"show","key":"kO9ewN4RVL"},{"type":"outputs","id":"JN5fwPXpgfJmNlVdUQd1H","children":[],"visibility":"show","key":"aANEUDKdY6"}],"visibility":"remove","key":"ucAfKutRZG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"QKvsiLSlkh"},{"type":"outputs","id":"HAy7LLnd8zu3isEbO_b5I","children":[],"key":"oGhnc40Srw"}],"key":"IwIOmWAPjO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_status = os.system(\"fpm build 2>/dev/null\")","key":"kz8c6j5egM"},{"type":"outputs","id":"EYCyIRVehVwmlNz_ysMgS","children":[],"key":"rlLzvlubc4"}],"key":"mVnLqwdHEt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"c