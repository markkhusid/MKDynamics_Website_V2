,"error":true,"key":"pUBK5tPjZD"}],"key":"Q2cXM0bsGI"}],"key":"W4t342G3b8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates computing the trace of a matrix  in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Trn2JLdqd8"}],"identifier":"this-program-demonstrates-computing-the-trace-of-a-matrix-in-fortran","label":"This program demonstrates computing the trace of a matrix  in Fortran.","html_id":"this-program-demonstrates-computing-the-trace-of-a-matrix-in-fortran","implicit":true,"key":"cpj9UrE3ur"}],"key":"i0bG2cGGJh"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program compute_trace\n    implicit none\n    integer :: i\n    real, dimension(5, 5) :: A\n\n    call random_number(A)\n    do i = 1, size(A, 1)\n        print '(5F7.4)', A(i, :)\n    end do\n    print '(/, A, F7.4)', 'trace = ', trace(A)\n\ncontains\n\n    real function trace(matrix)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        real, dimension(:, :), intent(in) :: matrix\n        integer :: i\n\n        if (size(matrix, 1) /= size(matrix, 2)) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: can not compute trace of a non-square matrix'\n            stop 1\n        end if\n        trace = 0.0\n        do i = 1, size(matrix, 1)\n            trace = trace + matrix(i, i)\n        end do\n    end function trace\n\nend program compute_trace","position":{"start":{"line":1,"column":1},"end":{"line":33,"column":1}},"key":"RhneRepPLH"}],"key":"JkQ3zyT8Kp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran