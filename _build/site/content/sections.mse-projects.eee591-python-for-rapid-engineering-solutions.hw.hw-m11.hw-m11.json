on":{"iopub.execute_input":"2026-07-25T16:05:44.617051Z","iopub.status.busy":"2026-07-25T16:05:44.616482Z","iopub.status.idle":"2026-07-25T16:05:44.622358Z","shell.execute_reply":"2026-07-25T16:05:44.620720Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(precisions_list)\n","key":"gdsvE1ApV4"},{"type":"outputs","id":"EoqDOU_RVWGwbhxuUNBcy","children":[],"key":"IgDzrblVes"}],"key":"varwjB0Zyt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Estimate_Pi_Attempt() Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a405bnFKee"}],"identifier":"define-estimate-pi-attempt-function","label":"Define Estimate_Pi_Attempt() Function","html_id":"define-estimate-pi-attempt-function","implicit":true,"key":"y6k1NXSBqo"}],"key":"CopbfxGFTz"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:05:44.625521Z","iopub.status.busy":"2026-07-25T16:05:44.625280Z","iopub.status.idle":"2026-07-25T16:05:44.631150Z","shell.execute_reply":"2026-07-25T16:05:44.629269Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(random())\n    print(type(np.pi))\n    print(f\"{np.pi:.50f}\")\n    print(np.finfo(float))\n","key":"Jrh4jl7HTd"},{"type":"outputs","id":"U755OnkMCdvVcyaMkjkwd","children":[],"key":"oFzgDy6ByR"}],"key":"Ip61RNougZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:05:44.635346Z","iopub.status.busy":"2026-07-25T16:05:44.634828Z","iopub.status.idle":"2026-07-25T16:05:44.641192Z","shell.execute_reply":"2026-07-25T16:05:44.639681Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"################################################################################\n# Function to estimate pi using the Monte Carlo method.  Returns the estimate  #\n# if successful and returns None if not successfull.                           #\n#                                                                              #\n# Inputs:                                                                      #\n#    precision - the desired precision of the estimate                         #\n#                                                                              #\n# Outputs:                                                                     #\n#    returns the estimate of pi at precision and None if not successful        #\n################################################################################\n\ndef estimate_pi_attempt(precision):\n\n    # Initialize the counter that holds the number of points that are\n    # inside the circle.\n    num_points_inside = 0\n\n    # Start estimation loop\n    for total_points in range(1, MAX_NUM_POINTS + 1):\n\n        # Generate random values for x and y\n        x = random() # Number is between 0 and 1\n        y = random() # Number is between 0 and 1\n\n        # Check whether generated points are inside the circle\n        # The condition is if the distance from the origin is <= 1\n        if (x**2 + y**2) <= 1.0:\n            # increment number of points inside circle counter\n            num_points_inside += 1\n\n        # Estimate pi up till now\n        estimated_pi = 4.0 * num_points_inside / total_points\n\n        # Check whether precision criteria is met\n        # if the estimated pi - built in pi is <= precision\n        # then return the estimated pi, otherwise return None\n        if abs(estimated_pi - np.pi) <= precision:\n            return(estimated_pi)\n\n    # Else always return a None for safety\n    return None   \n","key":"JTQ0YabBiB"},{"type":"outputs","id":"Ugn6C6TZ8jM2BCShJ8AF0","children":[],"key":"BXiUb5eBpi"}],"key":"fudAKmvuma"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:05:44.643915Z","iopub.status.busy":"2026-07-25T16:05:44.643637Z","iopub.status.idle":"2026-07-25T16:05:44.648358Z","shell.execute_reply":"2026-07-25T16:05:44.646911Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if debug:\n    print(estimate_pi_attempt(0.001))\n    print(estimate_pi_attempt(1e-20))\n","key":"AbAGO2HnGg"},{"type":"outputs","id":"kkNugkz21o8O2DI44FCL8","children":[],"key":"ffIoDCApQT"}],"key":"uAEMpBi6Xl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define Main() Function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yhEwPXawv5"}],"identifier":"define-main-function","label":"Define Main() Function","html_id":"define-main-function","implicit":true,"key":"YRJXsoFSlW"}],"key":"i2TZYj5P4m"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-25T16:05:44.651616Z","iopub.status.busy":"2026-07-25T16:05:44.651422Z","iopub.status.idle":"2026-07-25T16:05:45.674588Z","shell.execute_reply":"2026-07-25T16:05:45.672456Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def main():\n\n    # Loop through all required precisions in precision_list\n    for precision in precisions_list:\n\n        # Create a list of successful pi estimates at the current \n        # precision iteration.  \n        successful_values = []\n\n        # Initialize success counter\n        success_count = 0\n        \n        # Loop for MAX_NUM_ATTEMPTS times to estimate pi.\n        for attempt in range(MAX_NUM_ATTEMPTS):\n            # Try to estimate pi using the estimate_pi_attempt() function\n            pi_value = estimate_pi_attempt(precision=precision)\n\n            # If successful, add the pi_value to the successful_values list\n            # and increment success counter\n            if pi_value is not None:\n                successful_values.append(pi_value)\n                success_count += 1\n                \n                # Get level 2 debug info\n                if debug_lvl_2:\n                    print(f\"[*] Hit at {pi_value:.7f}, success_count = {success_count}\")\n\n        # Get the average pi value for this precision iteration only if there are successes\n        # Print out results per HW requirements\n        if success_count > 0:\n            average_pi = sum(successful_values) / success_count\n            print(f\"{precision}, success, {success_count}, times, {average_pi}\")\n        else:\n            print(f\"{precision}, no success\")\n\nif __name__ == \"__main__\":\n    main()\n","key":"cg1c83e69t"},{"type":"outputs","id":"TaE4rhuZ7dhyTUaZthMd1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"0.1, success, 100, times, 3.1559089439555827\n0.01, success, 98, times, 3.1415916359894327\n0.001, success, 89, times, 3.1413349566433344\n0.0001, success, 87, times, 3.141575097004688\n"},"children":[],"key":"OpScq6qFm1"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1e-05, success, 73, times, 3.1415923381900077\n"},"children":[],"key":"Os7sAfxBYN"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1e-06, success, 34, times, 3.1415927494298783\n"},"children":[],"key":"a0wumzKzRD"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1e-07, no success\n"},"children":[],"key":"ZPJYmtXW3O"}],"key":"mMnxPNkWy4"}],"key":"WnpkQrjuT3"}],"key":"zxnql3ve5Q"},"references":{"cite":{"order":[],"data":{}}}}