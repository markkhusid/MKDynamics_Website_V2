":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates use of the C++ Standard Template Library","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ODBS5tV9Xq"}],"identifier":"program-that-demonstrates-use-of-the-c-standard-template-library","label":"Program that demonstrates use of the C++ Standard Template Library","html_id":"program-that-demonstrates-use-of-the-c-standard-template-library","implicit":true,"key":"Hwl6ay23dw"},{"type":"code","lang":"cpp","value":"// Using the list container.\n#include <iostream>\n#include <list>\n#include <numeric>\nusing namespace std;\n\nvoid print(const list<double> &lst)\n{ // using an iterator to traverse lst\n    list<double>::const_iterator where;\n\n    for(where = lst.begin(); where != lst.end(); ++where)\n        cout << *where << '\\t';\n    cout << endl;\n}\n\nint main()\n{\n    double w[4] = {0.9, 0.8, 88, -99.99};\n    list<double> z;\n\n    for (int i = 0; i < 4; ++i)\n        z.push_front(w[i]);\n    print(z);\n    z.sort();\n    print(z);\n    cout << \"sum is \" << accumulate(z.begin(), z.end(), 0.0) << endl;\n}","key":"imK92OCeLX"}],"key":"XJX21wEwHI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kO9t66vMGf"}],"key":"FyuWZzYO9e"}],"key":"rFHLFtWCFc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"viGoTu4f6B"},{"type":"outputs","id":"pCiRlaveqQeKDzTmE4YT1","children":[],"key":"UNemsbaI7z"}],"key":"vDUA1xXCvB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \"Cpp_Code/Chapter_1_7_