{"version":3,"kind":"Notebook","sha256":"8a3accbb3ab02d50b2b50bbb06db434405abfc6aeac5f1501d757a0d2c115c4c","slug":"sections.computer-programming.fortran.fortran-mooc.section-arrays-identity","location":"/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","dependencies":[],"frontmatter":{"title":"Section Arrays: Identity","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3.9.15 ('base')","language":"python"},"authors":[{"nameParsed":{"literal":"Mark Khusid","given":"Mark","family":"Khusid"},"name":"Mark Khusid","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/markkhusid/MKDynamics_Website_V2","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":5}},"source_url":"https://github.com/markkhusid/MKDynamics_Website_V2/blob/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","edit_url":"https://github.com/markkhusid/MKDynamics_Website_V2/edit/main/Sections/Computer_Programming/Fortran/Fortran_MOOC/Section_Arrays_Identity.ipynb","exports":[{"format":"ipynb","filename":"Section_Arrays_Identity.ipynb","url":"/Section_Arrays_Ident-601dc99a792b28bd35c68b80ca9ca88a.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"","value":"---\njupytext:\n  formats: md:myst\n  text_representation:\n    extension: .md\n    format_name: myst\nkernelspec:\n  display_name: Python 3\n  language: python\n  name: python3\n---","key":"NdHdYSqSiA"}],"key":"UoJs11LFNo"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Section Arrays: Identity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RpirLFZKM8"}],"identifier":"section-arrays-identity","label":"Section Arrays: Identity","html_id":"section-arrays-identity","implicit":true,"key":"RdEjtkLR9Q"}],"visibility":"show","key":"IGGJ3WYfXX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WcN73qIYuZ"},{"type":"link","url":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/gjbex​/Fortran​-MOOC​/tree​/master​/source​_code​/arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HqXEZW2tLS"}],"urlSource":"https://github.com/gjbex/Fortran-MOOC/tree/master/source_code/arrays","error":true,"key":"J6R6urguki"}],"key":"I1fcCcQpeJ"}],"key":"GPCQOtN3v9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This program demonstrates reading in command line arguments in Fortran.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BFvdXSECXr"}],"identifier":"this-program-demonstrates-reading-in-command-line-arguments-in-fortran","label":"This program demonstrates reading in command line arguments in Fortran.","html_id":"this-program-demonstrates-reading-in-command-line-arguments-in-fortran","implicit":true,"key":"iLtZwvT8bz"}],"key":"B77eJrH5Vm"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"fortran","value":"program identity\n    use, intrinsic :: iso_fortran_env, only : error_unit\n    implicit none\n    integer :: n, i, istat\n    real, dimension(:, :), allocatable :: A\n\n    n = get_size()\n    allocate(A(n, n), stat=istat)\n    if (istat /= 0) then\n        write (unit=error_unit, fmt='(A)') &\n            'error: can not allocate array'\n        stop 3\n    end if\n    A = eye(n)\n    do i = 1, size(A, 1)\n        print *, A(i, :)\n    end do\n    deallocate(A)\n\ncontains\n\n    function get_size() result(n)\n        use, intrinsic :: iso_fortran_env, only : error_unit\n        implicit none\n        integer :: n\n        integer :: istat\n        character(len=1024) :: buffer, msg\n\n        if (command_argument_count() /= 1) then\n            write (unit=error_unit, fmt='(A)') &\n                'error: expecting an integer argument, size of array'\n            stop 1\n        end if\n        call get_command_argument(1, buffer)\n        read (buffer, fmt=*, iostat=istat, iomsg=msg) n\n        if (istat /= 0) then\n            write (unit=error_unit, fmt='(2A)') &\n                'error: ', msg\n            stop 2\n        end if\n    end function get_size\n\n    function eye(n) result(matrix)\n        implicit none\n        integer, value :: n\n        real, dimension(n, n) :: matrix\n        integer :: i\n\n        matrix = 0.0\n        do i = 1, size(A, 1)\n            matrix(i, i) = 1.0\n        end do\n    end function eye\n\nend program identity","position":{"start":{"line":1,"column":1},"end":{"line":57,"column":1}},"key":"zNdOz7d8oB"}],"key":"OSbuk4Cioz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Fortran Package Manager (fpm):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a54gt1U6zx"}],"key":"cRPTnDZ8aD"}],"key":"QQIBS7yMee"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the Program using FPM (Fortran Package Manager)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jOrCOZ6MXr"}],