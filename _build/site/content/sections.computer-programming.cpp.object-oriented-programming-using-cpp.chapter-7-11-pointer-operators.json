nd":{"line":1,"column":1}},"key":"RfjhAzvJXD"}],"identifier":"chapter-7-11-pointer-operators","label":"Chapter 7.11: Pointer Operators","html_id":"chapter-7-11-pointer-operators","implicit":true,"key":"pZtyfnwkDr"}],"visibility":"show","key":"jsOwUypErf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NzvSutaQ4K"}],"key":"YTQ9Qo0jsm"}],"key":"McHx3WmtBa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k5TtdkFP6M"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"KvclcB80z4"}],"key":"jp9xQXk6zV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LNIDay6oGy"}],"key":"JDgFDBNyHQ"}],"key":"uzdQTA1cEU"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"LVIA58r268"}],"key":"AwXkLtP6O8"}],"key":"rGIQ8vvlnD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pP1nQPdZ07"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"WR0DlSwlFK"}],"key":"oiFbwMUn2Z"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XgD4zRdyaP"}],"key":"tiNOwPZTnI"}],"key":"wa5H4YHCb0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"htw2Yv06Xv"},{"type":"outputs","id":"TkBj3l593OzcitpunUrHd","children":[],"key":"srRkBMsMaT"}],"key":"kVAjdk6Ml3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"Wyqg953Asi"},{"type":"outputs","id":"ubZA8i4p2jVKdBiLD_LK7","children":[],"key":"QfCFB1Dhyi"}],"key":"CKd5BwSkXE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"AAIZKF3EPU"},{"type":"outputs","id":"QM3_6XEl5d8req74QtYUV","children":[],"key":"mThnyqsPZL"}],"key":"AJrnFBT92e"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"a8ZG1kg1jr"},{"type":"outputs","id":"iJotA9iFFuWi82UjVF4iz","children":[],"key":"IrdwiczP7x"}],"key":"zmM8tdpoGs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rxxHaYJXjA"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"ee1A7V6FFV"}],"key":"OlI4hOZO68"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./triple\")","key":"QMmzGmkDRZ"},{"type":"outputs","id":"SV1Lg08wcFbQkGjYajjWe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attempting to print triple a...\nunauthorized access\ni = 0, j = 0, k = 0\n\nAttempting to print triple b...\nauthorized access\ni = 4, j = 5, k = 6"},"children":[],"key":"fGNHYaY3gz"}],"key":"fjpFxaegCo"}],"key":"aVaWETY1Gn"}],"key":"ifpSG5W5kt"},"references":{"cite":{"order":[],"data":{}}}}