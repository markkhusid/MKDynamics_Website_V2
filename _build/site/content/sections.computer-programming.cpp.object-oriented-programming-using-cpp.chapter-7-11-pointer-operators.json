nd":{"line":1,"column":1}},"key":"xEUQ3WWRMa"}],"identifier":"chapter-7-11-pointer-operators","label":"Chapter 7.11: Pointer Operators","html_id":"chapter-7-11-pointer-operators","implicit":true,"key":"Um8Hfa0lhr"}],"visibility":"show","key":"sitcgrxh5d"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WQ9J9gvsOb"}],"key":"fQDiHvPg9O"}],"key":"YYwuphSHNt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZclUaSHzKf"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"CMeuh2MtfC"}],"key":"gjDb3VMYYk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VYBt86iUKk"}],"key":"WCQex8HoUI"}],"key":"NzdbpircSL"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"d6NCzkXtLh"}],"key":"WmVBS6YbSS"}],"key":"yYAUTRdP99"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pg45gcy9rT"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"r0OWOP1r2Q"}],"key":"R6sH0WQOSt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aPxbezeQl0"}],"key":"SbF3Y2NqYN"}],"key":"AA0NTcd8yY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"oUi6TWEHmW"},{"type":"outputs","id":"QDclRqyBEmRDmzyCkl29K","children":[],"key":"xlYmOMC70J"}],"key":"Q23MvPF8fO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"vqz2qrGOPj"},{"type":"outputs","id":"jFWv8rdCXxkII2-AlF9vO","children":[],"key":"loGhoewYad"}],"key":"M89iDSfwSk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"ElDHWgSw1k"},{"type":"outputs","id":"Zr1VuapvSZ3bRBtj6TmUb","children":[],"key":"nDe9ASESEs"}],"key":"WbZO2vOQcX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"BfYSNRn6eu"},{"type":"outputs","id":"IqseVkDyrYHM56Ha0n-JS","children":[],"key":"FYRkTNhreo"}],"key":"Vv5922XNHw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UwYkne381r"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"JNpu65inhY"}],"key":"tX7JN1Z2IO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./triple\")","key":"O0dbd9BWa2"},{"type":"outputs","id":"8-bBOz0h-bsNjcs5S6ssm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attempting to print triple a...\nunauthorized access\ni = 0, j = 0, k = 0\n\nAttempting to print triple b...\nauthorized access\ni = 4, j = 5, k = 6"},"children":[],"key":"OyGE7wTj7m"}],"key":"MQelkQmJCA"}],"key":"kAlvM2jqqj"}],"key":"CZbqHH0iP0"},"references":{"cite":{"order":[],"data":{}}}}