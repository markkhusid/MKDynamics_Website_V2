nd":{"line":1,"column":1}},"key":"UA2W7jyEdK"}],"identifier":"chapter-7-11-pointer-operators","label":"Chapter 7.11: Pointer Operators","html_id":"chapter-7-11-pointer-operators","implicit":true,"key":"rxuhZ5I1QZ"}],"visibility":"show","key":"g4vPbvkrx8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wRc2CfJ4Fy"}],"key":"HDw88tgyvk"}],"key":"MHWoLgxWoV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T9k9wzkhAb"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"dp0gTixWsc"}],"key":"IUSlNXfT6W"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GBfWivYBZt"}],"key":"o0wRu1I8ez"}],"key":"Lay8YmaJwr"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"YJ2OrHqcpV"}],"key":"UKHeV93aY8"}],"key":"lMBqqoMYyI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XhEHOOsIpv"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"k4NojPeS9W"}],"key":"ARHjEpM0Ar"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kjba1jBnnw"}],"key":"Zh2y0elH8a"}],"key":"iGGG4vQt4k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"iosTEi0fnj"},{"type":"outputs","id":"g-FvCoc_3_RYOqPT1c580","children":[],"key":"RXgYHgc0f2"}],"key":"BntID77pC2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"c7LmnNiyIZ"},{"type":"outputs","id":"Ao60bdEkgESD5yx7AiNK9","children":[],"key":"Yax3mr1c38"}],"key":"YfcvydKK0g"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"rGQyGfOM4f"},{"type":"outputs","id":"sEmBkMj4W5jYDI0oEhAuc","children":[],"key":"NqG2KcZdUo"}],"key":"GkSB118St2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"Qnre27xzIa"},{"type":"outputs","id":"RYGmXdB3vbNTaUXzDS3vv","children":[],"key":"pvbNJhqy6K"}],"key":"Su7jHLLDL9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g9A7DNvFAK"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"YprPJg12Sn"}],"key":"DkUuvF5DMB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./triple\")","key":"GdXdVXth6l"},{"type":"outputs","id":"vCUvCR9RLLgIp2ivj5XD8","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attempting to print triple a...\nunauthorized access\ni = 0, j = 0, k = 0\n\nAttempting to print triple b...\nauthorized access\ni = 4, j = 5, k = 6"},"children":[],"key":"gea9Qa2czb"}],"key":"SN0DH32BQN"}],"key":"EyHDw01l6q"}],"key":"eht9hPcW0p"},"references":{"cite":{"order":[],"data":{}}}}