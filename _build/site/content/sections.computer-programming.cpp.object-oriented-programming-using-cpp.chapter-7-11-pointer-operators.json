96\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"dQMHnDXnOx"}],"key":"BmRnBkre0t"}],"key":"eTA3yUpF4m"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CtSBYHYCVb"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"tLOUwqTPo4"}],"key":"UqXHfEY3KG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Jjnw0fOlw3"}],"key":"wr9ktO6Uyu"}],"key":"QdUMB0vprN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"LAAucagRyu"},{"type":"outputs","id":"6G0TxbA4gYhTSDfRulqP3","children":[],"key":"Mrg9b0hOzf"}],"key":"rHcTUYXKxV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"hX5NkX4p3P"},{"type":"outputs","id":"eVondARof09_5ylSR3kwN","children":[],"key":"Sjz9VpuZzt"}],"key":"sqAqOvTZd7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"L2EFeJgN0B"},{"type":"outputs","id":"_DsKRBWzj1O8snJs25wVh","children":[],"key":"f162x419hk"}],"key":"ZMjOJdFr8P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"aJi3dQnQML"},{"type":"outputs","id":"3Z7M-r4cEZSUu5CxRGZM9","children":[],"key":"LOyZiUF8Tj"}],"key":"aht1o5XgHH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wAcHxvNNRi"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"MMtwKMhOVi"}],"key":"u3mDuW7vMJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"