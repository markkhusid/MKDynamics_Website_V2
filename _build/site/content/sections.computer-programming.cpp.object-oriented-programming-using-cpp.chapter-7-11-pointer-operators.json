nd":{"line":1,"column":1}},"key":"me6N4m8b9Z"}],"identifier":"chapter-7-11-pointer-operators","label":"Chapter 7.11: Pointer Operators","html_id":"chapter-7-11-pointer-operators","implicit":true,"key":"uqSKgq2iag"}],"visibility":"show","key":"yf8juryw5n"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wx4XUpQZQU"}],"key":"krTOtLNydo"}],"key":"uDGeyPnmGh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YnJvEZpP2f"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"pU48jofH4K"}],"key":"QoTTP48zQZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sx2r3wyvpm"}],"key":"hW42yGpt2K"}],"key":"gSIS2ryPwI"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"IduWiVfr6e"}],"key":"Y4ar2O4WBc"}],"key":"Tcql8GVFDG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vCfqtqCii4"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"Mvaq0KpdXu"}],"key":"TaZmAla7XD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s3UVS1e3OL"}],"key":"RFNJvgohOF"}],"key":"TNzE5XQ2Zx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"QDZM4X2Xsq"},{"type":"outputs","id":"k0D0bZGxUO9J78LbCF3t4","children":[],"key":"s0eE6slKkI"}],"key":"vYlla8evSD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"AopEhH7hJi"},{"type":"outputs","id":"NmLYq2S2Uw2Ub9SfHnslK","children":[],"key":"hxyiLMZnnx"}],"key":"HVQRzGMgZR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"y0tV0Mn9qK"},{"type":"outputs","id":"X_Jv7YTbmKj9El2BAnwrc","children":[],"key":"ObQ2Lo2vKX"}],"key":"Hctvc9MUxY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"xp8iMGI5Vu"},{"type":"outputs","id":"YI1vIUdZi0mZFZCxepxHd","children":[],"key":"dtuCv1XXkT"}],"key":"AZPnmCgsSy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yseBgicM8K"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"RVbZoN0xXQ"}],"key":"Xgcg9AwdaJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./triple\")","key":"fJq27xYPsG"},{"type":"outputs","id":"rpvH940EwC8t5DDtyD8E7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attempting to print triple a...\nunauthorized access\ni = 0, j = 0, k = 0\n\nAttempting to print triple b...\nauthorized access\ni = 4, j = 5, k = 6"},"children":[],"key":"lezhmacGtV"}],"key":"AsfYYDjwV5"}],"key":"gERp9dmUwK"}],"key":"ZJA5jiKpxU"},"references":{"cite":{"order":[],"data":{}}}}