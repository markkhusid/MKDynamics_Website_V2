nd":{"line":1,"column":1}},"key":"yQby2MCAYJ"}],"identifier":"chapter-7-11-pointer-operators","label":"Chapter 7.11: Pointer Operators","html_id":"chapter-7-11-pointer-operators","implicit":true,"key":"x3KIXSxLqO"}],"visibility":"show","key":"PRSt3Dg3jf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adapted from: “Object-Oriented Programming Using C++” by Ira Pohl (Addison - Wesley)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pesu2t3HZo"}],"key":"aWSsr1dSeE"}],"key":"E8LelKkAOC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Program that demonstrates overloading the pointer operator -> in C++","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VIklJgUafv"}],"identifier":"program-that-demonstrates-overloading-the-pointer-operator-in-c","label":"Program that demonstrates overloading the pointer operator -> in C++","html_id":"program-that-demonstrates-overloading-the-pointer-operator-in-c","implicit":true,"key":"bqs83vv3Ve"}],"key":"Lp4By4wJgB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In file triple.cpp","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ACb8zoDX4J"}],"key":"YIm2T7liwZ"}],"key":"NuxJVNYzUN"},{"type":"block","kind":"notebook-content","children":[{"type":"include","file":"Cpp_Code/Chapter_7_11_Pointer_Operators/triple.cpp","literal":true,"children":[{"type":"code","value":"/*********************************************************************\n\n  Filename:  triple.cpp\n  Chapter:   7      Ad Hoc Polymorphism\n  Section:   7.11   Pointer Operators\n  Compiler:  Borland C++     Version 5.0       Summer 1996\n  Object Oriented Programming Using C++, Edition 2   By Ira Pohl\n\n*********************************************************************/\n\n// This file was not present together with the downloadable files that \n// accompany Ira Pohl's book.  This file was typed and adapted from \n// Ira Pohl's book.\n\n#include <iostream>\n\nusing namespace std;\n\nclass triple {\npublic:\n    triple(int a, int b, int c) {\n        i = a;\n        j = b;\n        k = c;\n    }\n\n    void print() {\n        cout << \"\\ni = \" << i << \", j = \"\n             << j << \", k = \" << k;\n    }\n\nprivate:\n    int i, j, k;\n};\n\ntriple unauthor(0, 0, 0);\n\nclass t_ptr {\npublic:\n    t_ptr(bool f, triple* p) {\n        access = f;\n        ptr = p;\n    }\n\n    triple* operator ->() ;\n\nprivate:\n    bool    access;\n    triple* ptr;\n};\n\ntriple* t_ptr::operator->()\n{\n    if (access) {\n        cout << \"\\nauthorized access\";\n        return (ptr);\n    }\n        \n    else {\n        cout << \"\\nunauthorized access\";\n        return &unauthor;\n    }\n}\n\nint main()\n{\n    triple a(1, 2, 3), b(4, 5, 6);\n    t_ptr ta(false, &a), tb(true, &b);\n\n    cout << \"Attempting to print triple a...\";\n    ta -> print();\n\n    cout << endl; cout << endl;\n\n    cout << \"Attempting to print triple b...\";\n    tb -> print();\n}\n","lang":"C++","filename":"triple.cpp","key":"MCQUdrk4f5"}],"key":"GCDVanPKOa"}],"key":"WU4iM6rq5d"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compilation Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Idu1MIouCo"}],"identifier":"compilation-process","label":"Compilation Process","html_id":"compilation-process","implicit":true,"key":"UVUYG2TVqq"}],"key":"ensSUJ07bk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZEM15ZR2VR"}],"key":"dl9PvYBVQD"}],"key":"li9BUyakT3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"i2cVB4M8P7"},{"type":"outputs","id":"UuYxSNknMZl8Bl1zNrZhO","children":[],"key":"e5GjALvkcv"}],"key":"wmXH10eSZh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_7_11_Pointer_Operators\"","key":"uPegTpiz7C"},{"type":"outputs","id":"8HrDUpH-Kzw_D4TcOly1z","children":[],"key":"Yp5MJjQJNp"}],"key":"uO2bOfB7FE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"UJRwcMhlEp"},{"type":"outputs","id":"zVUA7Q7SDKtvBs2WCTl8Z","children":[],"key":"aJEDY7RnMP"}],"key":"opQdvV4x1z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ triple.cpp -w -o triple\")","key":"z3goOQcLlP"},{"type":"outputs","id":"7kX8VCs5_GI48XBg5V43R","children":[],"key":"ml8qdZjpnD"}],"key":"UjIte5Jzqe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Execution Process","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JNLQiPtve7"}],"identifier":"execution-process","label":"Execution Process","html_id":"execution-process","implicit":true,"key":"wIRZLQ2JXv"}],"key":"opCm6N9riG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"exec_status = os.system(\"./triple\")","key":"p91SpBAzGD"},{"type":"outputs","id":"BiMnLzf_kxW-wzUuMCtza","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attempting to print triple a...\nunauthorized access\ni = 0, j = 0, k = 0\n\nAttempting to print triple b...\nauthorized access\ni = 4, j = 5, k = 6"},"children":[],"key":"slXUADgHpj"}],"key":"CTxF5ZxD1i"}],"key":"S1iIBIyLuI"}],"key":"dzbBaIPDYA"},"references":{"cite":{"order":[],"data":{}}}}