/constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"zT3xsLi92l"}],"key":"T9YjRr53yS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CWUbi5OuLM"}],"key":"tTHGIe448P"}],"key":"nBV2pBmHig"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"awANFagRpZ"},{"type":"outputs","id":"LduoTU5iGY4da0y0YYLin","children":[],"key":"YiYJjlh2yf"}],"key":"hFZx88ZCmZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"HicXDPziuM"},{"type":"outputs","id":"Rx4doc3kpeQ-nRKMUKgKN","children":[],"key":"P9nD0theJZ"}],"key":"B6eQ28QyUN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"faRTyIHWop"},{"type":"outputs","id":"XH1VhdmJsmuNm8aHLH9vE","children":[],"key":"dFQ7zIC3d1"}],"key":"fMUPMPHSLg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")",