/constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"Z0upxRjdNx"}],"key":"aI79hC09CD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JXgj4dmN84"}],"key":"U9rrlvxVAB"}],"key":"KhHO7yzqJ7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"KA9i4Q1Gh2"},{"type":"outputs","id":"kn9ea-QdBbRHVpJ9qSo6_","children":[],"key":"VRKVCoGKwt"}],"key":"KV7YYioGwg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"yFms0MUaxm"},{"type":"outputs","id":"W399HWCWrPwSa84g2rp9p","children":[],"key":"I6tq77PYLR"}],"key":"o2BeBsOnec"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"om2IC2zOfU"},{"type":"outputs","id":"SHvrtrQXGS54hc6Ep_tcW","children":[],"key":"l7IEBPvAK5"}],"key":"WYLW2HcopV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")",