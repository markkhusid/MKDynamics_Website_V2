/constructor declaration\n   void  assign(int i) { v = i % modulus; }\n   void  print() const { cout << v << '\\t'; }\n   const static int modulus = 60;\nprivate:\n   int  v;\n};\n\ninline  mod_int::mod_int(int i = 0)\n{\n    v = i % modulus;\n}\nconst int  mod_int::modulus;\n\nint main()\n{\n   int      seconds = 400;\n   mod_int  z(seconds);\n\n   cout << seconds << \" seconds equals \"\n        << seconds / 60 << \" minutes \";\n   z.print();\n   cout << \" seconds\" << endl;\n}","position":{"start":{"line":1,"column":1},"end":{"line":47,"column":1}},"key":"LyOTsJCadT"}],"key":"ZcXDa5K65m"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The above program is compiled and run using Gnu Compiler Collection (g++):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TWw78u5JaC"}],"key":"lM47cogA4A"}],"key":"IPKue1BcwW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nroot_dir = os.getcwd()","key":"n0E7uD8S75"},{"type":"outputs","id":"6acUR2NgeMuU3ekn-W6LU","children":[],"key":"LC3cfmRPXh"}],"key":"VuY4HEaDZ9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"code_dir = root_dir + \"/\" + \\\n    \"Cpp_Code/Chapter_6_1_0_Classes_with_Constructors\"","key":"LBIMsyfY8z"},{"type":"outputs","id":"vUxd_LXJbGB2fsnTCkrE0","children":[],"key":"zS5bFCOBgq"}],"key":"DZWABOfgll"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"os.chdir(code_dir)","key":"TomKmxpAby"},{"type":"outputs","id":"00HyZwOAf-lQxUIN95kKc","children":[],"key":"psXg8BBjKr"}],"key":"N6UP9JJcvd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"build_command = os.system(\"g++ modulo.cpp -w -o modulo\")",