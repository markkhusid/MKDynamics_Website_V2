 n\n\n    read *, n ! Will be piped in from command line\n    print *\n    write (unit = *, fmt = \"(i10, a, i10)\") n, \"! = \", factorial(n)\n\nend program test_factorial\n\n","lang":"fortran","filename":"section_1_16_factorial_recursion.f90","key":"Fv6N9RGOQD"}],"key":"IElpMYg6CT"}],"key":"CePdFaCV8H"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The following explanation is given by “Code Copilot” within ChatGPT 4.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pu6yRmzQTG"}],"key":"lVwI4yMA68"}],"key":"kHhF3QFkM6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The provided Fortran program consists of two main components: a module named ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R12moqsR9A"},{"type":"inlineCode","value":"factorial_module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QaR633erqL"},{"type":"text","value":" and a program named ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RMFhKMbRyR"},{"type":"inlineCode","value":"test_factorial","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BPp9EFlElH"},{"type":"text","value":". Here is an explanation of each part and their interactions:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"frudmFKcgj"}],"key":"Ynr4JglnY3"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Module: factorial_module","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xecWJtUPa8"}],"identifier":"module-factorial-module","label":"Module: factorial_module","html_id":"modul